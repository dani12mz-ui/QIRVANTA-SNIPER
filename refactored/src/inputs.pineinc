string uiMode = input.string("МОБИЛЕН", "Изглед", options=["МОБИЛЕН", "ПОДРОБЕН", "СТАТИСТИКА", "ДИАГНОСТИКА"], group="06 / ИЗГЛЕД", display=display.none)
