// Canonical configuration; generated identically in indicator and validation strategy.
string runModel = input.string("Всички", "Модел за този тест", options=["Всички", "Ретест", "Бърз пробив", "Ранно обръщане"], group="01 / МОДЕЛИ", tooltip="За независимо сравнение стартирай отделно всеки модел със същите данни и разходи. Общият портфейл има фиксиран приоритет: ретест, пробив, обръщане.")
string tradingMode = input.string("АВТОМАТИЧЕН", "Хоризонт", options=["АВТОМАТИЧЕН", "СКАЛПИНГ", "СУИНГ"], group="01 / МОДЕЛИ")
string engineMode = input.string("КОМБИНИРАН", "Подмодел само за РЕТЕСТ", options=["КОМБИНИРАН", "САМО ЛИКВИДНОСТ", "САМО ПРОДЪЛЖЕНИЕ"], group="01 / МОДЕЛИ")
string selectivity = input.string("СНАЙПЪР", "Съгласуваност само за РЕТЕСТ", options=["БАЛАНСИРАН", "СНАЙПЪР", "МНОГО СТРОГ"], group="01 / МОДЕЛИ", tooltip="Брой допълнителни условия, НЕ вероятност за печалба.")
bool useFastBreakout = input.bool(true, "Бърз пробив — изследователски", group="01 / МОДЕЛИ")
bool allowFastCountertrend = input.bool(true, "Пробив срещу HTF — изследователски", group="01 / МОДЕЛИ")
bool useEarlyReversal = input.bool(true, "Ранно обръщане — само M5/M15/M30", group="01 / МОДЕЛИ")
bool automaticHTF = input.bool(true, "Автоматична по-висока рамка", group="01 / МОДЕЛИ")
string customHTF = input.timeframe("60", "Ръчна по-висока рамка", group="01 / МОДЕЛИ")
int liquidityBars = input.int(14, "Период за ликвидност", minval=5, maxval=80, group="02 / СТРУКТУРА")
int structureBars = input.int(6, "Период за структурен пробив", minval=3, maxval=25, group="02 / СТРУКТУРА")
int maxSetupAge = input.int(18, "Срок на ретест модела (свещи)", minval=4, maxval=80, group="02 / СТРУКТУРА")
int maxBarsAfterMSS = input.int(5, "Срок след MSS/BOS (свещи)", minval=1, maxval=25, group="02 / СТРУКТУРА")
int fastBreakLookback = input.int(4, "Бърз пробив: предходни свещи", minval=3, maxval=9, group="02 / СТРУКТУРА")
float fastMinBodyATR = input.float(0.50, "Бърз пробив: мин. тяло / ATR", minval=0.30, maxval=1.5, step=0.05, group="02 / СТРУКТУРА")
float fastMaxBodyATR = input.float(1.65, "Бърз пробив: макс. тяло / ATR", minval=0.9, maxval=3.0, step=0.05, group="02 / СТРУКТУРА")
float fastMaxBreakDistanceATR = input.float(0.70, "Бърз пробив: макс. отстояние / ATR", minval=0.15, maxval=1.4, step=0.05, group="02 / СТРУКТУРА")
int reversalWaitBars = input.int(3, "Обръщане: срок (свещи)", minval=1, maxval=5, group="02 / СТРУКТУРА")
int reversalLiquidityBars = input.int(8, "Обръщане: предходни върхове/дъна", minval=5, maxval=16, group="02 / СТРУКТУРА")
float reversalMaxChaseATR = input.float(0.65, "Обръщане: макс. отстояние / ATR", minval=0.20, maxval=1.5, step=0.05, group="02 / СТРУКТУРА")
float reversalMinRoomR = input.float(1.0, "Обръщане: мин. място до преграда (R)", minval=0.5, maxval=2.5, step=0.25, group="02 / СТРУКТУРА")
float maxRetestCloseATR = input.float(0.55, "Ретест: макс. отстояние / ATR", minval=0.1, maxval=2.0, step=0.05, group="02 / СТРУКТУРА")
int pivotLeft = input.int(3, "Пивот: свещи вляво", minval=2, maxval=10, group="02 / СТРУКТУРА")
int pivotRight = input.int(3, "Пивот: свещи за потвърждение вдясно", minval=2, maxval=10, group="02 / СТРУКТУРА")
float minDisplaceATR = input.float(0.30, "Структурен импулс: тяло / ATR", minval=0.1, maxval=2, step=0.05, group="02 / СТРУКТУРА")
float nearRetestATR = input.float(0.30, "Близост за ретест / ATR", minval=0.05, maxval=2, step=0.05, group="02 / СТРУКТУРА")
float pierceRetestATR = input.float(0.30, "Проникване при ретест / ATR", minval=0.05, maxval=1.5, step=0.05, group="02 / СТРУКТУРА")
float eqToleranceATR = input.float(0.12, "Допуск за равни върхове/дъна / ATR", minval=0.02, maxval=0.5, step=0.02, group="02 / СТРУКТУРА")
int pdWindow = input.int(80, "Скъпа/евтина зона: период", minval=20, maxval=250, group="02 / СТРУКТУРА")
bool requireFVG = input.bool(false, "Изисквай FVG във всеки модел", group="03 / ФИЛТРИ", tooltip="Ретест: FVG при структурното потвърждение. Други модели: FVG на сигналната свещ.")
bool requirePD = input.bool(false, "Изисквай скъпа/евтина зона", group="03 / ФИЛТРИ")
bool requireRoom = input.bool(false, "Изисквай структурно място до TP1", group="03 / ФИЛТРИ", tooltip="Обръщането винаги проверява и EMA прегради. Известна преграда преди TP1 може да блокира входа.")
float minimumRoomR = input.float(1.0, "Минимално място (R)", minval=0.3, maxval=5, step=0.1, group="03 / ФИЛТРИ")
float fvgSizeATR = input.float(0.04, "Мин. FVG / ATR", minval=0, maxval=0.5, step=0.01, group="03 / ФИЛТРИ")
int minADX = input.int(17, "Мин. ADX за ретест и пробив", minval=5, maxval=45, group="03 / ФИЛТРИ")
float minATRratio = input.float(0.55, "Мин. ATR / средно ATR", minval=0.2, maxval=2, step=0.05, group="03 / ФИЛТРИ")
float maxATRratio = input.float(2.8, "Макс. ATR / средно ATR", minval=1, maxval=6, step=0.1, group="03 / ФИЛТРИ")
float maxEntryBarATR = input.float(2.6, "Макс. сигнална свещ / ATR", minval=0.7, maxval=8, step=0.1, group="03 / ФИЛТРИ")
float maxExtensionATR = input.float(2.0, "Макс. отстояние от EMA21 — ретест/пробив", minval=0.5, maxval=6, step=0.1, group="03 / ФИЛТРИ")
bool filterSession = input.bool(false, "Филтър по сесия", group="03 / ФИЛТРИ")
string sessionScope = input.string("Само скалпинг", "Обхват на сесията", options=["Само скалпинг", "Всички рамки"], group="03 / ФИЛТРИ")
string scalpSession = input.session("1000-2000", "Сесия", group="03 / ФИЛТРИ")
string riskTimezone = input.string("Europe/Sofia", "Часова зона за сесия/дневен лимит", group="03 / ФИЛТРИ", tooltip="IANA зона. Денят се определя по времето на отваряне на свещта; DST се обработва от платформата.")
bool manualNewsPause = input.bool(false, "Ръчна пауза за новини — НЯМА календар", group="03 / ФИЛТРИ")
bool useNewsWindow = input.bool(false, "Ръчно въведен новинарски прозорец", group="03 / ФИЛТРИ")
int newsAt = input.time(timestamp("01 Jan 2020 00:00 +0000"), "Проверен час на събитието", group="03 / ФИЛТРИ")
int newsBefore = input.int(15, "Пауза преди събитието (минути)", minval=0, maxval=240, group="03 / ФИЛТРИ")
int newsAfter = input.int(15, "Пауза след събитието (минути)", minval=0, maxval=240, group="03 / ФИЛТРИ")
float spreadAssumption = input.float(0.35, "PAPER: общ спред (ценови единици)", minval=0, step=0.05, group="04 / РИСК", tooltip="Допускане, НЕ получен спред от PU Prime. Не добавяй същия разход два пъти.")
int slipTicks = input.int(2, "PAPER: приплъзване за посока (тикове)", minval=0, maxval=100, group="04 / РИСК")
float feePrice = input.float(0.0, "PAPER: обща комисиона (цена)", minval=0, step=0.05, group="04 / РИСК")
float fundingLong = input.float(0.0, "PAPER: финансиране BUY / ден (цена)", minval=0, step=0.01, group="04 / РИСК")
float fundingShort = input.float(0.0, "PAPER: финансиране SELL / ден (цена)", minval=0, step=0.01, group="04 / РИСК")
float minStopATR = input.float(0.8, "Минимален SL / ATR", minval=0.2, maxval=5, step=0.05, group="04 / РИСК")
float maxStopATR = input.float(3.5, "Максимален SL / ATR", minval=0.8, maxval=8, step=0.1, group="04 / РИСК")
float slBufferATR = input.float(0.12, "Структурен буфер SL / ATR", minval=0.0, maxval=0.5, step=0.02, group="04 / РИСК")
float maxCostRisk = input.float(0.18, "Макс. очакван разход / риск", minval=0.01, maxval=0.7, step=0.01, group="04 / РИСК")
float target1R = input.float(1.0, "TP1 — брутно R", minval=0.4, maxval=4, step=0.1, group="04 / РИСК")
float target2R = input.float(2.0, "TP2 — брутно R", minval=0.5, maxval=7, step=0.1, group="04 / РИСК")
float target3R = input.float(3.0, "TP3 — брутно R", minval=1.0, maxval=10, step=0.1, group="04 / РИСК")
float profitLockR = input.float(0.05, "SL след TP1 — брутен буфер R", minval=0, maxval=0.5, step=0.05, group="04 / РИСК", tooltip="Прилага се от следващата свещ. НЕ гарантира нетна печалба след разходи и гап.")
int minCooldown = input.int(8, "Пауза след технически модел (свещи, по family)", minval=0, maxval=100, group="04 / РИСК")
int scalpMaxHold = input.int(48, "Макс. скалпинг задържане (свещи)", minval=5, maxval=300, group="04 / РИСК")
int swingMaxHold = input.int(60, "Макс. суинг задържане (свещи)", minval=5, maxval=300, group="04 / РИСК")
float maxOpenDeviationATR = input.float(0.20, "PAPER: макс. отклонение на next-open / ATR", minval=0.05, maxval=0.8, step=0.05, group="04 / РИСК")
bool paperGapFilter = input.bool(true, "PAPER: отменяй невалидното next-open", group="04 / РИСК", tooltip="Native market тестът не може да отмени вече изпълнено next-open нареждане. Разликата е описана във VALIDATION_BG.")
int maxPaperLosingStreak = input.int(3, "Филтриран PAPER: дневна поредица загуби", minval=1, maxval=20, group="05 / СТАТИСТИКА")
float maxPaperDailyLossR = input.float(3.0, "Филтриран PAPER: дневен лимит R", minval=0.5, maxval=50, step=0.5, group="05 / СТАТИСТИКА")
bool enableEvidenceShield = input.bool(true, "Пауза на филтрирания портфейл по статистика", group="05 / СТАТИСТИКА")
int globalMinClosed = input.int(30, "Обща защита: мин. затворени сделки", minval=15, maxval=200, group="05 / СТАТИСТИКА")
float globalStopNetR = input.float(-5.0, "Обща защита: праг нетно R", minval=-50, maxval=-1, step=0.5, group="05 / СТАТИСТИКА")
int modelMinClosed = input.int(20, "По модел: мин. затворени сделки", minval=10, maxval=100, group="05 / СТАТИСТИКА")
float modelStopAvgR = input.float(-0.15, "По модел: праг средно нетно R", minval=-1, maxval=-0.05, step=0.05, group="05 / СТАТИСТИКА")
int recoveryTrades = input.int(5, "Възстановяване: допълнителни raw сделки", minval=1, maxval=100, group="05 / СТАТИСТИКА")
bool observeCountertrendOnly = input.bool(true, "Контратренд: не включвай във филтриран портфейл", group="05 / СТАТИСТИКА")
int testStart = input.time(timestamp("01 Jan 2020 00:00 +0000"), "Начало на теста", group="05 / СТАТИСТИКА")
int testEnd = input.time(timestamp("01 Jan 2035 00:00 +0000"), "Край на новите планове", group="05 / СТАТИСТИКА")
string uiMode = input.string("МОБИЛЕН", "Изглед", options=["МОБИЛЕН", "ПОДРОБЕН", "СТАТИСТИКА"], group="06 / ИЗГЛЕД")
string panelPosition = input.string("Горе вляво", "Позиция на таблото", options=["Горе вляво", "Долу вляво", "Горе вдясно", "Долу вдясно"], group="06 / ИЗГЛЕД")
int uiFontPt = input.int(12, "Букви в таблото (pt)", minval=10, maxval=18, group="06 / ИЗГЛЕД")
bool showPanel = input.bool(true, "Показвай таблото", group="06 / ИЗГЛЕД")
bool displayEMAs = input.bool(true, "EMA21 / EMA55", group="06 / ИЗГЛЕД")
bool showLevels = input.bool(true, "Нива на текущия план", group="06 / ИЗГЛЕД")
string displayBook = input.string("RAW", "План на графиката", options=["RAW", "ФИЛТРИРАН"], group="06 / ИЗГЛЕД", tooltip="RAW включва и невалидирани/паузирани модели; не е реална MT5 позиция.")
int keepLabels = input.int(18, "Макс. исторически етикети", minval=1, maxval=60, group="06 / ИЗГЛЕД")
int levelOffset = input.int(3, "Надписи надясно (свещи)", minval=1, maxval=15, group="06 / ИЗГЛЕД")
bool alertsEnabled = input.bool(true, "Общ ключ за всички известия", group="07 / ИЗВЕСТИЯ")
bool alertWatch = input.bool(true, "Наблюдение", group="07 / ИЗВЕСТИЯ")
bool alertPlan = input.bool(true, "Потвърден технически модел", group="07 / ИЗВЕСТИЯ")
bool alertRisk = input.bool(true, "Отмяна / изтичане / статистическо състояние", group="07 / ИЗВЕСТИЯ")
bool alertPaper = input.bool(true, "PAPER изпълнение / цели / стоп", group="07 / ИЗВЕСТИЯ")
string alertBook = input.string("RAW", "PAPER известия за портфейл", options=["RAW", "ФИЛТРИРАН", "И ДВАТА"], group="07 / ИЗВЕСТИЯ")
bool exportEvents = input.bool(false, "JSONL събития в Pine Logs", group="08 / ВАЛИДИРАНЕ", tooltip="Логовете са за експортиране/проверка. Не е webhook за брокер. Платформата ограничава историческите записи.")

int tfSeconds = timeframe.in_seconds()
bool scalp = tradingMode == "СКАЛПИНГ" or (tradingMode == "АВТОМАТИЧЕН" and tfSeconds <= 900)
string autoHTF = tfSeconds <= 300 ? "60" : tfSeconds <= 900 ? "240" : "D"
string htf = automaticHTF ? autoHTF : customHTF
int maxHoldBars = scalp ? scalpMaxHold : swingMaxHold
int minExtra = selectivity == "БАЛАНСИРАН" ? 1 : selectivity == "СНАЙПЪР" ? 2 : 4
float roundTripPriceCost = spreadAssumption + 2.0 * slipTicks * syminfo.mintick + feePrice
bool datePass = time_close >= testStart and time_close < testEnd
bool timedNews = useNewsWindow and time_close >= newsAt - newsBefore * 60000 and time_close <= newsAt + newsAfter * 60000
bool newsPaused = manualNewsPause or timedNews
bool processBar = barstate.isconfirmed
if barstate.isfirst
    if not chart.is_standard
        runtime.error("Използвай стандартни OHLC свещи, не Heikin Ashi/Renko.")
    if not (tfSeconds == 300 or tfSeconds == 900 or tfSeconds == 1800 or tfSeconds == 3600 or tfSeconds == 14400)
        runtime.error("Поддържат се M5, M15, M30, H1 и H4.")
    if timeframe.in_seconds(htf) <= tfSeconds
        runtime.error("HTF трябва да е над текущата времева рамка.")
    if not (target1R < target2R and target2R < target3R)
        runtime.error("Целите трябва да изпълняват TP1 < TP2 < TP3 по R.")
    if maxStopATR <= minStopATR or maxATRratio <= minATRratio or fastMaxBodyATR < fastMinBodyATR
        runtime.error("Невалидни минимални/максимални граници.")
    if testEnd <= testStart
        runtime.error("Краят на теста трябва да е след началото.")
