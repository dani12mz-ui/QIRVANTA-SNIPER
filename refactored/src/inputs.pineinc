// Canonical configuration; generated identically in indicator and validation strategy.
string runModel = input.string("Всички", "Модел за този тест", options=["Всички", "Ретест", "Бърз пробив", "Ранно обръщане"], group="01 / МОДЕЛИ", tooltip="За независимо сравнение стартирай отделно всеки модел със същите данни и разходи. Общият портфейл има фиксиран приоритет: ретест, пробив, обръщане.", display=display.none)
