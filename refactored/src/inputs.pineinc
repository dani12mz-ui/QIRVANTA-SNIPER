string contextPolicy = input.string("БАЗОВ", "Филтриран портфейл: политика", options=["БАЗОВ", "СЪГЛАСУВАН ТРЕНД — ПРОБЕН"], group="05 / СТАТИСТИКА", tooltip="БАЗОВ пази предишните правила. Пробната политика иска еднакви локален/HTF тренд и минимална насоченост. Не е доказано по-печеливша; RAW и моделните книги НЕ се филтрират.", display=display.none)
