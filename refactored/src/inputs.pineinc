bool alertPlan = input.bool(true, "Потвърден технически модел", group="07 / ИЗВЕСТИЯ", display=display.none)
bool alertRisk = input.bool(true, "Отмяна / изтичане / статистическо състояние", group="07 / ИЗВЕСТИЯ", display=display.none)
bool alertPaper = input.bool(true, "PAPER изпълнение / цели / стоп", group="07 / ИЗВЕСТИЯ", display=display.none)
string alertBook = input.string("RAW", "PAPER известия за портфейл", options=["RAW", "ФИЛТРИРАН", "И ДВАТА"], group="07 / ИЗВЕСТИЯ", display=display.none)
bool exportEvents = input.bool(false, "JSONL събития в Pine Logs", group="08 / ВАЛИДИРАНЕ", tooltip="Логовете са за експортиране/проверка. Не е webhook за брокер. Платформата ограничава историческите записи.", display=display.none)

int tfSeconds = timeframe.in_seconds()
bool scalp = tradingMode == "СКАЛПИНГ" or (tradingMode == "АВТОМАТИЧЕН" and tfSeconds <= 900)
string autoHTF = tfSeconds <= 300 ? "60" : tfSeconds <= 900 ? "240" : "D"
string htf = automaticHTF ? autoHTF : customHTF
int maxHoldBars = scalp ? scalpMaxHold : swingMaxHold
int minExtra = selectivity == "БАЛАНСИРАН" ? 1 : selectivity == "СНАЙПЪР" ? 2 : 4
float roundTripPriceCost = spreadAssumption + 2.0 * slipTicks * syminfo.mintick + feePrice
bool datePass = time_close >= testStart and time_close < testEnd
bool timedNews = useNewsWindow and time_close >= newsAt - newsBefore * 60000 and time_close <= newsAt + newsAfter * 60000
bool newsPaused = manualNewsPause or timedNews
bool processBar = barstate.isconfirmed
if barstate.isfirst
    if not chart.is_standard
        runtime.error("Използвай стандартни OHLC свещи, не Heikin Ashi/Renko.")
    if not (tfSeconds == 300 or tfSeconds == 900 or tfSeconds == 1800 or tfSeconds == 3600 or tfSeconds == 14400)
        runtime.error("Поддържат се M5, M15, M30, H1 и H4.")
    if timeframe.in_seconds(htf) <= tfSeconds
        runtime.error("HTF трябва да е над текущата времева рамка.")
    if not (target1R < target2R and target2R < target3R)
        runtime.error("Целите трябва да изпълняват TP1 < TP2 < TP3 по R.")
    if maxStopATR <= minStopATR or maxATRratio <= minATRratio or fastMaxBodyATR < fastMinBodyATR
        runtime.error("Невалидни минимални/максимални граници.")
    if testEnd <= testStart
        runtime.error("Краят на теста трябва да е след началото.")

