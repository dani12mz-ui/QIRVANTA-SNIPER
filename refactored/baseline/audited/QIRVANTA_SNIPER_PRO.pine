int keepSignalLabels = input.int(40, "Отделен архив на потвърдени модели", minval=10, maxval=120, group="06 / ИЗГЛЕД", display=display.none)
bool showContextLabels = input.bool(true, "Показвай кратки наблюдения/отмени", group="06 / ИЗГЛЕД", display=display.none)
