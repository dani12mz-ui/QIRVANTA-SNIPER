//@version=6
indicator("QIRVANTA GOLD PRO · LUMINOUS ZONES", shorttitle="QIRV LUMINOUS", overlay=true, behind_chart=true, max_boxes_count=4, max_lines_count=8, max_labels_count=14, max_bars_back=300, calc_bars_count=1200)

// Frozen observational rules in research/precision_buy_sell_zones/PROTOCOL.json.
bool pzShow = input.bool(true, "Show precision zones", display=display.none)
bool pzMarks = input.bool(true, "Show confirmed lifecycle markers", display=display.none)
bool pzNotify = input.bool(false, "Research zone alerts", display=display.none)
bool pzQa = input.bool(false, "Export precision zones QA journal", display=display.none)
string pzLayout = input.string("DESKTOP", "Layout", options=["DESKTOP", "COMPACT", "MOBILE"], display=display.none)
bool pzLarge = input.bool(true, "Larger text", display=display.none)
bool pzLuminous = input.bool(true, "Luminous zone borders", group="PREMIUM VISUAL EFFECTS", display=display.none)
int pzProjectBars = input.int(5, "Zone right projection (bars)", minval=1, maxval=8, group="PREMIUM VISUAL EFFECTS", display=display.none)
bool pzFormationBadges = input.bool(true, "Formation event badges", group="PREMIUM VISUAL EFFECTS", display=display.none)
string pzCorner = input.string("Auto", "Dashboard position", options=["Auto", "Bottom left", "Bottom right", "Top left", "Top right"], display=display.none)
bool pzReview = input.bool(false, "Historical review", display=display.none)
int pzReviewAt = input.time(timestamp("11 Nov 2026 12:00 +0000"), "Exact UTC close for review", display=display.none)
bool pzSupported = syminfo.tickerid == "OANDA:XAUUSD" and chart.is_standard and
     (timeframe.period == "5" or timeframe.period == "15" or timeframe.period == "30")
bool pzBar = pzSupported and barstate.isconfirmed
int pzInterval = timeframe.in_seconds() * 1000
bool pzGap = not na(time_close[1]) and time != time_close[1]
float pzAtr = ta.atr(14)
float pzBody = math.abs(close - open)
float pzRange = math.max(high - low, syminfo.mintick)
bool pzBull = close > open and (close - low) / pzRange >= .65
bool pzBear = close < open and (high - close) / pzRange >= .65
bool pzBuyFvg = not na(high[2]) and low > high[2] and low - high[2] >= .04 * pzAtr
bool pzSellFvg = not na(low[2]) and high < low[2] and low[2] - high >= .04 * pzAtr
float pzHighPivot = ta.pivothigh(high, 3, 3)
float pzLowPivot = ta.pivotlow(low, 3, 3)
var float pzHigh = na
var float pzLow = na
var int pzHighKnown = na
var int pzLowKnown = na

type PzZone
    string id
    int side
    int born
    int formed
    int origin
    float proximal
    float distal
    float level
    int pivotKnown
    bool fvg
    bool touched = false
    bool partial = false
    bool full = false
    bool rejected = false

var array<PzZone> pzActive = array.new<PzZone>(2, na)
var array<PzZone> pzArchive = array.new<PzZone>(2, na)
var array<string> pzAlertItems = array.new<string>()
var array<label> pzMarkerPool = array.new<label>()
var int pzLastClose = na
var bool pzReviewFound = false
varip int pzLastAlert = na
bool pzLight = color.r(chart.bg_color) * .2126 + color.g(chart.bg_color) * .7152 + color.b(chart.bg_color) * .0722 > 145
color pzBuyInk = pzLight ? #006956 : #31D5B3
color pzSellInk = pzLight ? #A82946 : #F87C88
color pzMuted = #B2BFD0
color pzPanel = #172538

f_pzNumber(float value) => na(value) ? "null" : str.tostring(value, "0.##########")
f_pzInt(int value) => na(value) ? "null" : str.tostring(value)
f_pzBool(bool value) => value ? "true" : "false"
f_pzSide(int side) => side > 0 ? "BUY" : "SELL"
f_pzUtc(int stamp) => str.format_time(stamp, "yyyy-MM-dd HH:mm", "UTC") + " UTC"
f_pzStatus(PzZone zone) =>
    zone.rejected ? "REJECTION CONFIRMED" : zone.full ? "FULLY MITIGATED" : zone.partial ? "PARTIALLY MITIGATED" :
         zone.touched ? "FIRST TOUCH" : "UNTESTED"

f_pzEmit(PzZone zone, string state) =>
    string notification = switch state
        "FIRST_TOUCH" => "RESEARCH " + f_pzSide(zone.side) + " ZONE TOUCHED"
        "REJECTION_CONFIRMED" => "RESEARCH " + f_pzSide(zone.side) + " REJECTION CONFIRMED"
        "INVALIDATED" => "RESEARCH ZONE INVALIDATED"
        => ""
    if pzQa or (pzNotify and notification != "")
        string message = '{"zone_id":"' + zone.id + '","event_id":"' + zone.id + "|" + state +
             '","state":"' + state + '","known_ms":' + f_pzInt(time_close) + ',"bar_index":' + f_pzInt(bar_index) +
             ',"atr":' + f_pzNumber(pzAtr) + ',"side":' + f_pzInt(zone.side) + ',"origin_open_ms":' + f_pzInt(zone.origin) +
             ',"formed_ms":' + f_pzInt(zone.formed) + ',"proximal":' + f_pzNumber(zone.proximal) +
             ',"distal":' + f_pzNumber(zone.distal) + ',"break_level":' + f_pzNumber(zone.level) +
             ',"pivot_known_ms":' + f_pzInt(zone.pivotKnown) + ',"fvg":' + f_pzBool(zone.fvg) +
             ',"observation_only":true,"notification":"' + notification + '"}'
        if pzQa
            log.info("PZ_EVENT|" + message)
        if pzNotify and notification != "" and not pzReview
            array.push(pzAlertItems, message)
    // VISUAL ONLY: new formation badge; event messages and signal conditions are unchanged.
    bool formationBadge = state == "FORMATION_DETECTED" and pzFormationBadges
    if pzShow and pzMarks and (not pzReview or time_close <= pzReviewAt) and (notification != "" or formationBadge)
        bool touch = state == "FIRST_TOUCH"
        bool broken = state == "INVALIDATED"
        color markerBg = zone.side > 0 ? (pzLight ? #006956 : #116B57) : (pzLight ? #9F2843 : #9B3E54)
        string caption = touch ? "◆" : formationBadge ? "◆ " + f_pzSide(zone.side) + " ZONE" :
             broken ? "× " + f_pzSide(zone.side) + " BROKEN" : "✓ " + f_pzSide(zone.side) + " REJECTION"
        if array.size(pzMarkerPool) >= 12
            label.delete(array.shift(pzMarkerPool))
        bool markerAbove = broken ? zone.side > 0 : zone.side < 0
        label mark = label.new(bar_index, markerAbove ? high : low, caption, xloc=xloc.bar_index,
             yloc=touch ? yloc.price : markerAbove ? yloc.abovebar : yloc.belowbar,
             style=touch ? label.style_none : markerAbove ? label.style_label_down : label.style_label_up,
             size=touch ? size.small : formationBadge or pzLayout == "MOBILE" ? size.small : pzLarge ? size.normal : size.small,
             color=color.new(markerBg, broken ? 15 : formationBadge ? 22 : 0),
             textcolor=touch ? markerBg : color.white,
             tooltip=(formationBadge ? "RESEARCH ZONE CREATED" : notification) + "\n" + f_pzUtc(time_close) + "\nObservation only · no trading permission")
        array.push(pzMarkerPool, mark)
    true

if pzBar
    pzLastClose := time_close
    if pzQa
        log.info('PZ_MARKET|{"symbol":"' + syminfo.tickerid + '","timeframe":' + f_pzInt(timeframe.multiplier) +
             ',"index":' + f_pzInt(bar_index) + ',"time":' + f_pzInt(time) + ',"time_close":' + f_pzInt(time_close) +
             ',"open":' + f_pzNumber(open) + ',"high":' + f_pzNumber(high) + ',"low":' + f_pzNumber(low) +
             ',"close":' + f_pzNumber(close) + ',"atr14":' + f_pzNumber(pzAtr) + ',"tick":' + f_pzNumber(syminfo.mintick) +
             ',"pivot_high":' + f_pzNumber(pzHighPivot) + ',"pivot_low":' + f_pzNumber(pzLowPivot) +
             ',"fvg_buy":' + f_pzBool(pzBuyFvg) + ',"fvg_sell":' + f_pzBool(pzSellFvg) + '}')
    array.clear(pzAlertItems)
    for slot = 0 to 1
        PzZone zone = array.get(pzActive, slot)
        if not na(zone)
            if bar_index - zone.born >= 24
                f_pzEmit(zone, "EXPIRED")
                array.set(pzActive, slot, na)
            else if pzAtr > 0 and zone.side * (close - zone.distal) <= -.10 * pzAtr
                f_pzEmit(zone, "INVALIDATED")
                array.set(pzActive, slot, na)
            else
                float top = math.max(zone.proximal, zone.distal)
                float bottom = math.min(zone.proximal, zone.distal)
                bool overlap = low <= top and high >= bottom
                float extreme = zone.side > 0 ? low : high
                if overlap and not zone.touched
                    zone.touched := true
                    f_pzEmit(zone, "FIRST_TOUCH")
                if overlap and not zone.full
                    if zone.side * (extreme - zone.distal) <= 0
                        zone.full := true
                        f_pzEmit(zone, "FULLY_MITIGATED")
                    else if not zone.partial and zone.side * (extreme - zone.proximal) < 0
                        zone.partial := true
                        f_pzEmit(zone, "PARTIALLY_MITIGATED")
                bool priorInside = close[1] >= bottom and close[1] <= top
                if zone.touched and not zone.rejected and not pzGap and (overlap or priorInside) and pzAtr > 0 and
                     zone.side * (close - zone.proximal) > 0 and zone.side * (close - open) >= .25 * pzAtr
                    zone.rejected := true
                    f_pzEmit(zone, "REJECTION_CONFIRMED")

    // These levels were committed before the current bar. Same-close pivots are committed below.
    bool eligible = bar_index >= 250 and not pzGap and pzAtr > 0 and pzBody >= .50 * pzAtr and
         math.round((high - low) / syminfo.mintick) >= 1
    int side = eligible and pzBull and not na(pzHigh) and close > pzHigh and close[1] <= pzHigh ? 1 :
         eligible and pzBear and not na(pzLow) and close < pzLow and close[1] >= pzLow ? -1 : 0
    if side != 0
        for ago = 1 to 5
            if na(time_close[ago]) or time[ago - 1] != time_close[ago]
                break
            float proximal = open[ago]
            float distal = side > 0 ? low[ago] : high[ago]
            float height = side * (proximal - distal)
            if side * (open[ago] - close[ago]) > 0 and math.round(height / syminfo.mintick) >= 2 and height <= 2 * pzAtr
                int slot = side > 0 ? 0 : 1
                PzZone previous = array.get(pzActive, slot)
                if not na(previous)
                    f_pzEmit(previous, "REPLACED")
                string id = syminfo.tickerid + "|" + timeframe.period + "|" + f_pzSide(side) + "|" +
                     f_pzInt(time_close) + "|" + f_pzInt(time[ago])
                PzZone formed = PzZone.new(id, side, bar_index, time_close, time[ago], proximal, distal,
                     side > 0 ? pzHigh : pzLow, side > 0 ? pzHighKnown : pzLowKnown, side > 0 ? pzBuyFvg : pzSellFvg)
                array.set(pzActive, slot, formed)
                f_pzEmit(formed, "FORMATION_DETECTED")
                break
    if not na(pzHighPivot)
        pzHigh := pzHighPivot
        pzHighKnown := time_close
    if not na(pzLowPivot)
        pzLow := pzLowPivot
        pzLowKnown := time_close

    if pzReview and time_close == pzReviewAt
        pzReviewFound := true
        for slot = 0 to 1
            PzZone zone = array.get(pzActive, slot)
            array.set(pzArchive, slot, na(zone) ? na : zone.copy())
    if array.size(pzAlertItems) > 0
        string batch = '{"schema":"qirvanta.precision-zones.research.v1","symbol":"' + syminfo.tickerid +
             '","timeframe":"' + timeframe.period + '","known_ms":' + f_pzInt(time_close) +
             ',"events":[' + array.join(pzAlertItems, ",") + ']}'
        if pzQa
            log.info("PZ_ALERT_INTENT|" + batch)
        if barstate.isrealtime and (na(pzLastAlert) or pzLastAlert != time_close)
            pzLastAlert := time_close
            alert(batch, alert.freq_once_per_bar_close)
    if pzQa and barstate.islastconfirmedhistory
        log.info('PZ_END|{"index":' + f_pzInt(bar_index) + ',"time_close":' + f_pzInt(time_close) + '}')

// Two bands and right-edge tags are recycled. UI only: no changes to detection or risk.
var array<box> pzBands = array.new<box>(2, na)
var array<box> pzSpotlights = array.new<box>(2, na)
var array<line> pzGlowRails = array.new<line>(8, na)
var array<label> pzTags = array.new<label>(2, na)
string pzPosition = switch pzCorner
    "Auto" => pzLayout == "MOBILE" ? position.top_right : position.bottom_left
    "Bottom right" => position.bottom_right
    "Top left" => position.top_left
    "Top right" => position.top_right
    => position.bottom_left
// The outer rows can reserve room for TradingView's status line or watermark.
var table pzTable = table.new(pzPosition, 2, 9)
if barstate.isfirst
    for row in array.from(0, 1, 2, 7, 8)
        table.merge_cells(pzTable, 0, row, 1, row)

if barstate.islast or barstate.islastconfirmedhistory
    if not pzShow
        table.clear(pzTable, 0, 0, 1, 8)
        for slot = 0 to 1
            box inactiveBand = array.get(pzBands, slot)
            box inactiveSpotlight = array.get(pzSpotlights, slot)
            label inactiveTag = array.get(pzTags, slot)
            if not na(inactiveBand)
                box.set_top(inactiveBand, na)
                box.set_bottom(inactiveBand, na)
            if not na(inactiveSpotlight)
                box.set_top(inactiveSpotlight, na)
                box.set_bottom(inactiveSpotlight, na)
            for j = 0 to 3
                line rail = array.get(pzGlowRails, slot * 4 + j)
                if not na(rail)
                    line.set_y1(rail, na)
                    line.set_y2(rail, na)
            if not na(inactiveTag)
                label.set_y(inactiveTag, na)
    else
        bool mobile = pzLayout == "MOBILE"
        int bodySize = (pzLayout == "DESKTOP" ? 13 : mobile ? 10 : 11) + (pzLarge ? 1 : 0)
        int titleSize = bodySize + (mobile ? 1 : 2)
        int detailSize = math.max(9, bodySize - 1)
        string view = pzReview ? (pzReviewFound ? "HISTORICAL REVIEW" : "SELECT UTC CLOSE") : "LIVE OBSERVATION"
        string heading = not pzSupported ? "USE XAUUSD M5/M15/M30" :
             mobile ? "QIRVANTA · PRECISION ZONES" : "QIRVANTA GOLD PRO  /  PRECISION ZONES"
        table.cell(pzTable, 0, 1, heading, text_color=#EDC376, bgcolor=#0D1521,
             text_size=titleSize, text_formatting=text.format_bold, text_halign=text.align_center,
             tooltip="Premium zone visual layer. Original event and alert logic unchanged.")
        string context = (mobile ? syminfo.ticker : syminfo.tickerid) + " · " + timeframe.period + "m · " + view
        table.cell(pzTable, 0, 2, context, text_color=#AFC0D2, bgcolor=#111F2E, text_size=detailSize,
             text_halign=text.align_center)
        int asOf = pzReview ? pzReviewAt : pzLastClose
        array<PzZone> visibleZones = pzReview ? pzArchive : pzActive
        for slot = 0 to 1
            PzZone zone = array.get(visibleZones, slot)
            PzZone other = array.get(visibleZones, 1 - slot)
            box band = array.get(pzBands, slot)
            box spotlight = array.get(pzSpotlights, slot)
            label tag = array.get(pzTags, slot)
            bool isBuy = slot == 0
            color ink = isBuy ? pzBuyInk : pzSellInk
            color captionInk = isBuy ? #5BE4C8 : #FF9AA6
            color cellBg = isBuy ? #12352F : #3B2430
            color tagBg = isBuy ? #0B483A : #662D41
            string side = isBuy ? "BUY" : "SELL"
            string zoneTitle = (isBuy ? "◆  BUY  /  DEMAND" : "◆  SELL  /  SUPPLY")
            string rangeText = "—"
            string statusText = "NO ACTIVE ZONE"
            string timestampText = "WAIT FOR STRUCTURE"
            string tooltip = "No active research zone"
            if not na(zone)
                int right = math.max(zone.formed + 1, asOf + pzInterval * pzProjectBars)
                float top = math.max(zone.proximal, zone.distal)
                float bottom = math.min(zone.proximal, zone.distal)
                string separator = mobile ? "\n" : " – "
                rangeText := str.tostring(zone.proximal, format.mintick) + separator + str.tostring(zone.distal, format.mintick)
                string status = f_pzStatus(zone)
                string shortStatus = zone.rejected ? "REJECTION" : zone.full ? "FULL" : zone.partial ? "PARTIAL" :
                     zone.touched ? "TOUCHED" : "WATCH"
                string clock = str.format_time(zone.formed, "HH:mm", "UTC") + " UTC"
                string age = str.tostring(int(math.max(0, asOf - zone.formed) / 60000)) + "m"
                statusText := mobile ? shortStatus : status
                timestampText := clock + (mobile ? " · " : "   ·   ") + age
                tooltip := side + " RESEARCH ZONE · " + status + "\nProximal → distal " + rangeText +
                     "\nKnown " + f_pzUtc(zone.formed) + (zone.fvg ? "\nSame-close FVG" : "") +
                     "\nNot an approved entry or reversal prediction"
                // LUMINOUS PRESENTATION: two alpha layers and double border rails.
                // All price coordinates stay inside the exact, original proximal/distal range.
                int mainAlpha = zone.rejected ? (pzLight ? 84 : 80) : zone.touched ? (pzLight ? 88 : 85) :
                     (pzLight ? 91 : 87)
                if na(band)
                    band := box.new(zone.formed, top, right, bottom, xloc=xloc.bar_time, border_width=1)
                    array.set(pzBands, slot, band)
                box.set_lefttop(band, zone.formed, top)
                box.set_rightbottom(band, right, bottom)
                box.set_bgcolor(band, color.new(ink, pzLuminous ? mainAlpha : 92))
                box.set_border_color(band, color.new(ink, pzLuminous ? 42 : 55))
                box.set_border_width(band, 1)
                int brightStart = math.max(zone.formed, right - 2 * pzInterval)
                if na(spotlight)
                    spotlight := box.new(brightStart, top, right, bottom, xloc=xloc.bar_time, border_width=0)
                    array.set(pzSpotlights, slot, spotlight)
                box.set_lefttop(spotlight, brightStart, top)
                box.set_rightbottom(spotlight, right, bottom)
                box.set_bgcolor(spotlight, color.new(ink, pzLuminous ? (zone.rejected ? 77 : 86) : 100))
                box.set_border_color(spotlight, color.new(ink, 100))
                // Reusable line objects: each real boundary has a wide translucent halo plus a crisp rail.
                for edge = 0 to 1
                    float price = edge == 0 ? top : bottom
                    for layer = 0 to 1
                        int railIndex = slot * 4 + edge * 2 + layer
                        line rail = array.get(pzGlowRails, railIndex)
                        bool isGlow = layer == 0
                        color railInk = color.new(ink, pzLuminous ? (isGlow ? 77 : zone.rejected ? 6 : 16) :
                             (isGlow ? 100 : 46))
                        int railWidth = isGlow ? 6 : 2
                        if na(rail)
                            rail := line.new(zone.formed, price, right, price, xloc=xloc.bar_time,
                                 color=railInk, width=railWidth)
                            array.set(pzGlowRails, railIndex, rail)
                        line.set_xy1(rail, zone.formed, price)
                        line.set_xy2(rail, right, price)
                        line.set_color(rail, railInk)
                        line.set_width(rail, railWidth)
                        line.set_style(rail, zone.touched ? line.style_solid : line.style_dotted)
                if na(tag)
                    tag := label.new(right, zone.proximal, xloc=xloc.bar_time, yloc=yloc.price,
                         style=label.style_label_left, size=mobile ? size.small : pzLarge ? size.normal : size.small,
                         textcolor=color.white, color=tagBg)
                    array.set(pzTags, slot, tag)
                // Put the higher range's label above its band and the lower range's label below.
                // Both price labels can stay visible even when the zones are close on screen.
                bool upperTag = not na(other) and (zone.proximal + zone.distal > other.proximal + other.distal or
                     (zone.proximal + zone.distal == other.proximal + other.distal and isBuy))
                label.set_style(tag, na(other) ? label.style_label_left :
                     upperTag ? label.style_label_lower_left : label.style_label_upper_left)
                label.set_xy(tag, right, na(other) ? zone.proximal : upperTag ? top : bottom)
                label.set_size(tag, mobile ? size.tiny : pzLarge ? size.normal : size.small)
                label.set_text(tag, mobile ? "◆ " + side + " · " + shortStatus :
                     "◆ " + side + (isBuy ? " DEMAND" : " SUPPLY") + "  ·  " + shortStatus + "\n" + rangeText + "\nRESEARCH ZONE")
                label.set_tooltip(tag, tooltip)
            else
                if not na(band)
                    box.set_top(band, na)
                    box.set_bottom(band, na)
                if not na(spotlight)
                    box.set_top(spotlight, na)
                    box.set_bottom(spotlight, na)
                for j = 0 to 3
                    line rail = array.get(pzGlowRails, slot * 4 + j)
                    if not na(rail)
                        line.set_y1(rail, na)
                        line.set_y2(rail, na)
                if not na(tag)
                    label.set_y(tag, na)
            table.cell(pzTable, slot, 3, zoneTitle, text_color=captionInk, bgcolor=cellBg,
                 text_size=bodySize, text_formatting=text.format_bold, text_halign=text.align_center, tooltip=tooltip)
            table.cell(pzTable, slot, 4, rangeText, text_color=#F2F6FA, bgcolor=#19293B,
                 text_size=mobile ? bodySize : bodySize + 1, text_font_family=font.family_monospace,
                 text_formatting=text.format_bold, text_halign=text.align_center, tooltip=tooltip)
            table.cell(pzTable, slot, 5, "●  " + statusText, text_color=captionInk, bgcolor=#172538,
                 text_size=detailSize, text_halign=text.align_center, tooltip=tooltip)
            table.cell(pzTable, slot, 6, timestampText, text_color=#B7C7D7, bgcolor=#172538,
                 text_size=detailSize, text_halign=text.align_center, tooltip=tooltip)
        table.cell(pzTable, 0, 7, mobile ? "ZONES · RESEARCH ONLY" : "OBSERVATION ONLY   ·   NOT AN EXECUTABLE TRADE",
             text_color=#EDC376, bgcolor=#0D1521, text_size=detailSize,
             text_halign=text.align_center,
             tooltip="A zone may break without reversing. S5/RC2 trading decisions are separate.")
        bool dockedAtTop = pzPosition == position.top_left or pzPosition == position.top_right
        if mobile and dockedAtTop
            table.cell(pzTable, 0, 0, "", height=17, bgcolor=color.new(color.black, 100))
        else
            table.clear(pzTable, 0, 0, 1, 0)
        if not dockedAtTop
            table.cell(pzTable, 0, 8, "", height=mobile ? 6 : 4, bgcolor=color.new(color.black, 100))
        else
            table.clear(pzTable, 0, 8, 1, 8)
