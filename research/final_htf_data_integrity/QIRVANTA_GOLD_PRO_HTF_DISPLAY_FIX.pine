indicator("QIRVANTA GOLD PRO · UNIFIED", shorttitle="QIRVANTA GOLD", overlay=true, behind_chart=false, max_labels_count=42, max_lines_count=16, max_boxes_count=6, max_bars_back=1000, calc_bars_count=1200)
const string CORE_SHA256 = "0d12e94769569a5af6c70061ae1ea4ff5cf4b41b1d8e0867abf739c70710c1d6"
bool tvAllowVolume = false
bool tvEnglish = "Български" == "English"
bool tvAlertConfirmed = false
bool tvAlertClosed = true
// @tv-inputs
// S0 is the unchanged Champion. One selected mode feeds one native account.
string tvStrategyMode = "S5"
bool tvCandidateRequireHTF = false

// BEGIN CANONICAL CORE 0d12e94769569a5af6c70061ae1ea4ff5cf4b41b1d8e0867abf739c70710c1d6
// Canonical configuration; generated identically in indicator and validation strategy.
string runModel = "Всички"
string tradingMode = "АВТОМАТИЧЕН"
string engineMode = "КОМБИНИРАН"
string selectivity = "СНАЙПЪР"
bool useFastBreakout = true
bool allowFastCountertrend = true
bool useEarlyReversal = true
bool automaticHTF = true
string customHTF = "60"
int liquidityBars = 14
int structureBars = 6
int maxSetupAge = 18
int maxBarsAfterMSS = 5
int fastBreakLookback = 4
float fastMinBodyATR = 0.50
float fastMaxBodyATR = 1.65
float fastMaxBreakDistanceATR = 0.70
int reversalWaitBars = 3
int reversalLiquidityBars = 8
float reversalMaxChaseATR = 0.65
float reversalMinRoomR = 1.0
