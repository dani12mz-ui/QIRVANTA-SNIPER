int tfSeconds = timeframe.in_seconds()
bool scalp = tradingMode == "СКАЛПИНГ" or (tradingMode == "АВТОМАТИЧЕН" and tfSeconds <= 900)
string autoHTF = tfSeconds <= 300 ? "60" : tfSeconds <= 900 ? "240" : "D"
string htf = automaticHTF ? autoHTF : customHTF
int maxHoldBars = scalp ? scalpMaxHold : swingMaxHold
int minExtra = selectivity == "БАЛАНСИРАН" ? 1 : selectivity == "СНАЙПЪР" ? 2 : 4
float roundTripPriceCost = spreadAssumption + 2.0 * slipTicks * syminfo.mintick + feePrice
bool datePass = time_close >= testStart and time_close < testEnd
bool timedNews = useNewsWindow and time_close >= newsAt - newsBefore * 60000 and time_close <= newsAt + newsAfter * 60000
bool newsPaused = manualNewsPause or timedNews
bool processBar = barstate.isconfirmed
if barstate.isfirst
    if not chart.is_standard
        runtime.error("Използвай стандартни OHLC свещи, не Heikin Ashi/Renko.")
    if not (tfSeconds == 300 or tfSeconds == 900 or tfSeconds == 1800 or tfSeconds == 3600 or tfSeconds == 14400)
        runtime.error("Поддържат се M5, M15, M30, H1 и H4.")
    if timeframe.in_seconds(htf) <= tfSeconds
        runtime.error("HTF трябва да е над текущата времева рамка.")
    if not (target1R < target2R and target2R < target3R)
        runtime.error("Целите трябва да изпълняват TP1 < TP2 < TP3 по R.")
    if maxStopATR <= minStopATR or maxATRratio <= minATRratio or fastMaxBodyATR < fastMinBodyATR
        runtime.error("Невалидни минимални/максимални граници.")
    if testEnd <= testStart
        runtime.error("Краят на теста трябва да е след началото.")

// The [1] HTF offset + lookahead_on returns the last COMPLETED HTF candle.
[htfClose, htfEMA50, htfEMA200, htfEMA50prev] = request.security(syminfo.tickerid, htf, [close[1], ta.ema(close, 50)[1], ta.ema(close, 200)[1], ta.ema(close, 50)[3]], lookahead=barmerge.lookahead_on)
[priorDayHigh, priorDayLow] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
bool readyHTF = not na(htfClose) and not na(htfEMA50) and not na(htfEMA50prev)
bool bullHTF = readyHTF and htfClose > htfEMA50 and htfEMA50 > htfEMA50prev
bool bearHTF = readyHTF and htfClose < htfEMA50 and htfEMA50 < htfEMA50prev
bool strongBullHTF = bullHTF and not na(htfEMA200) and htfClose > htfEMA200
bool strongBearHTF = bearHTF and not na(htfEMA200) and htfClose < htfEMA200
float emaFast = ta.ema(close, 21)
float emaSlow = ta.ema(close, 55)
float atr = ta.atr(14)
float atrMean = ta.sma(atr, 40)
float rsi = ta.rsi(close, 14)
// Causal efficiency ratio: all inputs belong to this bar or preceding bars.
float traveled = math.sum(math.abs(ta.change(close)), efficiencyLength)
float efficiency = not na(traveled) and not na(close[efficiencyLength]) ? (traveled > 0 ? math.min(1.0, math.abs(close - close[efficiencyLength]) / traveled) : 0.0) : na
[diPlus, diMinus, adx] = ta.dmi(14, 14)
float body = math.abs(close - open)
float barRange = math.max(high - low, syminfo.mintick)
bool bullishBar = close > open and (close - low) / barRange >= 0.65
bool bearishBar = close < open and (high - close) / barRange >= 0.65
bool displacementUp = bullishBar and body >= atr * minDisplaceATR
bool displacementDn = bearishBar and body >= atr * minDisplaceATR
bool bullLocal = close > emaFast and emaFast > emaSlow and emaFast >= emaFast[2]
bool bearLocal = close < emaFast and emaFast < emaSlow and emaFast <= emaFast[2]
bool bullMomentum = rsi > 50 and diPlus > diMinus
bool bearMomentum = rsi < 50 and diMinus > diPlus
bool validATR = not na(atrMean) and atr > 0 and atr >= atrMean * minATRratio and atr <= atrMean * maxATRratio
bool validTrend = not na(adx) and adx >= minADX
bool acceptableBar = atr > 0 and barRange <= atr * maxEntryBarATR
bool notExtended = atr > 0 and math.abs(close - emaFast) <= atr * maxExtensionATR
bool inSession = not na(time(timeframe.period, scalpSession, riskTimezone))
bool sessionPass = not filterSession or (sessionScope == "Само скалпинг" and not scalp) or inSession
bool warmup = bar_index > 250 and readyHTF and not na(atrMean) and not na(rsi) and not na(adx)
float sweepHigh = ta.highest(high, liquidityBars)[1]
float sweepLow = ta.lowest(low, liquidityBars)[1]
float shortStruct = ta.lowest(low, structureBars)[1]
float longStruct = ta.highest(high, structureBars)[1]
float localSwingLow = ta.lowest(low, structureBars)
float localSwingHigh = ta.highest(high, structureBars)
float pdHi = ta.highest(high, pdWindow)[1]
float pdLo = ta.lowest(low, pdWindow)[1]
float pdMid = (pdHi + pdLo) / 2.0
bool inDiscount = not na(pdMid) and close <= pdMid
bool inPremium = not na(pdMid) and close >= pdMid
bool bullFvgNow = not na(high[2]) and low > high[2] and low - high[2] >= fvgSizeATR * atr
bool bearFvgNow = not na(low[2]) and high < low[2] and low[2] - high >= fvgSizeATR * atr
bool sweepDown = not na(sweepLow) and low < sweepLow and close > sweepLow and (math.min(open, close) - low) / barRange >= 0.23
bool sweepUp = not na(sweepHigh) and high > sweepHigh and close < sweepHigh and (high - math.max(open, close)) / barRange >= 0.23
bool bosUp = not na(sweepHigh) and close > sweepHigh and close[1] <= sweepHigh and displacementUp
bool bosDown = not na(sweepLow) and close < sweepLow and close[1] >= sweepLow and displacementDn
// Short local break trigger: confirmed PREVIOUS highs/lows, no pivot hindsight.
float fastBreakHigh = ta.highest(high, fastBreakLookback)[1]
float fastBreakLow = ta.lowest(low, fastBreakLookback)[1]
float fastStopHigh = ta.highest(high, 3)[1]
float fastStopLow = ta.lowest(low, 3)[1]
float priorReversalLow = ta.lowest(low, reversalLiquidityBars)[1]
float priorReversalHigh = ta.highest(high, reversalLiquidityBars)[1]
float priorRecoveryHigh = ta.highest(high, 12)[1]
float priorRecoveryLow = ta.lowest(low, 12)[1]
float pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
float pivotLow = ta.pivotlow(low, pivotLeft, pivotRight)
var float lastPivotHigh = na
var float prevPivotHigh = na
var float lastPivotLow = na
var float prevPivotLow = na
// A developing pivot on an open realtime bar may disappear. Commit pivots on candle close only.
if barstate.isconfirmed and not na(pivotHigh)
    prevPivotHigh := lastPivotHigh
    lastPivotHigh := pivotHigh
if barstate.isconfirmed and not na(pivotLow)
    prevPivotLow := lastPivotLow
    lastPivotLow := pivotLow
bool equalHighs = barstate.isconfirmed and not na(prevPivotHigh) and not na(lastPivotHigh) and math.abs(lastPivotHigh - prevPivotHigh) <= atr * eqToleranceATR
bool equalLows = barstate.isconfirmed and not na(prevPivotLow) and not na(lastPivotLow) and math.abs(lastPivotLow - prevPivotLow) <= atr * eqToleranceATR
bool higherHigh = not na(prevPivotHigh) and lastPivotHigh > prevPivotHigh
bool higherLow = not na(prevPivotLow) and lastPivotLow > prevPivotLow
bool lowerHigh = not na(prevPivotHigh) and lastPivotHigh < prevPivotHigh
bool lowerLow = not na(prevPivotLow) and lastPivotLow < prevPivotLow
string pivotStructure = higherHigh and higherLow ? "По-високи върхове/дъна" : lowerHigh and lowerLow ? "По-ниски върхове/дъна" : "Смесена/непотвърдена структура"

// Completed Asian session levels, not the developing high/low.
bool asiaActive = timeframe.isintraday and not na(time(timeframe.period, "0200-1000", riskTimezone))
var float asianH = na
var float asianL = na
var float lastAsianH = na
var float lastAsianL = na
// Freeze the session bounds using closed candles; release levels at the session's first closed non-Asia bar.
if barstate.isconfirmed
    if asiaActive
        if not asiaActive[1] or na(asianH)
            asianH := high
            asianL := low
        else
            asianH := math.max(asianH, high)
            asianL := math.min(asianL, low)
    else if asiaActive[1]
        lastAsianH := asianH
        lastAsianL := asianL

// Remember only confirmed, not-fully-mitigated FVGs. A FVG is NOT verified institutional flow.
var float bullGapTop = na
var float bullGapBottom = na
var int bullGapAt = na
var float bearGapTop = na
var float bearGapBottom = na
var int bearGapAt = na
if barstate.isconfirmed
    if bullFvgNow
        bullGapTop := low
        bullGapBottom := high[2]
        bullGapAt := bar_index
    else if not na(bullGapAt)
        if bar_index - bullGapAt > 75 or low <= bullGapBottom
            bullGapAt := na
            bullGapTop := na
            bullGapBottom := na
        else if low < bullGapTop
            // Track partial mitigation. Do not continue displaying a filled segment.
            bullGapTop := low
    if bearFvgNow
        bearGapTop := low[2]
        bearGapBottom := high
        bearGapAt := bar_index
    else if not na(bearGapAt)
        if bar_index - bearGapAt > 75 or high >= bearGapTop
            bearGapAt := na
            bearGapTop := na
            bearGapBottom := na
        else if high > bearGapBottom
            bearGapBottom := high

// Closest available *confirmed* opposing liquidity reference, never future pivots.
float longObstacle = na
float shortObstacle = na
if not na(lastPivotHigh) and lastPivotHigh > close
    longObstacle := lastPivotHigh
if not na(priorDayHigh) and priorDayHigh > close
    longObstacle := na(longObstacle) ? priorDayHigh : math.min(longObstacle, priorDayHigh)
if not na(lastAsianH) and lastAsianH > close
    longObstacle := na(longObstacle) ? lastAsianH : math.min(longObstacle, lastAsianH)
if not na(lastPivotLow) and lastPivotLow < close
    shortObstacle := lastPivotLow
if not na(priorDayLow) and priorDayLow < close
    shortObstacle := na(shortObstacle) ? priorDayLow : math.max(shortObstacle, priorDayLow)
if not na(lastAsianL) and lastAsianL < close
    shortObstacle := na(shortObstacle) ? lastAsianL : math.max(shortObstacle, lastAsianL)

string regime = validATR and atr > atrMean * 1.9 ? "СИЛНА ВОЛАТИЛНОСТ" : validATR and atr < atrMean * 0.7 ? "СВИТА ВОЛАТИЛНОСТ" : adx < minADX ? "ДИАПАЗОН / СЛАБ ТРЕНД" : bullHTF ? "ВЪЗХОДЯЩ ТРЕНД" : bearHTF ? "НИЗХОДЯЩ ТРЕНД" : "НЕУТРАЛНО"


// Display and analysis refer to closed candles only. No unconfirmed marker is emitted.
bool structureDownNow = barstate.isconfirmed and not na(shortStruct) and close < shortStruct and close[1] >= shortStruct and displacementDn
bool structureUpNow = barstate.isconfirmed and not na(longStruct) and close > longStruct and close[1] <= longStruct and displacementUp

float uiLocalEMA50 = ta.ema(close, 50)
float uiH1Close = na
float uiH1EMA = na
float uiH1EarlierEMA = na
int uiH1ClosedAt = na
float uiH4Close = na
float uiH4EMA = na
float uiH4EarlierEMA = na
int uiH4ClosedAt = na
if tfSeconds < 3600
    [uiC1, uiE1, uiP1, uiT1] = request.security(syminfo.tickerid, "60", [close[1], ta.ema(close, 50)[1], ta.ema(close, 50)[3], time_close[1]], lookahead=barmerge.lookahead_on)
    uiH1Close := uiC1
    uiH1EMA := uiE1
    uiH1EarlierEMA := uiP1
    uiH1ClosedAt := uiT1
else if tfSeconds == 3600
    uiH1Close := barstate.isconfirmed ? close : close[1]
    uiH1EMA := barstate.isconfirmed ? uiLocalEMA50 : uiLocalEMA50[1]
    uiH1EarlierEMA := barstate.isconfirmed ? uiLocalEMA50[2] : uiLocalEMA50[3]
    uiH1ClosedAt := barstate.isconfirmed ? time_close : time_close[1]
if tfSeconds < 14400
    [uiC4, uiE4, uiP4, uiT4] = request.security(syminfo.tickerid, "240", [close[1], ta.ema(close, 50)[1], ta.ema(close, 50)[3], time_close[1]], lookahead=barmerge.lookahead_on)
    uiH4Close := uiC4
    uiH4EMA := uiE4
    uiH4EarlierEMA := uiP4
    uiH4ClosedAt := uiT4
else if tfSeconds == 14400
    uiH4Close := barstate.isconfirmed ? close : close[1]
    uiH4EMA := barstate.isconfirmed ? uiLocalEMA50 : uiLocalEMA50[1]
    uiH4EarlierEMA := barstate.isconfirmed ? uiLocalEMA50[2] : uiLocalEMA50[3]
    uiH4ClosedAt := barstate.isconfirmed ? time_close : time_close[1]
int uiH1Bias = na(uiH1EarlierEMA) ? 0 : uiH1Close > uiH1EMA and uiH1EMA > uiH1EarlierEMA ? 1 : uiH1Close < uiH1EMA and uiH1EMA < uiH1EarlierEMA ? -1 : 0
int uiH4Bias = na(uiH4EarlierEMA) ? 0 : uiH4Close > uiH4EMA and uiH4EMA > uiH4EarlierEMA ? 1 : uiH4Close < uiH4EMA and uiH4EMA < uiH4EarlierEMA ? -1 : 0
string uiRegime = not warmup ? "Недостатъчно данни" : not validATR ? "Волатилност извън обхват" : atr > atrMean * 1.9 ? "Разширяване" : atr < atrMean * 0.7 ? "Свиване" : adx < minADX ? "Диапазон" : bullLocal and bullHTF ? "Тренд нагоре" : bearLocal and bearHTF ? "Тренд надолу" : "Преход / неясно"

// Confirmed context shared by research candidates and the dashboard.
bool tvEntryFrame = chart.is_standard and (tfSeconds == 300 or tfSeconds == 900 or tfSeconds == 1800)
bool tvContextReady = not na(uiH1ClosedAt) and not na(uiH4ClosedAt) and not na(uiH1EarlierEMA) and not na(uiH4EarlierEMA)
int tvH1Bias = uiH1Bias
int tvH4Bias = uiH4Bias
float tvAtrPercentile = ta.percentrank(atr, 100)
float tvBodyATR = atr > 0 ? body / atr : na
float tvWickBody = (barRange - body) / math.max(body, syminfo.mintick)
float tvEmaSlope = atr > 0 ? (emaFast - emaFast[5]) / atr : na
float tvPullbackDepth = atr > 0 ? math.abs(close - emaFast) / atr : na
bool tvShock = not na(atrMean) and (atr > 1.9 * atrMean or barRange > 3.0 * atr)
bool tvCompression = not na(tvAtrPercentile) and tvAtrPercentile <= 20 and atr < 0.85 * atrMean
bool tvExpansion = not na(tvAtrPercentile) and tvAtrPercentile >= 80 and atr > 1.25 * atrMean
int tvObservedRegime = not warmup or not tvContextReady or na(efficiency) or na(tvAtrPercentile) ? 0 : tvExpansion ? 4 : tvCompression ? 3 : bullLocal and tvEmaSlope > 0.10 and efficiency >= 0.30 and adx >= minADX ? 1 : bearLocal and tvEmaSlope < -0.10 and efficiency >= 0.30 and adx >= minADX ? -1 : adx < minADX or efficiency < 0.20 ? 2 : 0
var int tvRegime = 0
var int tvRegimeStreak = 0
var int tvRegimeCandidate = 0
var int tvTrendAge = 0
var int tvStructure = 0
bool tvBullChange = false
bool tvBearChange = false
if processBar
    if tvObservedRegime == tvRegimeCandidate
        tvRegimeStreak := math.min(3, tvRegimeStreak + 1)
    else
        tvRegimeCandidate := tvObservedRegime
        tvRegimeStreak := 1
    if not warmup or not tvContextReady
        tvRegime := 0
    else if tvRegimeStreak >= 3
        tvRegime := tvRegimeCandidate
    tvTrendAge := math.abs(tvRegime) == 1 ? (tvRegime == tvRegime[1] ? math.min(500, tvTrendAge + 1) : 1) : 0
    if structureUpNow
        tvBullChange := tvStructure == -1
        tvStructure := 1
    else if structureDownNow
        tvBearChange := tvStructure == 1
        tvStructure := -1
bool tvExhaustion = tvTrendAge >= 12 and tvPullbackDepth > 1.2 and (tvWickBody > 1.0 or efficiency < efficiency[3])

// London and New York opening ranges require the entire first hour on this chart.
// IANA time zones follow local daylight saving. Gaps make the current range unavailable.
type TvOpeningRange
    float buildingHigh = na
    float buildingLow = na
    float frozenHigh = na
    float frozenLow = na
    int nextOpen = na
    int localDay = na
    int bars = 0
    bool complete = false

f_tvOpeningRange(TvOpeningRange boxState, bool inRange, bool inSession, bool firstRangeBar, int localDay) =>
    if processBar
        if na(boxState.localDay) or boxState.localDay != localDay
            boxState.localDay := localDay
            boxState.complete := false
            boxState.frozenHigh := na
            boxState.frozenLow := na
        if firstRangeBar
            boxState.buildingHigh := high
            boxState.buildingLow := low
            boxState.frozenHigh := na
            boxState.frozenLow := na
            boxState.nextOpen := time_close
            boxState.bars := 1
            boxState.complete := true
        else if inRange
            boxState.complete := boxState.complete and time == boxState.nextOpen
            boxState.buildingHigh := math.max(boxState.buildingHigh, high)
            boxState.buildingLow := math.min(boxState.buildingLow, low)
            boxState.nextOpen := time_close
            boxState.bars += 1
        else if not inSession
            boxState.complete := false
            boxState.frozenHigh := na
            boxState.frozenLow := na
        else if boxState.complete and na(boxState.frozenHigh) and time == boxState.nextOpen and boxState.bars * tfSeconds == 3600
            boxState.frozenHigh := boxState.buildingHigh
            boxState.frozenLow := boxState.buildingLow
    boxState

bool tvLondonActive = tvEntryFrame and not na(time(timeframe.period, "0800-1630:23456", "Europe/London"))
bool tvNewYorkActive = tvEntryFrame and not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
bool tvLondonORActive = tvLondonActive and not na(time(timeframe.period, "0800-0900:23456", "Europe/London"))
bool tvNewYorkORActive = tvNewYorkActive and not na(time(timeframe.period, "0930-1030:23456", "America/New_York"))
var TvOpeningRange tvLondon = TvOpeningRange.new()
var TvOpeningRange tvNewYork = TvOpeningRange.new()
f_tvLocalDay(string zone) => year(time, zone) * 10000 + month(time, zone) * 100 + dayofmonth(time, zone)
f_tvOpeningRange(tvLondon, tvLondonORActive, tvLondonActive, tvLondonORActive and hour(time, "Europe/London") == 8 and minute(time, "Europe/London") == 0, f_tvLocalDay("Europe/London"))
f_tvOpeningRange(tvNewYork, tvNewYorkORActive, tvNewYorkActive, tvNewYorkORActive and hour(time, "America/New_York") == 9 and minute(time, "America/New_York") == 30, f_tvLocalDay("America/New_York"))
float tvLondonORHigh = tvLondon.frozenHigh
float tvLondonORLow = tvLondon.frozenLow
float tvNewYorkORHigh = tvNewYork.frozenHigh
float tvNewYorkORLow = tvNewYork.frozenLow

// Provider-day weighted HLC3. A complete, contiguous set of positive-volume
// bars since the actual day boundary is required. Tick activity is not exchange volume.
bool tvVolumeBasis = tvAllowVolume and (syminfo.volumetype == "tick" or syminfo.volumetype == "base" or syminfo.volumetype == "quote")
int tvVolumeDay = time("D")
bool tvVolumeReset = not na(tvVolumeDay) and (na(tvVolumeDay[1]) or tvVolumeDay != tvVolumeDay[1])
var bool tvVolumeComplete = false
var float tvVolumeSum = 0.0
var float tvVwapMean = 0.0
var float tvVwapM2 = 0.0
if processBar
    if tvVolumeReset
        tvVolumeSum := 0.0
        tvVwapMean := 0.0
        tvVwapM2 := 0.0
        tvVolumeComplete := time == tvVolumeDay
    else
        tvVolumeComplete := tvVolumeComplete and time == time_close[1]
    tvVolumeComplete := tvVolumeComplete and tvVolumeBasis and not na(volume) and volume > 0
    if tvVolumeComplete
        float tvNewWeight = tvVolumeSum + volume
        float tvDelta = hlc3 - tvVwapMean
        tvVwapMean += tvDelta * volume / tvNewWeight
        tvVwapM2 += volume * tvDelta * (hlc3 - tvVwapMean)
        tvVolumeSum := tvNewWeight
bool tvVolumeValid = tvVolumeComplete and tvVolumeSum > 0
float tvVWAP = tvVolumeValid ? tvVwapMean : na
float tvVWAPSd = tvVolumeValid ? math.sqrt(math.max(0.0, tvVwapM2 / tvVolumeSum)) : na

// Stateful setup objects are isolated by family and direction.
type Setup
    int phase = 0
    int bornBar = na
    int bornTime = na
    int mssBar = na
    float anchor = na
    float trigger = na
    float rejectionHigh = na
    float rejectionLow = na
    bool swept = false
    bool fvg = false
    string id = ""

type Plan
    string strategyKey = "S0"
    string targetBasis = "R"
    string quality = "UNVERIFIED"
    string qualityNote = ""
    string id = ""
    string setupId = ""
    int family = 0
    int side = 0
    int signalBar = na
    int createdTime = na
    int signalTime = na
    float reference = na
    float initialStop = na
    float tp1 = na
    float tp2 = na
    float tp3 = na
    float risk = na
    float atrValue = na
    float costPrice = na
    float maxRiskATR = na
    float obstacle = na
    float requiredRoom = 0.0
    bool countertrend = false
    bool localAligned = false
    float efficiencyValue = na
    string evidence = "НЕВАЛИДИРАН"
    bool filterEligible = false
    int maxHoldBarsFrozen = na
    float maxDeviationATRFrozen = na
    int expiresAfterBar = na
    string cancellationReason = ""

type Event
    string strategyKey = "S0"
    string targetBasis = "R"
    string quality = "UNVERIFIED"
    string qualityNote = ""
    string id = ""
    string kind = ""
    string book = "CORE"
    string planId = ""
    int family = 0
    int side = 0
    int effectiveTime = na
    int knownTime = na
    float price = na
    float quantityFraction = na
    float grossR = na
    float costR = na
    float netR = na
    float cashPnl = na
    string riskBasis = "ACTUAL_INITIAL_DISTANCE"
    string reason = ""
    string evidence = "НЕВАЛИДИРАН"
    float reference = na
    float stop = na
    float tp1 = na
    float tp2 = na
    float tp3 = na
    int createdTime = na
    float atrValue = na
    float costPrice = na
    float maxRiskATR = na
    float obstacle = na
    float requiredRoom = 0.0
    bool countertrend = false
    bool localAligned = false
    float efficiencyValue = na
    bool filterEligible = false

type Ledger
    int entered = 0
    int closed = 0
    int positive = 0
    int negative = 0
    int zero = 0
    int cancelled = 0
    int capacitySkipped = 0
    int ambiguousBars = 0
    float gross = 0.0
    float costs = 0.0
    float net = 0.0
    float gains = 0.0
    float losses = 0.0
    float peak = 0.0
    float drawdown = 0.0
    float holdBars = 0.0

type Paper
    int phase = 0
    Plan p = na
    float entry = na
    float risk = na
    float stop = na
    float remaining = 1.0
    bool hit1 = false
    bool hit2 = false
    bool hit3 = false
    int fillBar = na
    int fillTime = na
    int lockBar = na
    bool exitNextOpen = false
    float gross = 0.0
    float costs = 0.0
    float lastExecutionPrice = na
    int lastExecutionTime = na
    string lastClosedId = ""
    string lastClosedReason = ""
    float lastClosedNet = na
    string lastCancelledId = ""
    string lastCancelledReason = ""
    int dayKey = na
    float dayNet = 0.0
    int dayStreak = 0

type EvidenceGate
    bool paused = false
    int pausedAtCount = 0

f_side(int d) => d == 1 ? "КУПИ" : d == -1 ? "ПРОДАЙ" : "—"
f_model(int m) => m == 1 ? "Ретест" : m == 2 ? "Пробив" : m == 3 ? "Обръщане" : "Общо"
f_enabled(int m) => runModel == "Всички" or (m == 1 and runModel == "Ретест") or (m == 2 and runModel == "Бърз пробив") or (m == 3 and runModel == "Ранно обръщане")
f_price(float v) => na(v) ? "—" : str.tostring(v, format.mintick)
f_num(float v) => na(v) ? "null" : str.tostring(v, "#.########")
f_int(int v) => na(v) ? "null" : str.tostring(v)
f_short(string v, int n) => str.length(v) > n ? str.substring(v, 0, n - 1) + "…" : v
f_escape(string v) => str.replace_all(str.replace_all(str.replace_all(v, "\\", "\\\\"), '"', '\\"'), "\n", "\\n")
f_q(string v) => '"' + f_escape(v) + '"'
f_id(int m, int d, int born) => syminfo.tickerid + "|" + timeframe.period + "|" + str.tostring(m) + "|" + str.tostring(d) + "|" + str.tostring(born)
f_day(int t) => year(t, riskTimezone) * 10000 + month(t, riskTimezone) * 100 + dayofmonth(t, riskTimezone)
f_stopRound(float x, int d) => d == 1 ? math.floor(x / syminfo.mintick + 1e-8) * syminfo.mintick : math.ceil(x / syminfo.mintick - 1e-8) * syminfo.mintick
f_targetRound(float x, int d) => d == 1 ? math.ceil(x / syminfo.mintick - 1e-8) * syminfo.mintick : math.floor(x / syminfo.mintick + 1e-8) * syminfo.mintick
f_nearest(float a, float b, float c, int d, float fromPrice) =>
    float result = na
    for x in array.from(a, b, c)
        if not na(x) and (x - fromPrice) * d > 0
            if na(result) or (x - fromPrice) * d < (result - fromPrice) * d
                result := x
    result
f_reason(array<bool> tests, array<string> names) =>
    string result = ""
    for i = 0 to array.size(tests) - 1
        if not array.get(tests, i)
            result += (str.length(result) > 0 ? " / " : "") + array.get(names, i)
    result == "" ? "УСЛОВИЯТА СА ИЗПЪЛНЕНИ" : result
f_emit(array<Event> out, string kind, string book, string pid, int m, int d, int effective, float px, string reason) =>
    Event e = Event.new()
    e.id := pid + "|" + book + "|" + kind + "|" + str.tostring(time_close)
    e.kind := kind
    e.book := book
    e.strategyKey := tvStrategyMode
    e.planId := pid
    e.family := m
    e.side := d
    e.effectiveTime := effective
    e.knownTime := time_close
    e.price := px
    e.reason := reason
    // Each event is deduplicated by immutable identity within this evaluation.
    bool seen = false
    Event result = e
    if array.size(out) > 0
        for old in out
            if old.id == e.id
                seen := true
                result := old
    if not seen
        array.push(out, e)
    result
f_planEvent(array<Event> out, Plan p, string kind, string book, int effective, float px, string reason) =>
    Event e = f_emit(out, kind, book, p.id, p.family, p.side, effective, px, reason)
    e.strategyKey := p.strategyKey
    e.targetBasis := p.targetBasis
    e.quality := p.quality
    e.qualityNote := p.qualityNote
    e.evidence := p.evidence
    e.reference := p.reference
    e.stop := p.initialStop
    e.tp1 := p.tp1
    e.tp2 := p.tp2
    e.tp3 := p.tp3
    e.createdTime := p.createdTime
    e.atrValue := p.atrValue
    e.costPrice := p.costPrice
    e.maxRiskATR := p.maxRiskATR
    e.obstacle := p.obstacle
    e.requiredRoom := p.requiredRoom
    e.countertrend := p.countertrend
    e.localAligned := p.localAligned
    e.efficiencyValue := p.efficiencyValue
    e.filterEligible := p.filterEligible
    e
f_json(Event e) =>
    "{\"schema\":\"qirvanta.event.v1\",\"core_sha256\":" + f_q(CORE_SHA256) + ",\"event_id\":" + f_q(e.id) + ",\"event\":" + f_q(e.kind) + ",\"book\":" + f_q(e.book) + ",\"plan_id\":" + f_q(e.planId) + ",\"strategy_key\":" + f_q(e.strategyKey) + ",\"target_basis\":" + f_q(e.targetBasis) + ",\"quality\":" + f_q(e.quality) + ",\"quality_note\":" + f_q(e.qualityNote) + ",\"symbol\":" + f_q(syminfo.tickerid) + ",\"timeframe\":" + f_q(timeframe.period) + ",\"family\":" + str.tostring(e.family) + ",\"side\":" + str.tostring(e.side) + ",\"bar_open_time\":" + str.tostring(time) + ",\"bar_close_time\":" + f_int(time_close) + ",\"effective_time\":" + f_int(e.effectiveTime) + ",\"known_time\":" + f_int(e.knownTime) + ",\"price\":" + f_num(e.price) + ",\"quantity_fraction\":" + f_num(e.quantityFraction) + ",\"gross_r\":" + f_num(e.grossR) + ",\"cost_r\":" + f_num(e.costR) + ",\"net_r\":" + f_num(e.netR) + ",\"cash_pnl\":" + f_num(e.cashPnl) + ",\"risk_basis\":" + f_q(e.riskBasis) + ",\"reference\":" + f_num(e.reference) + ",\"initial_sl\":" + f_num(e.stop) + ",\"tp1\":" + f_num(e.tp1) + ",\"tp2\":" + f_num(e.tp2) + ",\"tp3\":" + f_num(e.tp3) + ",\"evidence\":" + f_q(e.evidence) + ",\"reason\":" + f_q(e.reason) + ",\"created_time\":" + f_int(e.createdTime) + ",\"atr_at_signal\":" + f_num(e.atrValue) + ",\"roundtrip_cost_price\":" + f_num(e.costPrice) + ",\"max_risk_atr\":" + f_num(e.maxRiskATR) + ",\"obstacle\":" + f_num(e.obstacle) + ",\"required_room_r\":" + f_num(e.requiredRoom) + ",\"countertrend\":" + (e.countertrend ? "true" : "false") + ",\"local_aligned\":" + (e.localAligned ? "true" : "false") + ",\"efficiency_ratio\":" + f_num(e.efficiencyValue) + ",\"filter_eligible\":" + (e.filterEligible ? "true" : "false") + ",\"advisory_only\":true}"
// Advisory rules. Quality neither selects a candidate nor changes an order.
f_tvFamily(string strategyKey, int family) => strategyKey == "S0" ? (tvEnglish ? (family == 1 ? "RETEST" : family == 2 ? "FAST" : family == 3 ? "REVERSAL" : "S0") : f_model(family)) : strategyKey
f_tvText(string bg, string en) => tvEnglish ? en : bg
f_tvQualityLabel(string grade) => grade == "STRONG" ? f_tvText("СИЛЕН", "STRONG") : grade == "MODERATE" ? f_tvText("УМЕРЕН", "MODERATE") : grade == "WEAK" ? f_tvText("СЛАБ", "WEAK") : f_tvText("НЕПРОВЕРЕН", "UNVERIFIED")
f_tvTargets(string basis) => basis == "STRUCTURE" ? f_tvText("Структурни цели", "Structural targets") : f_tvText("R проекции", "R projections")
f_tvRegimeLabel(int state) =>
    state == 1 ? f_tvText("Тренд нагоре", "Uptrend") : state == -1 ? f_tvText("Тренд надолу", "Downtrend") : state == 2 ? f_tvText("Диапазон", "Range") : state == 3 ? f_tvText("Свиване", "Compression") : state == 4 ? f_tvText("Разширяване", "Expansion") : f_tvText("Неясен режим", "Uncertain")
f_tvR(float entry, float stop, float target, int side) =>
    float risk = (entry - stop) * side
    float reward = (target - entry) * side
    risk > 0 and reward > 0 ? str.tostring(reward / risk, "0.00") + "R" : "—"
f_tvProtection(Plan plan, float entry, float currentStop, bool pending) =>
    pending ? f_tvText("Чака вход", "Pending") : currentStop == plan.initialStop ? f_tvText("Начален SL", "Initial SL") : (currentStop - entry) * plan.side > syminfo.mintick * 0.5 ? f_tvText("Защитена печалба", "Profit lock") : math.abs(currentStop - entry) <= syminfo.mintick * 0.5 ? f_tvText("BE по цена", "Price BE") : f_tvText("Преместен SL", "Protective stop")
f_tvGrade(Plan p) =>
    bool available = tvEntryFrame and tvContextReady and not na(efficiency) and not na(tvAtrPercentile) and not na(p.obstacle)
    bool trend = tvH1Bias == p.side and tvH4Bias == p.side
    bool momentum = (p.side == 1 ? bullMomentum : bearMomentum) and efficiency >= 0.30
    bool volatility = validATR and not tvShock and not tvExhaustion
    bool room = (p.obstacle - p.tp1) * p.side >= -syminfo.mintick * 0.000001
    int checks = (trend ? 1 : 0) + (momentum ? 1 : 0) + (volatility ? 1 : 0) + (room ? 1 : 0)
    p.quality := not available ? "UNVERIFIED" : checks == 4 ? "STRONG" : checks >= 2 ? "MODERATE" : "WEAK"
    p.qualityNote := not available ? f_tvText("Липсва контекст или преграда", "Missing context or reference") : f_reason(array.from(trend, momentum, volatility, room), array.from("H1/H4", f_tvText("Импулс", "Momentum"), f_tvText("Волатилност", "Volatility"), f_tvText("Място до TP1", "Room to TP1")))
    if available and checks == 4
        p.qualityNote := f_tvText("Четири съгласувани условия", "Four aligned conditions")
    p

f_makePlan(int family, int d, float sl, int born, float maxRisk, float obstacle, float room) =>
    Plan p = Plan.new()
    p.setupId := f_id(family, d, born)
    p.id := p.setupId + "|" + str.tostring(time_close)
    p.family := family
    p.side := d
    p.signalBar := bar_index
    p.createdTime := born
    p.signalTime := time_close
    p.reference := math.round_to_mintick(close)
    p.initialStop := sl
    p.risk := (p.reference - sl) * d
    p.tp1 := f_targetRound(p.reference + d * p.risk * target1R, d)
    p.tp2 := f_targetRound(p.reference + d * p.risk * target2R, d)
    p.tp3 := f_targetRound(p.reference + d * p.risk * target3R, d)
    p.atrValue := atr
    p.costPrice := roundTripPriceCost
    p.maxRiskATR := maxRisk
    p.obstacle := obstacle
    p.requiredRoom := room
    p.countertrend := d == 1 ? not bullHTF : not bearHTF
    p.localAligned := d == 1 ? bullLocal : bearLocal
    p.efficiencyValue := efficiency
    // Additive immutable metadata; candidate thresholds and all prior Plan values stay unchanged.
    p.maxHoldBarsFrozen := maxHoldBars
    p.maxDeviationATRFrozen := maxOpenDeviationATR
    p.expiresAfterBar := bar_index + 1
    p.cancellationReason := "Неизпълнена заявка до следващото затваряне"
    f_tvGrade(p)
f_targetRoom(Plan p, float entry, float risk) =>
    // Respect the actual rounded/frozen TP1, not merely its pre-rounding R distance.
    p.requiredRoom <= 0 or (not na(p.obstacle) and (p.obstacle - entry) * p.side + syminfo.mintick * 1e-6 >= math.max(risk * p.requiredRoom, (p.tp1 - entry) * p.side))
f_policyReason(Plan p) =>
    contextPolicy == "БАЗОВ" ? "" : p.countertrend ? "HTF не съвпада" : not p.localAligned ? "Локалният тренд не съвпада" : na(p.efficiencyValue) ? "Няма данни за насоченост" : p.efficiencyValue < minEfficiency ? "Ниска насоченост" : ""
f_validPlan(Plan p) =>
    f_targetRoom(p, p.reference, p.risk) and not na(p.risk) and p.risk >= syminfo.mintick and p.risk + syminfo.mintick * 1e-6 >= minStopATR * p.atrValue and p.risk <= p.maxRiskATR * p.atrValue and p.costPrice / p.risk <= maxCostRisk and (p.tp1 - p.reference) * p.side > 0 and (p.tp2 - p.tp1) * p.side > 0 and (p.tp3 - p.tp2) * p.side > 0
f_clear(Setup s) =>
    s.phase := 0
    s.bornBar := na
    s.bornTime := na
    s.mssBar := na
    s.anchor := na
    s.trigger := na
    s.rejectionHigh := na
    s.rejectionLow := na
    s.fvg := false
    s.swept := false
    s.id := ""
    s
f_start(Setup s, int family, int d, int phase, float anchor, float trigger, bool swept, bool gap) =>
    s.phase := phase
    s.bornBar := bar_index
    s.bornTime := time_close
    s.mssBar := phase == 2 ? bar_index : na
    s.anchor := anchor
    s.trigger := trigger
    s.swept := swept
    s.fvg := gap
    s.rejectionHigh := high
    s.rejectionLow := low
    s.id := f_id(family, d, time_close)
    s

// Independent model state: execution positions and evidence do not control candidate discovery.
var array<Setup> retestStates = array.new<Setup>()
var array<Setup> reversalStates = array.new<Setup>()
var array<int> lastModelSignal = array.new<int>(3, na)
var array<string> buyReasons = array.new<string>(3, "Няма завършена свещ")
var array<string> sellReasons = array.new<string>(3, "Няма завършена свещ")
var array<Plan> candidates = array.new<Plan>()
var array<Event> events = array.new<Event>()
var array<int> triggerAttempts = array.new<int>(6, 0)
var array<int> confirmedCounts = array.new<int>(6, 0)
var array<int> refusedCounts = array.new<int>(6, 0)
var array<string> lastRefusals = array.new<string>(6, "Няма проверен trigger")
f_recordDecision(int family, int d, bool accepted, string why) =>
    int idx = (family - 1) * 2 + (d == 1 ? 0 : 1)
    array.set(triggerAttempts, idx, array.get(triggerAttempts, idx) + 1)
    if accepted
        array.set(confirmedCounts, idx, array.get(confirmedCounts, idx) + 1)
    else
        array.set(refusedCounts, idx, array.get(refusedCounts, idx) + 1)
        array.set(lastRefusals, idx, why)
    accepted
var int lastAnalysisClose = na
var int localPressure = 0
var int closedHtfBias = 0
var string lastContext = "НЕДОСТАТЪЧНИ ДАННИ"
var float closedEfficiency = na
if barstate.isfirst
    for n = 0 to 1
        array.push(retestStates, Setup.new())
        array.push(reversalStates, Setup.new())

f_cooldown(int m, array<int> lastBars) =>
    int last = array.get(lastBars, m - 1)
    na(last) or bar_index - last > minCooldown
f_capture(Plan p, array<Plan> out, array<int> lastBars, array<Event> ev) =>
    bool accepted = f_validPlan(p)
    if accepted
        array.push(out, p)
        array.set(lastBars, p.family - 1, bar_index)
    else
        f_planEvent(ev, p, "REJECTED", "CORE", time_close, close, "Закръгляне/SL/TP1 преграда")
    accepted

f_retest(Setup s, int d, array<Plan> out, array<int> lastBars, array<Event> ev) =>
    bool enabled = f_enabled(1)
    bool opposite = d == 1 ? structureDownNow : structureUpNow
    bool invalidated = false
    bool consumed = false
    bool candle = d == 1 ? bullishBar : bearishBar
    bool displacement = d == 1 ? displacementUp : displacementDn
    bool higherBias = d == 1 ? bullHTF : bearHTF
    bool localBias = d == 1 ? bullLocal : bearLocal
    bool momentum = d == 1 ? bullMomentum : bearMomentum
    bool discount = d == 1 ? inDiscount : inPremium
    float obstacle = d == 1 ? longObstacle : shortObstacle
    if s.phase != 0
        bool stale = bar_index - s.bornBar > maxSetupAge
        bool crossedAnchor = (close - s.anchor) * d < -slBufferATR * atr
        bool late = s.phase == 2 and bar_index - s.mssBar > maxBarsAfterMSS
        if opposite or crossedAnchor or stale or late or not enabled
            string why = opposite ? "Противоположен структурен пробив" : crossedAnchor ? "Нарушен структурен стоп" : not enabled ? "Изключен модел" : "Изтекъл срок"
            f_emit(ev, stale or late ? "EXPIRED" : "CANCELLED", "CORE", s.id, 1, d, time_close, close, why)
            f_clear(s)
            invalidated := true
    if enabled and s.phase == 1 and bar_index > s.bornBar and (close - s.trigger) * d > 0 and displacement
        s.phase := 2
        s.mssBar := bar_index
        s.fvg := d == 1 ? bullFvgNow : bearFvgNow
        f_emit(ev, "WATCH", "CORE", s.id, 1, d, time_close, s.trigger, "Структура потвърдена; чака ретест")
    bool retest = s.phase == 2 and bar_index > s.mssBar and (d == 1 ? low <= s.trigger + atr * nearRetestATR and low >= s.trigger - atr * pierceRetestATR : high >= s.trigger - atr * nearRetestATR and high <= s.trigger + atr * pierceRetestATR) and (close - s.trigger) * d > 0 and candle and body >= atr * 0.1
    bool timely = retest and (close - s.trigger) * d <= atr * maxRetestCloseATR and bar_index - s.mssBar <= maxBarsAfterMSS
    float structural = d == 1 ? math.min(s.anchor - slBufferATR * atr, close - minStopATR * atr) : math.max(s.anchor + slBufferATR * atr, close + minStopATR * atr)
    float sl = f_stopRound(structural, d)
    float risk = (close - sl) * d
    bool riskOK = not na(risk) and risk >= minStopATR * atr and risk <= maxStopATR * atr and risk >= syminfo.mintick and roundTripPriceCost / risk <= maxCostRisk
    bool room = not na(obstacle) and (obstacle - close) * d >= risk * math.max(minimumRoomR, target1R)
    int checks = ((d == 1 ? strongBullHTF : strongBearHTF) ? 1 : 0) + (adx > minADX + 6 ? 1 : 0) + (s.fvg ? 1 : 0) + (discount ? 1 : 0) + (inSession ? 1 : 0) + (room ? 1 : 0)
    array<bool> gates = array.from(enabled, warmup, datePass, not newsPaused, sessionPass, validATR, validTrend, acceptableBar, notExtended, timely, riskOK, higherBias, localBias, momentum, not requireFVG or s.fvg, not requirePD or discount, not requireRoom or room, checks >= minExtra, f_cooldown(1, lastBars))
    array<string> names = array.from("Модел изключен", "Данни", "Тестов период", "Новинарска пауза", "Сесия", "ATR", "ADX", "Размер свещ", "EMA отстояние", retest ? "Закъснял ретест" : "Чака MSS/ретест", "SL/разходи", "HTF", "Локален тренд", "RSI/DI", "FVG", "Скъпа/евтина зона", "Място до TP1", "Съгласуваност", "Пауза по модел")
    string why = f_reason(gates, names)
    if retest
        consumed := true
        if why == "УСЛОВИЯТА СА ИЗПЪЛНЕНИ"
            Plan p = f_makePlan(1, d, sl, s.bornTime, maxStopATR, obstacle, requireRoom ? math.max(minimumRoomR, target1R) : 0.0)
            bool accepted = f_capture(p, out, lastBars, ev)
            if not accepted
                why := "Закръгляне/SL/TP1 преграда"
            f_recordDecision(1, d, accepted, why)
        else
            f_recordDecision(1, d, false, why)
            f_emit(ev, "REJECTED", "CORE", s.id, 1, d, time_close, close, why)
        f_clear(s)
    // Never rebuild the scenario on its invalidation/consumption bar.
    if enabled and warmup and datePass and not newsPaused and s.phase == 0 and not invalidated and not consumed and not opposite
        bool sweep = d == 1 ? sweepDown : sweepUp
        bool bos = d == 1 ? bosUp : bosDown
        if sweep and engineMode != "САМО ПРОДЪЛЖЕНИЕ"
            f_start(s, 1, d, 1, d == 1 ? low : high, d == 1 ? longStruct : shortStruct, true, false)
            f_emit(ev, "WATCH", "CORE", s.id, 1, d, time_close, s.trigger, "Ликвидност; чака MSS")
        else if bos and higherBias and engineMode != "САМО ЛИКВИДНОСТ"
            f_start(s, 1, d, 2, d == 1 ? localSwingLow : localSwingHigh, d == 1 ? sweepHigh : sweepLow, false, d == 1 ? bullFvgNow : bearFvgNow)
            f_emit(ev, "WATCH", "CORE", s.id, 1, d, time_close, s.trigger, "BOS; чака ретест")
    why

f_fast(int d, array<Plan> out, array<int> lastBars, array<Event> ev) =>
    bool enabled = f_enabled(2) and useFastBreakout
    bool candle = d == 1 ? bullishBar : bearishBar
    float boundary = d == 1 ? fastBreakHigh : fastBreakLow
    bool crossed = not na(boundary) and (close - boundary) * d > 0 and (close[1] - boundary) * d <= 0
    bool bodyOK = atr > 0 and body >= atr * fastMinBodyATR and body <= atr * fastMaxBodyATR
    bool timely = crossed and (close - boundary) * d <= atr * fastMaxBreakDistanceATR
    bool local = d == 1 ? close > emaFast and emaFast > emaFast[1] and bullMomentum and rsi >= 53 : close < emaFast and emaFast < emaFast[1] and bearMomentum and rsi <= 47
    bool extension = math.abs(close - emaFast) <= atr * 1.35
    bool htfOK = d == 1 ? bullHTF : bearHTF
    bool contraOK = allowFastCountertrend and (d == 1 ? close > emaSlow and rsi >= 56 : close < emaSlow and rsi <= 44) and adx >= minADX + 5 and body >= atr * 0.80
    float structural = d == 1 ? math.min(fastStopLow - slBufferATR * atr, close - minStopATR * atr) : math.max(fastStopHigh + slBufferATR * atr, close + minStopATR * atr)
    float sl = f_stopRound(structural, d)
    float risk = (close - sl) * d
    float cap = math.min(maxStopATR, 2.4)
    bool riskOK = not na(risk) and risk >= minStopATR * atr and risk >= syminfo.mintick and risk <= cap * atr and roundTripPriceCost / risk <= maxCostRisk
    bool pd = d == 1 ? inDiscount : inPremium
    bool gap = d == 1 ? bullFvgNow : bearFvgNow
    float obstacle = d == 1 ? longObstacle : shortObstacle
    bool room = not na(obstacle) and (obstacle - close) * d >= risk * math.max(minimumRoomR, target1R)
    string why = f_reason(array.from(enabled, warmup, datePass, not newsPaused, sessionPass, validATR, validTrend, acceptableBar, notExtended, f_cooldown(2, lastBars), crossed, candle, bodyOK, timely, local, extension, htfOK or contraOK, riskOK, barRange <= atr * 1.85, not requirePD or pd, not requireRoom or room, not requireFVG or gap), array.from("Модел изключен", "Данни", "Тестов период", "Новинарска пауза", "Сесия", "ATR", "ADX", "Размер свещ", "EMA отстояние", "Пауза по модел", "Локален пробив", "Потвърждаваща свещ", "Тяло", "Закъснял пробив", "EMA/RSI/DI", "Отстояние 1.35 ATR", "HTF/контратренд", "SL/разходи", "Свещ >1.85 ATR", "Скъпа/евтина зона", "Място до TP1", "FVG"))
    if enabled and crossed and candle
        if why == "УСЛОВИЯТА СА ИЗПЪЛНЕНИ"
            Plan p = f_makePlan(2, d, sl, time_close, cap, obstacle, requireRoom ? math.max(minimumRoomR, target1R) : 0.0)
            bool accepted = f_capture(p, out, lastBars, ev)
            if not accepted
                why := "Закръгляне/SL/TP1 преграда"
            f_recordDecision(2, d, accepted, why)
        else
            f_recordDecision(2, d, false, why)
            f_emit(ev, "REJECTED", "CORE", f_id(2, d, time_close), 2, d, time_close, close, why)
    why

f_reversal(Setup s, int d, array<Plan> out, array<int> lastBars, array<Event> ev) =>
    bool enabled = f_enabled(3) and useEarlyReversal and tfSeconds >= 300 and tfSeconds <= 1800
    bool opposite = d == 1 ? structureDownNow : structureUpNow
    bool invalidated = false
    bool consumed = false
    bool candle = d == 1 ? bullishBar : bearishBar
    if s.phase != 0
        bool expired = bar_index - s.bornBar > reversalWaitBars
        bool breached = d == 1 ? low < s.rejectionLow - syminfo.mintick : high > s.rejectionHigh + syminfo.mintick
        if expired or breached or opposite or not enabled
            f_emit(ev, expired ? "EXPIRED" : "CANCELLED", "CORE", s.id, 3, d, time_close, close, opposite ? "Противоположна структура" : breached ? "Нарушен екстремум" : "Изтекъл/изключен модел")
            f_clear(s)
            invalidated := true
    float trigger = d == 1 ? s.rejectionHigh : s.rejectionLow
    bool crossed = s.phase != 0 and bar_index > s.bornBar and (close - trigger) * d > 0
    bool timely = crossed and (close - trigger) * d <= atr * reversalMaxChaseATR
    bool risingRsi = d == 1 ? rsi > rsi[1] and rsi >= 33 : rsi < rsi[1] and rsi <= 67
    float structural = d == 1 ? math.min(s.rejectionLow - slBufferATR * atr, close - minStopATR * atr) : math.max(s.rejectionHigh + slBufferATR * atr, close + minStopATR * atr)
    float sl = f_stopRound(structural, d)
    float risk = (close - sl) * d
    float cap = math.min(maxStopATR, 2.7)
    bool riskOK = not na(risk) and risk >= minStopATR * atr and risk >= syminfo.mintick and risk <= cap * atr and roundTripPriceCost / risk <= maxCostRisk
    // Select the NEAREST obstacle among BOTH moving averages and known structure.
    float obstacle = f_nearest(emaFast, emaSlow, d == 1 ? longObstacle : shortObstacle, d, close)
    float minimumRoom = math.max(reversalMinRoomR, target1R)
    if requireRoom
        minimumRoom := math.max(minimumRoom, minimumRoomR)
    bool room = not na(obstacle) and (obstacle - close) * d >= risk * minimumRoom
    bool pd = d == 1 ? inDiscount : inPremium
    bool gap = d == 1 ? bullFvgNow : bearFvgNow
    string why = f_reason(array.from(enabled, warmup, datePass, not newsPaused, sessionPass, validATR, acceptableBar, f_cooldown(3, lastBars), crossed, candle, body >= atr * 0.25, timely, risingRsi, barRange <= atr * 1.75, riskOK, room, not requirePD or pd, not requireFVG or gap), array.from("Модел/рамка изключени", "Данни", "Тестов период", "Новинарска пауза", "Сесия", "ATR", "Размер свещ", "Пауза по модел", "Чака следваща свещ над/под отхвърлянето", "Потвърждаваща свещ", "Малко тяло", "Закъсняло обръщане", "RSI не се възстановява", "Свещ >1.75 ATR", "SL/разходи", "Няма място до TP1", "Скъпа/евтина зона", "FVG"))
    if enabled and crossed and candle
        if why == "УСЛОВИЯТА СА ИЗПЪЛНЕНИ"
            Plan p = f_makePlan(3, d, sl, s.bornTime, cap, obstacle, minimumRoom)
            bool accepted = f_capture(p, out, lastBars, ev)
            if not accepted
                why := "Закръгляне/SL/TP1 преграда"
            f_recordDecision(3, d, accepted, why)
            consumed := true
            f_clear(s)
        else
            // A failed FILTER check is now visible; it does not cancel a still-timely setup.
            f_recordDecision(3, d, false, why)
            f_emit(ev, "REJECTED", "CORE", s.id, 3, d, time_close, close, why)
            if not timely
                consumed := true
                f_clear(s)
    // An existing candidate is never silently overwritten by a different rejection.
    if enabled and warmup and datePass and not newsPaused and s.phase == 0 and not consumed and not invalidated and not opposite
        float wick = d == 1 ? math.min(open, close) - low : high - math.max(open, close)
        bool excursion = d == 1 ? not na(priorRecoveryHigh) and priorRecoveryHigh - low >= atr * 1.5 : not na(priorRecoveryLow) and high - priorRecoveryLow >= atr * 1.5
        bool rejection = d == 1 ? not na(priorReversalLow) and low < priorReversalLow and wick >= barRange * 0.24 and close - low >= barRange * 0.40 : not na(priorReversalHigh) and high > priorReversalHigh and wick >= barRange * 0.24 and high - close >= barRange * 0.40
        bool priorRegime = d == 1 ? (emaFast < emaSlow or close < emaFast) and rsi <= 54 : (emaFast > emaSlow or close > emaFast) and rsi >= 46
        if excursion and rejection and priorRegime and validATR
            f_start(s, 3, d, 1, d == 1 ? low : high, d == 1 ? high : low, true, false)
            f_emit(ev, "WATCH", "CORE", s.id, 3, d, time_close, s.trigger, "Отхвърляне; чака отделна потвърждаваща свещ")
    why

if processBar and (tvStrategyMode == "S0" or str.startswith(tvStrategyMode, "F"))
    array.clear(events)
    array.clear(candidates)
    for directionIndex = 0 to 1
        int d = directionIndex == 0 ? 1 : -1
        array<string> diagnostics = d == 1 ? buyReasons : sellReasons
        array.set(diagnostics, 0, f_retest(array.get(retestStates, directionIndex), d, candidates, lastModelSignal, events))
        array.set(diagnostics, 1, f_fast(d, candidates, lastModelSignal, events))
        array.set(diagnostics, 2, f_reversal(array.get(reversalStates, directionIndex), d, candidates, lastModelSignal, events))
    lastAnalysisClose := time_close
    closedEfficiency := efficiency
    bool bearPressure = atr > 0 and close < emaFast and (bearishBar or close < close[1]) and (emaFast < emaFast[1] or rsi < 50)
    bool bullPressure = atr > 0 and close > emaFast and (bullishBar or close > close[1]) and (emaFast > emaFast[1] or rsi > 50)
    localPressure := bullPressure ? 1 : bearPressure ? -1 : 0
    closedHtfBias := bullHTF ? 1 : bearHTF ? -1 : 0
    lastContext := localPressure == 1 ? "НАТИСК НАГОРЕ" : localPressure == -1 ? "НАТИСК НАДОЛУ" : "СМЕСЕН КОНТЕКСТ"

// Conservative OHLC engine. Execution events are OBSERVED at bar close.
// Entry effective_time can be the bar open; intrabar touch times remain unknown (null).
// Insert after decision, before paper_engine. Original decision's processBar block
// runs only for S0/F*. All state below is isolated from the Champion's state.
// S families share legacy execution slot 2, but strategyKey and IDs identify them.
f_tvStrategyName(string key) =>
    switch key
        "S0" => "S0 Champion"
        "S1" => "S1 Тренд ретест"
        "S2" => "S2 Sweep обръщане"
        "S3" => "S3 Приемане и ретест"
        "S4" => "S4 Компресия пробив"
        "S5" => "S5 Неуспешен пробив"
        "S6" => "S6 VWAP връщане"
        "S7" => "S7 Opening range"
        "S8" => "S8 Импулс продължение"
        "S9" => "S9 Swing failure"
        "S10" => "S10 БЛОКИРАН"
        "F0" => "F0 Оригинален FAST"
        "F1" => "F1 ОТХВЪРЛЕН · архив"
        "F2" => "F2 Приемане"
        "F3" => "F3 H1/H4 посока"
        "F4" => "F4 Ретест"
        "F5" => "F5 Място до TP1"
        "F6" => "F6 Тренд режим"
        "F7" => "F7 Без преследване"
        "F8" => "F8 Импулс"
        "F9" => "F9 Сесия"
        => "F10 H1/H4 + отстояние"

type TvCandidateState
    int phase = 0
    int born = na
    int bornTime = na
    int accepted = na
    float anchor = na
    float level = na
    float trigger = na

// All history-dependent calculations execute on every bar in global scope.
float tvEma20 = ta.ema(close, 20)
float tvEma50 = ta.ema(close, 50)
float tvEma200 = ta.ema(close, 200)
float tvRange20High = ta.highest(high, 20)[1]
float tvRange20Low = ta.lowest(low, 20)[1]
float tvRange3High = ta.highest(high, 3)[1]
float tvRange3Low = ta.lowest(low, 3)[1]
float tvAtrRatio = atrMean > 0 ? atr / atrMean : na
bool tvTimeGap = not na(time_close[1]) and time != time_close[1]
int tvResearchDirection = close > tvEma20 and tvEma20 > tvEma50 and tvEma50 > tvEma200 ? 1 : close < tvEma20 and tvEma20 < tvEma50 and tvEma50 < tvEma200 ? -1 : 0
var array<TvCandidateState> tvCandidateStates = array.new<TvCandidateState>()
var array<int> tvCandidateLast = array.new<int>(2, na)
var array<Plan> tvFastPending = array.new<Plan>(2, na)
var array<float> tvFastBoundary = array.new<float>(2, na)
var array<string> tvReasons = array.new<string>(2, "Чака потвърдена свещ")
var int tvRawAttempts = 0
var int tvAcceptedAttempts = 0
var int tvRejectedAttempts = 0
if barstate.isfirst
    array.push(tvCandidateStates, TvCandidateState.new())
    array.push(tvCandidateStates, TvCandidateState.new())

f_tvClear(TvCandidateState s) =>
    s.phase := 0
    s.born := na
    s.bornTime := na
    s.accepted := na
    s.anchor := na
    s.level := na
    s.trigger := na
    s
f_tvStart(TvCandidateState s, float anchor, float level, float trigger) =>
    s.phase := 1
    s.born := bar_index
    s.bornTime := time_close
    s.anchor := anchor
    s.level := level
    s.trigger := trigger
    s
f_tvStamp(Plan p, string key) =>
    p.strategyKey := key
    p.setupId := key + "|" + p.setupId
    p.id := key + "|" + p.id
    p
f_tvRawEvent(string kind, int d, int born, float level, string reason) =>
    Event e = f_emit(events, kind, "CORE", tvStrategyMode + "|" + f_id(2, d, born), 2, d, time_close, level, reason)
    e.strategyKey := tvStrategyMode
    e
f_tvCommonReason(Plan p, bool htfGate) =>
    f_reason(array.from(warmup, datePass, not newsPaused, sessionPass, validATR, acceptableBar, not tvTimeGap, not htfGate or tvH1Bias == p.side, not requireFVG or (p.side == 1 ? bullFvgNow : bearFvgNow), not requirePD or (p.side == 1 ? inDiscount : inPremium), f_validPlan(p)), array.from("Данни", "Тестов период", "Новинарска пауза", "Сесия", "ATR", "Размер свещ", "Прекъсване на историята", "H1 не съвпада", "FVG", "Скъпа/евтина зона", "SL / разходи / цели / преграда"))

f_tvCandidate(int d) =>
    int idx = d == 1 ? 0 : 1
    TvCandidateState s = array.get(tvCandidateStates, idx)
    bool terminated = false
    bool raw = false
    int born = time_close
    float anchor = d == 1 ? tvRange3Low : tvRange3High
    float obstacle = d == 1 ? longObstacle : shortObstacle
    float directionalBody = (close - open) * d
    bool candle = directionalBody >= 0.25 * atr and (d == 1 ? bullishBar : bearishBar)
    bool trend = tvResearchDirection == d and adx >= 20 and efficiency >= 0.25
    string extraReason = ""
    string reason = "Няма суров trigger"
    int ageLimit = tvStrategyMode == "S3" ? 6 : tvStrategyMode == "S9" ? 2 : 3
    if s.phase != 0
        bool expired = bar_index - s.born > ageLimit
        bool invalid = (close - s.anchor) * d < 0
        if tvTimeGap or expired or invalid
            reason := tvTimeGap ? "Прекъсване на историята" : expired ? "Срокът изтече" : "Нарушена структура"
            f_tvRawEvent(expired ? "EXPIRED" : "CANCELLED", d, s.bornTime, close, reason)
            f_tvClear(s)
            terminated := true
    if tvStrategyMode == "S10"
        reason := "S10: няма независимо потвърдено правило за избор"
    else if tvStrategyMode == "S6" and not tvVolumeValid
        reason := "S6: липсва валидна TradingView volume основа"
    else if not warmup or not tvEntryFrame
        reason := "Недостатъчни данни или неподдържана рамка"
    else if not terminated
        if s.phase != 0
            born := s.bornTime
            anchor := s.anchor
        if tvStrategyMode == "S1"
            bool pullback = d == 1 ? low[1] <= tvEma20[1] and close[1] <= tvEma20[1] : high[1] >= tvEma20[1] and close[1] >= tvEma20[1]
            raw := pullback and (close - (d == 1 ? high[1] : low[1])) * d > 0
            anchor := d == 1 ? math.min(low[1], low) : math.max(high[1], high)
            extraReason := not trend ? "Няма насочен тренд" : not candle ? "Няма потвърждаваща свещ" : ""
        else if tvStrategyMode == "S2" or tvStrategyMode == "S9"
            if s.phase != 0
                raw := bar_index > s.born and (close - s.trigger) * d > 0
                extraReason := not candle ? "Няма потвърждаваща свещ" : ""
            else
                float level = tvStrategyMode == "S2" ? (d == 1 ? tvRange20Low : tvRange20High) : (d == 1 ? lastPivotLow[1] : lastPivotHigh[1])
                float wick = d == 1 ? math.min(open, close) - low : high - math.max(open, close)
                bool sweep = not na(level) and (d == 1 ? low < level and close > level : high > level and close < level) and wick >= 0.25 * barRange
                if sweep and not tvTimeGap
                    f_tvStart(s, d == 1 ? low : high, level, d == 1 ? high : low)
                    f_tvRawEvent("WATCH", d, time_close, s.trigger, "Sweep; чака отделна затворена свещ")
        else if tvStrategyMode == "S3"
            if s.phase == 1
                if bar_index == s.born + 1 and (close - s.level) * d > 0
                    s.phase := 2
                    s.accepted := bar_index
                    f_tvRawEvent("WATCH", d, s.bornTime, s.level, "Приемане потвърдено; чака отделен ретест")
                else if bar_index > s.born
                    reason := "Приемането на пробива е отказано"
                    f_tvRawEvent("CANCELLED", d, s.bornTime, close, reason)
                    f_tvClear(s)
                    terminated := true
            else if s.phase == 2 and bar_index > s.accepted
                float extreme = d == 1 ? low : high
                raw := math.abs(extreme - s.level) <= 0.20 * atr and (close - s.level) * d > 0
                extraReason := not candle ? "Няма потвърждаваща свещ" : (close - s.level) * d > 0.75 * atr ? "Закъснял ретест" : ""
            else if s.phase == 0
                float level = d == 1 ? tvRange20High : tvRange20Low
                if not tvTimeGap and (close - level) * d > 0 and (close[1] - level) * d <= 0
                    f_tvStart(s, anchor, level, level)
                    f_tvRawEvent("WATCH", d, time_close, level, "Пробив; чака следващо затваряне отвъд нивото")
        else if tvStrategyMode == "S4"
            float level = d == 1 ? tvRange20High : tvRange20Low
            raw := (close - level) * d > 0 and (close[1] - level) * d <= 0
            bool compressed = tvAtrRatio[1] < 0.75 and tvRange20High[1] - tvRange20Low[1] <= 6.0 * atr[1]
            extraReason := not compressed ? "Няма предходна компресия" : not candle ? "Няма потвърждаваща свещ" : barRange < atr ? "Липсва разширение" : (close - level) * d > 0.75 * atr ? "Късен пробив" : ""
        else if tvStrategyMode == "S5"
            if s.phase != 0
                raw := bar_index > s.born and (close - s.level) * d > 0
                extraReason := not candle ? "Няма потвърждаваща свещ" : ""
            else
                float level = d == 1 ? tvRange20Low : tvRange20High
                if not tvTimeGap and (close - level) * d < 0 and (close[1] - level) * d >= 0
                    f_tvStart(s, d == 1 ? low : high, level, level)
                    f_tvRawEvent("WATCH", d, time_close, level, "Противоположен пробив; чака връщане отвъд нивото")
        else if tvStrategyMode == "S6"
            raw := tvVolumeValid[1] and not na(tvVWAP[1]) and tvVWAPSd > 0 and tvVWAPSd[1] > 0 and (close[1] - tvVWAP[1]) * d < -2.0 * tvVWAPSd[1] and (close - tvVWAP) * d >= -2.0 * tvVWAPSd
            anchor := d == 1 ? math.min(low[1], low) : math.max(high[1], high)
            obstacle := tvVWAP
            extraReason := tvRegime != 2 ? "Не е диапазон" : not candle ? "Няма потвърждаваща свещ" : ""
        else if tvStrategyMode == "S7"
            float londonLevel = d == 1 ? tvLondonORHigh : tvLondonORLow
            float nyLevel = d == 1 ? tvNewYorkORHigh : tvNewYorkORLow
            bool londonBreak = tvLondonActive and not na(londonLevel) and (close - londonLevel) * d > 0 and (close[1] - londonLevel) * d <= 0
            bool nyBreak = tvNewYorkActive and not na(nyLevel) and (close - nyLevel) * d > 0 and (close[1] - nyLevel) * d <= 0
            raw := londonBreak or nyBreak
            if raw
                anchor := londonBreak ? (d == 1 ? tvLondonORLow : tvLondonORHigh) : (d == 1 ? tvNewYorkORLow : tvNewYorkORHigh)
            extraReason := not candle ? "Няма потвърждаваща свещ" : ""
        else if tvStrategyMode == "S8"
            float level = d == 1 ? tvRange3High : tvRange3Low
            raw := (close - level) * d > 0 and (close[1] - level) * d <= 0
            extraReason := not trend ? "Няма насочен тренд" : efficiency < 0.35 ? "Ниска насоченост" : body[1] > 0.5 * atr[1] ? "Няма предходна пауза" : directionalBody < 0.5 * atr ? "Слаб импулс" : math.abs(close - tvEma20) > 2.0 * atr ? "Разтеглен импулс" : ""
        if raw
            // A triggered state is consumed even when risk/context rejects it.
            f_tvClear(s)
            float structural = d == 1 ? math.min(anchor - slBufferATR * atr, close - minStopATR * atr) : math.max(anchor + slBufferATR * atr, close + minStopATR * atr)
            Plan p = f_tvStamp(f_makePlan(2, d, f_stopRound(structural, d), born, maxStopATR, obstacle, requireRoom ? math.max(minimumRoomR, target1R) : 0.0), tvStrategyMode)
            string commonReason = f_tvCommonReason(p, tvCandidateRequireHTF)
            int last = array.get(tvCandidateLast, idx)
            bool cool = na(last) or bar_index - last > minCooldown
            reason := extraReason != "" ? extraReason : not cool ? "Пауза след потвърден модел" : commonReason
            if reason == "УСЛОВИЯТА СА ИЗПЪЛНЕНИ"
                array.push(candidates, p)
                array.set(tvCandidateLast, idx, bar_index)
            else
                f_planEvent(events, p, "REJECTED", "CORE", time_close, close, reason)
            f_recordDecision(2, d, reason == "УСЛОВИЯТА СА ИЗПЪЛНЕНИ", reason)
        else if not terminated and s.phase != 0
            reason := s.phase == 2 ? "Чака ретест" : "Чака отделна потвърждаваща свещ"
    [reason, raw]

f_tvFastGate(Plan p) =>
    int d = p.side
    float boundary = d == 1 ? fastBreakHigh : fastBreakLow
    bool body55 = (close - open) * d / barRange >= 0.55
    bool alignedHTF = tvH1Bias == d and tvH4Bias == d
    bool clearance = not na(p.obstacle) and (p.obstacle - p.reference) * d + syminfo.mintick * 1e-6 >= math.max(p.risk, (p.tp1 - p.reference) * d)
    bool fresh = (p.reference - boundary) * d <= 0.25 * p.atrValue
    bool momentum = (rsi - 50) * d >= 5 and (close - close[2]) * d >= 0.25 * atr
    switch tvStrategyMode
        "F1" => body55 ? "" : "F1 архив: тяло <55%"
        "F3" => alignedHTF ? "" : "F3: H1/H4 не съвпадат"
        "F5" => clearance ? "" : "F5: няма потвърдено място до TP1"
        "F6" => tvRegime == d ? "" : "F6: няма устойчив насочен режим"
        "F7" => fresh ? "" : "F7: пробивът е над 0.25 ATR"
        "F8" => momentum ? "" : "F8: слаб RSI/двубаров импулс"
        "F9" => tvLondonActive or tvNewYorkActive ? "" : "F9: извън London/NY"
        "F10" => alignedHTF and fresh ? "" : "F10: H1/H4 или отстояние"
        => ""

if processBar and tvStrategyMode != "S0"
    // Preserve raw FAST detector/cooldown for F variants; never inherit a legacy
    // RETEST/REVERSAL candidate, label or event into a challenger experiment.
    array<Plan> tvOriginalFast = array.new<Plan>()
    if str.startswith(tvStrategyMode, "F") and tvEntryFrame and array.size(candidates) > 0
        for p in candidates
            if p.family == 2
                array.push(tvOriginalFast, p.copy())
    array.clear(candidates)
    array.clear(events)
    if str.startswith(tvStrategyMode, "S")
        for idx = 0 to 1
            int d = idx == 0 ? 1 : -1
            [why, attempted] = f_tvCandidate(d)
            array.set(tvReasons, idx, why)
            if attempted
                tvRawAttempts += 1
                if why == "УСЛОВИЯТА СА ИЗПЪЛНЕНИ"
                    tvAcceptedAttempts += 1
                else
                    tvRejectedAttempts += 1
        lastAnalysisClose := time_close
        closedEfficiency := efficiency
        localPressure := tvResearchDirection
        closedHtfBias := tvH1Bias
        lastContext := tvResearchDirection == 1 ? "НАТИСК НАГОРЕ" : tvResearchDirection == -1 ? "НАТИСК НАДОЛУ" : "СМЕСЕН КОНТЕКСТ"
    else
        for idx = 0 to 1
            int d = idx == 0 ? 1 : -1
            Plan pending = array.get(tvFastPending, idx)
            bool terminated = false
            string why = "Няма оригинален FAST trigger"
            if not na(pending)
                float boundary = array.get(tvFastBoundary, idx)
                int wait = tvStrategyMode == "F2" ? 1 : 4
                int age = bar_index - pending.signalBar
                float extreme = d == 1 ? low : high
                bool cancelled = tvTimeGap or (extreme - pending.initialStop) * d <= 0 or (close - boundary) * d <= 0
                bool expired = age > wait
                bool accepted = age >= 1 and age <= wait and (tvStrategyMode == "F2" ? (close - boundary) * d >= 0.10 * pending.atrValue : math.abs(extreme - boundary) <= 0.15 * pending.atrValue)
                if cancelled or expired or accepted or (tvStrategyMode == "F2" and age == 1)
                    terminated := true
                    array.set(tvFastPending, idx, na)
                    if cancelled or expired or not accepted
                        why := cancelled ? "Прекъсване / стоп / връщане през пробива" : "Изтекло отложено потвърждение"
                        f_planEvent(events, pending, cancelled ? "CANCELLED" : "EXPIRED", "CORE", time_close, close, why)
                        tvRejectedAttempts += 1
                    else
                        float obstacle = d == 1 ? longObstacle : shortObstacle
                        Plan p = f_tvStamp(f_makePlan(2, d, pending.initialStop, pending.createdTime, pending.maxRiskATR, obstacle, pending.requiredRoom), tvStrategyMode)
                        why := f_tvCommonReason(p, false)
                        if why == "УСЛОВИЯТА СА ИЗПЪЛНЕНИ"
                            array.push(candidates, p)
                            tvAcceptedAttempts += 1
                        else
                            f_planEvent(events, p, "REJECTED", "CORE", time_close, close, why)
                            tvRejectedAttempts += 1
                else
                    why := "Чака по-късно потвърждение; няма вход назад"
            if array.size(tvOriginalFast) > 0
                for rawPlan in tvOriginalFast
                    if rawPlan.side == d
                        tvRawAttempts += 1
                        Plan p = f_tvStamp(rawPlan.copy(), tvStrategyMode)
                        if tvStrategyMode == "F2" or tvStrategyMode == "F4"
                            if not terminated and na(array.get(tvFastPending, idx))
                                array.set(tvFastPending, idx, p)
                                array.set(tvFastBoundary, idx, d == 1 ? fastBreakHigh : fastBreakLow)
                                why := tvStrategyMode == "F2" ? "Чака следващо приемане" : "Чака отделен ретест до 4 свещи"
                                f_planEvent(events, p, "WATCH", "CORE", time_close, p.reference, why)
                            else
                                why := "Непрезаписан чакащ FAST / приключен на тази свещ"
                                f_planEvent(events, p, "REJECTED", "CORE", time_close, close, why)
                                tvRejectedAttempts += 1
                        else
                            why := f_tvFastGate(p)
                            if why == ""
                                array.push(candidates, p)
                                tvAcceptedAttempts += 1
                                why := "УСЛОВИЯТА СА ИЗПЪЛНЕНИ"
                            else
                                f_planEvent(events, p, "REJECTED", "CORE", time_close, close, why)
                                tvRejectedAttempts += 1
            array.set(tvReasons, idx, why)
    for i = 0 to 2
        array.set(buyReasons, i, array.get(tvReasons, 0))
        array.set(sellReasons, i, array.get(tvReasons, 1))

f_addClosed(Ledger a, Paper s) =>
    float net = s.gross - s.costs
    a.closed += 1
    a.gross += s.gross
    a.costs += s.costs
    a.net += net
    if net > 1e-10
        a.positive += 1
        a.gains += net
    else if net < -1e-10
        a.negative += 1
        a.losses += -net
    else
        a.zero += 1
    a.peak := math.max(a.peak, a.net)
    a.drawdown := math.max(a.drawdown, a.peak - a.net)
    a.holdBars += bar_index - s.fillBar
    a
f_realize(Paper s, float fraction, float px, string kind, string book, int effective, array<Event> ev) =>
    float part = math.min(fraction, s.remaining)
    float gross = part * (px - s.entry) * s.p.side / s.risk
    float rate = s.p.side == 1 ? fundingLong : fundingShort
    int durationEnd = na(effective) ? time_close : effective
    float days = math.max(0.0, (durationEnd - s.fillTime) / 86400000.0)
    float costs = part * (s.p.costPrice + rate * days) / s.risk
    s.remaining := math.max(0.0, s.remaining - part)
    s.gross += gross
    s.costs += costs
    s.lastExecutionPrice := px
    s.lastExecutionTime := effective
    s.dayNet += gross - costs
    Event e = f_planEvent(ev, s.p, kind, book, effective, px, "Виртуален изход; известен при затваряне")
    e.quantityFraction := part
    e.grossR := gross
    e.costR := costs
    e.netR := gross - costs
    e
f_finish(Paper s, Ledger a, string book, string reason, array<Event> ev) =>
    f_addClosed(a, s)
    float net = s.gross - s.costs
    if net < -1e-10
        s.dayStreak += 1
    else if net > 1e-10
        s.dayStreak := 0
    s.lastClosedId := s.p.id
    s.lastClosedReason := reason
    s.lastClosedNet := net
    Event e = f_planEvent(ev, s.p, "CLOSED", book, s.lastExecutionTime, s.lastExecutionPrice, reason)
    e.quantityFraction := 1.0
    e.grossR := s.gross
    e.costR := s.costs
    e.netR := net
    s.phase := 0
    s.exitNextOpen := false
    s.lockBar := na
    s
f_openRejection(Plan p, float fill, int fillTime) =>
    float risk = (fill - p.initialStop) * p.side
    bool wrongSide = risk < syminfo.mintick or (p.tp1 - fill) * p.side <= 0
    bool farOpen = math.abs(fill - p.reference) > p.atrValue * maxOpenDeviationATR
    bool riskOpen = risk >= minStopATR * p.atrValue and risk <= p.maxRiskATR * p.atrValue and risk > 0 and p.costPrice / risk <= maxCostRisk
    bool roomOpen = f_targetRoom(p, fill, risk)
    bool newsAtOpen = manualNewsPause or (useNewsWindow and fillTime >= newsAt - newsBefore * 60000 and fillTime <= newsAt + newsAfter * 60000)
    wrongSide ? "Отваряне извън SL/TP1" : newsAtOpen ? "Новинарска пауза при отваряне" : paperGapFilter and farOpen ? "Гап/отстояние" : paperGapFilter and not riskOpen ? "Риск/разходи при отваряне" : paperGapFilter and not roomOpen ? "Недостатъчно място при отваряне" : ""
f_takeTargets(Paper s, Ledger a, string book, array<Event> ev, bool atOpen) =>
    bool closed = false
    int effective = atOpen ? time : na
    float favorable = atOpen ? open : s.p.side == 1 ? high : low
    if (favorable - s.p.tp1) * s.p.side >= 0 and not s.hit1
        f_realize(s, 1.0 / 3.0, s.p.tp1, "SIM_TP1", book, effective, ev)
        s.hit1 := true
        s.lockBar := bar_index + 1
    if (favorable - s.p.tp2) * s.p.side >= 0 and not s.hit2
        f_realize(s, 1.0 / 3.0, s.p.tp2, "SIM_TP2", book, effective, ev)
        s.hit2 := true
    if (favorable - s.p.tp3) * s.p.side >= 0 and not s.hit3
        f_realize(s, s.remaining, s.p.tp3, "SIM_TP3", book, effective, ev)
        s.hit3 := true
        f_finish(s, a, book, "TP3", ev)
        closed := true
    closed
f_step(Paper s, Ledger a, string book, array<Event> ev) =>
    int today = f_day(time)
    if na(s.dayKey) or s.dayKey != today
        s.dayKey := today
        s.dayNet := 0.0
        s.dayStreak := 0
    bool closedNow = false
    if s.phase == 1 and bar_index > s.p.signalBar
        float openRisk = (open - s.p.initialStop) * s.p.side
        string openReason = f_openRejection(s.p, open, time)
        bool reject = openReason != ""
        if reject
            a.cancelled += 1
            s.lastCancelledId := s.p.id
            s.lastCancelledReason := openReason
            f_planEvent(ev, s.p, "CANCELLED", book, time, open, s.lastCancelledReason)
            s.phase := 0
        else
            s.phase := 2
            s.entry := open
            s.risk := openRisk
            s.stop := s.p.initialStop
            s.remaining := 1.0
            s.hit1 := false
            s.hit2 := false
            s.hit3 := false
            s.fillBar := bar_index
            s.fillTime := time
            s.lockBar := na
            s.exitNextOpen := false
            s.gross := 0.0
            s.costs := 0.0
            a.entered += 1
            Event fillEvent = f_planEvent(ev, s.p, "SIM_ENTRY", book, time, s.entry, "Предполагаемо next-open; съобщено при close")
            fillEvent.quantityFraction := 1.0
    if s.phase == 2
        // Lock is established at the preceding close, effective from this bar.
        if not na(s.lockBar) and bar_index >= s.lockBar
            float nextSL = f_stopRound(s.entry + s.p.side * s.risk * profitLockR, s.p.side)
            float previous = s.stop
            s.stop := s.p.side == 1 ? math.max(s.stop, nextSL) : math.min(s.stop, nextSL)
            if s.stop != previous
                f_planEvent(ev, s.p, "STOP_UPDATE", book, time, s.stop, "Брутен буфер; не гарантира нетна печалба")
            s.lockBar := na
        if s.exitNextOpen
            bool gapStop = (open - s.stop) * s.p.side <= 0
            f_realize(s, s.remaining, open, gapStop ? "SIM_SL" : "SIM_TIME", book, time, ev)
            f_finish(s, a, book, gapStop ? "STOP_GAP" : "TIME_NEXT_OPEN", ev)
            closedNow := true
        else if (open - s.stop) * s.p.side <= 0
            // A gap through SL is a known open event, not an ambiguous intrabar path.
            f_realize(s, s.remaining, open, "SIM_SL", book, time, ev)
            f_finish(s, a, book, "STOP_GAP", ev)
            closedNow := true
        else
            // Already-marketable targets at open must execute before any later reversal.
            // Price improvement is deliberately not assumed: use each frozen target price.
            closedNow := f_takeTargets(s, a, book, ev, true)
            if s.phase == 2
                bool stopTouched = s.p.side == 1 ? low <= s.stop : high >= s.stop
                bool tp1Touched = (s.p.side == 1 ? high >= s.p.tp1 : low <= s.p.tp1) and not s.hit1
                bool tp2Touched = (s.p.side == 1 ? high >= s.p.tp2 : low <= s.p.tp2) and not s.hit2
                bool tp3Touched = (s.p.side == 1 ? high >= s.p.tp3 : low <= s.p.tp3) and not s.hit3
                if stopTouched
                    if tp1Touched or tp2Touched or tp3Touched
                        a.ambiguousBars += 1
                        f_planEvent(ev, s.p, "AMBIGUOUS", book, na, s.stop, "Неизвестен ред след open: SL-first за остатъка")
                    f_realize(s, s.remaining, s.stop, "SIM_SL", book, na, ev)
                    f_finish(s, a, book, "STOP_FIRST", ev)
                    closedNow := true
                else
                    closedNow := f_takeTargets(s, a, book, ev, false)
                    if s.phase == 2 and bar_index - s.fillBar >= maxHoldBars
                        s.exitNextOpen := true
                        f_planEvent(ev, s.p, "TIME_PENDING", book, time_close, close, "Планиран виртуален изход на следващо отваряне")
    closedNow
f_queue(Paper s, Ledger a, Plan p, string book, array<Event> ev) =>
    bool accepted = s.phase == 0
    if accepted
        s.p := p.copy()
        s.phase := 1
        f_planEvent(ev, p, "QUEUED", book, time_close, p.reference, "Чака следващо отваряне; няма брокерска поръчка")
    else
        a.capacitySkipped += 1
        f_planEvent(ev, p, "CAPACITY", book, time_close, p.reference, "Портфейлът има виртуална позиция; кандидатът е запазен в журнала")
    accepted
f_gate(EvidenceGate g, Ledger a, bool globalGate, array<Event> ev, int model) =>
    bool previous = g.paused
    int minimum = globalGate ? globalMinClosed : modelMinClosed
    float metric = globalGate ? a.net : a.closed > 0 ? a.net / a.closed : 0.0
    float pauseAt = globalGate ? globalStopNetR : modelStopAvgR
    float recoverAt = globalGate ? globalStopNetR * 0.5 : 0.0
    if enableEvidenceShield and a.closed >= minimum
        if not g.paused and metric <= pauseAt
            g.paused := true
            g.pausedAtCount := a.closed
        else if g.paused and a.closed >= g.pausedAtCount + recoveryTrades and metric >= recoverAt
            g.paused := false
    else if not enableEvidenceShield
        g.paused := false
    if previous != g.paused
        f_emit(ev, "EVIDENCE", "CORE", "EVIDENCE|" + str.tostring(model), model, 0, time_close, na, g.paused ? "Пауза: отрицателна виртуална извадка" : "Излязъл от пауза; остава невалидиран")
    g
f_pick(array<Plan> plans, int family, bool eligibleOnly) =>
    Plan chosen = na
    bool conflict = false
    int seenSide = 0
    if array.size(plans) > 0
        for p in plans
            if (family == 0 or p.family == family) and (not eligibleOnly or p.filterEligible)
                if seenSide != 0 and seenSide != p.side
                    conflict := true
                seenSide := p.side
                if na(chosen) or p.family < chosen.family
                    chosen := p
    conflict ? na : chosen

// M1/M2/M3 are independent shadow books. RAW is a single-capacity combined portfolio.
// FILTERED is a separate portfolio; neither can suppress independent candidate discovery.
var array<Paper> books = array.new<Paper>()
var array<Ledger> ledgers = array.new<Ledger>()
var array<EvidenceGate> gates = array.new<EvidenceGate>()
if barstate.isfirst
    for n = 0 to 4
        array.push(books, Paper.new())
        array.push(ledgers, Ledger.new())
    for n = 0 to 3
        array.push(gates, EvidenceGate.new())

var string lastEvidence = "НЕВАЛИДИРАН"
if processBar
    // Step existing portfolios BEFORE queuing any newly confirmed plan.
    for i = 0 to 4
        string name = i < 3 ? "M" + str.tostring(i + 1) : i == 3 ? "RAW" : "FILTERED"
        f_step(array.get(books, i), array.get(ledgers, i), name, events)
    for i = 0 to 3
        f_gate(array.get(gates, i), array.get(ledgers, i == 0 ? 3 : i - 1), i == 0, events, i)
    Paper filtered = array.get(books, 4)
    bool dailyPass = filtered.dayNet > -maxPaperDailyLossR and filtered.dayStreak < maxPaperLosingStreak
    if array.size(candidates) > 0
        for p in candidates
            EvidenceGate globalG = array.get(gates, 0)
            EvidenceGate familyG = array.get(gates, p.family)
            Ledger familyL = array.get(ledgers, p.family - 1)
            bool shieldPaused = enableEvidenceShield and (globalG.paused or familyG.paused)
            bool contraPause = observeCountertrendOnly and p.countertrend
            string policyReason = f_policyReason(p)
            p.filterEligible := not shieldPaused and not contraPause and dailyPass and policyReason == ""
            p.evidence := policyReason != "" ? "ПРОБНА ПОЛИТИКА: " + policyReason : shieldPaused ? "ПАУЗА: ИЗВАДКА" : contraPause ? "ИЗСЛЕДВАНЕ: КОНТРАТРЕНД" : not dailyPass ? "ПАУЗА: ДНЕВЕН ЛИМИТ" : familyL.closed < modelMinClosed ? "НЕВАЛИДИРАН: МАЛКА ИЗВАДКА" : "НЕВАЛИДИРАН: НЯМА OOS"
            lastEvidence := p.evidence
            f_planEvent(events, p, "CONFIRMED", "CORE", time_close, p.reference, "Техническите правила са изпълнени; НЕ е препоръка за поръчка")
    for m = 1 to 3
        Plan independent = f_pick(candidates, m, false)
        if not na(independent)
            f_queue(array.get(books, m - 1), array.get(ledgers, m - 1), independent, "M" + str.tostring(m), events)
    Plan combined = f_pick(candidates, 0, false)
    Plan permitted = f_pick(candidates, 0, true)
    if not na(combined)
        f_queue(array.get(books, 3), array.get(ledgers, 3), combined, "RAW", events)
    else if array.size(candidates) > 0
        f_emit(events, "CONFLICT", "RAW", "RAW|" + str.tostring(time_close), 0, 0, time_close, close, "Противоположни технически модели; няма портфейлен избор")
    if not na(permitted)
        f_queue(array.get(books, 4), array.get(ledgers, 4), permitted, "FILTERED", events)
// END CANONICAL CORE
// Opt-in native research only. The baseline signal and independent shadow books keep their own geometry.
bool tvManagement = false
string tvEntryMode = "Следващ тик"
int tvLimitBars = 3
int tvMaxSetupAge = 0
float tvDeviationATR = 0.0
float tvExtraStopATR = 0.0
string tvTargetMode = "R"
string tvAllocation = "Равни"
string tvBreakEven = "Буфер след TP1"
float tvTrailATR = 0.0
int tvHoldOverride = 0
string tvEarlyExit = "Само срок"
bool tvLimitEntry = tvManagement and tvEntryMode == "Структурен лимит"
bool tvStructuralTargets = tvManagement and tvTargetMode == "Структура"
bool tvUsesBaselineLock = not tvManagement or tvBreakEven == "Буфер след TP1"
float tvPriorClose = close[1]
bool tvContiguousClose = time == time_close[1]

f_tvManagementQty(float unit) =>
    bool weighted = tvManagement and tvAllocation == "50/30/20"
    float total = 3.0 * unit
    [weighted ? total * 0.5 : unit, weighted ? total * 0.3 : unit, weighted ? total * 0.2 : unit]

f_tvQtyOnGrid(float amount) =>
    float stepSize = syminfo.mincontract
    not na(stepSize) and stepSize > 0 and amount + stepSize * 1e-8 >= stepSize and math.abs(amount / stepSize - math.round(amount / stepSize)) <= 1e-7

f_tvProtectionBoundary(Plan p) =>
    int side = p.side
    float best = na
    for rawLevel in array.from(side == 1 ? fastBreakHigh : fastBreakLow, side == 1 ? longStruct : shortStruct, side == 1 ? lastPivotLow : lastPivotHigh, side == 1 ? prevPivotLow : prevPivotHigh)
        if not na(rawLevel)
            float px = f_stopRound(rawLevel, side)
            bool between = (px - p.initialStop) * side >= syminfo.mintick * 0.5 and (p.reference - px) * side >= syminfo.mintick * 0.5
            if between and (na(best) or (px - best) * side > 0)
                best := px
    best

f_tvNextStructure(array<float> levels, float fromPrice, int side) =>
    float chosen = na
    if not na(fromPrice)
        for rawLevel in levels
            if not na(rawLevel)
                // Inward tick rounding keeps a limit at or inside the observed level.
                float px = f_stopRound(rawLevel, side)
                if (px - fromPrice) * side >= syminfo.mintick * 0.5 and (na(chosen) or (px - chosen) * side < 0)
                    chosen := px
    chosen

f_tvManagePlan(Plan original, float unit) =>
    Plan p = original
    string reason = ""
    float limitPrice = na
    float boundary = na
    if tvManagement and not na(original)
        p := original.copy()
        if tvExtraStopATR > 0
            p.initialStop := f_stopRound(p.initialStop - p.side * p.atrValue * tvExtraStopATR, p.side)
        boundary := f_tvProtectionBoundary(p)
        if tvLimitEntry and not na(boundary)
            limitPrice := boundary
            p.reference := limitPrice
            p.expiresAfterBar := bar_index + tvLimitBars
            p.cancellationReason := "Лимитът изтече"
        p.risk := (p.reference - p.initialStop) * p.side
        if tvStructuralTargets
            int side = p.side
            array<float> levels = array.from(p.obstacle, side == 1 ? lastPivotHigh : lastPivotLow, side == 1 ? prevPivotHigh : prevPivotLow, side == 1 ? priorDayHigh : priorDayLow, side == 1 ? lastAsianH : lastAsianL, side == 1 ? priorRecoveryHigh : priorRecoveryLow)
            p.tp1 := f_tvNextStructure(levels, p.reference, side)
            p.tp2 := f_tvNextStructure(levels, p.tp1, side)
            p.tp3 := f_tvNextStructure(levels, p.tp2, side)
            p.targetBasis := "STRUCTURE"
        else if tvLimitEntry or tvExtraStopATR > 0
            p.tp1 := f_targetRound(p.reference + p.side * p.risk * target1R, p.side)
            p.tp2 := f_targetRound(p.reference + p.side * p.risk * target2R, p.side)
            p.tp3 := f_targetRound(p.reference + p.side * p.risk * target3R, p.side)
            p.targetBasis := "R"
        if tvDeviationATR > 0
            p.maxDeviationATRFrozen := math.min(p.maxDeviationATRFrozen, tvDeviationATR)
        if tvHoldOverride > 0
            p.maxHoldBarsFrozen := tvHoldOverride
        [part1, part2, part3] = f_tvManagementQty(unit)
        bool weightedInvalid = tvAllocation == "50/30/20" and not (f_tvQtyOnGrid(part1) and f_tvQtyOnGrid(part2) and f_tvQtyOnGrid(part3))
        bool oldSetup = tvMaxSetupAge > 0 and (na(p.createdTime) or p.createdTime > time_close or time_close - p.createdTime > tvMaxSetupAge * tfSeconds * 1000)
        bool missingLevels = tvStructuralTargets and (na(p.tp1) or na(p.tp2) or na(p.tp3))
        if oldSetup
            reason := "Изтекла подготовка"
        else if tvLimitEntry and na(limitPrice)
            reason := "Няма структурен лимит между цена и SL"
        else if weightedInvalid
            reason := "Частите 50/30/20 не са на стъпката на символа"
        else if missingLevels
            reason := "Липсват три отделни структурни цели"
        else if not f_validPlan(p)
            reason := "Невалидни вход, SL, цели или разход"
    [p, reason, limitPrice, boundary]

f_tvNativeOpenRejection(Plan p, float fill, int fillTime) =>
    string original = f_openRejection(p, fill, fillTime)
    tvManagement and tvDeviationATR > 0 and original == "" and math.abs(fill - p.reference) > p.atrValue * p.maxDeviationATRFrozen ? "Отстояние от замразен вход" : original

f_tvPendingReason(Plan p) =>
    string reason = ""
    if tvLimitEntry and not na(p)
        reason := bar_index >= p.expiresAfterBar ? "Лимитът изтече" : newsPaused ? "Лимитът е отменен при пауза" : time_close >= testEnd ? "Лимитът е отменен в края на теста" : (close - p.initialStop) * p.side <= 0 ? "Лимитът е отменен при инвалидация" : ""
    reason

f_tvTighten(float oldStop, float proposed, int side) =>
    float result = oldStop
    if not na(proposed)
        float nextStop = f_stopRound(proposed, side)
        if (nextStop - oldStop) * side >= syminfo.mintick * 0.5 and (close - nextStop) * side >= syminfo.mintick * 0.5
            result := nextStop
    result

f_tvManagedStop(Plan p, float entry, float initialRisk, float oldStop, float boundary, bool tp1Filled, bool tp2Filled) =>
    float result = oldStop
    string reason = ""
    if tvManagement and not na(initialRisk) and initialRisk > 0
        bool entryLock = (tvBreakEven == "BE след TP1" and tp1Filled) or (tvBreakEven == "BE след TP2" and tp2Filled)
        float protect = entryLock ? entry : tvBreakEven == "Структурен след TP1" and tp1Filled ? boundary : na
        result := f_tvTighten(result, protect, p.side)
        if result != oldStop
            reason := tvBreakEven
        if tvTrailATR > 0 and not na(atr) and atr > 0
            float trailed = f_tvTighten(result, close - p.side * atr * tvTrailATR, p.side)
            if trailed != result
                result := trailed
                reason := "ATR трейлинг"
    [result, reason]

f_tvManagementCloseReason(Plan p, float boundary, int fillBar) =>
    string reason = ""
    if tvManagement and not na(fillBar)
        if tvEarlyExit == "Структурна инвалидация" and not na(boundary) and (close - boundary) * p.side <= 0
            reason := "СТРУКТУРНА ИНВАЛИДАЦИЯ"
        else if tvEarlyExit == "Слаб моментум" and bar_index - fillBar >= 1 and tvContiguousClose and (close - p.reference) * p.side < 0 and (tvPriorClose - p.reference) * p.side < 0 and (rsi - 50) * p.side < 0
            reason := "СЛАБ МОМЕНТУМ"
    reason

// Native fill messages contain known plan/order levels, never an invented future fill.
// Actual fill price/quantity are supplied by the strategy_alert_message UI template.
f_alertSide(int d) => d == 1 ? "ПОКУПКА" : d == -1 ? "ПРОДАЖБА" : "БЕЗ ПОСОКА"
f_clockUtc(int stamp) => na(stamp) ? "—" : str.format_time(stamp, "dd.MM.yyyy HH:mm:ss", "UTC") + " UTC"
f_biasSymbol(int bias) => bias == 1 ? "↑" : bias == -1 ? "↓" : "↔"
// Only commentary is bounded. IDs, timestamps and executable prices never use this helper.
f_humanReason(string value, int limit) =>
    bool codeFragment = str.contains(value, "f_price(") or str.contains(value, "plannedCampaignQty") or str.contains(value, "maxDeviationATRFrozen") or str.contains(value, "=>")
    string clean = codeFragment ? "Технически подробности в диагностиката" : value
    clean := str.replace_all(clean, "NATIVE_", "")
    clean := str.replace_all(clean, "native", "емулатор")
    clean := str.replace_all(clean, "NATIVE", "ЕМУЛАТОР")
    clean := str.replace_all(clean, "FILTERED", "филтрирана симулация")
    clean := str.replace_all(clean, "RAW", "основна симулация")
    clean := str.replace_all(clean, "PAPER", "отделна симулация")
    clean := str.replace_all(clean, "HTF", "по-висока рамка")
    clean := str.replace_all(clean, "next-open", "следващо отваряне")
    clean := str.replace_all(clean, "fill", "изпълнение")
    f_short(clean, limit)
f_eventTitle(string kind) =>
    kind == "NATIVE_CLOSED" ? "СИМУЛИРАН ПЛАН ПРИКЛЮЧЕН" : kind == "NATIVE_EXIT_RESEARCH" ? "СИМУЛИРАН ЗАЩИТЕН ИЗХОД" : kind == "NATIVE_STOP_SCHEDULED" ? "ЗАЩИТЕН СТОП · СЛЕДВАЩ ТИК" : (kind == "ENTRY" or kind == "NATIVE_ENTRY") ? "СИМУЛИРАН ВХОД" : (kind == "TP1" or kind == "NATIVE_TP1") ? "СИМУЛИРАН ИЗХОД TP1" : (kind == "TP2" or kind == "NATIVE_TP2") ? "СИМУЛИРАН ИЗХОД TP2" : (kind == "TP3" or kind == "NATIVE_TP3") ? "СИМУЛИРАН ИЗХОД TP3" : (kind == "SL" or str.startswith(kind, "NATIVE_SL")) ? "СИМУЛИРАН СТОП" : kind == "NATIVE_EXIT_TIME" ? "ИЗХОД — ИЗТЕКЪЛ СРОК" : kind == "NATIVE_EXIT_GAP" ? "НЕВАЛИДЕН ИЗПЪЛНЕН ВХОД" : kind == "NATIVE_SUBMITTED" ? "ПЛАН ЗАЯВЕН · БЕЗ ИЗПЪЛНЕНИЕ" : kind == "WATCH" ? "ПОДГОТОВКА · ЧАКА ПОТВЪРЖДЕНИЕ" : kind == "CONFIRMED" ? "ТЕХНИЧЕСКИ КАНДИДАТ" : kind == "NATIVE_BLOCKED" ? "КАНДИДАТ БЕЗ ПОРЪЧКА" : kind == "NATIVE_NOT_FILLED" ? "ЗАЯВКАТА НЕ Е ИЗПЪЛНЕНА" : kind == "NATIVE_STOP_SCHEDULED" ? "НОВ СТОП ОТ СЛЕДВАЩИЯ ТИК" : kind == "CANCELLED" ? "ПЛАНЪТ Е ОТМЕНЕН" : kind == "EXPIRED" ? "ПЛАНЪТ Е ИЗТЕКЪЛ" : kind == "REJECTED" ? "КАНДИДАТЪТ Е ОТХВЪРЛЕН" : "ПРЕДУПРЕЖДЕНИЕ"
f_nativeMessage(Plan p, float plannedCampaignQty, string eventKind, string reason, float level) =>
    string actionReason = eventKind == "NATIVE_EXIT_GAP" ? "Точната причина не е записана; възможни са риск, преграда, новини или отклонение." : reason
    string expiry = f_int(p.expiresAfterBar - p.signalBar) + " св. след потв.: " + f_humanReason(p.cancellationReason, 64)
    string age = str.tostring(math.max(0, bar_index - p.signalBar)) + " св. при заявката"
    "QIRVANTA · " + syminfo.tickerid + " · " + timeframe.period + "\n" + f_eventTitle(eventKind) + " · " + f_alertSide(p.side) + "\n" + f_tvFamily(p.strategyKey, p.family) + " · План " + p.id + "\nПотв. " + f_clockUtc(p.signalTime) + " · " + age + "\nОриентир " + f_price(p.reference) + " · Структ. SL " + f_price(p.initialStop) + "\n" + f_tvTargets(p.targetBasis) + " · TP1 " + f_price(p.tp1) + " · TP2 " + f_price(p.tp2) + " · TP3 " + f_price(p.tp3) + "\nПреграда " + f_price(p.obstacle) + " · Заявено ниво " + f_price(level) + "\nРазмер на плана " + f_num(plannedCampaignQty) + " · Гап ≤ " + f_num(p.maxDeviationATRFrozen) + " ATR\nСрок " + f_int(p.maxHoldBarsFrozen) + " св. след вход\nБез изпълнение: " + expiry + "\n" + f_humanReason(actionReason, 96) + "\nСамо симулация; изпълнението е в данните на известието."
f_isRiskEvent(Event e) =>
    e.kind == "CANCELLED" or e.kind == "EXPIRED" or e.kind == "REJECTED" or e.kind == "EVIDENCE" or e.kind == "CONFLICT" or e.kind == "AMBIGUOUS" or e.kind == "NATIVE_BLOCKED" or e.kind == "NATIVE_DIVERGENCE" or e.kind == "NATIVE_NOT_FILLED" or e.kind == "NATIVE_LEDGER_INCOMPLETE" or e.kind == "NATIVE_STOP_SCHEDULED"
f_allowedUnifiedEvent(Event e) =>
    bool shadow = e.book != "CORE" and e.book != "NATIVE"
    bool nativeFillObservation = e.kind == "NATIVE_ENTRY" or str.startswith(e.kind, "NATIVE_EXIT_")
    bool selectedPlan = e.book == "NATIVE" and e.kind == "NATIVE_SUBMITTED" and alertPlan
    bool watch = e.book == "CORE" and e.kind == "WATCH" and alertWatch
    bool risk = not shadow and f_isRiskEvent(e) and alertRisk and (e.book == "NATIVE" or e.kind == "EVIDENCE")
    bool confirmed = e.book == "CORE" and e.kind == "CONFIRMED" and tvAlertConfirmed
    bool closed = e.book == "NATIVE" and e.kind == "NATIVE_CLOSED" and tvAlertClosed
    bool diagnostic = alertDiagnostics and e.book == "CORE" and (e.kind == "CONFIRMED" or f_isRiskEvent(e))
    alertsEnabled and not nativeFillObservation and (selectedPlan or confirmed or closed or watch or risk or diagnostic or (shadow and alertShadow))
f_readableEvent(Event e) =>
    string origin = e.book == "CORE" ? "АНАЛИЗ" : e.book == "NATIVE" ? "ЕМУЛАТОР" : "ОТДЕЛНА СИМУЛАЦИЯ"
    string direction = e.kind == "WATCH" ? (e.side == 1 ? "НАГОРЕ" : "НАДОЛУ") : f_alertSide(e.side)
    string age = str.tostring(math.max(0, e.knownTime - e.effectiveTime) / 1000) + " сек. до обработка"
    "QIRVANTA · " + syminfo.tickerid + " · " + timeframe.period + "\n" + f_eventTitle(e.kind) + " · " + direction + "\n" + origin + " · " + f_tvFamily(e.strategyKey, e.family) + " · План " + e.planId + "\nСъбитие " + f_clockUtc(e.effectiveTime) + "\nОбработено " + f_clockUtc(e.knownTime) + " · " + age + "\nОриентир " + f_price(e.reference) + " · Структ. SL " + f_price(e.stop) + "\n" + f_tvTargets(e.targetBasis) + " · TP1 " + f_price(e.tp1) + " · TP2 " + f_price(e.tp2) + " · TP3 " + f_price(e.tp3) + "\nПреграда " + f_price(e.obstacle) + " · Цена на събитието " + f_price(e.price) + "\n" + f_humanReason(e.reason, 96) + "\nСамо симулация; старо известие не е нов вход."


const bool rc2Parity = false
// Preregistered, opt-in signal experiments. S5 candidates and risk levels are immutable.
const float RC2_RANGE_ATR_LIMIT = 1.75
const string RC2_FILTER_REASON = "RC2 experimental range filter: signal bar exceeds 1.75 ATR"
bool rc2FilterOpt = input.bool(false, "Experimental range filter", group="RC2 RESEARCH",
     tooltip="Rejects a READY plan when the confirmed signal bar exceeds 1.75 ATR. Ignored in the S5 RAW parity lane.", display=display.none)
bool rc2FilterActive = rc2FilterOpt and not rc2Parity

f_rc2FilterPass(Plan p) =>
    not rc2FilterActive or na(p) or barRange <= RC2_RANGE_ATR_LIMIT * p.atrValue

// Read-only bridge from the pinned engine. READY means a valid plan at decision time.
const int RC_NONE = 0
const int RC_WATCH = 1
const int RC_CONFIRMED = 2
const int RC_READY = 3
const int RC_REJECTED = 4
const int RC_INVALIDATED = 5
const int RC_EXPIRED = 6
bool rcSupported = syminfo.tickerid == "OANDA:XAUUSD" and tvEntryFrame
bool rcCanDrawBar = rcSupported and processBar
bool rcQa = input.bool(false, "Export RC2 QA journal", group="NATIVE QA", display=display.none)
int rcQaStart = input.time(timestamp("01 Oct 2026 00:00 +0000"), "QA start UTC", group="NATIVE QA", display=display.none)
int rcQaEnd = input.time(timestamp("11 Nov 2026 06:00 +0000"), "QA end UTC", group="NATIVE QA", display=display.none)
bool rcQaBar = rcQa and rcCanDrawBar and time_close >= rcQaStart and time_close <= rcQaEnd
var int rcFirstOpen = time
var int rcQaLastIndex = na
var int rcQaLastClose = na
var bool rcQaEnded = false

f_rcSide(int side) => side == 1 ? "BUY" : side == -1 ? "SELL" : ""
f_rcStage(string kind) =>
    switch kind
        "WATCH" => RC_WATCH
        "CONFIRMED" => RC_CONFIRMED
        "REJECTED" => RC_REJECTED
        "CANCELLED" => RC_INVALIDATED
        "EXPIRED" => RC_EXPIRED
        => RC_NONE
f_rcStageText(int stage) =>
    switch stage
        RC_WATCH => "WATCH"
        RC_CONFIRMED => "CONFIRMED"
        RC_READY => "READY"
        RC_REJECTED => "RISK REJECTED"
        RC_INVALIDATED => "INVALIDATED"
        RC_EXPIRED => "EXPIRED"
        => "NO SETUP"
f_rcCore(Event e) => e.strategyKey == "S5" and e.book == "CORE" and f_rcStage(e.kind) != RC_NONE
f_rcPayload(Event e, string state, Plan p, string reason) =>
    string utc = str.format_time(e.knownTime, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
    string ids = '"event_id":' + f_q(e.id + "|RC1|" + state) + ',"source_id":' + f_q(e.id)
    string context = ',"model":"S5","symbol":' + f_q(syminfo.tickerid) + ',"timeframe":' + f_q(timeframe.period)
    string decision = ',"direction":' + f_q(f_rcSide(e.side)) + ',"state":' + f_q(state) +
         ',"confirmed_ms":' + f_int(e.knownTime) + ',"confirmation_utc":' + f_q(utc)
    string levels = ',"entry":' + f_num(na(p) ? na : p.reference) + ',"sl":' + f_num(na(p) ? na : p.initialStop) +
         ',"tp1":' + f_num(na(p) ? na : p.tp1) + ',"tp2":' + f_num(na(p) ? na : p.tp2) + ',"tp3":' + f_num(na(p) ? na : p.tp3)
    "{" + ids + context + decision + levels + ',"reason":' + f_q(reason) +
         ',"provisional":' + (state == "WATCH" ? "true" : "false") + "}"

Plan rcSelected = rcCanDrawBar ? f_pick(candidates, 0, false) : na
Plan rcBarPlan = na
if not na(rcSelected)
    if rcSelected.strategyKey == "S5" and f_validPlan(rcSelected) and f_tvQtyOnGrid(1.0)
        rcBarPlan := rcSelected
Event rcPrimaryEvent = na
int rcEventRank = 0
string rcReadyPayload = ""
const string RC_READY_REASON = "Проверен S5 план при затварянето; Entry е референтна цена, следващото отваряне може да откаже входа."

if rcQaBar
    rcQaLastIndex := bar_index
    rcQaLastClose := time_close
    string ctx = "RC1_CTX|1|" + syminfo.tickerid + "|" + timeframe.period + "|" + f_int(rcFirstOpen) +
         "|" + f_int(bar_index) + "|" + f_int(time) + "|" + f_int(time_close)
    log.info(ctx + "|" + f_num(open) + "|" + f_num(high) + "|" + f_num(low) + "|" + f_num(close) +
         "|" + f_int(uiH1ClosedAt) + "|" + f_int(uiH4ClosedAt))
else if rcQa and rcCanDrawBar and not rcQaEnded and not na(rcQaLastIndex) and time_close > rcQaEnd
    rcQaEnded := true
    log.info("RC1_END|1|" + syminfo.tickerid + "|" + timeframe.period + "|" + f_int(rcQaLastIndex) + "|" + f_int(rcQaLastClose))

if rcCanDrawBar
    for e in events
        if f_rcCore(e)
            int stage = f_rcStage(e.kind)
            bool ready = stage == RC_CONFIRMED and not na(rcBarPlan) and e.planId == rcBarPlan.id
            int rank = ready ? 4 : stage == RC_CONFIRMED ? 3 : stage == RC_WATCH ? 1 : 2
            if rank > rcEventRank
                rcEventRank := rank
                rcPrimaryEvent := e
            if rcQaBar
                log.info("RC1_CORE|" + f_json(e))
            if ready
                rcReadyPayload := f_rcPayload(e, "READY", rcBarPlan, RC_READY_REASON)
                if rcQaBar
                    log.info("RC1_READY|" + rcReadyPayload)

// Independent confirmed-bar wick geometry and bounded formation lifecycle.
const int WF_ATR_BARS = 14
const int WF_FORM_BARS = 4
const int WF_WATCH_BARS = 8
const int WF_RETEST_BARS = 6
const int WF_ACTIVITY_BARS = 20
const int WF_CONTEXT_BARS = 110

bool wfSupported = syminfo.tickerid == "OANDA:XAUUSD" and chart.is_standard and
     (timeframe.period == "5" or timeframe.period == "15" or timeframe.period == "30") and syminfo.mintick > 0
bool wfConfirmed = wfSupported and barstate.isconfirmed
const bool wfAuditBar = false
int wfInterval = int(timeframe.in_seconds() * 1000)
float wfTick = syminfo.mintick

// Only completed higher-timeframe closes enter the finite EMA comparison.
f_wfHtfContext() =>
    float fast = close[WF_CONTEXT_BARS]
    float slow = fast
    if not na(fast)
        for ago = WF_CONTEXT_BARS - 1 to 1
            fast += (close[ago] - fast) * (2.0 / 22.0)
            slow += (close[ago] - slow) * (2.0 / 56.0)
    [time_close[1], close[1], fast, slow]

[wfH1Known, wfH1Close, wfH1Fast, wfH1Slow] = request.security(
     syminfo.tickerid, "60", f_wfHtfContext(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[wfH4Known, wfH4Close, wfH4Fast, wfH4Slow] = request.security(
     syminfo.tickerid, "240", f_wfHtfContext(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

f_wfHtfSide(int known, float value, float fast, float slow, int maxAge) =>
    int result = na
    if wfSupported and not na(known) and known <= time and time - known <= maxAge and
         not na(value) and not na(fast) and not na(slow)
        int c = math.round(value * 1000000.0)
        int f = math.round(fast * 1000000.0)
        int s = math.round(slow * 1000000.0)
        result := c > f and f > s ? 1 : c < f and f < s ? -1 : 0
    result

int wfH1Side = f_wfHtfSide(wfH1Known, wfH1Close, wfH1Fast, wfH1Slow, 7200000)
int wfH4Side = f_wfHtfSide(wfH4Known, wfH4Close, wfH4Fast, wfH4Slow, 28800000)
float wfTrueRange = ta.tr(true)
float wfPriorAtr = ta.sma(wfTrueRange, WF_ATR_BARS)[1]
float wfRange = high - low
float wfUpper = wfRange > 0 ? (high - math.max(open, close)) / wfRange : na
float wfLower = wfRange > 0 ? (math.min(open, close) - low) / wfRange : na
bool wfEligibleCandle = not na(wfPriorAtr) and wfPriorAtr > 0 and wfRange >= 0.50 * wfPriorAtr
bool wfBuyEvidence = wfEligibleCandle and wfLower >= 0.45 and wfUpper < 0.30
bool wfSellEvidence = wfEligibleCandle and wfUpper >= 0.45 and wfLower < 0.30
int wfBuyCount = int(math.sum(wfBuyEvidence ? 1 : 0, WF_FORM_BARS))
int wfSellCount = int(math.sum(wfSellEvidence ? 1 : 0, WF_FORM_BARS))
bool wfSequenceReady = wfPriorAtr > 0 and wfPriorAtr[1] > 0 and wfPriorAtr[2] > 0 and wfPriorAtr[3] > 0 and
     time == time_close[1] and
     time[1] == time_close[2] and time[2] == time_close[3]
float wfWindowHigh = ta.highest(high, WF_FORM_BARS)
float wfWindowLow = ta.lowest(low, WF_FORM_BARS)
float wfPriorHigh = ta.highest(high, WF_ACTIVITY_BARS)[1]
float wfPriorLow = ta.lowest(low, WF_ACTIVITY_BARS)[1]
bool wfNearSupport = bar_index >= WF_ACTIVITY_BARS and math.abs(low - wfPriorLow) <= 0.40 * wfPriorAtr
bool wfNearResistance = bar_index >= WF_ACTIVITY_BARS and math.abs(high - wfPriorHigh) <= 0.40 * wfPriorAtr
bool wfClusterNearSupport = math.sum(wfBuyEvidence and wfNearSupport ? 1 : 0, WF_FORM_BARS) > 0
bool wfClusterNearResistance = math.sum(wfSellEvidence and wfNearResistance ? 1 : 0, WF_FORM_BARS) > 0
bool wfVolumeKnown = not na(volume) and volume > 0
bool wfClusterVolume = math.sum(wfVolumeKnown ? 1 : 0, WF_FORM_BARS) == WF_FORM_BARS
float wfPriorActivity = math.sum(wfVolumeKnown ? volume : 0.0, WF_ACTIVITY_BARS)[1] / WF_ACTIVITY_BARS
float wfPriorActivityCount = math.sum(wfVolumeKnown ? 1 : 0, WF_ACTIVITY_BARS)[1]
bool wfActivityPass = wfVolumeKnown and wfPriorActivityCount == WF_ACTIVITY_BARS and
     wfPriorActivity > 0 and volume >= 1.25 * wfPriorActivity
float wfLocation = wfRange > 0 ? (close - low) / wfRange : na

// Fingerprint the finite context used by the local geometry and volume calculation.
int wfToken = (int(time / 1000) + 3 * int(time_close / 1000) + 5 * math.round(open / wfTick) +
     7 * math.round(high / wfTick) + 11 * math.round(low / wfTick) + 13 * math.round(close / wfTick) +
     (wfVolumeKnown ? 17 * int(volume % 1000000007) : 0)) % 1000000007
float wfWindowSum = math.sum(wfToken, 40)
int wfFingerprint = na(wfWindowSum) ? na : int(wfWindowSum) % 1000000007

type WickFormation
    string id
    int side
    int knownAt
    int firstRejection
    int knownIndex
    float top
    float bottom
    float sizeAtr
    bool nearLevel
    bool formationVolume
    bool probed = false
    int breakoutAt = na
    int breakoutIndex = na
    bool retested = false

f_wfNumber(float value) =>
    na(value) ? "NA" : str.tostring(value, "#.########")

f_wfInt(int value) =>
    na(value) ? "NA" : str.tostring(value)

f_wfFlag(bool value) =>
    value ? "1" : "0"

f_wfSide(int side) =>
    side == 1 ? "BUY" : side == -1 ? "SELL" : "—"

f_wfLogId(string id) =>
    str.replace_all(id, "|", ":")

f_wfEvent(string kind, WickFormation formation, int side, string reason) =>
    if wfAuditBar
        bool hasFormation = not na(formation)
        log.info("WICK_EVT|1|" + f_wfInt(time_close) + "|" + str.replace_all(kind, " ", "_") + "|" +
             (hasFormation ? f_wfLogId(formation.id) : "NA") + "|" + str.tostring(side) + "|" +
             (hasFormation ? f_wfInt(formation.knownAt) + "|" + f_wfNumber(formation.top) + "|" +
             f_wfNumber(formation.bottom) + "|" + f_wfNumber(formation.sizeAtr) + "|" +
             str.tostring(bar_index - formation.knownIndex) + "|" + str.tostring(WF_FORM_BARS) + "|" +
             f_wfFlag(formation.nearLevel) + "|" + f_wfFlag(formation.formationVolume) + "|" +
             f_wfInt(formation.breakoutAt) : "NA|NA|NA|NA|NA|NA|NA|NA|NA") + "|" + reason + "|" +
             (hasFormation ? f_wfInt(formation.firstRejection) : "NA"))

var WickFormation wfActive = na
var string wfLastClosed = "—"
var string wfState = "WAIT"
var string wfReason = ""
var int wfStateSide = 0
bool wfBuildingEvent = false
bool wfNewFormation = false
bool wfBreakout = false
bool wfNewRetest = false
bool wfFalseBreakout = false
bool wfExpired = false
bool wfProbeEvent = false
WickFormation wfEventFormation = na
bool wfWasActive = not na(wfActive)

if wfConfirmed and wfWasActive
    WickFormation formation = wfActive
    wfEventFormation := formation
    int side = formation.side
    float edge = side > 0 ? formation.top : formation.bottom
    float opposite = side > 0 ? formation.bottom : formation.top
    float extreme = side > 0 ? high : low
    float touch = side > 0 ? low : high
    float body = side * (close - open)
    float beyond = side * (close - edge)
    wfStateSide := side
    wfReason := ""
    if na(formation.breakoutAt)
        wfState := f_wfSide(side) + " WATCH"
        if bar_index - formation.knownIndex > WF_WATCH_BARS or time_close - formation.knownAt > WF_WATCH_BARS * wfInterval
            wfExpired := true
            wfReason := "BREAKOUT_WINDOW_EXPIRED"
        else if side * (close - opposite) < 0
            wfExpired := true
            wfReason := "OPPOSITE_EDGE_CLOSE"
        else if beyond >= 0.05 * wfPriorAtr and body >= 0.35 * wfPriorAtr
            wfBreakout := true
            formation.breakoutAt := time_close
            formation.breakoutIndex := bar_index
            wfState := f_wfSide(side) + " BREAKOUT CONFIRMED"
            f_wfEvent(wfState, formation, side, "DIRECTIONAL_CLOSE")
        else if not formation.probed and side * (extreme - edge) >= 0.05 * wfPriorAtr
            formation.probed := true
            wfProbeEvent := true
            wfState := "BREAKOUT PENDING"
            wfReason := side * (touch - opposite) <= -0.05 * wfPriorAtr ? "BOTH_EDGES_PROBED" :
                 beyond >= 0.05 * wfPriorAtr ? "INSUFFICIENT_CLOSE_DISPLACEMENT" : "EXTREME_WITHOUT_CLOSE"
            f_wfEvent(wfState, formation, side, wfReason)
    else
        wfState := "RETEST WATCH"
        if bar_index - formation.breakoutIndex > WF_RETEST_BARS or time_close - formation.breakoutAt > WF_RETEST_BARS * wfInterval
            wfExpired := true
            wfReason := "RETEST_WINDOW_EXPIRED"
        else if beyond <= 0
            wfFalseBreakout := true
            wfState := "FALSE BREAKOUT"
            wfReason := "CLOSE_BACK_INSIDE"
            f_wfEvent(wfState, formation, side, wfReason)
        else if not formation.retested and math.abs(touch - edge) <= 0.15 * wfPriorAtr and
             beyond >= 0.10 * wfPriorAtr and body > 0
            formation.retested := true
            wfNewRetest := true
            wfReason := "EDGE_RETEST"
    if wfExpired
        wfState := "FORMATION EXPIRED"
        f_wfEvent(wfState, formation, side, wfReason)
    if wfExpired or wfFalseBreakout
        wfLastClosed := f_wfSide(side) + " · " + (wfExpired ? "EXPIRED" : "FALSE BREAKOUT")
        wfActive := na

if wfConfirmed and not wfWasActive
    bool ambiguous = wfBuyCount > 0 and wfSellCount > 0
    int side = ambiguous ? 0 : wfBuyCount > 0 ? 1 : wfSellCount > 0 ? -1 : 0
    bool clustered = not ambiguous and math.max(wfBuyCount, wfSellCount) >= 2
    bool evidence = wfSequenceReady and (wfBuyCount > 0 or wfSellCount > 0)
    wfStateSide := side
    wfReason := ""
    if evidence and clustered and (wfWindowHigh - wfWindowLow) / wfPriorAtr <= 2.00
        bool nearLevel = side > 0 ? wfClusterNearSupport : wfClusterNearResistance
        int firstRejection = time_close
        for ago = 1 to WF_FORM_BARS - 1
            if side > 0 ? wfBuyEvidence[ago] : wfSellEvidence[ago]
                firstRejection := time_close[ago]
        wfActive := WickFormation.new("WF|" + str.tostring(side) + "|" + f_wfInt(time_close), side, time_close,
             firstRejection, bar_index, wfWindowHigh, wfWindowLow, (wfWindowHigh - wfWindowLow) / wfPriorAtr,
             nearLevel, wfClusterVolume)
        wfNewFormation := true
        wfEventFormation := wfActive
        wfState := f_wfSide(side) + " WATCH"
        f_wfEvent(wfState, wfActive, side, "WICK_CLUSTER_CONFIRMED")
    else if evidence
        wfState := "FORMATION BUILDING"
        wfReason := ambiguous ? "OPPOSING_REJECTIONS" : clustered ? "RANGE_TOO_WIDE" : "FIRST_REJECTION"
        if wfBuyEvidence or wfSellEvidence
            wfBuildingEvent := true
            f_wfEvent(wfState, na, side, wfReason)
    else
        wfState := "WAIT"
bool wfIntrabarPending = wfSupported and barstate.isrealtime and not barstate.isconfirmed and not na(wfActive) and
     na(wfActive.breakoutAt) and not wfActive.probed and
     (wfActive.side > 0 ? high >= wfActive.top + 0.05 * wfPriorAtr : low <= wfActive.bottom - 0.05 * wfPriorAtr)
string rcPreset = input.string("PREMIUM", "Изглед", options=["PREMIUM", "MINIMAL", "COMPACT", "MOBILE", "FULL AUDIT"], group="GOLD PRO RC2", display=display.none)
string rcCorner = input.string("Auto", "Място на таблото", options=["Auto", "Top right", "Top left", "Bottom right", "Bottom left"], group="GOLD PRO RC2", display=display.none)
bool rcShowWick = input.bool(true, "Wick формации", group="GOLD PRO RC2", display=display.none)
bool rcReviewEnabled = input.bool(false, "Исторически преглед", group="FULL AUDIT", display=display.none)
int rcReviewAt = input.time(timestamp("11 Nov 2026 05:40 +0000"), "Затваряне за преглед", group="FULL AUDIT", display=display.none)
bool rcReview = rcPreset == "FULL AUDIT" and rcReviewEnabled
bool rcEarlyEnabled = input.bool(false, "Experimental EARLY WATCH", group="RC2 RESEARCH",
     tooltip="Observation on a confirmed breakout through the preceding 12 bars. Never changes S5 or authorizes an entry.", display=display.none)

f_rc2TrendValue() =>
    float fast = ta.ema(close, 21)
    float slow = ta.ema(close, 55)
    na(fast[2]) or na(slow) ? na : close > fast and fast > slow and fast >= fast[2] ? 1 :
         close < fast and fast < slow and fast <= fast[2] ? -1 : 0

// The lower-frame result is consumed only when the containing chart bar has closed.
f_rc2Trend(simple string frame) =>
    int seconds = timeframe.in_seconds(frame)
    if seconds == tfSeconds
        f_rc2TrendValue()
    else if seconds > tfSeconds
        request.security(syminfo.tickerid, frame, f_rc2TrendValue()[1], lookahead=barmerge.lookahead_on)
    else
        [closing, directions] = request.security_lower_tf(syminfo.tickerid, frame, [time_close, f_rc2TrendValue()])
        int last = array.size(directions) - 1
        last >= 0 and array.get(closing, last) <= time_close ? array.get(directions, last) : na

f_rc2TrendText(int side) => na(side) ? "—" : side == 1 ? "UP" : side == -1 ? "DOWN" : "MIXED"
f_rc2Session(int utc) =>
    int h = hour(utc, "UTC")
    h < 7 ? "ASIA" : h < 13 ? "LONDON" : h < 16 ? "OVERLAP" : h < 21 ? "NEW YORK" : "OFF HOURS"

type RcContext
    int m5 = na
    int m15 = na
    int h1 = na
    int h4 = na
    string session = "—"
    string volatility = "—"
    string quality = "—"
    string early = ""

type RcDecision
    int stage = 0
    int direction = 0
    int bias = 0
    int known = na
    int closed = na
    int expiry = na
    string reason = ""
    Plan plan = na
    RcContext context = na

int rcM5ClosedTrend = f_rc2Trend("5")
int rcM15ClosedTrend = f_rc2Trend("15")
float rcEarlyHigh = ta.highest(high, 12)[1]
float rcEarlyLow = ta.lowest(low, 12)[1]
bool rcEarlyExpansion = not na(atr[1]) and barRange >= 1.15 * atr[1]
bool rcEarlyBull = rcEarlyExpansion and close > rcEarlyHigh and close - open >= 0.50 * atr[1]
bool rcEarlyBear = rcEarlyExpansion and close < rcEarlyLow and open - close >= 0.50 * atr[1]
int rcEarlySide = rcCanDrawBar and rcEarlyEnabled and not tvTimeGap ?
     (rcEarlyBull and not rcEarlyBull[1] ? 1 : rcEarlyBear and not rcEarlyBear[1] ? -1 : 0) : 0
bool rcEarlyMarker = rcEarlySide != 0
var int rcEarlyLastAt = na
var int rcEarlyLastSide = 0
if rcEarlyMarker
    rcEarlyLastAt := time_close
    rcEarlyLastSide := rcEarlySide
    if rcQaBar
        log.info("RC2_EARLY|1|" + syminfo.tickerid + "|" + timeframe.period + "|" + f_int(time_close) +
             "|" + f_rcSide(rcEarlySide) + "|" + f_num(close))

bool rc2Blocked = rcReadyPayload != "" and not f_rc2FilterPass(rcBarPlan)
if rcQaBar and rc2FilterActive and rcReadyPayload != ""
    log.info("RC2_FILTER|1|" + rcBarPlan.id + "|" + f_int(time_close) + "|" +
         (rc2Blocked ? "REJECTED" : "PASS") + "|" + f_num(barRange / rcBarPlan.atrValue))

var RcDecision rcCurrent = RcDecision.new()
var RcDecision rcArchive = RcDecision.new()
var string rcLast = ""
var bool rcReviewFound = false
int rcMarkerStage = na(rcPrimaryEvent) ? RC_NONE : rc2Blocked ? RC_REJECTED : f_rcStage(rcPrimaryEvent.kind)
int rcMarkerSide = na(rcPrimaryEvent) ? 0 : rcPrimaryEvent.side
if rcCanDrawBar
    int stage = rcReadyPayload != "" and not rc2Blocked ? RC_READY : rcMarkerStage
    int side = rcMarkerSide
    int known = na(rcPrimaryEvent) ? na : rcPrimaryEvent.knownTime
    int expiry = time_close + tfSeconds * 1000
    string reason = na(rcPrimaryEvent) ? "Няма нов потвърден S5 план." : rcPrimaryEvent.reason
    if not na(rcPrimaryEvent)
        rcLast := f_rcSide(side) + " " + f_rcStageText(stage) + " · " + str.format_time(known, "MM-dd HH:mm", "UTC") + " UTC"
    if stage == RC_NONE or stage == RC_WATCH
        TvCandidateState buyWatch = array.get(tvCandidateStates, 0)
        TvCandidateState sellWatch = array.get(tvCandidateStates, 1)
        bool watchingBuy = buyWatch.phase != 0
        bool watchingSell = sellWatch.phase != 0
        if watchingBuy or watchingSell
            stage := RC_WATCH
            side := watchingBuy == watchingSell ? 0 : watchingBuy ? 1 : -1
            known := side == 0 ? math.max(buyWatch.bornTime, sellWatch.bornTime) : side == 1 ? buyWatch.bornTime : sellWatch.bornTime
            expiry := known + 4 * tfSeconds * 1000
            reason := side == 0 ? "Двупосочно наблюдение. Изчакай потвърждение." : "Чака връщане отвъд нивото със затворена свещ."
    if stage == RC_CONFIRMED
        reason := na(rcSelected) ? "Противоположни потвърждения; няма единен план." : "Планът не премина ценовата проверка или минималното количество."
    if stage == RC_READY
        reason := RC_READY_REASON
    if rc2Blocked
        reason := RC2_FILTER_REASON
    int bias = tvH1Bias == tvH4Bias ? tvH1Bias : 0
    bool h1Available = not na(uiH1ClosedAt) and not na(uiH1Close) and not na(uiH1EMA) and not na(uiH1EarlierEMA)
    bool h4Available = not na(uiH4ClosedAt) and not na(uiH4Close) and not na(uiH4EMA) and not na(uiH4EarlierEMA)
    string quality = rc2Blocked or stage == RC_REJECTED ? "FILTERED" : stage == RC_READY or stage == RC_CONFIRMED ?
         (not h1Available or not h4Available ? "HTF DATA MISSING" :
         bias == side ? "HTF ALIGNED" : bias == -side ? "COUNTERTREND" : "HTF MIXED") :
         stage == RC_WATCH ? "OBSERVATION" : "—"
    float atrRatio = atrMean > 0 ? atr / atrMean : na
    string volatility = na(atrRatio) ? "—" : atrRatio < 0.80 ? "COMPRESSED" : atrRatio > 1.25 ? "EXPANDED" : "NORMAL"
    string early = rcEarlyEnabled and not na(rcEarlyLastAt) and time_close - rcEarlyLastAt < 2 * tfSeconds * 1000 ?
         f_rcSide(rcEarlyLastSide) + " EARLY WATCH" : ""
    RcContext context = RcContext.new(rcM5ClosedTrend, rcM15ClosedTrend,
         h1Available ? tvH1Bias : na, h4Available ? tvH4Bias : na, f_rc2Session(time_close),
         volatility, quality, early)
    rcCurrent := RcDecision.new(stage, side, bias, known, time_close, expiry, reason, stage == RC_READY ? rcBarPlan.copy() : na, context)
    if rcReview and time_close == rcReviewAt
        rcReviewFound := true
        rcArchive := rcCurrent.copy()

RcDecision rcView = rcReview ? rcArchive : rcCurrent
int rcStage = rcView.stage
int rcDirection = rcView.direction
int rcBias = rcView.bias
int rcKnownAt = rcView.known
int rcExpiresAt = rcView.expiry
string rcReason = rcView.reason
Plan rcShownPlan = rcView.plan
if not rcReview and rcStage != RC_NONE
    if timenow >= rcExpiresAt
        rcStage := rcStage == RC_READY or rcStage == RC_CONFIRMED or rcStage == RC_WATCH ? RC_EXPIRED : RC_NONE
        rcReason := "Срокът на последното събитие изтече. Изчакай ново затваряне."
    else if rcStage == RC_READY and time > rcShownPlan.signalTime
        rcStage := RC_EXPIRED
        rcReason := "Пропуснато отваряне на следващия бар."
    else if rcStage == RC_READY and not barstate.isconfirmed and bar_index > rcShownPlan.signalBar
        string openingReason = f_openRejection(rcShownPlan, open, time)
        if time != rcShownPlan.signalTime or openingReason != ""
            rcStage := RC_INVALIDATED
            rcReason := time != rcShownPlan.signalTime ? "Прекъсване преди следващото отваряне." : openingReason
if rcStage != RC_READY
    rcShownPlan := na
if not rcSupported
    rcReason := "Избери OANDA:XAUUSD, стандартни свещи, M5, M15 или M30."
else if rcReview and not rcReviewFound
    rcReason := "Избери точния UTC час на затварянето в заредената история."
else if na(rcView.closed)
    rcReason := "Изчаква се затворена свещ."
string rcMarket = not rcSupported or na(rcView.context) ? "—" :
     na(rcView.context.h4) ? "H4 DATA MISSING" : na(rcView.context.h1) ? "H1 DATA MISSING" :
     rcBias == 1 ? "BULLISH" : rcBias == -1 ? "BEARISH" : "MIXED"
string rcModel = rc2FilterActive ? "S5 / RC2 EXP" : "S5"
string rcStatus = (rcStage == RC_READY or rcStage == RC_CONFIRMED or rcStage == RC_WATCH) and rcDirection != 0 ?
     f_rcSide(rcDirection) + " " + f_rcStageText(rcStage) : f_rcStageText(rcStage)
string rcAction = rcStage == RC_READY ? (rcReview ? "PLAN REVIEW" : rcStatus) : "WAIT"
string rcTrendM5 = na(rcView.context) ? "—" : f_rc2TrendText(rcView.context.m5)
string rcTrendM15 = na(rcView.context) ? "—" : f_rc2TrendText(rcView.context.m15)
string rcTrendH1 = na(rcView.context) or na(rcView.context.h1) ? "DATA MISSING" : f_rc2TrendText(rcView.context.h1)
string rcTrendH4 = na(rcView.context) or na(rcView.context.h4) ? "DATA MISSING" : f_rc2TrendText(rcView.context.h4)
string rcSession = na(rcView.context) ? "—" : rcView.context.session
string rcVolatility = na(rcView.context) ? "—" : rcView.context.volatility
string rcQuality = na(rcView.context) or rcStage == RC_NONE or rcStage == RC_EXPIRED or rcStage == RC_INVALIDATED ? "—" : rcView.context.quality
string rcEarlyObservation = na(rcView.context) or (not rcReview and not na(rcEarlyLastAt) and timenow >= rcEarlyLastAt + 2 * tfSeconds * 1000) ?
     "" : rcView.context.early

int rcWickKnownAt = na(wfActive) ? na : wfActive.knownAt
int rcWickSide = na(wfActive) ? 0 : wfActive.side
float rcWickTop = na(wfActive) ? na : wfActive.top
float rcWickBottom = na(wfActive) ? na : wfActive.bottom
int rcWickAt = rcCurrent.closed
int rcWickExpiry = na(wfActive) ? na : na(wfActive.breakoutAt) ?
     wfActive.knownAt + WF_WATCH_BARS * wfInterval : wfActive.breakoutAt + WF_RETEST_BARS * wfInterval
bool rcWickVisible = rcSupported and not rcReview and not na(rcWickExpiry) and timenow < rcWickExpiry
string rcWick = rcWickVisible ? wfState : ""

// Display-only experimental proxy. It never feeds RC2 decisions or alerts.
const string RC_PRESSURE_GROUP = "PRESSURE METER · EXPERIMENTAL"
bool rcPressureShow = input.bool(true, "Покажи BUY / SELL Pressure", group=RC_PRESSURE_GROUP,
     tooltip="OHLC proxy за положението на цената на затваряне. Не измерва потока на поръчките.", display=display.none)
int rcPressureLookback = input.int(10, "Затворени свещи", minval=1, maxval=100,
     group=RC_PRESSURE_GROUP, display=display.none)
bool rcPressureWeighted = input.bool(false, "Тегла по tick volume", group=RC_PRESSURE_GROUP,
     tooltip="При липса на валиден tick volume целият прозорец се изчислява без тегла.", display=display.none)
bool rcPressureCompare = input.bool(false, "Сравни M5 / M15 / H1", group=RC_PRESSURE_GROUP,
     tooltip="Сравнява последните налични потвърдени стойности от всеки интервал.", display=display.none)
bool rcPressureQa = input.bool(false, "Export pressure QA journal", group="NATIVE QA",
     tooltip="Използва същите начална и крайна UTC дата. За сурови H1 данни избери H1.", display=display.none)

const int RC_PRESSURE_ABSENT = 0
const int RC_PRESSURE_WARMUP = 1
const int RC_PRESSURE_INVALID_OHLC = 2
const int RC_PRESSURE_OHLC = 3
const int RC_PRESSURE_TICK = 4
const int RC_PRESSURE_NON_TICK = 5
const int RC_PRESSURE_INVALID_VOLUME = 6
const int RC_PRESSURE_ZERO_VOLUME = 7

type RcPressureReading
    float buy = na
    int closed = na
    string mode = "UNAVAILABLE"
    string reason = "SOURCE_UNAVAILABLE"

type RcPressureSnapshot
    RcPressureReading main
    RcPressureReading m5
    RcPressureReading m15
    RcPressureReading h1

f_rcPressureRaw() =>
    bool validOhlc = not na(open) and not na(high) and not na(low) and not na(close) and
         high >= low and open >= low and open <= high and close >= low and close <= high
    bool validVolume = not na(volume) and volume >= 0
    // Use non-na rolling inputs so math.sum never skips a bar in a window.
    float fraction = validOhlc and high > low ? (close - low) / (high - low) : 0.5
    float weight = validVolume ? volume : 0.0
    float unweighted = math.sum(fraction, rcPressureLookback)
    float weighted = math.sum(fraction * weight, rcPressureLookback)
    float totalWeight = math.sum(weight, rcPressureLookback)
    float invalidOhlcCount = math.sum(validOhlc ? 0 : 1, rcPressureLookback)
    float invalidVolumeCount = math.sum(validVolume ? 0 : 1, rcPressureLookback)
    int state = switch
        bar_index + 1 < rcPressureLookback or na(unweighted) => RC_PRESSURE_WARMUP
        invalidOhlcCount > 0 => RC_PRESSURE_INVALID_OHLC
        not rcPressureWeighted => RC_PRESSURE_OHLC
        syminfo.volumetype != "tick" => RC_PRESSURE_NON_TICK
        invalidVolumeCount > 0 => RC_PRESSURE_INVALID_VOLUME
        totalWeight <= 0 => RC_PRESSURE_ZERO_VOLUME
        => RC_PRESSURE_TICK
    float buy = state >= RC_PRESSURE_OHLC ?
         100.0 * math.max(0.0, math.min(1.0, state == RC_PRESSURE_TICK ? weighted / totalWeight : unweighted / rcPressureLookback)) : na
    [time_close, buy, state]

f_rcPressurePrevious() =>
    [stamp, buy, state] = f_rcPressureRaw()
    [stamp[1], buy[1], state[1]]

f_rcPressureFrame(simple string frame, int localClosed, float localBuy, int localState) =>
    int seconds = timeframe.in_seconds(frame)
    if not rcPressureCompare or not rcSupported or not chart.is_standard
        [int(na), float(na), RC_PRESSURE_ABSENT]
    else if seconds == tfSeconds
        [localClosed, localBuy, localState]
    else if seconds > tfSeconds
        // Offset the whole source result. Its bar was closed at the chart bar's open.
        [stamp, buy, state] = request.security(syminfo.tickerid, frame, f_rcPressurePrevious(),
             lookahead=barmerge.lookahead_on)
        bool valid = not na(stamp) and stamp <= time
        [valid ? stamp : na, valid ? buy : na, valid ? state : RC_PRESSURE_ABSENT]
    else
        [stamps, buyers, states] = request.security_lower_tf(syminfo.tickerid, frame, f_rcPressureRaw())
        int last = array.size(stamps) - 1
        while last >= 0 and (na(array.get(stamps, last)) or array.get(stamps, last) > time_close)
            last -= 1
        [last >= 0 ? array.get(stamps, last) : na, last >= 0 ? array.get(buyers, last) : na,
             last >= 0 ? array.get(states, last) : RC_PRESSURE_ABSENT]

f_rcPressureReading(int stamp, float buy, int state) =>
    string mode = switch
        state == RC_PRESSURE_WARMUP => "WARMUP"
        state == RC_PRESSURE_OHLC => "OHLC"
        state == RC_PRESSURE_TICK => "TICK"
        state >= RC_PRESSURE_NON_TICK => "FALLBACK"
        => "UNAVAILABLE"
    string reason = switch state
        RC_PRESSURE_WARMUP => "INSUFFICIENT_HISTORY"
        RC_PRESSURE_INVALID_OHLC => "INVALID_OHLC"
        RC_PRESSURE_OHLC => "OHLC_SELECTED"
        RC_PRESSURE_TICK => "TICK_WEIGHTED"
        RC_PRESSURE_NON_TICK => "NON_TICK_SOURCE"
        RC_PRESSURE_INVALID_VOLUME => "INVALID_TICK_VOLUME"
        RC_PRESSURE_ZERO_VOLUME => "ZERO_TICK_VOLUME"
        => "SOURCE_UNAVAILABLE"
    RcPressureReading.new(buy, stamp, mode, reason)

f_rcPressureNum(float value) => na(value) ? "null" : str.tostring(value, "0.########")

f_rcPressureLog(simple string frame, RcPressureReading reading) =>
    int seconds = timeframe.in_seconds(frame)
    string relation = seconds == tfSeconds ? "LOCAL" : seconds > tfSeconds ? "HTF" : "LTF"
    log.info('PR_SAMPLE|{"chart":' + f_q(timeframe.period) + ',"frame":' + f_q(frame) +
         ',"index":' + f_int(bar_index) + ',"decision_ms":' + f_int(time_close) + ',"chart_open_ms":' + f_int(time) +
         ',"source_ms":' + f_int(reading.closed) + ',"buy":' + f_rcPressureNum(reading.buy) +
         ',"sell":' + f_rcPressureNum(100.0 - reading.buy) +
         ',"mode":' + f_q(reading.mode) + ',"reason":' + f_q(reading.reason) + ',"lookback":' + f_int(rcPressureLookback) +
         ',"weighted":' + (rcPressureWeighted ? "true" : "false") + ',"comparison":' + (rcPressureCompare ? "true" : "false") +
         ',"relation":' + f_q(relation) + '}')

[rcPressureBarClosed, rcPressureBarBuy, rcPressureBarState] = f_rcPressureRaw()
[rcPressureM5Closed, rcPressureM5Buy, rcPressureM5State] =
     f_rcPressureFrame("5", rcPressureBarClosed, rcPressureBarBuy, rcPressureBarState)
[rcPressureM15Closed, rcPressureM15Buy, rcPressureM15State] =
     f_rcPressureFrame("15", rcPressureBarClosed, rcPressureBarBuy, rcPressureBarState)
[rcPressureH1Closed, rcPressureH1Buy, rcPressureH1State] =
     f_rcPressureFrame("60", rcPressureBarClosed, rcPressureBarBuy, rcPressureBarState)

var RcPressureReading rcPressureEmpty = RcPressureReading.new()
var RcPressureSnapshot rcPressureCurrent = RcPressureSnapshot.new(rcPressureEmpty, rcPressureEmpty, rcPressureEmpty, rcPressureEmpty)
var RcPressureSnapshot rcPressureArchive = rcPressureCurrent
bool rcPressureQaChart = rcPressureQa and syminfo.tickerid == "OANDA:XAUUSD" and chart.is_standard and
     (rcSupported or tfSeconds == 3600)
bool rcPressureQaBar = rcPressureQaChart and barstate.isconfirmed and time_close >= rcQaStart and time_close <= rcQaEnd
var int rcPressureQaLastIndex = na
var int rcPressureQaLastClose = na
var bool rcPressureQaEnded = false
if rcPressureQaBar
    rcPressureQaLastIndex := bar_index
    rcPressureQaLastClose := time_close
    log.info('PR_CTX|{"symbol":' + f_q(syminfo.tickerid) + ',"timeframe":' + f_q(timeframe.period) +
         ',"index":' + f_int(bar_index) + ',"first_open_ms":' + f_int(rcFirstOpen) +
         ',"open_ms":' + f_int(time) + ',"close_ms":' + f_int(time_close) + ',"open":' + f_rcPressureNum(open) +
         ',"high":' + f_rcPressureNum(high) + ',"low":' + f_rcPressureNum(low) + ',"close":' + f_rcPressureNum(close) +
         ',"volume":' + f_rcPressureNum(volume) + ',"volume_type":' + f_q(syminfo.volumetype) + '}')
else if rcPressureQaChart and barstate.isconfirmed and not rcPressureQaEnded and not na(rcPressureQaLastIndex) and time_close > rcQaEnd
    rcPressureQaEnded := true
    log.info('PR_END|{"symbol":' + f_q(syminfo.tickerid) + ',"timeframe":' + f_q(timeframe.period) +
         ',"index":' + f_int(rcPressureQaLastIndex) + ',"close_ms":' + f_int(rcPressureQaLastClose) + '}')

if rcCanDrawBar and chart.is_standard and (rcPressureShow or rcPressureQaBar)
    RcPressureReading main = f_rcPressureReading(rcPressureBarClosed, rcPressureBarBuy, rcPressureBarState)
    RcPressureReading m5 = rcPressureCompare ? f_rcPressureReading(rcPressureM5Closed, rcPressureM5Buy, rcPressureM5State) : rcPressureEmpty
    RcPressureReading m15 = rcPressureCompare ? f_rcPressureReading(rcPressureM15Closed, rcPressureM15Buy, rcPressureM15State) : rcPressureEmpty
    RcPressureReading h1 = rcPressureCompare ? f_rcPressureReading(rcPressureH1Closed, rcPressureH1Buy, rcPressureH1State) : rcPressureEmpty
    rcPressureCurrent := RcPressureSnapshot.new(main, m5, m15, h1)
    // Each snapshot is immutable so review stays fixed as new bars arrive.
    if rcReview and time_close == rcReviewAt
        rcPressureArchive := rcPressureCurrent
    if rcPressureQaBar
        f_rcPressureLog(timeframe.period, main)
        if rcPressureCompare
            if tfSeconds != 300
                f_rcPressureLog("5", m5)
            if tfSeconds != 900
                f_rcPressureLog("15", m15)
            f_rcPressureLog("60", h1)

RcPressureSnapshot rcPressureSnapshot = rcReview ? rcPressureArchive : rcPressureCurrent
RcPressureReading rcPressureView = rcPressureSnapshot.main
RcPressureReading rcPressureViewM5 = rcPressureSnapshot.m5
RcPressureReading rcPressureViewM15 = rcPressureSnapshot.m15
RcPressureReading rcPressureViewH1 = rcPressureSnapshot.h1

// Direct Trend Breakout observational probe. Keep these rules aligned with the Python research scan.
const string DT_GROUP = "DIRECT TREND BREAKOUT · SHADOW"
const string DT_STRUCTURAL = "STRUCTURAL_BREAK"
const string DT_CONSOLIDATION = "CONSOLIDATION_BREAK"
const string DT_RETEST = "RETEST_CONTINUATION"
bool dtShow = input.bool(true, "Покажи наблюдение", group=DT_GROUP, display=display.none)
bool dtQa = input.bool(false, "Export Direct Trend Breakout QA journal", group=DT_GROUP, display=display.none)

type DtPivot
    float price
    int sourceMs
    int knownMs

type DtSetup
    string model
    int side
    float level
    int levelKnownMs
    int sourceMs
    int firstBar
    int firstMs
    int breakoutMs = na
    string originModel = ""

type DtGeometry
    string planId
    float stop
    float risk
    float riskCash
    float extension
    float frictionR
    float room
    float obstacle
    float tp1
    float tp2
    float tp3
    string reasons

type DtObservation
    string state = "—"
    int side = 0
    int knownMs = na
    string reason = ""
    float level = na
    int rank = 0

var array<DtPivot> dtHighs = array.new<DtPivot>()
var array<DtPivot> dtLows = array.new<DtPivot>()
var array<DtSetup> dtWatches = array.new<DtSetup>(4, na)
var array<DtSetup> dtRetests = array.new<DtSetup>(2, na)
var map<string, bool> dtConsumed = map.new<string, bool>()
var array<DtObservation> dtObservation = array.new<DtObservation>(1, DtObservation.new())
var int dtSegment = 0
var float dtEma = na
float dtEmaSeed = ta.sma(close, 20)
dtEma := na(dtEma[1]) ? dtEmaSeed : dtEma[1] + (2.0 / 21.0) * (close - dtEma[1])
float dtPriorAtr = ta.rma(ta.tr(true), 14)[1]
int dtMinutes = timeframe.isminutes ? timeframe.multiplier : 0
bool dtSupported = syminfo.tickerid == "OANDA:XAUUSD" and chart.is_standard and
     (dtMinutes == 5 or dtMinutes == 15 or dtMinutes == 30)

f_dtNumber(float value) =>
    na(value) ? "null" : str.tostring(value, "0.#########")

f_dtInt(int value) =>
    na(value) ? "null" : str.tostring(value)

f_dtString(string value) =>
    value == "" ? "null" : '"' + value + '"'

f_dtIdentity(DtSetup setup) =>
    setup.model + "|" + str.tostring(setup.side) + "|" + str.tostring(setup.sourceMs) + "|" + f_dtNumber(setup.level)

f_dtReasons(string reasons) =>
    reasons == "" ? "[]" : '["' + str.replace_all(reasons, "|", '","') + '"]'

f_dtAddReason(string reasons, string reason) =>
    reasons == "" ? reason : reasons + "|" + reason

f_dtRoundAway(float price, int side) =>
    float scale = price / .001
    float rounded = side == 1 ? math.ceil(scale - .00000001) : math.floor(scale + .00000001)
    math.round(rounded * 1000000.0) / 1000000000.0

// Read-only display observer. The shadow engine retains ownership of all lifecycle decisions.
type DvSignal
    string source = ""
    string model = ""
    int side = 0
    int rank = 0
    int known = na
    int expiry = na
    string reason = ""
    bool research = false
    int originTime = na
    float level = na

type DvView
    DvSignal shadowBuy
    DvSignal shadowSell
    DvSignal s5Buy
    DvSignal s5Sell
    DvSignal early
    int asOf = na
    int closed = na
    bool review = false
    int bias = 0

var array<DvSignal> dvShadowBreaks = array.new<DvSignal>(6, na)

f_dvShadowSource(string model) =>
    switch model
        DT_STRUCTURAL => "DT STRUCTURE"
        DT_CONSOLIDATION => "DT CONSOLIDATION"
        => "DT RETEST"

f_dvBreakIndex(int side, string model) =>
    (side == 1 ? 0 : 3) + (model == DT_RETEST ? 0 : model == DT_STRUCTURAL ? 1 : 2)

f_dvShadowEvent(DtSetup setup, string state, string reason) =>
    int slot = f_dvBreakIndex(setup.side, setup.model)
    if state == "BREAKOUT CONFIRMED"
        DvSignal signal = DvSignal.new(f_dvShadowSource(setup.model), setup.model, setup.side, 2,
             time_close, time_close + tfSeconds * 1000, reason, false, setup.sourceMs, setup.level)
        array.set(dvShadowBreaks, slot, signal)
    else if state == "ENTRY CANDIDATE" or state == "REJECTED"
        DvSignal signal = array.get(dvShadowBreaks, slot)
        if not na(signal) and signal.known == time_close and signal.originTime == setup.sourceMs and signal.level == setup.level
            if state == "ENTRY CANDIDATE"
                signal.research := true
                signal.reason := signal.reason + " · RESEARCH ENTRY CANDIDATE"
            else
                signal.reason := signal.reason + " · RESEARCH REJECTED: " + reason
    true


f_dtRank(string state) =>
    switch state
        "ENTRY CANDIDATE" => 6
        "REJECTED" => 5
        "BREAKOUT CONFIRMED" => 4
        "RETEST WATCH" => 3
        "WATCH" => 2
        => 1

f_dtEmit(DtSetup setup, string state, string reason, DtGeometry geometry=na, string extraReasons="") =>
    f_dvShadowEvent(setup, state, reason)
    DtObservation latest = array.get(dtObservation, 0)
    int rank = f_dtRank(state)
    if na(latest.knownMs) or latest.knownMs < time_close or (latest.knownMs == time_close and rank > latest.rank)
        array.set(dtObservation, 0, DtObservation.new(state, setup.side, time_close, reason, setup.level, rank))
    if dtQa
        string details = ""
        if not na(geometry)
            string targets = na(geometry.tp1) ? "[]" : "[" + f_dtNumber(geometry.tp1) + "," +
                 f_dtNumber(geometry.tp2) + "," + f_dtNumber(geometry.tp3) + "]"
            details := ',"plan_id":' + f_dtString(geometry.planId) + ',"reference":' + f_dtNumber(close) +
                 ',"stop":' + f_dtNumber(geometry.stop) + ',"targets":' + targets + ',"risk":' + f_dtNumber(geometry.risk) +
                 ',"risk_cash":' + f_dtNumber(geometry.riskCash) + ',"extension_atr":' + f_dtNumber(geometry.extension) +
                 ',"friction_r":' + f_dtNumber(geometry.frictionR) + ',"net_room_r":' + f_dtNumber(geometry.room) +
                 ',"obstacle":' + f_dtNumber(geometry.obstacle) + ',"reasons":' + f_dtReasons(geometry.reasons)
        else if extraReasons != ""
            details := ',"reasons":' + f_dtReasons(extraReasons)
        log.info('DT_SHADOW|{"time_ms":' + f_dtInt(time_close) + ',"bar":' + f_dtInt(bar_index) +
             ',"side":' + f_dtInt(setup.side) + ',"model":' + f_dtString(setup.model) + ',"state":' + f_dtString(state) +
             ',"reason":' + f_dtString(reason) + ',"level":' + f_dtNumber(setup.level) +
             ',"level_known_ms":' + f_dtInt(setup.levelKnownMs) + ',"source_ms":' + f_dtInt(setup.sourceMs) +
             ',"watch_ms":' + f_dtInt(setup.firstMs) + ',"breakout_ms":' + f_dtInt(setup.breakoutMs) +
             ',"origin_model":' + f_dtString(setup.originModel) + ',"prior_atr":' + f_dtNumber(dtPriorAtr) +
             ',"close":' + f_dtNumber(close) + details + '}')
    true

f_dtGeometry(DtSetup setup, bool alreadyClaimed) =>
    int side = setup.side
    int anchorBars = setup.model == DT_STRUCTURAL ? 3 : setup.model == DT_CONSOLIDATION ? 5 : 2
    float stopBase = side == 1 ? low : high
    for offset = 0 to math.min(anchorBars, dtSegment) - 1
        stopBase := side == 1 ? math.min(stopBase, low[offset]) : math.max(stopBase, high[offset])
    float stop = f_dtRoundAway(stopBase - side * .10 * dtPriorAtr, -side)
    float risk = math.round(side * (close - stop) * 1000000000.0) / 1000000000.0
    float extension = math.max(0.0, side * (close - setup.level) / dtPriorAtr)
    const float friction = .704
    array<DtPivot> obstacles = side == 1 ? dtHighs : dtLows
    float remaining = na
    for pivot in obstacles
        float roomToPivot = side * (pivot.price - close)
        if roomToPivot > 0
            remaining := na(remaining) ? roomToPivot : math.min(remaining, roomToPivot)
    float room = risk > 0 ? ((na(remaining) ? risk : math.min(risk, remaining)) - friction) / risk : na
    float riskCash = (risk + friction) * 3
    string reasons = ""
    if risk < math.max(.001, .25 * dtPriorAtr)
        reasons := f_dtAddReason(reasons, "STOP_TOO_SMALL")
    if risk > 2.50 * dtPriorAtr
        reasons := f_dtAddReason(reasons, "STOP_TOO_WIDE")
    if extension > 1.00
        reasons := f_dtAddReason(reasons, "LATE_EXTENSION")
    if risk > 0 and friction > .30 * risk
        reasons := f_dtAddReason(reasons, "COST_TOO_HIGH")
    if not na(room) and room < .70
        reasons := f_dtAddReason(reasons, "INSUFFICIENT_NET_ROOM")
    if riskCash > 250.0
        reasons := f_dtAddReason(reasons, "CASH_RISK_LIMIT")
    if reasons == "" and alreadyClaimed
        reasons := "OVERLAP_SAME_BAR"
    float tp1 = risk > 0 ? f_dtRoundAway(close + side * risk, side) : na
    float tp2 = risk > 0 ? f_dtRoundAway(close + side * 2 * risk, side) : na
    float tp3 = risk > 0 ? f_dtRoundAway(close + side * 3 * risk, side) : na
    string id = "DT|" + setup.model + "|" + str.tostring(side) + "|" + str.tostring(time_close)
    DtGeometry geometry = DtGeometry.new(id, stop, risk, riskCash, extension, risk > 0 ? friction / risk : na,
         room, na(remaining) ? na : close + side * remaining, tp1, tp2, tp3, reasons)
    bool valid = reasons == ""
    string firstReason = valid ? "DIAGNOSTIC_ONLY" : array.get(str.split(reasons, "|"), 0)
    f_dtEmit(setup, valid ? "ENTRY CANDIDATE" : "REJECTED", firstReason, geometry)
    valid

f_dtOffer(string model, int side) =>
    DtSetup result = na
    if model == DT_STRUCTURAL
        array<DtPivot> defended = side == 1 ? dtHighs : dtLows
        array<DtPivot> directional = side == 1 ? dtLows : dtHighs
        int size = array.size(directional)
        if array.size(defended) > 0 and size >= 2
            DtPivot last = array.get(directional, size - 1)
            DtPivot previous = array.get(directional, size - 2)
            if side * (last.price - previous.price) > 0
                DtPivot pivot = array.last(defended)
                result := DtSetup.new(model, side, pivot.price, pivot.knownMs, pivot.sourceMs, bar_index, time_close)
    else if dtSegment > 4 and not na(dtEma[4])
        if math.min(side * (close[1] - dtEma[1]), side * (dtEma[1] - dtEma[4])) > 0
            float boxHigh = high[4]
            float boxLow = low[4]
            int highSource = time[4]
            int lowSource = time[4]
            int offset = 3
            while offset >= 1
                if high[offset] > boxHigh
                    boxHigh := high[offset]
                    highSource := time[offset]
                if low[offset] < boxLow
                    boxLow := low[offset]
                    lowSource := time[offset]
                offset -= 1
            if boxHigh - boxLow <= 1.50 * dtPriorAtr
                result := DtSetup.new(model, side, side == 1 ? boxHigh : boxLow, time_close[1],
                     side == 1 ? highSource : lowSource, bar_index, time_close)
    result

f_dtExpired(DtSetup setup) =>
    bar_index - setup.firstBar > 6 or time_close - setup.firstMs > 6 * (time_close - time)

f_dtRemember(array<DtPivot> pivots, float price) =>
    array.push(pivots, DtPivot.new(price, time[2], time_close))
    if array.size(pivots) > 8
        array.shift(pivots)
    true

if barstate.isconfirmed and dtSupported and (dtShow or dtQa)
    dtSegment := na(time_close[1]) or time != time_close[1] ? 1 : dtSegment + 1
    if dtQa
        log.info('DT_MARKET|{"symbol":' + f_dtString(syminfo.tickerid) + ',"timeframe":' + f_dtInt(dtMinutes) +
             ',"index":' + f_dtInt(bar_index) + ',"time":' + f_dtInt(time) + ',"time_close":' + f_dtInt(time_close) +
             ',"open":' + f_dtNumber(open) + ',"high":' + f_dtNumber(high) + ',"low":' + f_dtNumber(low) +
             ',"close":' + f_dtNumber(close) + '}')
    if not na(dtPriorAtr) and dtPriorAtr > 0 and not na(close[1])
        for sideSlot = 0 to 1
            int side = sideSlot == 0 ? 1 : -1
            bool claimed = false
            DtSetup retest = array.get(dtRetests, sideSlot)
            if not na(retest)
                if dtSegment == 1 or f_dtExpired(retest)
                    f_dtEmit(retest, "EXPIRED", dtSegment == 1 ? "DATA_GAP" : "RETEST_WINDOW_EXPIRED")
                    array.set(dtRetests, sideSlot, na)
                else if side * (close - retest.level) < -.10 * dtPriorAtr
                    f_dtEmit(retest, "INVALIDATED", "CLOSE_BACK_THROUGH_BREAK_LEVEL")
                    array.set(dtRetests, sideSlot, na)
                else if (math.abs((side == 1 ? low : high) - retest.level) <= .20 * dtPriorAtr and
                     side * (close - retest.level) >= .10 * dtPriorAtr and side * (close - open) >= .15 * dtPriorAtr)
                    f_dtEmit(retest, "BREAKOUT CONFIRMED", "RETEST_CONFIRMED")
                    claimed := f_dtGeometry(retest, false)
                    array.set(dtRetests, sideSlot, na)

            for modelSlot = 0 to 1
                string model = modelSlot == 0 ? DT_STRUCTURAL : DT_CONSOLIDATION
                int slot = sideSlot * 2 + modelSlot
                DtSetup setup = dtSegment > 1 ? f_dtOffer(model, side) : na
                DtSetup watch = array.get(dtWatches, slot)
                if not na(watch)
                    bool expired = dtSegment == 1 or f_dtExpired(watch)
                    bool changed = na(setup) or f_dtIdentity(setup) != f_dtIdentity(watch)
                    if expired or changed
                        string reason = expired ? (dtSegment == 1 ? "DATA_GAP" : "WATCH_WINDOW_EXPIRED") : "STRUCTURE_CHANGED"
                        f_dtEmit(watch, expired ? "EXPIRED" : "INVALIDATED", reason)
                        map.put(dtConsumed, f_dtIdentity(watch), true)
                        array.set(dtWatches, slot, na)
                        watch := na
                if not na(setup) and not map.contains(dtConsumed, f_dtIdentity(setup))
                    float proximity = side * (setup.level - close)
                    bool approaching = proximity >= 0 and proximity <= .30 * dtPriorAtr and side * (close - close[1]) > 0
                    bool crossed = side * (close[1] - setup.level) <= .05 * dtPriorAtr and
                         .05 * dtPriorAtr < side * (close - setup.level)
                    float favorableWick = side == 1 ? high - close : close - low
                    bool displacement = side * (close - open) >= .50 * dtPriorAtr and favorableWick <= .35 * (high - low)
                    if na(watch) and (approaching or (crossed and displacement))
                        watch := setup
                        array.set(dtWatches, slot, watch)
                        f_dtEmit(watch, "WATCH", approaching ? "APPROACHING_LEVEL" : "FIRST_OBSERVED_ON_BREAK")
                    if crossed
                        if not displacement
                            f_dtEmit(na(watch) ? setup : watch, "REJECTED", "INSUFFICIENT_DISPLACEMENT", na, "INSUFFICIENT_DISPLACEMENT")
                        else
                            DtSetup confirmed = watch.copy()
                            confirmed.breakoutMs := time_close
                            f_dtEmit(confirmed, "BREAKOUT CONFIRMED", "CONFIRMED_CLOSE_CROSS")
                            bool valid = f_dtGeometry(confirmed, claimed)
                            claimed := claimed or valid
                            map.put(dtConsumed, f_dtIdentity(confirmed), true)
                            array.set(dtWatches, slot, na)
                            if na(array.get(dtRetests, sideSlot))
                                DtSetup newRetest = confirmed.copy()
                                newRetest.model := DT_RETEST
                                newRetest.firstBar := bar_index
                                newRetest.firstMs := time_close
                                newRetest.originModel := model
                                array.set(dtRetests, sideSlot, newRetest)
                                f_dtEmit(newRetest, "RETEST WATCH", "CONFIRMED_BREAK_LEVEL")
    if dtSegment > 4
        if high[2] > high[4] and high[2] > high[3] and high[2] > high[1] and high[2] > high
            f_dtRemember(dtHighs, high[2])
        if low[2] < low[4] and low[2] < low[3] and low[2] < low[1] and low[2] < low
            f_dtRemember(dtLows, low[2])
    if dtQa and barstate.islastconfirmedhistory
        log.info('DT_END|{"index":' + f_dtInt(bar_index) + ',"time_close":' + f_dtInt(time_close) + '}')

DtObservation dtCurrent = array.get(dtObservation, 0)
string dtShadowState = dtCurrent.state
int dtShadowSide = dtCurrent.side
int dtShadowKnownMs = dtCurrent.knownMs
string dtShadowReason = dtCurrent.reason
float dtShadowLevel = dtCurrent.level

// DIRECTIONAL VISIBILITY SNAPSHOT
f_dvEmptyView(int asOf, bool review) =>
    DvView.new(DvSignal.new(), DvSignal.new(), DvSignal.new(), DvSignal.new(), DvSignal.new(), asOf, na, review)

f_dvActive(DvSignal signal, int stamp) =>
    not na(signal) and not na(stamp) and signal.rank > 0 and signal.known <= stamp and stamp < signal.expiry

f_dvFresh(DvSignal signal, int stamp) =>
    f_dvActive(signal, stamp) ? signal : DvSignal.new()

f_dvShadowAtClose(int side) =>
    int sideSlot = side == 1 ? 0 : 1
    DtSetup retest = array.get(dtRetests, sideSlot)
    DvSignal best = DvSignal.new()
    for offset = 0 to 2
        int slot = sideSlot * 3 + offset
        DvSignal breakout = array.get(dvShadowBreaks, slot)
        if not na(breakout)
            // Once the original retest closes, invalidates or expires, its origin
            // ceases to be active. A fresh confirmation without a linked retest
            // is visible for its own confirmed-bar snapshot.
            bool linked = not na(retest) and retest.originModel == breakout.model and
                 retest.breakoutMs == breakout.known and retest.sourceMs == breakout.originTime and
                 retest.level == breakout.level
            if linked or breakout.known == time_close
                if best.rank == 0 or breakout.known > best.known
                    best := breakout.copy()
                    if linked
                        // The existing expiry rule is age > 6, so the seventh
                        // close is the first excluded timestamp.
                        best.expiry := retest.firstMs + 7 * tfSeconds * 1000
            else
                array.set(dvShadowBreaks, slot, na)
    if best.rank == 0
        for offset = 0 to 1
            DtSetup watch = array.get(dtWatches, sideSlot * 2 + offset)
            if not na(watch) and (best.rank == 0 or watch.firstMs > best.known)
                best := DvSignal.new(f_dvShadowSource(watch.model), watch.model, side, 1, watch.firstMs,
                     watch.firstMs + 7 * tfSeconds * 1000, "APPROACHING_LEVEL", false, watch.sourceMs, watch.level)
    f_dvFresh(best, time_close)

f_dvS5AtClose(int side) =>
    DvSignal signal = DvSignal.new()
    if tvStrategyMode == "S5"
        TvCandidateState watch = array.get(tvCandidateStates, side == 1 ? 0 : 1)
        if watch.phase != 0
            signal := DvSignal.new("S5", "S5_RECLAIM", side, 1, watch.bornTime,
                 watch.bornTime + 4 * tfSeconds * 1000, "Противоположен пробив; чака връщане отвъд нивото")
    f_dvFresh(signal, time_close)

f_dvEarlyAtClose() =>
    DvSignal signal = DvSignal.new()
    if rcEarlyEnabled and not na(rcEarlyLastAt) and rcEarlyLastSide != 0
        signal := DvSignal.new("RC2 EARLY WATCH", "RC2_EARLY_WATCH", rcEarlyLastSide, 1, rcEarlyLastAt,
             rcEarlyLastAt + 2 * tfSeconds * 1000, "Затворена свещ отвъд предходния 12-баров диапазон")
    f_dvFresh(signal, time_close)

f_dvFreshView(DvView view, int stamp) =>
    DvView.new(f_dvFresh(view.shadowBuy, stamp), f_dvFresh(view.shadowSell, stamp),
         f_dvFresh(view.s5Buy, stamp), f_dvFresh(view.s5Sell, stamp), f_dvFresh(view.early, stamp),
         stamp, view.closed, view.review, view.bias)

f_dvSignalJson(DvSignal signal) =>
    signal.rank == 0 ? "null" : '{"source":' + f_q(signal.source) + ',"model":' + f_q(signal.model) +
         ',"side":' + f_int(signal.side) + ',"stage":' + f_q(signal.rank == 2 ? "BREAKOUT CONFIRMED" : "WATCH") +
         ',"known_ms":' + f_int(signal.known) + ',"expires_ms":' + f_int(signal.expiry) +
         ',"reason":' + f_q(signal.reason) + ',"research":' + (signal.research ? "true" : "false") + '}'

f_dvSignalsJson(DvView view) =>
    array<string> signals = array.new<string>()
    for signal in array.from(view.shadowBuy, view.shadowSell, view.s5Buy, view.s5Sell, view.early)
        if signal.rank > 0
            array.push(signals, f_dvSignalJson(signal))
    "[" + array.join(signals, ",") + "]"

var DvView dvClosedView = f_dvEmptyView(na, false)
var DvView dvReviewView = f_dvEmptyView(rcReviewAt, true)
if rcCanDrawBar
    DvSignal shadowBuy = dtShow and dtSupported ? f_dvShadowAtClose(1) : DvSignal.new()
    DvSignal shadowSell = dtShow and dtSupported ? f_dvShadowAtClose(-1) : DvSignal.new()
    dvClosedView := DvView.new(shadowBuy, shadowSell, f_dvS5AtClose(1), f_dvS5AtClose(-1),
         f_dvEarlyAtClose(), time_close, time_close, false, rcCurrent.bias)
    if rcReview and time_close == rcReviewAt
        dvReviewView := dvClosedView.copy()
        dvReviewView.review := true

DvView dvView = rcReview ? dvReviewView : f_dvFreshView(dvClosedView, timenow)
DvSignal dvShadowBuyEvent = dvClosedView.shadowBuy
DvSignal dvShadowSellEvent = dvClosedView.shadowSell
bool dvShadowBuyConfirmedNow = rcCanDrawBar and dtShow and dtSupported and not rcReview and
     dvShadowBuyEvent.rank == 2 and dvShadowBuyEvent.known == time_close
bool dvShadowSellConfirmedNow = rcCanDrawBar and dtShow and dtSupported and not rcReview and
     dvShadowSellEvent.rank == 2 and dvShadowSellEvent.known == time_close

// Presentation reads the existing S5 decision and the existing RAW Paper ledger.
type DvPermission
    string state = "WAIT"
    string source = "S5"
    int known = na
    int side = 0
    string reason = ""
    bool planVisible = false

f_dvReadPermission(int stage, int side, int known, int checked, string reason, Plan plan,
     int paperPhase, string paperPlanId, bool capacity) =>
    bool ready = stage == RC_READY and not na(plan)
    if stage == RC_REJECTED
        DvPermission.new("RISK REJECTED", reason == RC2_FILTER_REASON ? "RC2 FILTER" : "S5", nz(known, checked), side, reason, false)
    else if paperPhase == 2 or capacity
        string held = "Виртуалният RAW Paper слот е зает."
        string detail = ready ? "S5 READY при затварянето. " + held : held
        DvPermission.new("POSITION OCCUPIED", "S5 RAW · PAPER", checked, 0,
             detail + (paperPlanId == "" ? "" : " План " + paperPlanId), false)
    else if ready
        DvPermission.new(f_rcSide(side) + " READY", "S5 · RC2", nz(known, checked), side, reason, true)
    else
        DvPermission.new("WAIT", "S5 · RC2", checked, 0, reason, false)

var DvPermission dvClosedPermission = DvPermission.new()
var DvPermission dvHistoricalPermission = DvPermission.new()
var int dvPaperPhase = 0
var string dvPaperPlanId = ""
var bool dvPaperCapacity = false
if rcCanDrawBar
    Paper paper = array.get(books, 3)
    dvPaperPhase := paper.phase
    dvPaperPlanId := paper.phase == 0 or na(paper.p) ? "" : paper.p.id
    dvPaperCapacity := false
    if not na(rcCurrent.plan)
        for e in events
            if e.book == "RAW" and e.kind == "CAPACITY" and e.knownTime == time_close and e.planId == rcCurrent.plan.id
                dvPaperCapacity := true
    dvClosedPermission := f_dvReadPermission(rcCurrent.stage, rcCurrent.direction, rcCurrent.known,
         rcCurrent.closed, rcCurrent.reason, rcCurrent.plan, dvPaperPhase, dvPaperPlanId, dvPaperCapacity)
    if rcReview and time_close == rcReviewAt
        dvHistoricalPermission := dvClosedPermission

bool dvPermissionFresh = not na(rcView.closed) and
     (rcReview or (time <= rcView.closed and timenow < rcView.closed + tfSeconds * 1000))
DvPermission dvVisiblePermission = rcReview and rcReviewFound ? dvHistoricalPermission :
     f_dvReadPermission(rcStage, rcDirection, rcKnownAt, rcView.closed, rcReason, rcShownPlan,
          dvPermissionFresh ? dvPaperPhase : 0, dvPermissionFresh ? dvPaperPlanId : "",
          dvPermissionFresh and dvPaperCapacity)
string dvPermission = dvVisiblePermission.state
string dvPermissionSource = dvVisiblePermission.source
int dvPermissionKnownMs = dvVisiblePermission.known
string dvPermissionReason = dvVisiblePermission.reason
int dvPermissionSide = dvVisiblePermission.side
bool dvPlanVisible = dvVisiblePermission.planVisible
int dvPermissionClock = rcReview ? rcView.closed : timenow
int dvPermissionAgeMinutes = na(dvPermissionKnownMs) ? na :
     int(math.max(0, dvPermissionClock - dvPermissionKnownMs) / 60000)
string dvPermissionFreshness = na(dvPermissionAgeMinutes) ? "—" :
     (rcReview ? "AT CLOSE" : dvPermissionFresh ? "FRESH" : "STALE") + " · " + str.tostring(dvPermissionAgeMinutes) + "m"

// Presentation reads the frozen decision and observation streams.
const string RC_DISPLAY = "PREMIUM · ГРАФИКА"
string rcDisplaySize = input.string("Standard", "Размер на таблото", options=["Small", "Standard", "Large"], group=RC_DISPLAY, display=display.none)
bool rcDisplayPassive = input.bool(true, "WATCH и INVALIDATED", group=RC_DISPLAY, display=display.none)
bool rcDisplaySessions = input.bool(false, "Начало на London и New York", group=RC_DISPLAY, display=display.none)
bool rcDisplayStructure = input.bool(false, "Потвърдени структурни high/low", group=RC_DISPLAY, display=display.none)
bool rcDisplayWickMarks = input.bool(false, "Маркери за Wick наблюдения", group=RC_DISPLAY, display=display.none)
bool psDisplay = input.bool(false, "Professional Selector · RESEARCH", group=RC_DISPLAY, display=display.none)

bool rcViewMobile = rcPreset == "MOBILE"
bool rcViewMinimal = rcPreset == "MINIMAL" or rcPreset == "COMPACT"
bool rcViewAudit = rcPreset == "FULL AUDIT"
bool rcViewDetailed = not rcViewMobile and not rcViewMinimal
bool rcViewLight = color.r(chart.bg_color) * 0.2126 + color.g(chart.bg_color) * 0.7152 +
     color.b(chart.bg_color) * 0.0722 > 145
color rcViewGraphite = #0D1521
color rcViewPanel = #172538
color rcViewRaised = #21334B
color rcViewText = #F1F4F8
color rcViewMuted = #B2BFD0
color rcViewBuy = #25D9B5
color rcViewSell = #FF7884
color rcViewCyan = #62C9E2
color rcViewGold = #EDC376
color rcViewChartBuy = rcViewLight ? #006956 : #31D5B3
color rcViewChartSell = rcViewLight ? #A82946 : #F87C88
color rcViewChartCyan = rcViewLight ? #146279 : #71CCE3
color rcViewChartGold = rcViewLight ? #815704 : #E4BE79
color rcViewTagBg = rcViewLight ? #F4F7FA : rcViewGraphite
string rcViewPosition = switch rcCorner
    "Top right" => position.top_right
    "Bottom right" => position.bottom_right
    "Bottom left" => position.bottom_left
    "Top left" => position.top_left
    => rcViewMobile ? position.bottom_right : position.top_right

f_rcViewPrice(float value) =>
    na(value) ? "—" : str.tostring(value, format.mintick)

f_rcViewUtc(int value) =>
    na(value) ? "—" : str.format_time(value, "yyyy-MM-dd HH:mm", "UTC") + " UTC"

f_rcViewClock(int value) =>
    na(value) ? "—" : str.format_time(value, "HH:mm", "UTC") + "Z"

f_rcViewClip(string value, int limit) =>
    str.length(value) > limit ? str.substring(value, 0, limit - 1) + "…" : value

f_rcViewRemember(array<label> pool, label item, int capacity) =>
    array.push(pool, item)
    if array.size(pool) > capacity
        label.delete(array.shift(pool))

f_rcViewSignal(int direction, int known, string caption, string tip, bool confirmed) =>
    bool isBuy = direction > 0
    color directionInk = isBuy ? rcViewChartBuy : rcViewChartSell
    color paper = confirmed ? directionInk : rcViewTagBg
    color ink = confirmed ? (rcViewLight ? color.white : rcViewGraphite) : rcViewChartGold
    label.new(bar_index, isBuy ? low : high, caption, xloc=xloc.bar_index,
         yloc=isBuy ? yloc.belowbar : yloc.abovebar, style=isBuy ? label.style_label_up : label.style_label_down,
         color=paper, textcolor=ink, size=size.tiny, tooltip=tip + "\n" + f_rcViewUtc(known))

// Presentation reads the existing closed H1/H4 snapshots.
f_sqAlignment(RcContext context) =>
    na(context) or na(context.h1) or na(context.h4) ? int(na) : context.h1 == context.h4 ? context.h1 : 0

f_sqClass(int side, bool confirmed, RcContext context) =>
    int alignment = f_sqAlignment(context)
    na(alignment) ? "HTF DATA MISSING" : confirmed ? (alignment == side ? "TREND CONTINUATION" : "BREAKOUT CONFIRMED") :
         alignment == -side ? "COUNTERTREND REVERSAL WATCH" : "UNCONFIRMED"

var array<label> rcViewConfirmedMarks = array.new<label>()
var array<label> rcViewPassiveMarks = array.new<label>()
var array<label> rcViewWickMarks = array.new<label>()
var array<line> rcViewSessionLines = array.new<line>()
bool rcViewPaintBar = rcCanDrawBar and (not rcReview or time_close <= rcReviewAt)
if rcViewPaintBar
    bool confirmedOnBar = false
    for e in events
        if f_rcCore(e) and f_rcStage(e.kind) == RC_CONFIRMED
            string side = f_rcSide(e.side)
            float reference = na(e.reference) ? e.price : e.reference
            string caption = side + "  " + f_rcViewPrice(reference) + "\n" + f_rcViewClock(e.knownTime)
            string tip = "S5 · " + side + " CONFIRMED\nСигнална цена " + f_rcViewPrice(reference)
            label mark = f_rcViewSignal(e.side, e.knownTime, caption, tip, true)
            f_rcViewRemember(rcViewConfirmedMarks, mark, rcViewAudit ? 18 : rcViewDetailed ? 6 : 3)
            confirmedOnBar := true
    bool baselinePassive = rcMarkerSide != 0 and (rcMarkerStage == RC_WATCH or rcMarkerStage == RC_INVALIDATED or
         (rcViewAudit and (rcMarkerStage == RC_REJECTED or rcMarkerStage == RC_EXPIRED)))
    // Paint research events on their existing confirmation bar.
    bool shadowBuyOnBar = dvShadowBuyEvent.rank == 2 and dvShadowBuyEvent.known == time_close
    bool shadowSellOnBar = dvShadowSellEvent.rank == 2 and dvShadowSellEvent.known == time_close
    bool oneShadow = shadowBuyOnBar != shadowSellOnBar
    int researchSide = not rcEarlyEnabled ? 0 : rcEarlyMarker ? rcEarlySide :
         oneShadow ? (shadowBuyOnBar ? 1 : -1) : structureUpNow ? 1 : structureDownNow ? -1 : 0
    if not confirmedOnBar and rcViewDetailed and rcDisplayPassive and baselinePassive and (rcMarkerStage != RC_WATCH or researchSide == 0)
        string stage = f_rcStageText(rcMarkerStage)
        string caption = rcMarkerStage == RC_WATCH ? f_rcSide(rcMarkerSide) + " WATCH" : stage
        label mark = f_rcViewSignal(rcMarkerSide, rcPrimaryEvent.knownTime, caption, "S5 · " + rcPrimaryEvent.reason, false)
        f_rcViewRemember(rcViewPassiveMarks, mark, rcViewAudit ? 10 : 4)
    else if not confirmedOnBar and rcViewDetailed and researchSide != 0
        string source = rcEarlyMarker ? "RC2 EARLY" : oneShadow ? "DT SHADOW" : "SIX-BAR"
        string stage = rcEarlyMarker ? " EARLY WATCH" : oneShadow ? " BREAKOUT" : " STRUCTURE"
        string caption = f_rcSide(researchSide) + stage + " · RESEARCH\n" + source + " · " + f_rcViewClock(time_close)
        int expiry = rcEarlyMarker ? dvClosedView.early.expiry :
             oneShadow ? (shadowBuyOnBar ? dvShadowBuyEvent.expiry : dvShadowSellEvent.expiry) : na
        string tip = "RESEARCH · " + source + "\n" + f_sqClass(researchSide, not rcEarlyMarker, rcCurrent.context) +
             " · at bar close" + (na(expiry) ? "" : "\nValid until " + f_rcViewUtc(expiry))
        label mark = f_rcViewSignal(researchSide, time_close, caption, tip, false)
        f_rcViewRemember(rcViewPassiveMarks, mark, rcViewAudit ? 10 : 4)
    else if not confirmedOnBar and rcViewDetailed and rcDisplayWickMarks and wfBuyEvidence != wfSellEvidence
        bool isBuy = wfBuyEvidence
        color ink = isBuy ? rcViewChartBuy : rcViewChartSell
        label mark = label.new(bar_index, isBuy ? low : high, "", xloc=xloc.bar_index,
             yloc=isBuy ? yloc.belowbar : yloc.abovebar, style=label.style_circle,
             color=color.new(ink, 30), size=size.tiny, tooltip="WICK · OBS\n" + f_rcViewUtc(time_close))
        f_rcViewRemember(rcViewWickMarks, mark, rcViewAudit ? 6 : 4)
    bool startsLondon = tvLondonActive and not tvLondonActive[1]
    bool startsNewYork = tvNewYorkActive and not tvNewYorkActive[1]
    if rcViewDetailed and rcDisplaySessions and not barstate.isfirst and (startsLondon or startsNewYork)
        line divider = line.new(bar_index, low, bar_index, math.max(high, low + syminfo.mintick),
             xloc=xloc.bar_index, extend=extend.both, color=color.new(startsLondon ? rcViewChartGold : rcViewChartCyan, 78),
             style=line.style_dotted, width=1)
        array.push(rcViewSessionLines, divider)
        if array.size(rcViewSessionLines) > 4
            line.delete(array.shift(rcViewSessionLines))

// Each horizontal structural level starts when the right-side pivot window is known.
var int rcViewHighKnown = na
var int rcViewLowKnown = na
var int rcViewReviewHighKnown = na
var int rcViewReviewLowKnown = na
var float rcViewReviewHigh = na
var float rcViewReviewLow = na
if rcCanDrawBar and rcViewDetailed and rcDisplayStructure
    if not na(pivotHigh)
        rcViewHighKnown := time_close
    if not na(pivotLow)
        rcViewLowKnown := time_close
    if rcReview and time_close == rcReviewAt
        rcViewReviewHighKnown := rcViewHighKnown
        rcViewReviewLowKnown := rcViewLowKnown
        rcViewReviewHigh := lastPivotHigh
        rcViewReviewLow := lastPivotLow

// Recycle one reference plan and one Wick zone. Projected levels never depict fills.
var array<line> rcViewPlanLines = array.new<line>()
var array<label> rcViewPlanTags = array.new<label>()
var box rcViewLoss = na
var box rcViewReward = na
var box rcViewWick = na
var line rcViewHighLine = na
var line rcViewLowLine = na

f_rcViewPlanLevel(int slot, int left, int right, float price, string caption, color ink, string stroke, bool tag) =>
    line rail = array.get(rcViewPlanLines, slot)
    label badge = array.get(rcViewPlanTags, slot)
    line.set_xy1(rail, left, price)
    line.set_xy2(rail, right, price)
    line.set_style(rail, stroke)
    line.set_color(rail, ink)
    label.set_xy(badge, right, tag ? price : na)
    label.set_color(badge, rcViewTagBg)
    label.set_textcolor(badge, ink)
    label.set_text(badge, caption + "  " + f_rcViewPrice(price))
    label.set_tooltip(badge, caption + " · " + f_rcViewPrice(price))

f_rcViewZone(box zone, int left, int right, float first, float second, color fill) =>
    box.set_lefttop(zone, left, math.max(first, second))
    box.set_rightbottom(zone, right, math.min(first, second))
    box.set_bgcolor(zone, fill)

f_rcViewStructureLine(line prior, int known, int rightEdge, float level, color ink) =>
    line guide = prior
    if not na(known) and not na(rightEdge) and not na(level)
        int right = math.max(known + 1, rightEdge)
        if na(guide)
            guide := line.new(known, level, right, level, xloc=xloc.bar_time,
                 color=color.new(ink, 52), style=line.style_dashed, width=1)
        else
            line.set_xy1(guide, known, level)
            line.set_xy2(guide, right, level)
    guide

bool rcViewRefresh = barstate.islast or barstate.islastconfirmedhistory
bool rcViewHasPlan = rcSupported and dvPlanVisible and not na(rcShownPlan) and not na(rcKnownAt)
if rcViewRefresh
    if rcViewHasPlan
        if array.size(rcViewPlanLines) == 0
            for i = 0 to 4
                array.push(rcViewPlanLines, line.new(time, na, time, na, xloc=xloc.bar_time, width=1))
                array.push(rcViewPlanTags, label.new(time, na, xloc=xloc.bar_time, yloc=yloc.price,
                     style=label.style_label_left, size=size.tiny, text_font_family=font.family_monospace))
            rcViewLoss := box.new(time, na, time, na, xloc=xloc.bar_time, border_width=0)
            rcViewReward := box.new(time, na, time, na, xloc=xloc.bar_time, border_width=0)
        Plan p = rcShownPlan
        int right = math.max(rcKnownAt + 1, nz(rcExpiresAt, rcKnownAt + tfSeconds * 1000))
        float gap = math.max(syminfo.mintick * 5.0, p.atrValue * 0.37)
        bool tags = not rcViewMobile
        bool tag2 = tags and math.abs(p.tp2 - p.tp3) >= gap and math.abs(p.tp2 - p.reference) >= gap
        bool tag1 = tags and math.abs(p.tp1 - p.reference) >= gap and math.abs(p.tp1 - (tag2 ? p.tp2 : p.tp3)) >= gap
        f_rcViewPlanLevel(0, rcKnownAt, right, p.reference, "ENTRY", rcViewChartCyan, line.style_solid, tags)
        f_rcViewPlanLevel(1, rcKnownAt, right, p.initialStop, "SL", rcViewChartSell, line.style_dashed,
             tags and math.abs(p.initialStop - p.reference) >= gap)
        f_rcViewPlanLevel(2, rcKnownAt, right, p.tp1, "TP1", rcViewChartBuy, line.style_dotted, tag1)
        f_rcViewPlanLevel(3, rcKnownAt, right, p.tp2, "TP2", rcViewChartBuy, line.style_dotted, tag2)
        f_rcViewPlanLevel(4, rcKnownAt, right, p.tp3, "TP3", rcViewChartBuy, line.style_solid,
             tags and math.abs(p.tp3 - p.reference) >= gap)
        f_rcViewZone(rcViewLoss, rcKnownAt, right, p.reference, p.initialStop, color.new(rcViewChartSell, rcViewLight ? 92 : 88))
        f_rcViewZone(rcViewReward, rcKnownAt, right, p.reference, p.tp3, color.new(rcViewChartBuy, rcViewLight ? 94 : 90))
    else if array.size(rcViewPlanLines) > 0
        for i = 0 to 4
            line.set_y1(array.get(rcViewPlanLines, i), na)
            line.set_y2(array.get(rcViewPlanLines, i), na)
            label.set_y(array.get(rcViewPlanTags, i), na)
        f_rcViewZone(rcViewLoss, time, time, na, na, na)
        f_rcViewZone(rcViewReward, time, time, na, na, na)

    if rcShowWick and rcViewDetailed and rcWickVisible and not na(rcWickKnownAt) and not na(rcWickTop) and not na(rcWickBottom)
        if na(rcViewWick)
            rcViewWick := box.new(time, na, time, na, xloc=xloc.bar_time, border_style=line.style_dotted,
                 text_size=size.tiny, text_halign=text.align_left, text_valign=text.align_top)
        color wickInk = rcWickSide > 0 ? rcViewChartBuy : rcWickSide < 0 ? rcViewChartSell : rcViewChartCyan
        f_rcViewZone(rcViewWick, rcWickKnownAt, math.max(rcWickKnownAt + 1, nz(rcWickAt, rcWickKnownAt + 1)),
             rcWickTop, rcWickBottom, color.new(wickInk, 96))
        box.set_border_color(rcViewWick, color.new(wickInk, 55))
        box.set_text(rcViewWick, " WICK · OBS")
        box.set_text_color(rcViewWick, wickInk)
    else if not na(rcViewWick)
        f_rcViewZone(rcViewWick, time, time, na, na, na)
        box.set_text(rcViewWick, "")

    if rcSupported and rcViewDetailed and rcDisplayStructure
        int edge = rcReview ? (rcReviewFound ? rcReviewAt : na) : rcView.closed
        rcViewHighLine := f_rcViewStructureLine(rcViewHighLine, rcReview ? rcViewReviewHighKnown : rcViewHighKnown,
             edge, rcReview ? rcViewReviewHigh : lastPivotHigh, rcViewChartSell)
        rcViewLowLine := f_rcViewStructureLine(rcViewLowLine, rcReview ? rcViewReviewLowKnown : rcViewLowKnown,
             edge, rcReview ? rcViewReviewLow : lastPivotLow, rcViewChartBuy)

// Six columns support one, two and three-cell groups without a second overlay.
int rcViewFontAdjust = rcViewMobile ? 0 : rcDisplaySize == "Small" ? -1 : rcDisplaySize == "Large" ? 2 : 0
int rcViewSmall = (rcViewMobile ? 9 : 10) + rcViewFontAdjust
int rcViewBody = (rcViewMobile ? 10 : 12) + rcViewFontAdjust
int rcViewTitle = (rcViewMobile ? 11 : rcViewMinimal ? 14 : 17) + rcViewFontAdjust
int rcViewHero = (rcViewMobile ? 14 : rcViewMinimal ? 16 : 20) + rcViewFontAdjust
float rcViewColumn = rcViewMobile ? 10.8 : (rcViewMinimal ? 4.1 : 5.0) + rcViewFontAdjust * 0.35
var table rcViewTable = table.new(rcViewPosition, 12, 26, bgcolor=color.new(rcViewGraphite, 100), force_overlay=true)

f_rcViewCell(int col, int row, string value, color ink, color paper, int fontSize,
             string align=text.align_center, bool bold=false, string tip="", bool numeric=false) =>
    table.cell(rcViewTable, col * 2, row, value, text_color=ink, bgcolor=paper, text_halign=align,
         text_valign=text.align_center, text_size=fontSize, tooltip=tip,
         text_font_family=numeric ? font.family_monospace : font.family_default,
         text_formatting=bold ? text.format_bold : text.format_none)

// Presentation. Directional observations do not supply trade permission.
f_dvPresent(DvSignal signal) =>
    not na(signal) and signal.rank > 0

f_dvChoose(DvSignal preferred, DvSignal other) =>
    if not f_dvPresent(preferred)
        other
    else if f_dvPresent(other) and (other.rank > preferred.rank or (other.rank == preferred.rank and other.known > preferred.known))
        other
    else
        preferred

f_dvState(DvSignal signal) =>
    not f_dvPresent(signal) ? "NONE" :
         (signal.side > 0 ? "BUY " : "SELL ") + (signal.rank == 2 ? "BREAKOUT CONFIRMED" : "WATCH")

f_dvChooseOpportunity(DvView view, int side) =>
    DvSignal shadow = side > 0 ? view.shadowBuy : view.shadowSell
    DvSignal s5 = side > 0 ? view.s5Buy : view.s5Sell
    // Keep the confirmed shadow direction visible. S5 READY has its own card.
    DvSignal primary = f_dvPresent(shadow) and shadow.rank == 2 ? shadow : f_dvChoose(shadow, s5)
    f_dvPresent(view.early) and view.early.side == side ? f_dvChoose(primary, view.early) : primary

f_dvOpportunityState(DvSignal buy, DvSignal sell) =>
    bool hasBuy = f_dvPresent(buy)
    bool hasSell = f_dvPresent(sell)
    hasBuy and hasSell ? "CONFLICT" : hasBuy ? f_dvState(buy) : f_dvState(sell)

DvSignal dvOpportunityBuy = f_dvChooseOpportunity(dvView, 1)
DvSignal dvOpportunitySell = f_dvChooseOpportunity(dvView, -1)
bool dvHasBuy = f_dvPresent(dvOpportunityBuy)
bool dvHasSell = f_dvPresent(dvOpportunitySell)
bool dvConflict = dvHasBuy and dvHasSell
string dvOpportunity = f_dvOpportunityState(dvOpportunityBuy, dvOpportunitySell)
int dvOpportunityAsOfMs = dvView.asOf

f_dvAge(int known) =>
    if na(known) or na(dvOpportunityAsOfMs)
        "—"
    else
        int minutes = int(math.max(0, (dvOpportunityAsOfMs - known) / 60000))
        minutes < 60 ? str.tostring(minutes) + "m" : str.tostring(int(minutes / 60)) + "h " + str.tostring(minutes % 60) + "m"

f_dvClockAge(int known) =>
    na(known) ? "—" : f_rcViewClock(known) + " · " + f_dvAge(known)

f_dvCountertrend(DvSignal signal) =>
    f_dvPresent(signal) and signal.source == "S5" and signal.rank == 1 and signal.side * dvView.bias == -1

f_dvReasonLabel(string code) =>
    switch code
        "APPROACHING_LEVEL" => "Приближава нивото"
        "FIRST_OBSERVED_ON_BREAK" => "Наблюдение при пробив"
        "CONFIRMED_CLOSE_CROSS" => "Затваряне отвъд нивото"
        "RETEST_CONFIRMED" => "Потвърден ретест"
        "CONFIRMED_BREAK_LEVEL" => "Чака ретест на пробива"
        "DIAGNOSTIC_ONLY" => "Изследователски кандидат"
        "INSUFFICIENT_NET_ROOM" => "Недостатъчно нетно място"
        "STOP_TOO_SMALL" => "Прекалено тесен стоп"
        "STOP_TOO_WIDE" => "Прекалено широк стоп"
        "LATE_EXTENSION" => "Късно разтягане"
        "COST_TOO_HIGH" => "Високи разходи"
        "CASH_RISK_LIMIT" => "Лимит на паричния риск"
        "OVERLAP_SAME_BAR" => "Друг кандидат в същия бар"
        "INSUFFICIENT_DISPLACEMENT" => "Недостатъчно движение при пробива"
        "CLOSE_BACK_THROUGH_BREAK_LEVEL" => "Затваряне обратно през нивото"
        "RETEST_WINDOW_EXPIRED" => "Изтече прозорецът за ретест"
        "DATA_GAP" => "Прекъсване в данните"
        => code == "" ? "—" : code

f_dvObservationReason(string reason) =>
    string rejection = " · RESEARCH REJECTED: "
    if reason == ""
        "—"
    else if str.contains(reason, rejection)
        f_dvReasonLabel(array.get(str.split(reason, rejection), 1))
    else
        f_dvReasonLabel(array.get(str.split(reason, " · "), 0))

f_dvSourceLine(DvSignal signal) =>
    string source = str.startswith(signal.source, "DT ") ? "DT SHADOW" :
         signal.source == "RC2 EARLY WATCH" ? "RC2 EARLY" : signal.source
    source + " · " + f_dvClockAge(signal.known)

f_dvSignalTip(DvSignal signal) =>
    not f_dvPresent(signal) ? "" : "\n\n" + f_dvState(signal) + " · " + signal.source +
         (signal.research ? " · RESEARCH" : "") + (f_dvCountertrend(signal) ? " · COUNTERTREND" : "") +
         "\nИзвестно при " + f_rcViewUtc(signal.known) + " · възраст " + f_dvAge(signal.known) +
         "\nВалидно до " + f_rcViewUtc(signal.expiry) + "\n" + signal.reason

f_dvConflictLines(DvSignal sell, DvSignal buy) =>
    string sellState = f_dvState(sell)
    string buyState = f_dvState(buy)
    if rcViewMobile
        sellState := sell.rank == 2 ? "SELL BREAKOUT ✓" : sellState
        buyState := buy.rank == 2 ? "BUY BREAKOUT ✓" : buyState
    string sellDetails = sellState + "\n" + f_dvSourceLine(sell)
    string buyDetails = buyState + "\n" + f_dvSourceLine(buy)
    if f_dvCountertrend(sell)
        sellDetails += "\nCOUNTERTREND"
    if f_dvCountertrend(buy)
        buyDetails += "\nCOUNTERTREND"
    if sell.research or buy.research
        sellDetails += sell.research ? "\nSELL · RESEARCH" : ""
        buyDetails += buy.research ? "\nBUY · RESEARCH" : ""
    sellDetails + "\n" + buyDetails

f_dvContextLine(string chartName) =>
    string viewMode = rcReview ? "HISTORICAL REVIEW" : rcPreset + (dvPermissionFresh ? " · LIVE" : " · LAST CLOSE")
    "  " + chartName + "  ·  " + viewMode

// Retain the existing Shadow terminal event at the selected historical close.
var DtObservation sqReviewTerminal = na
if rcReview and rcCanDrawBar and time_close == rcReviewAt
    sqReviewTerminal := dtCurrent
DtObservation sqTerminal = rcReview ? sqReviewTerminal : dtCurrent
bool sqTerminalVisible = dtShow and not na(sqTerminal) and sqTerminal.knownMs == dvView.closed and
     (sqTerminal.state == "INVALIDATED" or sqTerminal.state == "EXPIRED") and
     (rcReview or timenow < sqTerminal.knownMs + tfSeconds * 1000)

f_dvDashboard() =>
    DvSignal lead = dvHasSell ? dvOpportunitySell : dvOpportunityBuy
    bool hasDirection = dvHasBuy or dvHasSell
    bool confirmedSell = dvHasSell and dvOpportunitySell.rank == 2
    bool confirmedBuy = dvHasBuy and dvOpportunityBuy.rank == 2
    string detected = confirmedSell and confirmedBuy ? "BUY + SELL DETECTED" :
         confirmedSell ? "SELL DETECTED" : confirmedBuy ? "BUY DETECTED" : ""
    int reasonLimit = rcViewMobile ? 20 : 28
    string quality = dvConflict ? "CONFLICT" : hasDirection ? f_sqClass(lead.side, lead.rank == 2, rcView.context) :
         sqTerminalVisible ? sqTerminal.state : "NONE"
    string directionFace = dvConflict ? "CONFLICT" + (detected == "" ? "" : "\n" + detected) :
         not hasDirection ? quality : lead.rank == 2 ? (lead.side > 0 ? "BUY" : "SELL") + " BREAKOUT\nCONFIRMED" : dvOpportunity
    string selectorState = not hasDirection or str.contains(lead.reason, "RESEARCH REJECTED:") ? "REJECT / EXPIRED" :
         confirmedSell and confirmedBuy ? "CONFLICT" :
         lead.rank < 2 or dvConflict ? "OBSERVE" : "NO DATA"
    string selectorCaption = "QUALITY / WHY · " + selectorState
    string directionMeta = dtShow ? "S5 · DT SHADOW" : "S5"
    if dvConflict
        directionMeta := f_dvConflictLines(dvOpportunitySell, dvOpportunityBuy)
    else if hasDirection
        directionMeta := f_dvSourceLine(lead)
        if detected != ""
            directionMeta := detected + (lead.research ? " · RESEARCH" : "") + "\n" + directionMeta
        directionMeta += "\n" + (psDisplay ? selectorCaption : quality)
    else if sqTerminalVisible
        directionMeta := "DT SHADOW · " + f_rcSide(sqTerminal.side) + " · " + f_dvClockAge(sqTerminal.knownMs)
    string directionReason = sqTerminalVisible ? f_rcViewClip(f_dvReasonLabel(sqTerminal.reason), reasonLimit) : "Няма активно наблюдение"
    if dvConflict
        directionReason := "SELL · " + f_rcViewClip(f_dvObservationReason(dvOpportunitySell.reason), reasonLimit - 7) +
             "\nBUY · " + f_rcViewClip(f_dvObservationReason(dvOpportunityBuy.reason), reasonLimit - 6)
    else if hasDirection
        directionReason := f_rcViewClip(f_dvObservationReason(lead.reason), reasonLimit)
    string directionTip = quality + "\nКъм " + f_rcViewUtc(dvOpportunityAsOfMs) +
         f_dvSignalTip(dvView.shadowSell) + f_dvSignalTip(dvView.s5Sell) +
         f_dvSignalTip(dvView.shadowBuy) + f_dvSignalTip(dvView.s5Buy) + f_dvSignalTip(dvView.early)
    if sqTerminalVisible
        directionTip += "\n\nDT SHADOW · " + f_rcSide(sqTerminal.side) + " " + sqTerminal.state +
             " · " + f_rcViewUtc(sqTerminal.knownMs) + "\n" + f_dvReasonLabel(sqTerminal.reason)
    if psDisplay and (hasDirection or sqTerminalVisible)
        if dvConflict or not hasDirection
            directionMeta += "\n" + selectorCaption
        directionTip += "\n\n" + selectorCaption + "\nRESEARCH · Frozen evidence may be unavailable."
    color directionInk = dvConflict ? rcViewGold : dvHasSell ? rcViewSell : dvHasBuy ? rcViewBuy : rcViewMuted
    color directionPaper = dvConflict ? #403523 : dvHasSell ? #41262F : dvHasBuy ? #153A34 : rcViewPanel

    bool permissionReady = dvPermission == "BUY READY" or dvPermission == "SELL READY"
    bool permissionBlocked = dvPermission == "RISK REJECTED" or dvPermission == "POSITION OCCUPIED"
    color permissionInk = permissionReady ? (dvPermissionSide > 0 ? rcViewBuy : rcViewSell) :
         permissionBlocked ? rcViewGold : rcViewCyan
    color permissionPaper = permissionReady ? (dvPermissionSide > 0 ? #153A34 : #41262F) :
         permissionBlocked ? #403523 : #183647
    string permissionFace = rcViewMobile and dvPermission == "POSITION OCCUPIED" ? "POSITION\nOCCUPIED" : dvPermission
    string permissionMeta = (rcReview and permissionReady ? "HISTORICAL · " : "") +
         (psDisplay and permissionReady and rcViewHasPlan ? "S5 APPROVED" : dvPermissionSource) +
         "\n" + f_rcViewClock(dvPermissionKnownMs) + " · " + dvPermissionFreshness
    string permissionTip = dvPermission + " · " + dvPermissionSource +
         "\nИзвестно при " + f_rcViewUtc(dvPermissionKnownMs) + " · " + dvPermissionFreshness + "\n" + dvPermissionReason

    f_rcViewCell(0, 2, "DIRECTIONAL OPPORTUNITY", rcViewText, directionPaper, rcViewSmall, text.align_center, true, directionTip)
    f_rcViewCell(3, 2, "TRADE PERMISSION", rcViewText, permissionPaper, rcViewSmall, text.align_center, true, permissionTip)
    f_rcViewCell(0, 3, directionFace, directionInk, directionPaper, rcViewBody + 1, text.align_center, true, directionTip)
    f_rcViewCell(3, 3, permissionFace, permissionInk, permissionPaper, rcViewBody + 1, text.align_center, true, permissionTip)
    f_rcViewCell(0, 4, directionMeta, rcViewText, directionPaper, rcViewSmall, text.align_center, false, directionTip)
    f_rcViewCell(3, 4, permissionMeta, rcViewText, permissionPaper, rcViewSmall, text.align_center, false, permissionTip)
    f_rcViewCell(0, 5, directionReason, directionInk, directionPaper, rcViewSmall, text.align_center, false, directionTip)
    f_rcViewCell(3, 5, f_rcViewClip(dvPermissionReason, reasonLimit), permissionInk, permissionPaper,
         rcViewSmall, text.align_center, false, permissionTip)

f_dvBiasRow() =>
    color ink = rcBias > 0 ? rcViewBuy : rcBias < 0 ? rcViewSell : rcViewMuted
    f_rcViewCell(0, 6, "MARKET BIAS  ·  " + rcMarket, ink, rcViewRaised, rcViewSmall, text.align_center, true,
         "Контекст от затворени H1/H4 барове")

// Presentation only. The RC2 grid retains six logical columns, each spanning two strip segments.
f_rcPressureWidgetLayout() =>
    for row in array.from(22, 24)
        for col = 0 to 8 by 4
            table.merge_cells(rcViewTable, col, row, col + 3, row)
    table.merge_cells(rcViewTable, 0, 25, 11, 25)

f_rcPressureTenths(float buy) =>
    int(math.round(buy * 10.0))

f_rcPressurePercent(int tenths) =>
    na(tenths) ? "—" : str.tostring(tenths / 10.0, "0.0") + "%"

f_rcPressureCaption(string mode) =>
    switch mode
        "TICK" => "TICK PROXY"
        "FALLBACK" => "PROXY*"
        "WARMUP" => "WARMUP"
        "UNAVAILABLE" => "NO DATA"
        => "PROXY"

f_rcPressureTooltip(RcPressureReading reading) =>
    string detail = switch reading.mode
        "TICK" => "Tick-volume-weighted directional proxy"
        "FALLBACK" => "OHLC directional proxy\nTick volume is unavailable or invalid in this window"
        "WARMUP" => "Waiting for " + str.tostring(rcPressureLookback) + " closed source bars"
        "UNAVAILABLE" => "Closed source data unavailable"
        => "OHLC directional proxy"
    detail + "\nOHLC estimate, no order-flow measurement\n" + f_rcViewUtc(reading.closed)

f_rcPressureComparison(int col, string frame, RcPressureReading reading) =>
    int buyTenths = f_rcPressureTenths(reading.buy)
    string labelText = frame + " B" + f_rcPressurePercent(buyTenths) + (reading.mode == "FALLBACK" ? "*" : "")
    string tip = "BUY " + f_rcPressurePercent(buyTenths) + "  ·  SELL " +
         f_rcPressurePercent(1000 - buyTenths) + "\n" + f_rcPressureTooltip(reading)
    f_rcViewCell(col, 24, labelText, rcViewMuted, rcViewGraphite, rcViewSmall, text.align_center, false, tip)

f_rcPressureWidget() =>
    int buyTenths = f_rcPressureTenths(rcPressureView.buy)
    bool available = not na(buyTenths)
    string tip = f_rcPressureTooltip(rcPressureView)
    f_rcViewCell(0, 22, "BUY " + f_rcPressurePercent(buyTenths), available ? rcViewBuy : rcViewMuted,
         rcViewPanel, rcViewSmall, text.align_center, true, tip, true)
    f_rcViewCell(2, 22, f_rcPressureCaption(rcPressureView.mode), available ? rcViewGold : rcViewMuted,
         rcViewRaised, rcViewSmall, text.align_center, true, tip)
    f_rcViewCell(4, 22, "SELL " + f_rcPressurePercent(1000 - buyTenths), available ? rcViewSell : rcViewMuted,
         rcViewPanel, rcViewSmall, text.align_center, true, tip, true)
    int buySegments = int(math.round(rcPressureView.buy * 12 / 100.0))
    for col = 0 to 11
        color segmentColor = not available ? rcViewRaised : col < buySegments ? rcViewBuy : rcViewSell
        table.cell(rcViewTable, col, 23, "", width=rcViewColumn / 2, height=0.65, bgcolor=segmentColor, text_size=1, tooltip=tip)
    if rcPressureCompare
        f_rcPressureComparison(0, "M5", rcPressureViewM5)
        f_rcPressureComparison(2, "M15", rcPressureViewM15)
        f_rcPressureComparison(4, "H1", rcPressureViewH1)
    if rcViewAudit
        string weighting = rcPressureView.mode == "TICK" ? "Tick volume weighted" : "Equal weight"
        string method = "  EXPERIMENTAL · " + str.tostring(rcPressureLookback) + " CLOSED BARS\n" +
             "  Close in high–low range · " + weighting
        string auditTip = "Mean of (close − low) / (high − low). A flat bar contributes 50%.\n" +
             "Tick weighting falls back to equal weights if the window lacks valid tick volume.\n" +
             "M5/M15/H1 row shows BUY pressure. These values are directional proxies."
        f_rcViewCell(0, 25, method, rcViewMuted, rcViewGraphite, rcViewSmall, text.align_left, false, auditTip)

if barstate.isfirst
    for row in array.from(0, 1, 6, 7, 10, 15, 16, 17, 18, 19, 20)
        table.merge_cells(rcViewTable, 0, row, 11, row)
    for row in array.from(2, 3, 4, 5, 11, 12)
        table.merge_cells(rcViewTable, 0, row, 5, row)
        table.merge_cells(rcViewTable, 6, row, 11, row)
    for row in array.from(8, 9, 13, 14)
        for col = 0 to 4 by 2
            table.merge_cells(rcViewTable, col * 2, row, (col + 2) * 2 - 1, row)

    if rcPressureShow
        f_rcPressureWidgetLayout()

if rcViewRefresh
    for col = 0 to 11
        table.cell(rcViewTable, col, 21, "", width=rcViewColumn / 2, height=0.01,
             bgcolor=color.new(rcViewGraphite, 100), text_size=1)
    string chartName = rcSupported ? syminfo.tickerid + " · " + timeframe.period + "m" : "OANDA:XAUUSD · M5 / M15 / M30"
    f_rcViewCell(0, 0, "  QIRVANTA GOLD PRO UNIFIED", rcViewGold, rcViewGraphite, rcViewTitle, text.align_left, true)
    f_rcViewCell(0, 1, f_dvContextLine(chartName), rcViewMuted, rcViewGraphite, rcViewSmall, text.align_left)
    f_dvDashboard()
    f_dvBiasRow()

    if rcViewDetailed
        string trends = "M5 " + rcTrendM5 + "  ·  M15 " + rcTrendM15 + "  ·  H1 " + rcTrendH1 + "  ·  H4 " + rcTrendH4
        int alignment = f_sqAlignment(rcView.context)
        string trendTip = trends + "\nH1/H4: " + (na(alignment) ? "DATA INCOMPLETE" :
             alignment == 0 ? "MIXED / NEUTRAL" : alignment > 0 ? "ALIGNED UP" : "ALIGNED DOWN")
        f_rcViewCell(0, 7, f_rcViewClip(trends, 66), rcViewText, rcViewPanel, rcViewSmall, text.align_center, true, trendTip)
        f_rcViewCell(0, 8, "SESSION", rcViewMuted, rcViewPanel, rcViewSmall)
        f_rcViewCell(2, 8, "VOLATILITY", rcViewMuted, rcViewPanel, rcViewSmall)
        f_rcViewCell(4, 8, "SIGNAL QUALITY", rcViewMuted, rcViewPanel, rcViewSmall)
        f_rcViewCell(0, 9, f_rcViewClip(rcSession, 16), rcViewText, rcViewPanel, rcViewSmall, text.align_center, true, rcSession)
        f_rcViewCell(2, 9, f_rcViewClip(rcVolatility, 16), rcViewText, rcViewPanel, rcViewSmall, text.align_center, true, rcVolatility)
        f_rcViewCell(4, 9, f_rcViewClip(rcQuality, 16), rcViewGold, rcViewPanel, rcViewSmall, text.align_center, true, rcQuality)
    else
        table.clear(rcViewTable, 0, 7, 11, 9)

    if rcViewHasPlan
        Plan p = rcShownPlan
        string planTitle = rcReview ? "  PLAN STATUS · S5 HISTORICAL" : "  PLAN STATUS · S5 NEXT TICK"
        f_rcViewCell(0, 10, planTitle, rcReview ? rcViewGold : rcViewCyan, rcViewRaised, rcViewSmall, text.align_left, true)
        f_rcViewCell(0, 11, "ENTRY REF.", rcViewMuted, rcViewPanel, rcViewSmall)
        f_rcViewCell(3, 11, "INITIAL SL", rcViewMuted, rcViewPanel, rcViewSmall)
        f_rcViewCell(0, 12, f_rcViewPrice(p.reference), rcViewCyan, rcViewPanel, rcViewBody, text.align_center,
             true, "Референтна цена на плана", true)
        f_rcViewCell(3, 12, f_rcViewPrice(p.initialStop), rcViewSell, rcViewPanel, rcViewBody, text.align_center,
             true, "Цена на начална структурна инвалидация", true)
        for col = 0 to 4 by 2
            int target = int(col / 2) + 1
            float price = target == 1 ? p.tp1 : target == 2 ? p.tp2 : p.tp3
            f_rcViewCell(col, 13, "TP" + str.tostring(target), rcViewMuted, rcViewPanel, rcViewSmall)
            f_rcViewCell(col, 14, f_rcViewPrice(price), rcViewBuy, rcViewPanel, rcViewBody, text.align_center,
                 true, p.targetBasis == "STRUCTURE" ? "Структурна цел" : "Проекция по начален риск", true)
        float rr = math.abs(p.tp3 - p.reference) / math.abs(p.reference - p.initialStop)
        string targetBasis = p.targetBasis == "STRUCTURE" ? "STRUCTURAL TARGETS" : "R PROJECTIONS"
        string rrLine = "  RR · TP3  1:" + str.tostring(rr, "0.00") + "  ·  " + targetBasis
        f_rcViewCell(0, 15, rrLine, rcViewGold, rcViewGraphite, rcViewSmall, text.align_left)
    else
        if not rcViewMobile
            f_rcViewCell(0, 10, "  PLAN STATUS · " + (rcReview ? "NO HISTORICAL PLAN" : "NO ACTIVE PLAN"),
                 rcViewMuted, rcViewGraphite, rcViewSmall, text.align_left)
        else
            table.clear(rcViewTable, 0, 10, 11, 10)
        table.clear(rcViewTable, 0, 11, 11, 15)

    if not rcViewMobile
        string reason = rcReason == "" ? "—" : rcReason
        f_rcViewCell(0, 16, "  REASON  " + f_rcViewClip(reason, rcViewMinimal ? 28 : 43),
             rcViewText, rcViewGraphite, rcViewSmall, text.align_left, false, reason)
    else
        table.clear(rcViewTable, 0, 16, 11, 16)
    string updated = rcViewMobile ? f_rcViewClock(rcView.closed) :
         na(rcView.closed) ? "—" : str.format_time(rcView.closed, "yyyy-MM-dd HH:mm", "UTC")
    f_rcViewCell(0, 17, "  " + (rcViewMobile ? "UPDATE " : "LAST UPDATE UTC  ") + updated,
         rcViewMuted, rcViewGraphite, rcViewSmall, text.align_left, false, f_rcViewUtc(rcView.closed))

    string observation = not rcReview and rcEarlyObservation != "" ? "EARLY WATCH · " + rcEarlyObservation :
         rcShowWick and rcWick != "" ? "WICK · OBS  " + rcWick : ""
    if rcViewDetailed and observation != ""
        f_rcViewCell(0, 18, "  " + f_rcViewClip(observation, 43), rcViewGold, rcViewPanel, rcViewSmall, text.align_left, false, observation)
    else
        table.clear(rcViewTable, 0, 18, 11, 18)
    if rcViewAudit and rcLast != "" and not rcReview
        f_rcViewCell(0, 19, "  LAST S5 EVENT  " + f_rcViewClip(rcLast, 43), rcViewMuted, rcViewGraphite, rcViewSmall,
             text.align_left, false, rcLast)
    else
        table.clear(rcViewTable, 0, 19, 11, 19)
    if rcViewHasPlan and not rcViewMobile
        int stamp = rcReview ? rcKnownAt : rcExpiresAt
        string timing = rcReview ? "KNOWN " : "WINDOW ENDS "
        f_rcViewCell(0, 20, "  " + timing + f_rcViewUtc(stamp), rcViewMuted, rcViewGraphite, rcViewSmall, text.align_left)
    else
        table.clear(rcViewTable, 0, 20, 11, 20)
    if rcPressureShow
        f_rcPressureWidget()

bool rcAlertWatch = input.bool(true, "WATCH", group="ALERTS", display=display.none)
bool rcAlertConfirmed = input.bool(true, "CONFIRMED", group="ALERTS", display=display.none)
bool rcAlertReady = input.bool(true, "READY", group="ALERTS", display=display.none)
bool rcAlertLifecycle = input.bool(true, "INVALIDATED / EXPIRED", group="ALERTS", display=display.none)
bool rcAlertEarly = input.bool(false, "EARLY WATCH (research)", group="ALERTS", display=display.none)
varip int rcLastAlertClose = na

f_rc2Append(string batch, string item) => batch == "" ? item : batch + "," + item
f_rc2EarlyPayload() =>
    string source = syminfo.tickerid + "|" + timeframe.period + "|RC2_EARLY|" + f_rcSide(rcEarlySide) + "|" + f_int(time_close)
    string utc = str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
    '{"event_id":' + f_q(source + "|WATCH") + ',"source_id":' + f_q(source) +
     ',"model":"RC2_EARLY","symbol":' + f_q(syminfo.tickerid) + ',"timeframe":' + f_q(timeframe.period) +
     ',"direction":' + f_q(f_rcSide(rcEarlySide)) + ',"state":"WATCH","confirmed_ms":' + f_int(time_close) +
     ',"confirmation_utc":' + f_q(utc) + ',"entry":null,"sl":null,"tp1":null,"tp2":null,"tp3":null' +
     ',"reason":"Confirmed range break and displacement; observational only","provisional":true}'

// Preserve the stable S5 source keys. Execution events belong to the separate Audit script.
if rcCanDrawBar and (rcQaBar or barstate.isrealtime)
    string batch = ""
    for e in events
        if f_rcCore(e)
            int stage = f_rcStage(e.kind)
            bool include = (stage == RC_WATCH and rcAlertWatch) or (stage == RC_CONFIRMED and rcAlertConfirmed) or
                 ((stage == RC_INVALIDATED or stage == RC_EXPIRED) and rcAlertLifecycle)
            if include
                batch := f_rc2Append(batch, f_rcPayload(e, f_rcStageText(stage), na, e.reason))
    if rcAlertReady and rcReadyPayload != "" and not rc2Blocked
        batch := f_rc2Append(batch, rcReadyPayload)
    if rcQaBar and not rc2FilterActive and batch != ""
        log.info('RC1_ALERT|{"schema":"qirvanta.gold-pro.rc1.v1","events":[' + batch + "]}")
    if rcAlertEarly and rcEarlyMarker
        batch := f_rc2Append(batch, f_rc2EarlyPayload())
    if batch != ""
        string message = '{"schema":"qirvanta.gold-pro.rc2.v1","events":[' + batch + "]}"
        if rcQaBar
            log.info("RC2_ALERT|" + message)
        if barstate.isrealtime and (na(rcLastAlertClose) or rcLastAlertClose != time_close)
            rcLastAlertClose := time_close
            alert(message, alert.freq_once_per_bar_close)

// Separate selectable research alert conditions. The RC2 alert() stream above is unchanged.
bool dvNotify = input.bool(false, "Известия за потвърден shadow пробив", group="DIRECTIONAL OBSERVATIONS",
     tooltip="Включва отделните условия RESEARCH BUY и RESEARCH SELL в Create Alert.", display=display.none)
bool dvNotifyBuy = dvNotify and dtShow and dvShadowBuyConfirmedNow and barstate.isconfirmed
bool dvNotifySell = dvNotify and dtShow and dvShadowSellConfirmedNow and barstate.isconfirmed
plot(dvNotifyBuy or dvNotifySell ? time_close : na, "QIRVANTA observation close UTC ms", display=display.none, precision=0)
alertcondition(dvNotifyBuy and barstate.isrealtime and not rcReview, "RESEARCH · BUY BREAKOUT CONFIRMED",
     'QIRVANTA OBSERVATION | {{exchange}}:{{ticker}} {{interval}} | Direct Trend Shadow BUY BREAKOUT CONFIRMED | Close UTC ms {{plot("QIRVANTA observation close UTC ms")}} | Research only')
alertcondition(dvNotifySell and barstate.isrealtime and not rcReview, "RESEARCH · SELL BREAKOUT CONFIRMED",
     'QIRVANTA OBSERVATION | {{exchange}}:{{ticker}} {{interval}} | Direct Trend Shadow SELL BREAKOUT CONFIRMED | Close UTC ms {{plot("QIRVANTA observation close UTC ms")}} | Research only')

if rcQaBar and (dvNotifyBuy or dvNotifySell)
    for side in array.from(1, -1)
        if side == 1 ? dvNotifyBuy : dvNotifySell
            log.info('DTV_ALERT|{"symbol":' + f_q(syminfo.tickerid) + ',"frame":' + f_q(timeframe.period) +
                 ',"known_ms":' + f_int(time_close) + ',"side":' + f_q(f_rcSide(side)) +
                 ',"source":"DT SHADOW","observation_only":true}')

// Optional audit of the unchanged in-indicator RAW Paper stream, distinct from Strategy Tester.
if rcQaBar
    Paper dvQaPaper = array.get(books, 3)
    Ledger dvQaLedger = array.get(ledgers, 3)
    string dvQaPlan = dvQaPaper.phase == 0 or na(dvQaPaper.p) ? "" : dvQaPaper.p.id
    log.info('DTV_LEDGER|{"symbol":' + f_q(syminfo.tickerid) + ',"frame":' + f_q(timeframe.period) +
         ',"known_ms":' + f_int(time_close) + ',"phase":' + f_int(dvQaPaper.phase) + ',"plan_id":' + f_q(dvQaPlan) +
         ',"entered":' + f_int(dvQaLedger.entered) + ',"closed":' + f_int(dvQaLedger.closed) +
         ',"net":' + f_num(dvQaLedger.net) + ',"gross":' + f_num(dvQaLedger.gross) +
         ',"costs":' + f_num(dvQaLedger.costs) + ',"gains":' + f_num(dvQaLedger.gains) +
         ',"losses":' + f_num(dvQaLedger.losses) + ',"drawdown":' + f_num(dvQaLedger.drawdown) +
         ',"capacity_skipped":' + f_int(dvQaLedger.capacitySkipped) + '}')
    for e in events
        if e.book == "RAW"
            log.info("DTV_PAPER|" + f_json(e))

// Journal the same view used by the dashboard without changing its live freshness clock.
f_dvJournalState(DvView view, DvPermission permission, bool review, int asOf, string freshness) =>
    DvSignal buy = f_dvChooseOpportunity(view, 1)
    DvSignal sell = f_dvChooseOpportunity(view, -1)
    '{"symbol":' + f_q(syminfo.tickerid) + ',"frame":' + f_q(timeframe.period) +
         ',"open_ms":' + f_int(time) + ',"known_ms":' + f_int(time_close) + ',"as_of_ms":' + f_int(asOf) +
         ',"direction":' + f_q(f_dvOpportunityState(buy, sell)) + ',"signals":' + f_dvSignalsJson(view) +
         ',"permission":' + f_q(permission.state) + ',"permission_source":' + f_q(permission.source) +
         ',"permission_known_ms":' + f_int(permission.known) + ',"permission_reason":' + f_q(permission.reason) +
         ',"permission_freshness":' + f_q(freshness) + ',"plan_visible":' + str.tostring(permission.planVisible) +
         ',"paper_phase":' + f_int(dvPaperPhase) + ',"paper_plan_id":' + f_q(dvPaperPlanId) +
         ',"paper_capacity":' + str.tostring(dvPaperCapacity) + ',"s5_stage":' + f_q(f_rcStageText(rcCurrent.stage)) +
         ',"review":' + str.tostring(review) + '}'

if rcQaBar
    log.info("DTV_STATE|" + f_dvJournalState(dvClosedView, dvClosedPermission, false, time_close, "AT CLOSE"))
    if rcReview and time_close == rcReviewAt and rcReviewFound
        log.info("DTV_REVIEW|" + f_dvJournalState(dvView, dvVisiblePermission, true, dvView.asOf, dvPermissionFreshness))
