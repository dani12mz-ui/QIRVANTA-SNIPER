float globalStopNetR = -5.0
int modelMinClosed = 20
float modelStopAvgR = -0.15
int recoveryTrades = 5
bool observeCountertrendOnly = true
string contextPolicy = "БАЗОВ"
int efficiencyLength = 20
float minEfficiency = 0.25
int testStart = timestamp("01 Jan 2020 00:00 +0000")
int testEnd = timestamp("01 Jan 2035 00:00 +0000")
string uiMode = "PREMIUM"
string panelPosition = "Горе вдясно"
int uiFontPt = 11
bool showPanel = true
bool displayEMAs = false
bool showLevels = true
bool showEntryLevel = true
bool showStopLevel = true
bool showTP1Level = true
bool showTP2Level = true
bool showTP3Level = true
