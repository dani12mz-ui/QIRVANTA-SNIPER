//@version=6
indicator("QIRVANTA GOLD PRO · Wick Visual V3", shorttitle="Q WICK V3", overlay=true, behind_chart=false, max_bars_back=300, max_boxes_count=50, max_labels_count=80, max_lines_count=80)
// Generated by unified.tools.build_gold_wick_v3.

// Independent confirmed-bar wick geometry and bounded formation lifecycle.
const int WF_ATR_BARS = 14
const int WF_FORM_BARS = 4
const int WF_WATCH_BARS = 8
const int WF_RETEST_BARS = 6
const int WF_ACTIVITY_BARS = 20
const int WF_CONTEXT_BARS = 110

string wfEntryPolicy = input.string("Breakout", "Research entry", options=["Breakout", "Retest"], group="Wick research")
string wfVolumePolicy = input.string("A · No volume filter", "Volume alternative",
     options=["A · No volume filter", "B · Close-location proxy", "C · Relative activity"], group="Wick research")
bool wfRequireContext = input.bool(false, "Require aligned confirmed H1 and H4", group="Wick research")
bool wfAudit = input.bool(false, "Export confirmed context and events", group="Audit logs")
int wfAuditStart = input.time(timestamp("10 Nov 2026 00:00 +0000"), "Audit start", group="Audit logs")
int wfAuditEnd = input.time(timestamp("11 Nov 2026 06:00 +0000"), "Audit end", group="Audit logs")

bool wfSupported = syminfo.tickerid == "OANDA:XAUUSD" and chart.is_standard and
     (timeframe.period == "5" or timeframe.period == "15" or timeframe.period == "30") and syminfo.mintick > 0
bool wfConfirmed = wfSupported and barstate.isconfirmed
bool wfAuditBar = wfAudit and wfConfirmed and time_close >= wfAuditStart and time_close <= wfAuditEnd
int wfInterval = int(timeframe.in_seconds() * 1000)
float wfTick = syminfo.mintick

// Only completed higher-timeframe closes enter the finite EMA comparison.
f_wfHtfContext() =>
    float fast = close[WF_CONTEXT_BARS]
    float slow = fast
    if not na(fast)
        for ago = WF_CONTEXT_BARS - 1 to 1
            fast += (close[ago] - fast) * (2.0 / 22.0)
            slow += (close[ago] - slow) * (2.0 / 56.0)
    [time_close[1], close[1], fast, slow]

[wfH1Known, wfH1Close, wfH1Fast, wfH1Slow] = request.security(
     syminfo.tickerid, "60", f_wfHtfContext(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[wfH4Known, wfH4Close, wfH4Fast, wfH4Slow] = request.security(
     syminfo.tickerid, "240", f_wfHtfContext(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

f_wfHtfSide(int known, float value, float fast, float slow, int maxAge) =>
    int result = na
    if wfSupported and not na(known) and known <= time and time - known <= maxAge and
         not na(value) and not na(fast) and not na(slow)
        int c = math.round(value * 1000000.0)
        int f = math.round(fast * 1000000.0)
        int s = math.round(slow * 1000000.0)
        result := c > f and f > s ? 1 : c < f and f < s ? -1 : 0
    result

int wfH1Side = f_wfHtfSide(wfH1Known, wfH1Close, wfH1Fast, wfH1Slow, 7200000)
int wfH4Side = f_wfHtfSide(wfH4Known, wfH4Close, wfH4Fast, wfH4Slow, 28800000)
float wfTrueRange = ta.tr(true)
float wfPriorAtr = ta.sma(wfTrueRange, WF_ATR_BARS)[1]
float wfRange = high - low
float wfUpper = wfRange > 0 ? (high - math.max(open, close)) / wfRange : na
float wfLower = wfRange > 0 ? (math.min(open, close) - low) / wfRange : na
bool wfEligibleCandle = not na(wfPriorAtr) and wfPriorAtr > 0 and wfRange >= 0.50 * wfPriorAtr
bool wfBuyEvidence = wfEligibleCandle and wfLower >= 0.45 and wfUpper < 0.30
bool wfSellEvidence = wfEligibleCandle and wfUpper >= 0.45 and wfLower < 0.30
int wfBuyCount = int(math.sum(wfBuyEvidence ? 1 : 0, WF_FORM_BARS))
int wfSellCount = int(math.sum(wfSellEvidence ? 1 : 0, WF_FORM_BARS))
bool wfSequenceReady = wfPriorAtr > 0 and wfPriorAtr[1] > 0 and wfPriorAtr[2] > 0 and wfPriorAtr[3] > 0 and
     time == time_close[1] and
     time[1] == time_close[2] and time[2] == time_close[3]
float wfWindowHigh = ta.highest(high, WF_FORM_BARS)
float wfWindowLow = ta.lowest(low, WF_FORM_BARS)
float wfPriorHigh = ta.highest(high, WF_ACTIVITY_BARS)[1]
float wfPriorLow = ta.lowest(low, WF_ACTIVITY_BARS)[1]
bool wfNearSupport = bar_index >= WF_ACTIVITY_BARS and math.abs(low - wfPriorLow) <= 0.40 * wfPriorAtr
bool wfNearResistance = bar_index >= WF_ACTIVITY_BARS and math.abs(high - wfPriorHigh) <= 0.40 * wfPriorAtr
bool wfClusterNearSupport = math.sum(wfBuyEvidence and wfNearSupport ? 1 : 0, WF_FORM_BARS) > 0
bool wfClusterNearResistance = math.sum(wfSellEvidence and wfNearResistance ? 1 : 0, WF_FORM_BARS) > 0
bool wfVolumeKnown = not na(volume) and volume > 0
bool wfClusterVolume = math.sum(wfVolumeKnown ? 1 : 0, WF_FORM_BARS) == WF_FORM_BARS
float wfPriorActivity = math.sum(wfVolumeKnown ? volume : 0.0, WF_ACTIVITY_BARS)[1] / WF_ACTIVITY_BARS
float wfPriorActivityCount = math.sum(wfVolumeKnown ? 1 : 0, WF_ACTIVITY_BARS)[1]
bool wfActivityPass = wfVolumeKnown and wfPriorActivityCount == WF_ACTIVITY_BARS and
     wfPriorActivity > 0 and volume >= 1.25 * wfPriorActivity
float wfLocation = wfRange > 0 ? (close - low) / wfRange : na

// Fingerprint the finite context used by the local geometry and volume calculation.
int wfToken = (int(time / 1000) + 3 * int(time_close / 1000) + 5 * math.round(open / wfTick) +
     7 * math.round(high / wfTick) + 11 * math.round(low / wfTick) + 13 * math.round(close / wfTick) +
     (wfVolumeKnown ? 17 * int(volume % 1000000007) : 0)) % 1000000007
float wfWindowSum = math.sum(wfToken, 40)
int wfFingerprint = na(wfWindowSum) ? na : int(wfWindowSum) % 1000000007

type WickFormation
    string id
    int side
    int knownAt
    int firstRejection
    int knownIndex
    float top
    float bottom
    float sizeAtr
    bool nearLevel
    bool formationVolume
    bool probed = false
    int breakoutAt = na
    int breakoutIndex = na
    bool retested = false

type WickPlan
    string id
    string formationId
    string model
    int side
    int knownAt
    float entry
    float stop
    float tp1
    float tp2
    float tp3
    float atr
    float barrier
    float netRoom
    bool volumeB
    bool volumeC
    bool context
    string rejection

f_wfNumber(float value) =>
    na(value) ? "NA" : str.tostring(value, "#.########")

f_wfInt(int value) =>
    na(value) ? "NA" : str.tostring(value)

f_wfFlag(bool value) =>
    value ? "1" : "0"

f_wfSide(int side) =>
    side == 1 ? "BUY" : side == -1 ? "SELL" : "—"

f_wfLogId(string id) =>
    str.replace_all(id, "|", ":")

f_wfEvent(string kind, WickFormation formation, int side, string reason) =>
    if wfAuditBar
        bool hasFormation = not na(formation)
        log.info("WICK_EVT|1|" + f_wfInt(time_close) + "|" + str.replace_all(kind, " ", "_") + "|" +
             (hasFormation ? f_wfLogId(formation.id) : "NA") + "|" + str.tostring(side) + "|" +
             (hasFormation ? f_wfInt(formation.knownAt) + "|" + f_wfNumber(formation.top) + "|" +
             f_wfNumber(formation.bottom) + "|" + f_wfNumber(formation.sizeAtr) + "|" +
             str.tostring(bar_index - formation.knownIndex) + "|" + str.tostring(WF_FORM_BARS) + "|" +
             f_wfFlag(formation.nearLevel) + "|" + f_wfFlag(formation.formationVolume) + "|" +
             f_wfInt(formation.breakoutAt) : "NA|NA|NA|NA|NA|NA|NA|NA|NA") + "|" + reason + "|" +
             (hasFormation ? f_wfInt(formation.firstRejection) : "NA"))

f_wfRound(float price, int direction) =>
    float scale = price / wfTick
    (direction > 0 ? math.ceil(scale - 1e-8) : math.floor(scale + 1e-8)) * wfTick

f_wfPlan(WickFormation formation, string model, float stopBase) =>
    int side = formation.side
    float stop = f_wfRound(stopBase - side * 0.10 * wfPriorAtr, -side)
    float risk = math.round(side * (close - stop), 9)
    float outerLevel = side > 0 ? wfPriorHigh : wfPriorLow
    float barrier = bar_index >= WF_ACTIVITY_BARS and not na(outerLevel) and
         side * (outerLevel - close) >= wfTick - 1e-8 ? outerLevel : na
    float room = na(barrier) ? risk : math.min(risk, side * (barrier - close))
    float charge = 0.35 + 2.0 * 2.0 * wfTick + 2.0 * 0.175 / syminfo.pointvalue
    float netRoom = risk > 0 ? (room - charge) / risk : na
    bool volumeB = wfVolumeKnown and wfRange > 0 and
         (side > 0 ? wfLocation : (high - close) / wfRange) >= 0.65
    bool context = not na(wfH1Side) and not na(wfH4Side) and wfH1Side == side and wfH4Side == side
    string reject = risk < math.max(wfTick, 0.25 * wfPriorAtr) ? "STRUCTURE_INVALID" :
         risk > 2.75 * wfPriorAtr ? "OVERSIZED_STOP" :
         (risk + charge) * 3.0 * syminfo.pointvalue > 250.0 ? "CASH_RISK_CAP" :
         risk > 0 and charge / risk > 0.30 ? "COST_TOO_HIGH" :
         risk > 0 and netRoom < 0.70 ? "INSUFFICIENT_NET_ROOM" : ""
    string id = model + "|" + str.tostring(side) + "|" + f_wfInt(formation.knownAt) + "|" + f_wfInt(time_close)
    WickPlan.new(id, formation.id, model, side, time_close, close, stop,
         risk > 0 ? f_wfRound(close + side * risk, side) : na,
         risk > 0 ? f_wfRound(close + 2.0 * side * risk, side) : na,
         risk > 0 ? f_wfRound(close + 3.0 * side * risk, side) : na, wfPriorAtr, barrier, netRoom, volumeB,
         wfActivityPass, context, reject)

f_wfSelectedRejection(WickPlan plan) =>
    string reason = plan.rejection
    if reason == "" and wfVolumePolicy != "A · No volume filter"
        reason := not wfVolumeKnown ? "VOLUME_UNAVAILABLE" :
             wfVolumePolicy == "B · Close-location proxy" and not plan.volumeB ? "CLOSE_LOCATION" :
             wfVolumePolicy == "C · Relative activity" and nz(wfPriorActivityCount, 0) != WF_ACTIVITY_BARS ? "VOLUME_WARMUP" :
             wfVolumePolicy == "C · Relative activity" and not plan.volumeC ? "LOW_RELATIVE_ACTIVITY" : ""
    if reason == "" and wfRequireContext and not plan.context
        reason := "H1_H4_UNALIGNED"
    reason

f_wfLogPlan(WickPlan plan, string selectedRejection) =>
    if wfAuditBar
        log.info("WICK_PLAN|1|" + f_wfInt(plan.knownAt) + "|" + f_wfLogId(plan.id) + "|" + plan.model + "|" +
             str.tostring(plan.side) + "|" + f_wfNumber(plan.entry) + "|" + f_wfNumber(plan.stop) + "|" +
             f_wfNumber(plan.tp1) + "|" + f_wfNumber(plan.tp2) + "|" + f_wfNumber(plan.tp3) + "|" +
             f_wfNumber(plan.atr) + "|" + f_wfNumber(plan.barrier) + "|" + f_wfNumber(plan.netRoom) + "|" +
             f_wfFlag(plan.volumeB) + "|" + f_wfFlag(plan.volumeC) + "|" + f_wfFlag(plan.context) + "|" +
             (plan.rejection == "" ? "OK" : plan.rejection) + "|" +
             (selectedRejection == "" ? "OK" : selectedRejection))

if wfAuditBar
    log.info("WICK_CTX|1|" + syminfo.tickerid + "|" + timeframe.period + "|" + f_wfInt(time) + "|" +
         f_wfInt(time_close) + "|" + f_wfNumber(open) + "|" + f_wfNumber(high) + "|" + f_wfNumber(low) + "|" +
         f_wfNumber(close) + "|" + syminfo.volumetype + "|" + f_wfNumber(volume) + "|" +
         f_wfNumber(wfPriorAtr) + "|" + f_wfInt(wfH1Known) + "|" + f_wfInt(wfH4Known) + "|" +
         f_wfInt(wfH1Side) + "|" + f_wfInt(wfH4Side) + "|" + f_wfInt(wfFingerprint) + "|" +
         f_wfNumber(wfTick) + "|" + f_wfFlag(wfVolumeKnown) + "|" + f_wfNumber(wfUpper) + "|" +
         f_wfNumber(wfLower) + "|" + f_wfNumber(wfPriorActivity) + "|" + f_wfInt(int(wfPriorActivityCount)))

var WickFormation wfActive = na
var string wfLastClosed = "—"
var string wfState = "WAIT"
var string wfReason = ""
var int wfStateSide = 0
bool wfBuildingEvent = false
bool wfNewFormation = false
bool wfBreakout = false
bool wfNewRetest = false
bool wfFalseBreakout = false
bool wfExpired = false
bool wfProbeEvent = false
WickPlan wfOfferedPlan = na
WickPlan wfSelectedPlan = na
WickFormation wfEventFormation = na
bool wfWasActive = not na(wfActive)

if wfConfirmed and wfWasActive
    WickFormation formation = wfActive
    wfEventFormation := formation
    int side = formation.side
    float edge = side > 0 ? formation.top : formation.bottom
    float opposite = side > 0 ? formation.bottom : formation.top
    float extreme = side > 0 ? high : low
    float touch = side > 0 ? low : high
    float body = side * (close - open)
    float beyond = side * (close - edge)
    wfStateSide := side
    wfReason := ""
    if na(formation.breakoutAt)
        wfState := f_wfSide(side) + " WATCH"
        if bar_index - formation.knownIndex > WF_WATCH_BARS or time_close - formation.knownAt > WF_WATCH_BARS * wfInterval
            wfExpired := true
            wfReason := "BREAKOUT_WINDOW_EXPIRED"
        else if side * (close - opposite) < 0
            wfExpired := true
            wfReason := "OPPOSITE_EDGE_CLOSE"
        else if beyond >= 0.05 * wfPriorAtr and body >= 0.35 * wfPriorAtr
            wfBreakout := true
            formation.breakoutAt := time_close
            formation.breakoutIndex := bar_index
            wfState := f_wfSide(side) + " BREAKOUT CONFIRMED"
            f_wfEvent(wfState, formation, side, "DIRECTIONAL_CLOSE")
            wfOfferedPlan := f_wfPlan(formation, "WICK_BREAKOUT", opposite)
        else if not formation.probed and side * (extreme - edge) >= 0.05 * wfPriorAtr
            formation.probed := true
            wfProbeEvent := true
            wfState := "BREAKOUT PENDING"
            wfReason := side * (touch - opposite) <= -0.05 * wfPriorAtr ? "BOTH_EDGES_PROBED" :
                 beyond >= 0.05 * wfPriorAtr ? "INSUFFICIENT_CLOSE_DISPLACEMENT" : "EXTREME_WITHOUT_CLOSE"
            f_wfEvent(wfState, formation, side, wfReason)
    else
        wfState := "RETEST WATCH"
        if bar_index - formation.breakoutIndex > WF_RETEST_BARS or time_close - formation.breakoutAt > WF_RETEST_BARS * wfInterval
            wfExpired := true
            wfReason := "RETEST_WINDOW_EXPIRED"
        else if beyond <= 0
            wfFalseBreakout := true
            wfState := "FALSE BREAKOUT"
            wfReason := "CLOSE_BACK_INSIDE"
            f_wfEvent(wfState, formation, side, wfReason)
        else if not formation.retested and math.abs(touch - edge) <= 0.15 * wfPriorAtr and
             beyond >= 0.10 * wfPriorAtr and body > 0
            formation.retested := true
            wfNewRetest := true
            wfReason := "EDGE_RETEST"
            wfOfferedPlan := f_wfPlan(formation, "WICK_RETEST", touch)
    if wfExpired
        wfState := "FORMATION EXPIRED"
        f_wfEvent(wfState, formation, side, wfReason)
    if wfExpired or wfFalseBreakout
        wfLastClosed := f_wfSide(side) + " · " + (wfExpired ? "EXPIRED" : "FALSE BREAKOUT")
        wfActive := na

if wfConfirmed and not wfWasActive
    bool ambiguous = wfBuyCount > 0 and wfSellCount > 0
    int side = ambiguous ? 0 : wfBuyCount > 0 ? 1 : wfSellCount > 0 ? -1 : 0
    bool clustered = not ambiguous and math.max(wfBuyCount, wfSellCount) >= 2
    bool evidence = wfSequenceReady and (wfBuyCount > 0 or wfSellCount > 0)
    wfStateSide := side
    wfReason := ""
    if evidence and clustered and (wfWindowHigh - wfWindowLow) / wfPriorAtr <= 2.00
        bool nearLevel = side > 0 ? wfClusterNearSupport : wfClusterNearResistance
        int firstRejection = time_close
        for ago = 1 to WF_FORM_BARS - 1
            if side > 0 ? wfBuyEvidence[ago] : wfSellEvidence[ago]
                firstRejection := time_close[ago]
        wfActive := WickFormation.new("WF|" + str.tostring(side) + "|" + f_wfInt(time_close), side, time_close,
             firstRejection, bar_index, wfWindowHigh, wfWindowLow, (wfWindowHigh - wfWindowLow) / wfPriorAtr,
             nearLevel, wfClusterVolume)
        wfNewFormation := true
        wfEventFormation := wfActive
        wfState := f_wfSide(side) + " WATCH"
        f_wfEvent(wfState, wfActive, side, "WICK_CLUSTER_CONFIRMED")
    else if evidence
        wfState := "FORMATION BUILDING"
        wfReason := ambiguous ? "OPPOSING_REJECTIONS" : clustered ? "RANGE_TOO_WIDE" : "FIRST_REJECTION"
        if wfBuyEvidence or wfSellEvidence
            wfBuildingEvent := true
            f_wfEvent(wfState, na, side, wfReason)
    else
        wfState := "WAIT"
if not na(wfOfferedPlan)
    f_wfEvent(wfOfferedPlan.rejection == "" ? "ENTRY VALID" : "RISK REJECTED", wfEventFormation,
         wfOfferedPlan.side, wfOfferedPlan.rejection == "" ? "PRICE_AND_RISK_VALID" : wfOfferedPlan.rejection)
    if wfBreakout
        f_wfEvent("RETEST WATCH", wfEventFormation, wfOfferedPlan.side, "BREAKOUT_EDGE_KNOWN")
    string rejection = f_wfSelectedRejection(wfOfferedPlan)
    bool selected = wfEntryPolicy == "Breakout" ? wfBreakout : wfNewRetest
    f_wfLogPlan(wfOfferedPlan, selected ? rejection : "POLICY_NOT_SELECTED")
    if selected
        wfState := rejection == "" ? "ENTRY VALID" : "RISK REJECTED"
        wfReason := rejection
        if rejection == ""
            wfSelectedPlan := wfOfferedPlan

bool wfIntrabarPending = wfSupported and barstate.isrealtime and not barstate.isconfirmed and not na(wfActive) and
     na(wfActive.breakoutAt) and not wfActive.probed and
     (wfActive.side > 0 ? high >= wfActive.top + 0.05 * wfPriorAtr : low <= wfActive.bottom - 0.05 * wfPriorAtr)

string wfTradeState = "OBSERVATION"
bool wfExecutionPending = false
bool wfPositionOpen = false
int wfActiveSide = 0
float wfActiveStop = na
float wfActiveEntry = na
float wfActiveFirstTarget = na
float wfActiveSecondTarget = na
float wfActiveThirdTarget = na

// V3 PRESENTATION ONLY

string v3Preset = input.string("LIVE PREMIUM", "Presentation",
     options=["LIVE PREMIUM", "COMPACT", "MOBILE", "FULL AUDIT"], group="V3 presentation", display=display.none)
string v3PanelCorner = input.string("Auto", "Panel corner",
     options=["Auto", "Top right", "Bottom right", "Bottom left", "Top left"], group="V3 presentation", display=display.none)
bool v3ShowPanel = input.bool(true, "Show dashboard", group="V3 presentation", display=display.none)
bool v3ShowZones = input.bool(true, "Formation zones", group="V3 chart", display=display.none)
bool v3ShowMarkers = input.bool(true, "Signal markers", group="V3 chart", display=display.none)
bool v3ShowPlan = input.bool(true, "Trade plan levels", group="V3 chart", display=display.none)
bool v3ShowRiskZones = input.bool(true, "Trade risk and reward zones", group="V3 chart", display=display.none)
bool v3ShowPriceTags = input.bool(true, "Trade price tags", group="V3 chart", display=display.none)
bool v3Inspect = input.bool(false, "Inspect a historical bar close in FULL AUDIT",
     group="V3 historical inspection", display=display.none,
     tooltip="Show only the plan and state known at or before the selected UTC time. This changes presentation only.")
int v3InspectAt = input.time(timestamp("10 Nov 2026 16:10 +0000"), "Historical bar close",
     group="V3 historical inspection", display=display.none)

color v3Graphite = #0D1520
color v3Panel = #172435
color v3Emerald = #12C9A7
color v3Coral = #F05265
color v3Cyan = #39BED5
color v3Amber = #E9B65D
color v3Text = #E8EDF3
color v3Muted = #91A3B8
color v3Border = #293544
color v3Raised = #20324A
bool v3Live = v3Preset == "LIVE PREMIUM"
bool v3Compact = v3Preset == "COMPACT"
bool v3Mobile = v3Preset == "MOBILE"
bool v3Audit = v3Preset == "FULL AUDIT"
bool v3Light = color.r(chart.bg_color) * 0.2126 + color.g(chart.bg_color) * 0.7152 +
     color.b(chart.bg_color) * 0.0722 > 145
color v3ChartBuy = v3Light ? #007969 : v3Emerald
color v3ChartSell = v3Light ? #AE3048 : v3Coral
color v3ChartCyan = v3Light ? #0C6980 : v3Cyan
color v3ChartAmber = v3Light ? #885907 : v3Amber
color v3ChartNeutral = v3Light ? #495F74 : v3Muted
string v3PanelPosition = switch v3PanelCorner
    "Top right" => position.top_right
    "Bottom right" => position.bottom_right
    "Bottom left" => position.bottom_left
    "Top left" => position.top_left
    => v3Mobile ? position.bottom_right : position.top_right

f_v3SideInk(int side) =>
    side > 0 ? v3ChartBuy : side < 0 ? v3ChartSell : v3ChartNeutral

f_v3Price(float value) =>
    na(value) ? "—" : str.tostring(value, format.mintick)

f_v3Utc(int value) =>
    na(value) ? "—" : str.format_time(value, "HH:mm", "UTC") + " UTC"

WickPlan v3RolePlan = na
float v3RoleFill = na
int v3RoleFillAt = na
string v3RoleLast = "—"
bool v3RoleSim = false
bool v3RoleWindow = false

// A read-only view of confirmed decisions and native simulation state.
var WickPlan v3LatestOffer = na
var int v3LatestClose = na
var string v3LatestStage = "WAIT"
var string v3LatestReason = ""
var int v3LatestSide = 0
var bool v3LatestInWindow = false
var string v3LatestResult = "—"
var bool v3LatestVolume = false

if wfConfirmed
    v3LatestOffer := wfSelectedPlan
    v3LatestClose := time_close
    v3LatestStage := wfState
    v3LatestReason := wfReason
    v3LatestSide := wfStateSide
    v3LatestInWindow := v3RoleWindow
    v3LatestResult := v3RoleLast
    v3LatestVolume := wfVolumeKnown

bool v3Review = v3Audit and v3Inspect
int v3Clock = (barstate.islast or barstate.islastconfirmedhistory) ?
     math.max(nz(v3LatestClose, time), timenow) : nz(v3LatestClose, time)
int v3Known = nz(v3LatestClose, time)
int v3CurrentDeadline = na(wfActive) ? na : na(wfActive.breakoutAt) ?
     wfActive.knownAt + WF_WATCH_BARS * wfInterval : wfActive.breakoutAt + WF_RETEST_BARS * wfInterval
bool v3FormationFresh = wfSupported and not na(v3CurrentDeadline) and v3Clock <= v3CurrentDeadline
bool v3OfferFresh = wfSupported and not na(v3LatestOffer) and v3Clock < v3LatestOffer.knownAt + wfInterval

var WickPlan v3ReviewPlan = na
var int v3ReviewKnown = na
var float v3ReviewFill = na
var int v3ReviewFillAt = na
var bool v3ReviewPending = false
var bool v3ReviewOpen = false
var string v3ReviewStage = "WAIT"
var string v3ReviewReason = ""
var int v3ReviewSide = 0
var int v3ReviewH1 = na
var int v3ReviewH4 = na
var int v3ReviewDeadline = na
var int v3ReviewFirst = na
var float v3ReviewTop = na
var float v3ReviewBottom = na
var string v3ReviewLast = "—"
var bool v3ReviewVolume = false
if v3Review and wfConfirmed and time_close <= v3InspectAt
    v3ReviewKnown := time_close
    v3ReviewPlan := not na(v3RolePlan) ? v3RolePlan : wfSelectedPlan
    v3ReviewFill := v3RoleFill
    v3ReviewFillAt := v3RoleFillAt
    v3ReviewPending := wfExecutionPending
    v3ReviewOpen := wfPositionOpen
    v3ReviewStage := wfState
    v3ReviewReason := wfReason
    v3ReviewSide := wfStateSide
    v3ReviewH1 := wfH1Side
    v3ReviewH4 := wfH4Side
    v3ReviewDeadline := v3CurrentDeadline
    v3ReviewFirst := na(wfActive) ? na : wfActive.knownAt
    v3ReviewTop := na(wfActive) ? na : wfActive.top
    v3ReviewBottom := na(wfActive) ? na : wfActive.bottom
    v3ReviewLast := v3RoleLast
    v3ReviewVolume := wfVolumeKnown

bool v3ReviewReady = v3Review and not na(v3ReviewKnown) and
     v3InspectAt >= v3ReviewKnown and v3InspectAt - v3ReviewKnown < wfInterval
WickPlan v3ViewPlan = v3Review ? (v3ReviewReady ? v3ReviewPlan : na) :
     not na(v3RolePlan) ? v3RolePlan : v3OfferFresh ? v3LatestOffer : na
bool v3ViewPending = v3Review ? v3ReviewReady and v3ReviewPending : wfExecutionPending
bool v3ViewOpen = v3Review ? v3ReviewReady and v3ReviewOpen : wfPositionOpen
bool v3PlanFresh = not v3Review and v3OfferFresh and not v3ViewOpen and not v3ViewPending and
     (not v3RoleSim or v3LatestInWindow)
float v3FillPrice = v3Review ? (v3ReviewReady ? v3ReviewFill : na) : v3RoleFill
int v3FillAt = v3Review ? (v3ReviewReady ? v3ReviewFillAt : na) : v3RoleFillAt
int v3ViewAt = v3Review ? v3ReviewKnown : v3Known
int v3ViewSide = v3Review ? v3ReviewSide : v3LatestSide
int v3H1 = v3Review ? v3ReviewH1 : wfH1Side
int v3H4 = v3Review ? v3ReviewH4 : wfH4Side
bool v3CompactType = v3Compact or v3Mobile
int v3MarketSide = not na(v3H1) and not na(v3H4) and v3H1 == v3H4 ? v3H1 : 0
string v3MarketBias = na(v3H1) or na(v3H4) ? (v3CompactType ? "NO DATA" : "UNAVAILABLE") :
     v3MarketSide > 0 ? "BULLISH" : v3MarketSide < 0 ? "BEARISH" :
     v3H1 == 0 and v3H4 == 0 ? "NEUTRAL" : "MIXED"
color v3BiasInk = v3MarketSide > 0 ? v3Emerald : v3MarketSide < 0 ? v3Coral : v3Text
string v3RawStage = v3Review ? (v3ReviewReady ? v3ReviewStage : "WAIT") : v3LatestStage
string v3RawReason = v3Review ? v3ReviewReason : v3LatestReason
bool v3Unexpired = v3Review ? v3ReviewReady and not na(v3ReviewDeadline) : v3FormationFresh
bool v3FormationTimedOut = not v3Review and not na(v3CurrentDeadline) and not v3FormationFresh
bool v3BuildingFresh = v3Review or (not na(v3LatestClose) and v3Clock < v3LatestClose + wfInterval)
string v3FormationStage = switch
    not wfSupported => "UNSUPPORTED CHART"
    v3Review and not v3ReviewReady => "NO CLOSED BAR"
    v3RawStage == "FALSE BREAKOUT" => "BREAKOUT RECLAIMED"
    v3RawReason == "OPPOSITE_EDGE_CLOSE" => "INVALIDATED"
    v3RawStage == "FORMATION EXPIRED" or v3FormationTimedOut => "EXPIRED"
    not v3Review and wfIntrabarPending and v3FormationFresh => "PROBE · UNCONFIRMED"
    v3RawStage == "FORMATION BUILDING" and v3BuildingFresh => "FORMING"
    v3RawStage == "RISK REJECTED" and v3Unexpired => "CLOSE CONFIRMED"
    v3RawStage == "ENTRY VALID" and v3Unexpired => "CLOSE CONFIRMED"
    v3RawStage == "BREAKOUT PENDING" and v3Unexpired => "PROBE · UNCONFIRMED"
    v3RawStage == "RETEST WATCH" and v3Unexpired => "RETEST WINDOW"
    str.contains(v3RawStage, "CONFIRMED") and v3Unexpired => "CLOSE CONFIRMED"
    v3Unexpired => v3ViewSide > 0 ? "BUY WATCH" : "SELL WATCH"
    => "SCANNING"

string v3Action = switch
    not wfSupported => "UNSUPPORTED"
    v3Review => "HISTORICAL"
    v3ViewOpen => "SIM OPEN"
    v3ViewPending => "SIM PENDING"
    v3PlanFresh => v3ViewPlan.side > 0 ? "BUY PLAN" : "SELL PLAN"
    v3OfferFresh and v3RoleSim and not v3LatestInWindow => "SIM WINDOW OFF"
    v3RawStage == "RISK REJECTED" and v3Unexpired => "RISK REJECTED"
    => "WAIT"
color v3ActionInk = v3PlanFresh ? (v3ViewPlan.side > 0 ? v3Emerald : v3Coral) :
     v3ViewOpen or v3ViewPending ? v3Cyan : v3Action == "RISK REJECTED" ? v3Amber : v3Text

f_v3Reason(string reason) =>
    switch reason
        "COST_TOO_HIGH" => "COST TOO HIGH"
        "INSUFFICIENT_NET_ROOM" => "LIMITED REWARD"
        "STRUCTURE_INVALID" => "INVALID STOP"
        "OVERSIZED_STOP" => "STOP TOO WIDE"
        "CASH_RISK_CAP" => "RISK CAP"
        "H1_H4_UNALIGNED" => "H1 / H4 FILTER"
        "VOLUME_UNAVAILABLE" => "VOLUME MISSING"
        "VOLUME_WARMUP" => "VOLUME WARMUP"
        "LOW_RELATIVE_ACTIVITY" => "LOW ACTIVITY"
        "CLOSE_LOCATION" => "CLOSE LOCATION"
        "OPPOSING_REJECTIONS" => "MIXED WICKS"
        "RANGE_TOO_WIDE" => "RANGE TOO WIDE"
        "CLOSE_BACK_INSIDE" => "CLOSED INSIDE"
        "OPPOSITE_EDGE_CLOSE" => "OPPOSITE EDGE"
        => ""

string v3Quality = not na(v3ViewPlan) ? "RISK CHECK PASSED" :
     f_v3Reason(v3RawReason) != "" and (v3Unexpired or v3BuildingFresh) ? f_v3Reason(v3RawReason) :
     v3Unexpired and not na(wfActive) and wfActive.nearLevel and not v3Review ? "AT PRIOR LEVEL" :
     v3Unexpired or v3FormationStage == "FORMING" ? "AWAITING PROOF" : "—"
int v3First = v3Review ? v3ReviewFirst : v3FormationFresh ? wfActive.knownAt : na
int v3Deadline = v3Review ? v3ReviewDeadline : v3FormationFresh ? v3CurrentDeadline : na
int v3MinutesLeft = na(v3Deadline) ? na : int(math.ceil(math.max(0, v3Deadline - (v3Review ? v3ViewAt : v3Clock)) / 60000.0))
string v3Freshness = not na(v3MinutesLeft) ? str.tostring(v3MinutesLeft) + "m LEFT" :
     v3FormationStage == "FORMING" ? "LATEST CLOSE" : "—"
float v3Top = v3Review ? v3ReviewTop : v3FormationFresh ? wfActive.top : na
float v3Bottom = v3Review ? v3ReviewBottom : v3FormationFresh ? wfActive.bottom : na
string v3FormationRange = na(v3Top) ? "—" : f_v3Price(v3Bottom) + " – " + f_v3Price(v3Top)
string v3ModeStatus = v3Review ? "REVIEW · " + f_v3Utc(v3ViewAt) : not wfSupported ? "STANDARD OANDA XAUUSD" :
     v3RoleSim ? "STRATEGY SIMULATION" : "MONITORING"
string v3Feed = (v3Review ? v3ReviewVolume : v3LatestVolume) ?
     (syminfo.volumetype == "tick" ? "OANDA · TICK VOL" : "OANDA · VOLUME") : "OANDA · VOL MISSING"
string v3LastResult = v3Review ? v3ReviewLast : v3LatestResult
string v3PlanWindow = v3Review ? (v3ReviewReady ? "AS OF " + f_v3Utc(v3ViewAt) : "NO CLOSED BAR AT CURSOR") :
     v3ViewOpen ? "NATIVE SIMULATION · OPEN" : v3ViewPending ? "NATIVE SIMULATION · NEXT OPEN" :
     not na(v3ViewPlan) ? "NEXT OPEN · DISPLAY UNTIL " + f_v3Utc(v3ViewPlan.knownAt + wfInterval) : "AWAITING A VALID PLAN"

// The zone starts at the formation's known close, using the two frozen prices.
type V3WickZone
    box area
    line upper
    line lower

f_v3OpenWickZone(WickFormation formation) =>
    color ink = f_v3SideInk(formation.side)
    int right = v3Review ? math.min(formation.knownAt + wfInterval, v3InspectAt) : formation.knownAt + wfInterval
    box area = box.new(formation.knownAt, formation.top, right, formation.bottom,
         xloc=xloc.bar_time, bgcolor=color.new(ink, 94), border_color=color.new(ink, 79),
         text_halign=text.align_left, text_valign=text.align_top, text_color=ink,
         text_size=9, text_formatting=text.format_bold)
    line upper = line.new(formation.knownAt, formation.top, right, formation.top, xloc=xloc.bar_time,
         color=color.new(ink, formation.side > 0 ? 16 : 49),
         style=formation.side > 0 ? line.style_solid : line.style_dotted)
    line lower = line.new(formation.knownAt, formation.bottom, right, formation.bottom, xloc=xloc.bar_time,
         color=color.new(ink, formation.side < 0 ? 16 : 49),
         style=formation.side < 0 ? line.style_solid : line.style_dotted)
    V3WickZone.new(area, upper, lower)

f_v3SetWickZoneRight(V3WickZone zone, int right) =>
    box.set_right(zone.area, right)
    line.set_x2(zone.upper, right)
    line.set_x2(zone.lower, right)

f_v3ArchiveWickZone(V3WickZone zone, bool failed) =>
    color ink = failed ? v3Amber : v3Muted
    box.set_bgcolor(zone.area, color.new(ink, 98))
    box.set_border_color(zone.area, color.new(ink, 87))
    box.set_text(zone.area, "")
    line.set_color(zone.upper, color.new(ink, 72))
    line.set_color(zone.lower, color.new(ink, 72))
    line.set_style(zone.upper, line.style_dotted)
    line.set_style(zone.lower, line.style_dotted)

f_v3DeleteWickZone(V3WickZone zone) =>
    box.delete(zone.area)
    line.delete(zone.upper)
    line.delete(zone.lower)

var V3WickZone v3OpenZone = na
var array<V3WickZone> v3WickZoneHistory = array.new<V3WickZone>()
bool v3WickDrawingBar = wfConfirmed and (not v3Review or time_close <= v3InspectAt)
var int v3WickDrawingIndex = na
if v3WickDrawingBar
    v3WickDrawingIndex := bar_index
if v3WickDrawingBar and v3ShowZones
    if wfNewFormation
        v3OpenZone := f_v3OpenWickZone(wfEventFormation)
    else if not na(v3OpenZone)
        bool terminal = wfFalseBreakout or wfExpired
        int right = v3Review ? math.min(time_close + wfInterval, v3InspectAt) : time_close + wfInterval
        f_v3SetWickZoneRight(v3OpenZone, terminal ? time_close : right)
        if terminal
            if v3Audit
                f_v3ArchiveWickZone(v3OpenZone, wfFalseBreakout or wfReason == "OPPOSITE_EDGE_CLOSE")
                if array.size(v3WickZoneHistory) >= 12
                    f_v3DeleteWickZone(array.shift(v3WickZoneHistory))
                array.push(v3WickZoneHistory, v3OpenZone)
            else
                f_v3DeleteWickZone(v3OpenZone)
            v3OpenZone := na
        else if v3FormationFresh and not v3Mobile and not wfExecutionPending and not wfPositionOpen and na(wfSelectedPlan)
            bool enoughWidth = bar_index - wfActive.knownIndex >= 2
            string caption = not enoughWidth ? "" : na(wfActive.breakoutAt) ? "  WICK RANGE  " :
                 wfActive.retested ? "  RETEST SEEN  " : "  RETEST ZONE  "
            box.set_text(v3OpenZone.area, caption)
        else
            box.set_text(v3OpenZone.area, "")

if (barstate.islast or barstate.islastconfirmedhistory) and not v3Audit and
     not v3FormationFresh and not na(v3OpenZone)
    f_v3DeleteWickZone(v3OpenZone)
    v3OpenZone := na

// Rank selects one glyph. Secondary observations remain in its tooltip and the original audit log.
const int V3_MARK_WICK = 1
const int V3_MARK_PROBE = 2
const int V3_MARK_WATCH = 3
const int V3_MARK_RETEST = 4
const int V3_MARK_EXPIRED = 5
const int V3_MARK_INVALID = 6
const int V3_MARK_FAILED = 7
const int V3_MARK_BREAKOUT = 8
const int V3_MARK_APPROVED = 9

f_v3WickMarkerRank() =>
    bool nearRejection = (wfBuyEvidence and wfNearSupport) or (wfSellEvidence and wfNearResistance)
    if not na(wfSelectedPlan)
        V3_MARK_APPROVED
    else if wfBreakout
        V3_MARK_BREAKOUT
    else if wfFalseBreakout
        V3_MARK_FAILED
    else if wfExpired and wfReason == "OPPOSITE_EDGE_CLOSE"
        V3_MARK_INVALID
    else if wfExpired and v3Audit
        V3_MARK_EXPIRED
    else if wfNewRetest
        V3_MARK_RETEST
    else if wfNewFormation
        V3_MARK_WATCH
    else if wfProbeEvent and v3Audit
        V3_MARK_PROBE
    else if wfBuildingEvent and (v3Audit or (v3Live and nearRejection))
        V3_MARK_WICK
    else
        0

f_v3WickMarkerText(int rank, int side) =>
    string direction = f_wfSide(side)
    string arrow = side > 0 ? "↑" : "↓"
    switch rank
        V3_MARK_APPROVED => direction
        V3_MARK_BREAKOUT => (v3Mobile or v3Compact ? "BREAK " : "BREAKOUT ") + arrow
        V3_MARK_FAILED => v3Mobile ? "FAILED" : "FALSE BREAK"
        V3_MARK_INVALID => v3Mobile or v3Compact ? "INVALID" : "INVALIDATED"
        V3_MARK_EXPIRED => "EXPIRED"
        V3_MARK_RETEST => "RETEST"
        V3_MARK_WATCH => direction + " WATCH"
        V3_MARK_PROBE => "◇"
        => "•"

f_v3WickMarkerTooltip(int rank, int side) =>
    string title = switch rank
        V3_MARK_APPROVED => "Confirmed " + f_wfSide(side) + " plan"
        V3_MARK_BREAKOUT => "Confirmed " + f_wfSide(side) + " breakout"
        V3_MARK_FAILED => "False breakout · close back inside"
        V3_MARK_INVALID => "Formation invalidated · opposite edge closed through"
        V3_MARK_EXPIRED => "Formation expired"
        V3_MARK_RETEST => "Confirmed retest · breakout edge held"
        V3_MARK_WATCH => f_wfSide(side) + " watch · formation recognized"
        V3_MARK_PROBE => "Breakout probe · not close-confirmed"
        => "Wick rejection observed"
    string details = title + "\nClosed " + str.format_time(time_close, "dd MMM HH:mm", "UTC") + " UTC"
    if not na(wfEventFormation)
        details += "\nFormation " + wfEventFormation.id +
             "\nRange " + f_v3Price(wfEventFormation.bottom) + "–" + f_v3Price(wfEventFormation.top)
    if wfBreakout
        details += "\nDirectional close confirmed · retest watch opened"
    if wfNewRetest
        details += "\nRetest confirmed on this close"
    if not na(wfSelectedPlan)
        details += "\nApproved plan at " + f_v3Price(wfSelectedPlan.entry) + " · SL " +
             f_v3Price(wfSelectedPlan.stop) + "\nActual execution is a separate event."
    else if not na(wfOfferedPlan) and wfState == "RISK REJECTED"
        details += "\nSelected plan rejected · " + str.replace_all(wfReason, "_", " ")
    else if not na(wfOfferedPlan)
        string result = wfOfferedPlan.rejection == "" ? "Price and risk valid" :
             str.replace_all(wfOfferedPlan.rejection, "_", " ")
        details += "\n" + result + " · lane not selected"
    else if wfReason != ""
        details += "\n" + str.replace_all(wfReason, "_", " ")
    details

type V3WickBadge
    label drawing
    int index
    int rank
    bool below
    float price
    color background
    color foreground

var array<V3WickBadge> v3WickBadges = array.new<V3WickBadge>()
if v3WickDrawingBar and v3ShowMarkers
    int rank = f_v3WickMarkerRank()
    int count = array.size(v3WickBadges)
    V3WickBadge previous = count > 0 ? array.get(v3WickBadges, count - 1) : na
    bool dotSpacing = na(previous) or bar_index - previous.index >= 5
    if rank > 0 and (rank != V3_MARK_WICK or v3Audit or dotSpacing)
        int side = wfStateSide
        bool approved = rank == V3_MARK_APPROVED
        bool glyph = rank == V3_MARK_WICK or rank == V3_MARK_PROBE
        bool terminal = rank == V3_MARK_FAILED or rank == V3_MARK_INVALID or rank == V3_MARK_EXPIRED
        bool submitted = approved and wfExecutionPending and not na(v3RolePlan) and
             v3RolePlan.id == wfSelectedPlan.id
        // Reserve the usual BUY/SELL side for TradingView's neighboring native fill arrow.
        bool below = terminal or submitted ? side < 0 : side > 0
        float atr = nz(wfPriorAtr, high - low)
        float offset = math.max(4.0 * wfTick, atr * (approved ? 0.25 : 0.15))
        float price = below ? low - offset : high + offset
        if not glyph and not na(previous) and previous.rank > V3_MARK_PROBE and
             below == previous.below and bar_index - previous.index <= 2
            float gap = math.max(8.0 * wfTick, atr * 0.48)
            float lift = gap * 1.5
            price := below ? math.max(price - lift, math.min(price, previous.price - gap)) :
                 math.min(price + lift, math.max(price, previous.price + gap))
        color accent = side > 0 ? v3Emerald : side < 0 ? v3Coral : v3Muted
        color background = glyph ? color.new(v3Graphite, 100) : approved ? accent : v3Graphite
        color foreground = glyph ? color.new(f_v3SideInk(side), 30) : approved ? v3Graphite :
             rank == V3_MARK_EXPIRED ? v3Muted : terminal ? v3Amber :
             rank == V3_MARK_RETEST or rank == V3_MARK_BREAKOUT ? v3Cyan : accent
        int textSize = approved ? (v3Mobile ? 10 : 13) : glyph ? 9 : v3Mobile or v3Compact ? 8 : 10
        int limit = v3Audit ? 30 : v3Live ? 3 : 2
        if not v3Audit and not na(previous) and previous.rank <= V3_MARK_PROBE and
             rank > previous.rank and bar_index - previous.index <= 1
            V3WickBadge nearby = array.pop(v3WickBadges)
            label.delete(nearby.drawing)
        if array.size(v3WickBadges) >= limit
            V3WickBadge oldest = array.shift(v3WickBadges)
            label.delete(oldest.drawing)
        label marker = label.new(bar_index, price, f_v3WickMarkerText(rank, side), yloc=yloc.price,
             color=background, textcolor=foreground, size=textSize,
             style=glyph ? label.style_none : below ? label.style_label_up : label.style_label_down,
             text_formatting=approved ? text.format_bold : text.format_none,
             tooltip=f_v3WickMarkerTooltip(rank, side))
        array.push(v3WickBadges, V3WickBadge.new(marker, bar_index, rank, below, price, background, foreground))

if (barstate.islast or barstate.islastconfirmedhistory) and array.size(v3WickBadges) > 0
    for badge in v3WickBadges
        int age = (v3Review ? nz(v3WickDrawingIndex, bar_index) : bar_index) - badge.index
        int opacity = age <= 2 ? 0 : age <= 12 ? 10 : badge.rank == V3_MARK_APPROVED ? 17 : 26
        if badge.rank > V3_MARK_PROBE
            label.set_color(badge.drawing, color.new(badge.background, opacity))
        label.set_textcolor(badge.drawing, color.new(badge.foreground,
             math.min(100, int(color.t(badge.foreground)) + int(opacity / 2))))

// Only the selected view has a risk map. Reuse a fixed set of drawing objects.
var array<line> v3RiskLines = array.new<line>()
var array<label> v3RiskTags = array.new<label>()
var box v3LossZone = na
var box v3RewardZone = na

f_v3RiskLevel(int slot, int left, int right, float price, string name, color ink, string stroke, bool tagged) =>
    line rail = array.get(v3RiskLines, slot)
    label tag = array.get(v3RiskTags, slot)
    line.set_xy1(rail, left, price)
    line.set_xy2(rail, right, price)
    line.set_color(rail, ink)
    line.set_style(rail, stroke)
    line.set_width(rail, slot <= 1 ? 2 : 1)
    // Historical labels face the open chart area to the right of the review cut.
    label.set_style(tag, v3Review ? label.style_label_left : label.style_label_right)
    label.set_xy(tag, right, tagged ? price : na)
    label.set_text(tag, tagged ? name + "  " + f_v3Price(price) : "")
    label.set_color(tag, v3Light ? #EDF3F8 : v3Graphite)
    label.set_textcolor(tag, ink)
    label.set_tooltip(tag, name + " · " + f_v3Price(price))

f_v3RiskBand(box band, int left, int right, float first, float second, color ink) =>
    box.set_lefttop(band, left, math.max(first, second))
    box.set_rightbottom(band, right, math.min(first, second))
    box.set_bgcolor(band, ink)

bool v3RiskRender = (barstate.islast or barstate.islastconfirmedhistory) and wfSupported
if v3RiskRender
    bool visible = v3ShowPlan and not na(v3ViewPlan)
    if visible
        if array.size(v3RiskLines) == 0
            for slot = 0 to 5
                array.push(v3RiskLines, line.new(time, na, time, na, xloc=xloc.bar_time))
                array.push(v3RiskTags, label.new(time, na, xloc=xloc.bar_time, yloc=yloc.price,
                     style=label.style_label_right, size=9, text_font_family=font.family_monospace))
            v3LossZone := box.new(time, na, time, na, xloc=xloc.bar_time, border_width=0)
            v3RewardZone := box.new(time, na, time, na, xloc=xloc.bar_time, border_width=0)
        int left = v3ViewPlan.knownAt
        int right = v3Review ? math.max(left + wfInterval, v3ViewAt) : math.max(left + wfInterval, time_close + 2 * wfInterval)
        float entry = v3ViewPlan.entry
        float stop = v3ViewPlan.stop
        float first = v3ViewPlan.tp1
        float second = v3ViewPlan.tp2
        float third = v3ViewPlan.tp3
        bool tags = v3ShowPriceTags and not v3Mobile
        float gap = math.max(wfTick * 5.0, v3ViewPlan.atr * (v3Compact ? 0.58 : 0.42))
        float fillGap = math.max(wfTick * 2.0, v3ViewPlan.atr * 0.12)
        bool showFill = not na(v3FillPrice) and not na(v3FillAt) and math.abs(v3FillPrice - entry) >= fillGap
        bool showMidTarget = tags and not v3Compact and math.abs(second - third) >= gap
        bool showFirstTarget = tags and not v3Compact and math.abs(first - entry) >= gap and
             math.abs(first - (showMidTarget ? second : third)) >= gap
        f_v3RiskLevel(0, left, right, entry, "ENTRY PLAN", v3ChartCyan, line.style_dashed, tags)
        f_v3RiskLevel(1, left, right, stop, "SL · FIXED", v3ChartSell, line.style_solid, tags)
        f_v3RiskLevel(2, left, right, first, "TP1 · 1R", v3ChartBuy, line.style_dotted, showFirstTarget)
        f_v3RiskLevel(3, left, right, second, "TP2 · 2R", v3ChartBuy, line.style_dotted, showMidTarget)
        f_v3RiskLevel(4, left, right, third, "TP3 · 3R", v3ChartBuy, line.style_solid, tags)
        f_v3RiskLevel(5, showFill ? math.max(left, v3FillAt) : left, right, showFill ? v3FillPrice : na,
             "SIM FILL", v3ChartNeutral, line.style_solid,
             tags and showFill and math.abs(v3FillPrice - entry) >= gap and
             math.abs(v3FillPrice - stop) >= gap and math.abs(v3FillPrice - first) >= gap)
        bool zones = v3ShowRiskZones and not v3Mobile
        f_v3RiskBand(v3LossZone, left, right, zones ? entry : na, zones ? stop : na,
             color.new(v3ChartSell, v3Light ? 90 : 88))
        f_v3RiskBand(v3RewardZone, left, right, zones ? entry : na, zones ? third : na,
             color.new(v3ChartBuy, v3Light ? 94 : 92))
    else if array.size(v3RiskLines) > 0
        for slot = 0 to 5
            line.delete(array.get(v3RiskLines, slot))
            label.delete(array.get(v3RiskTags, slot))
        array.clear(v3RiskLines)
        array.clear(v3RiskTags)
        box.delete(v3LossZone)
        box.delete(v3RewardZone)
        v3LossZone := na
        v3RewardZone := na

// The six-column grid is shared by the hero, formation, and trade plan tiles.
const int V3_TITLE = 0
const int V3_CONTEXT = 1
const int V3_HERO_LABELS = 2
const int V3_HERO_VALUES = 3
const int V3_FORMATION_HEADER = 4
const int V3_FORMATION_LABELS = 5
const int V3_FORMATION_VALUES = 6
const int V3_QUALITY = 7
const int V3_PLAN_HEADER = 8
const int V3_PLAN_LABELS = 9
const int V3_PLAN_VALUES = 10
const int V3_TARGET_LABELS = 11
const int V3_TARGET_VALUES = 12
const int V3_PLAN_STATUS = 13
const int V3_FILL = 14
const int V3_MONITOR_HEADER = 15
const int V3_MONITOR_STATUS = 16
const int V3_RESULT = 17
const int V3_AUDIT_HEADER = 18
const int V3_AUDIT_RANGE = 19
const int V3_AUDIT_REASON = 20
const int V3_AUDIT_CONTEXT = 21

bool v3DashboardNarrow = v3Compact or v3Mobile
int v3DashboardSizingRow = v3Audit ? 22 : 18
int v3DashboardCaptionSize = v3Mobile ? 9 : 10
int v3DashboardBodySize = v3Mobile ? 10 : v3Compact ? 11 : 12
int v3DashboardValueSize = v3Mobile ? 11 : v3Compact ? 13 : 14
int v3DashboardBiasSize = v3Mobile ? 11 : v3Compact ? 13 : 15
int v3DashboardActionSize = v3Mobile ? 13 : v3Compact ? 16 : 19
int v3DashboardTitleSize = v3Mobile ? 13 : v3Compact ? 16 : 19
float v3DashboardColumnWidth = v3Mobile ? 13.5 : v3Compact ? 3.8 : 4.7
var table v3Dashboard = table.new(v3PanelPosition, 6, v3DashboardSizingRow + 1,
     bgcolor=v3Graphite, frame_color=v3Border, frame_width=1,
     border_color=v3Graphite, border_width=1)

f_v3DashboardCell(int col, int row, string value, color ink, color paper, int fontSize,
                   string align, bool bold=false, string tip="", bool numeric=false) =>
    table.cell(v3Dashboard, col, row, value, text_color=ink, bgcolor=paper,
         text_halign=align, text_valign=text.align_center, text_size=fontSize, tooltip=tip,
         text_font_family=numeric ? font.family_monospace : font.family_default,
         text_formatting=bold ? text.format_bold : text.format_none)

f_v3DashboardSection(int row, string title, color ink, string tip="") =>
    f_v3DashboardCell(0, row, "  " + title, ink, v3Raised, v3DashboardCaptionSize,
         text.align_left, true, tip)

f_v3DashboardHtf(int side) =>
    na(side) ? "UNAVAILABLE" : side > 0 ? "BULLISH" : side < 0 ? "BEARISH" : "NEUTRAL"

if barstate.isfirst
    for row in array.from(V3_TITLE, V3_CONTEXT, V3_FORMATION_HEADER, V3_PLAN_HEADER, V3_PLAN_STATUS,
                          V3_FILL, V3_MONITOR_HEADER, V3_RESULT)
        table.merge_cells(v3Dashboard, 0, row, 5, row)
    for row in array.from(V3_HERO_LABELS, V3_HERO_VALUES, V3_FORMATION_LABELS, V3_FORMATION_VALUES,
                          V3_QUALITY, V3_PLAN_LABELS, V3_PLAN_VALUES, V3_MONITOR_STATUS)
        table.merge_cells(v3Dashboard, 0, row, 2, row)
        table.merge_cells(v3Dashboard, 3, row, 5, row)
    for row in array.from(V3_TARGET_LABELS, V3_TARGET_VALUES)
        for col = 0 to 4 by 2
            table.merge_cells(v3Dashboard, col, row, col + 1, row)
    if v3Audit
        for row = V3_AUDIT_HEADER to V3_AUDIT_CONTEXT
            table.merge_cells(v3Dashboard, 0, row, 5, row)

if (barstate.islast or barstate.islastconfirmedhistory) and v3ShowPanel
    // The unmerged sizing band keeps the halves and thirds aligned at every viewport.
    for col = 0 to 5
        table.cell(v3Dashboard, col, v3DashboardSizingRow, "", width=v3DashboardColumnWidth,
             height=0.45, bgcolor=color.new(v3Cyan, 76), text_size=1)

    string feedTitle = wfSupported ? "XAUUSD · M" + timeframe.period :
         v3DashboardNarrow ? "OANDA XAUUSD" : "OANDA XAUUSD · M5 / M15 / M30"
    string presentation = v3Audit ? "FULL AUDIT" : "LIVE ANALYSIS"
    f_v3DashboardCell(0, V3_TITLE, "  QIRVANTA GOLD PRO", v3Text, v3Graphite, v3DashboardTitleSize,
         text.align_left, true)
    f_v3DashboardCell(0, V3_CONTEXT, "  " + feedTitle + " · " + presentation, v3Cyan, v3Graphite,
         v3DashboardCaptionSize, text.align_left, true, "Wick & Formation Intelligence · research")

    color biasPaper = v3Panel
    color actionInk = v3Action == "WAIT" ? v3Cyan : v3Review ? v3Amber : v3ActionInk
    color actionPaper = color.new(actionInk, 78)
    f_v3DashboardCell(0, V3_HERO_LABELS, "MARKET BIAS", v3Muted, biasPaper,
         v3DashboardCaptionSize, text.align_center, true, "Consensus of confirmed H1 and H4 context")
    f_v3DashboardCell(3, V3_HERO_LABELS, "TRADE ACTION", v3Text, actionPaper,
         v3DashboardCaptionSize, text.align_center, true, "A current plan or the actual simulation state")
    f_v3DashboardCell(0, V3_HERO_VALUES, v3MarketBias, v3BiasInk, biasPaper,
         v3DashboardBiasSize, text.align_center, true)
    string heroAction = v3Mobile and v3Action == "SIM WINDOW OFF" ? "WINDOW OFF" : v3Action
    f_v3DashboardCell(3, V3_HERO_VALUES, heroAction, actionInk, actionPaper,
         v3DashboardActionSize, text.align_center, true, v3Action)

    string formation = "None"
    color formationInk = v3Muted
    if not wfSupported
        formation := "Unsupported"
    else if v3Review
        formation := v3ReviewReady ? "Historical case" : "No closed bar"
        formationInk := v3Amber
    else if v3FormationFresh and not na(wfActive)
        formation := (wfActive.side > 0 ? "BUY" : "SELL") + (na(wfActive.breakoutAt) ? " WATCH" : " FORMATION")
        formationInk := wfActive.side > 0 ? v3Emerald : v3Coral
    else if v3FormationStage == "FORMING"
        formation := "Wick cluster"
        formationInk := v3Cyan
    string shownStage = switch v3FormationStage
        "FORMING" => v3DashboardNarrow ? "Collecting wicks" : "Collecting evidence"
        "BUY WATCH" => v3DashboardNarrow ? "Awaiting break" : "Awaiting breakout"
        "SELL WATCH" => v3DashboardNarrow ? "Awaiting break" : "Awaiting breakout"
        "UNSUPPORTED CHART" => v3DashboardNarrow ? "Unsupported" : "Unsupported chart"
        "BREAKOUT RECLAIMED" => v3DashboardNarrow ? "Reclaimed" : "Breakout reclaimed"
        "PROBE · UNCONFIRMED" => "Unconfirmed probe"
        "CLOSE CONFIRMED" => "Close confirmed"
        "RETEST WINDOW" => "Retest window"
        => v3FormationStage
    f_v3DashboardSection(V3_FORMATION_HEADER, "FORMATION", v3Cyan)
    f_v3DashboardCell(0, V3_FORMATION_LABELS, v3DashboardNarrow ? "CURRENT" : "CURRENT FORMATION",
         v3Muted, v3Panel, v3DashboardCaptionSize, text.align_center)
    f_v3DashboardCell(3, V3_FORMATION_LABELS, v3DashboardNarrow ? "STAGE" : "BREAKOUT / RETEST STAGE",
         v3Muted, v3Panel, v3DashboardCaptionSize, text.align_center)
    f_v3DashboardCell(0, V3_FORMATION_VALUES, formation, formationInk, v3Panel,
         v3DashboardValueSize, text.align_center, true, v3FormationRange)
    f_v3DashboardCell(3, V3_FORMATION_VALUES, shownStage, v3Text,
         v3Panel, v3DashboardBodySize, text.align_center, true, v3FormationStage)
    string formationQuality = v3Quality
    if not v3Review and not v3PlanFresh and not na(v3ViewPlan)
        if not v3FormationFresh or na(wfActive) or v3ViewPlan.formationId != wfActive.id
            formationQuality := v3FormationFresh ? "AWAITING PROOF" : "—"
    f_v3DashboardCell(0, V3_QUALITY, v3DashboardNarrow ? formationQuality : "Quality · " + formationQuality,
         v3Muted, v3Graphite, v3DashboardCaptionSize, text.align_center, false, "Signal quality from confirmed evidence")
    f_v3DashboardCell(3, V3_QUALITY, v3DashboardNarrow ? v3Freshness : "Freshness · " + v3Freshness,
         v3Muted, v3Graphite, v3DashboardCaptionSize, text.align_center, false, "Age at the last confirmed observation")

    bool showPlan = not na(v3ViewPlan)
    bool hasFill = showPlan and not na(v3FillPrice)
    string planHeader = v3Review ? "TRADE PLAN · HISTORICAL" : "TRADE PLAN"
    color planInk = v3Review ? v3Amber : v3Cyan
    f_v3DashboardSection(V3_PLAN_HEADER, planHeader, planInk, "1R, 2R and 3R are projected targets")
    if showPlan
        string stopLabel = v3DashboardNarrow ? "FIXED STOP" : "SL · INITIAL = CURRENT"
        f_v3DashboardCell(0, V3_PLAN_LABELS, "ENTRY", v3Muted, v3Panel,
             v3DashboardCaptionSize, text.align_center)
        f_v3DashboardCell(3, V3_PLAN_LABELS, stopLabel, v3Muted, v3Panel,
             v3DashboardCaptionSize, text.align_center)
        f_v3DashboardCell(0, V3_PLAN_VALUES, f_v3Price(v3ViewPlan.entry), v3Cyan, v3Panel,
             v3DashboardValueSize, text.align_center, true, "Planned entry", true)
        f_v3DashboardCell(3, V3_PLAN_VALUES, f_v3Price(v3ViewPlan.stop), v3Coral, v3Panel,
             v3DashboardValueSize, text.align_center, true, "Initial SL and current SL use the same fixed price", true)
        for col = 0 to 4 by 2
            int target = int(col / 2) + 1
            float targetPrice = target == 1 ? v3ViewPlan.tp1 : target == 2 ? v3ViewPlan.tp2 : v3ViewPlan.tp3
            string targetLabel = "TP" + str.tostring(target) + " · " + str.tostring(target) + "R"
            f_v3DashboardCell(col, V3_TARGET_LABELS, targetLabel, v3Muted, v3Panel,
                 v3DashboardCaptionSize, text.align_center)
            f_v3DashboardCell(col, V3_TARGET_VALUES, f_v3Price(targetPrice), v3Emerald, v3Panel,
                 v3DashboardValueSize, text.align_center, true,
                 "Projected target at " + str.tostring(target) + " times initial risk", true)
    else
        table.clear(v3Dashboard, 0, V3_PLAN_LABELS, 5, V3_TARGET_VALUES)
    string planStatus = showPlan ? v3PlanWindow : "No current plan"
    if showPlan and v3Mobile
        planStatus := v3ViewOpen ? "SIM OPEN" : v3ViewPending ? "SIM NEXT OPEN" :
             "VALID UNTIL " + f_v3Utc(v3ViewPlan.knownAt + wfInterval)
    f_v3DashboardCell(0, V3_PLAN_STATUS, "  " + planStatus, v3PlanFresh ? v3Cyan : v3Muted,
         v3Graphite, v3DashboardBodySize, text.align_left, v3PlanFresh, v3PlanWindow)
    if hasFill
        f_v3DashboardCell(0, V3_FILL, "  SIM FILL  " + f_v3Price(v3FillPrice), v3Cyan, v3Graphite,
             v3DashboardCaptionSize, text.align_left, false, "Actual simulated fill price")
    else
        table.clear(v3Dashboard, 0, V3_FILL, 5, V3_FILL)

    f_v3DashboardSection(V3_MONITOR_HEADER, "MONITOR", v3Cyan)
    string monitorMode = v3DashboardNarrow and v3ModeStatus == "STRATEGY SIMULATION" ? "SIMULATION" : v3ModeStatus
    string monitorFeed = not wfSupported ? "DATA UNAVAILABLE" :
         v3DashboardNarrow ? str.replace_all(v3Feed, "OANDA · ", "") : v3Feed
    f_v3DashboardCell(0, V3_MONITOR_STATUS, monitorMode, v3Text, v3Panel,
         v3DashboardCaptionSize, text.align_center, false, v3ModeStatus)
    f_v3DashboardCell(3, V3_MONITOR_STATUS, monitorFeed, v3Muted, v3Panel,
         v3DashboardCaptionSize, text.align_center, false, v3Feed)
    f_v3DashboardCell(0, V3_RESULT, "  LAST SIM RESULT   " + v3LastResult, v3Muted, v3Graphite,
         v3DashboardCaptionSize, text.align_left, false, "Last closed simulated campaign")

    if v3Audit
        f_v3DashboardSection(V3_AUDIT_HEADER, "AUDIT DETAILS", v3Amber)
        f_v3DashboardCell(0, V3_AUDIT_RANGE, "  RANGE   " + v3FormationRange, v3Text, v3Panel,
             v3DashboardBodySize, text.align_left, false, "Fixed formation boundaries")
        string diagnostic = v3RawReason == "" ? "—" : str.replace_all(v3RawReason, "_", " ")
        f_v3DashboardCell(0, V3_AUDIT_REASON, "  EVENT   " + diagnostic, v3Muted, v3Panel,
             v3DashboardCaptionSize, text.align_left, false, "Source engine reason for the displayed bar")
        string sourceBias = "  H1 " + f_v3DashboardHtf(v3H1) + "    H4 " + f_v3DashboardHtf(v3H4)
        f_v3DashboardCell(0, V3_AUDIT_CONTEXT, sourceBias, v3Muted, v3Graphite,
             v3DashboardCaptionSize, text.align_left)
