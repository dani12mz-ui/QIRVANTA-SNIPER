// @tv-inputs
// S0 is the unchanged Champion. One selected mode feeds one native account.
string tvStrategyMode = input.string("S0", "Стратегия за независим тест", options=["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9", "S10", "F0", "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10"], group="TV / СТРАТЕГИИ", tooltip="S0: Champion. S1: тренд ретест; S2: sweep; S3: приемане и ретест; S4: компресия; S5: неуспешен пробив; S6: VWAP; S7: opening range; S8: импулс; S9: swing failure. S10 е блокиран без независимо доказателство. F0–F10 са отделни FAST опити; F1 е отхвърлен исторически, само възпроизводимост.", display=display.none)
bool tvCandidateRequireHTF = input.bool(false, "S1–S9: допълнително H1 съвпадение", group="TV / СТРАТЕГИИ", tooltip="Отделен изследователски филтър. Не променя S0 или F вариантите. Няма доказана по-висока доходност.", display=display.none)

// @tv-candidates
// Insert after decision, before paper_engine. Original decision's processBar block
// runs only for S0/F*. All state below is isolated from the Champion's state.
// S families share legacy execution slot 2, but strategyKey and IDs identify them.
f_tvStrategyName(string key) =>
    switch key
        "S0" => "S0 Champion"
        "S1" => "S1 Тренд ретест"
        "S2" => "S2 Sweep обръщане"
        "S3" => "S3 Приемане и ретест"
        "S4" => "S4 Компресия пробив"
        "S5" => "S5 Неуспешен пробив"
        "S6" => "S6 VWAP връщане"
        "S7" => "S7 Opening range"
        "S8" => "S8 Импулс продължение"
        "S9" => "S9 Swing failure"
        "S10" => "S10 БЛОКИРАН"
        "F0" => "F0 Оригинален FAST"
        "F1" => "F1 ОТХВЪРЛЕН · архив"
        "F2" => "F2 Приемане"
        "F3" => "F3 H1/H4 посока"
        "F4" => "F4 Ретест"
        "F5" => "F5 Място до TP1"
        "F6" => "F6 Тренд режим"
        "F7" => "F7 Без преследване"
        "F8" => "F8 Импулс"
        "F9" => "F9 Сесия"
        => "F10 H1/H4 + отстояние"

type TvCandidateState
    int phase = 0
    int born = na
    int bornTime = na
    int accepted = na
    float anchor = na
    float level = na
    float trigger = na

// All history-dependent calculations execute on every bar in global scope.
float tvEma20 = ta.ema(close, 20)
float tvEma50 = ta.ema(close, 50)
float tvEma200 = ta.ema(close, 200)
float tvRange20High = ta.highest(high, 20)[1]
float tvRange20Low = ta.lowest(low, 20)[1]
float tvRange3High = ta.highest(high, 3)[1]
float tvRange3Low = ta.lowest(low, 3)[1]
float tvAtrRatio = atrMean > 0 ? atr / atrMean : na
bool tvTimeGap = not na(time_close[1]) and time != time_close[1]
int tvResearchDirection = close > tvEma20 and tvEma20 > tvEma50 and tvEma50 > tvEma200 ? 1 : close < tvEma20 and tvEma20 < tvEma50 and tvEma50 < tvEma200 ? -1 : 0
var array<TvCandidateState> tvCandidateStates = array.new<TvCandidateState>()
var array<int> tvCandidateLast = array.new<int>(2, na)
var array<Plan> tvFastPending = array.new<Plan>(2, na)
var array<float> tvFastBoundary = array.new<float>(2, na)
var array<string> tvReasons = array.new<string>(2, "Чака потвърдена свещ")
var int tvRawAttempts = 0
var int tvAcceptedAttempts = 0
var int tvRejectedAttempts = 0
if barstate.isfirst
    array.push(tvCandidateStates, TvCandidateState.new())
    array.push(tvCandidateStates, TvCandidateState.new())

f_tvClear(TvCandidateState s) =>
    s.phase := 0
    s.born := na
    s.bornTime := na
    s.accepted := na
    s.anchor := na
    s.level := na
    s.trigger := na
    s
f_tvStart(TvCandidateState s, float anchor, float level, float trigger) =>
    s.phase := 1
    s.born := bar_index
    s.bornTime := time_close
    s.anchor := anchor
    s.level := level
    s.trigger := trigger
    s
f_tvStamp(Plan p, string key) =>
    p.strategyKey := key
    p.setupId := key + "|" + p.setupId
    p.id := key + "|" + p.id
    p
f_tvRawEvent(string kind, int d, int born, float level, string reason) =>
    Event e = f_emit(events, kind, "CORE", tvStrategyMode + "|" + f_id(2, d, born), 2, d, time_close, level, reason)
    e.strategyKey := tvStrategyMode
    e
f_tvCommonReason(Plan p, bool htfGate) =>
    f_reason(array.from(warmup, datePass, not newsPaused, sessionPass, validATR, acceptableBar, not tvTimeGap, not htfGate or tvH1Bias == p.side, not requireFVG or (p.side == 1 ? bullFvgNow : bearFvgNow), not requirePD or (p.side == 1 ? inDiscount : inPremium), f_validPlan(p)), array.from("Данни", "Тестов период", "Новинарска пауза", "Сесия", "ATR", "Размер свещ", "Прекъсване на историята", "H1 не съвпада", "FVG", "Скъпа/евтина зона", "SL / разходи / цели / преграда"))

f_tvCandidate(int d) =>
    int idx = d == 1 ? 0 : 1
    TvCandidateState s = array.get(tvCandidateStates, idx)
    bool terminated = false
    bool raw = false
    int born = time_close
    float anchor = d == 1 ? tvRange3Low : tvRange3High
    float obstacle = d == 1 ? longObstacle : shortObstacle
    float directionalBody = (close - open) * d
    bool candle = directionalBody >= 0.25 * atr and (d == 1 ? bullishBar : bearishBar)
    bool trend = tvResearchDirection == d and adx >= 20 and efficiency >= 0.25
    string extraReason = ""
    string reason = "Няма суров trigger"
    int ageLimit = tvStrategyMode == "S3" ? 6 : tvStrategyMode == "S9" ? 2 : 3
    if s.phase != 0
        bool expired = bar_index - s.born > ageLimit
        bool invalid = (close - s.anchor) * d < 0
        if tvTimeGap or expired or invalid
            reason := tvTimeGap ? "Прекъсване на историята" : expired ? "Срокът изтече" : "Нарушена структура"
            f_tvRawEvent(expired ? "EXPIRED" : "CANCELLED", d, s.bornTime, close, reason)
            f_tvClear(s)
            terminated := true
    if tvStrategyMode == "S10"
        reason := "S10: няма независимо потвърдено правило за избор"
    else if tvStrategyMode == "S6" and not tvVolumeValid
        reason := "S6: липсва валидна TradingView volume основа"
    else if not warmup or not tvEntryFrame
        reason := "Недостатъчни данни или неподдържана рамка"
    else if not terminated
        if s.phase != 0
            born := s.bornTime
            anchor := s.anchor
        if tvStrategyMode == "S1"
            bool pullback = d == 1 ? low[1] <= tvEma20[1] and close[1] <= tvEma20[1] : high[1] >= tvEma20[1] and close[1] >= tvEma20[1]
            raw := pullback and (close - (d == 1 ? high[1] : low[1])) * d > 0
            anchor := d == 1 ? math.min(low[1], low) : math.max(high[1], high)
            extraReason := not trend ? "Няма насочен тренд" : not candle ? "Няма потвърждаваща свещ" : ""
        else if tvStrategyMode == "S2" or tvStrategyMode == "S9"
            if s.phase != 0
                raw := bar_index > s.born and (close - s.trigger) * d > 0
                extraReason := not candle ? "Няма потвърждаваща свещ" : ""
            else
                float level = tvStrategyMode == "S2" ? (d == 1 ? tvRange20Low : tvRange20High) : (d == 1 ? lastPivotLow[1] : lastPivotHigh[1])
                float wick = d == 1 ? math.min(open, close) - low : high - math.max(open, close)
                bool sweep = not na(level) and (d == 1 ? low < level and close > level : high > level and close < level) and wick >= 0.25 * barRange
                if sweep and not tvTimeGap
                    f_tvStart(s, d == 1 ? low : high, level, d == 1 ? high : low)
                    f_tvRawEvent("WATCH", d, time_close, s.trigger, "Sweep; чака отделна затворена свещ")
        else if tvStrategyMode == "S3"
            if s.phase == 1
                if bar_index == s.born + 1 and (close - s.level) * d > 0
                    s.phase := 2
                    s.accepted := bar_index
                    f_tvRawEvent("WATCH", d, s.bornTime, s.level, "Приемане потвърдено; чака отделен ретест")
                else if bar_index > s.born
                    reason := "Приемането на пробива е отказано"
                    f_tvRawEvent("CANCELLED", d, s.bornTime, close, reason)
                    f_tvClear(s)
                    terminated := true
            else if s.phase == 2 and bar_index > s.accepted
                float extreme = d == 1 ? low : high
                raw := math.abs(extreme - s.level) <= 0.20 * atr and (close - s.level) * d > 0
                extraReason := not candle ? "Няма потвърждаваща свещ" : (close - s.level) * d > 0.75 * atr ? "Закъснял ретест" : ""
            else if s.phase == 0
                float level = d == 1 ? tvRange20High : tvRange20Low
                if not tvTimeGap and (close - level) * d > 0 and (close[1] - level) * d <= 0
                    f_tvStart(s, anchor, level, level)
                    f_tvRawEvent("WATCH", d, time_close, level, "Пробив; чака следващо затваряне отвъд нивото")
        else if tvStrategyMode == "S4"
            float level = d == 1 ? tvRange20High : tvRange20Low
            raw := (close - level) * d > 0 and (close[1] - level) * d <= 0
            bool compressed = tvAtrRatio[1] < 0.75 and tvRange20High[1] - tvRange20Low[1] <= 6.0 * atr[1]
            extraReason := not compressed ? "Няма предходна компресия" : not candle ? "Няма потвърждаваща свещ" : barRange < atr ? "Липсва разширение" : (close - level) * d > 0.75 * atr ? "Късен пробив" : ""
        else if tvStrategyMode == "S5"
            if s.phase != 0
                raw := bar_index > s.born and (close - s.level) * d > 0
                extraReason := not candle ? "Няма потвърждаваща свещ" : ""
            else
                float level = d == 1 ? tvRange20Low : tvRange20High
                if not tvTimeGap and (close - level) * d < 0 and (close[1] - level) * d >= 0
                    f_tvStart(s, d == 1 ? low : high, level, level)
                    f_tvRawEvent("WATCH", d, time_close, level, "Противоположен пробив; чака връщане отвъд нивото")
        else if tvStrategyMode == "S6"
            raw := tvVolumeValid[1] and not na(tvVWAP[1]) and tvVWAPSd > 0 and tvVWAPSd[1] > 0 and (close[1] - tvVWAP[1]) * d < -2.0 * tvVWAPSd[1] and (close - tvVWAP) * d >= -2.0 * tvVWAPSd
            anchor := d == 1 ? math.min(low[1], low) : math.max(high[1], high)
            obstacle := tvVWAP
            extraReason := tvRegime != 2 ? "Не е диапазон" : not candle ? "Няма потвърждаваща свещ" : ""
        else if tvStrategyMode == "S7"
            float londonLevel = d == 1 ? tvLondonORHigh : tvLondonORLow
            float nyLevel = d == 1 ? tvNewYorkORHigh : tvNewYorkORLow
            bool londonBreak = tvLondonActive and not na(londonLevel) and (close - londonLevel) * d > 0 and (close[1] - londonLevel) * d <= 0
            bool nyBreak = tvNewYorkActive and not na(nyLevel) and (close - nyLevel) * d > 0 and (close[1] - nyLevel) * d <= 0
            raw := londonBreak or nyBreak
            if raw
                anchor := londonBreak ? (d == 1 ? tvLondonORLow : tvLondonORHigh) : (d == 1 ? tvNewYorkORLow : tvNewYorkORHigh)
            extraReason := not candle ? "Няма потвърждаваща свещ" : ""
        else if tvStrategyMode == "S8"
            float level = d == 1 ? tvRange3High : tvRange3Low
            raw := (close - level) * d > 0 and (close[1] - level) * d <= 0
            extraReason := not trend ? "Няма насочен тренд" : efficiency < 0.35 ? "Ниска насоченост" : body[1] > 0.5 * atr[1] ? "Няма предходна пауза" : directionalBody < 0.5 * atr ? "Слаб импулс" : math.abs(close - tvEma20) > 2.0 * atr ? "Разтеглен импулс" : ""
        if raw
            // A triggered state is consumed even when risk/context rejects it.
            f_tvClear(s)
            float structural = d == 1 ? math.min(anchor - slBufferATR * atr, close - minStopATR * atr) : math.max(anchor + slBufferATR * atr, close + minStopATR * atr)
            Plan p = f_tvStamp(f_makePlan(2, d, f_stopRound(structural, d), born, maxStopATR, obstacle, requireRoom ? math.max(minimumRoomR, target1R) : 0.0), tvStrategyMode)
            string commonReason = f_tvCommonReason(p, tvCandidateRequireHTF)
            int last = array.get(tvCandidateLast, idx)
            bool cool = na(last) or bar_index - last > minCooldown
            reason := extraReason != "" ? extraReason : not cool ? "Пауза след потвърден модел" : commonReason
            if reason == "УСЛОВИЯТА СА ИЗПЪЛНЕНИ"
                array.push(candidates, p)
                array.set(tvCandidateLast, idx, bar_index)
            else
                f_planEvent(events, p, "REJECTED", "CORE", time_close, close, reason)
            f_recordDecision(2, d, reason == "УСЛОВИЯТА СА ИЗПЪЛНЕНИ", reason)
        else if not terminated and s.phase != 0
            reason := s.phase == 2 ? "Чака ретест" : "Чака отделна потвърждаваща свещ"
    [reason, raw]

f_tvFastGate(Plan p) =>
    int d = p.side
    float boundary = d == 1 ? fastBreakHigh : fastBreakLow
    bool body55 = (close - open) * d / barRange >= 0.55
    bool alignedHTF = tvH1Bias == d and tvH4Bias == d
    bool clearance = not na(p.obstacle) and (p.obstacle - p.reference) * d + syminfo.mintick * 1e-6 >= math.max(p.risk, (p.tp1 - p.reference) * d)
    bool fresh = (p.reference - boundary) * d <= 0.25 * p.atrValue
    bool momentum = (rsi - 50) * d >= 5 and (close - close[2]) * d >= 0.25 * atr
    switch tvStrategyMode
        "F1" => body55 ? "" : "F1 архив: тяло <55%"
        "F3" => alignedHTF ? "" : "F3: H1/H4 не съвпадат"
        "F5" => clearance ? "" : "F5: няма потвърдено място до TP1"
        "F6" => tvRegime == d ? "" : "F6: няма устойчив насочен режим"
        "F7" => fresh ? "" : "F7: пробивът е над 0.25 ATR"
        "F8" => momentum ? "" : "F8: слаб RSI/двубаров импулс"
        "F9" => tvLondonActive or tvNewYorkActive ? "" : "F9: извън London/NY"
        "F10" => alignedHTF and fresh ? "" : "F10: H1/H4 или отстояние"
        => ""

if processBar and tvStrategyMode != "S0"
    // Preserve raw FAST detector/cooldown for F variants; never inherit a legacy
    // RETEST/REVERSAL candidate, label or event into a challenger experiment.
    array<Plan> tvOriginalFast = array.new<Plan>()
    if str.startswith(tvStrategyMode, "F") and tvEntryFrame and array.size(candidates) > 0
        for p in candidates
            if p.family == 2
                array.push(tvOriginalFast, p.copy())
    array.clear(candidates)
    array.clear(events)
    if str.startswith(tvStrategyMode, "S")
        for idx = 0 to 1
            int d = idx == 0 ? 1 : -1
            [why, attempted] = f_tvCandidate(d)
            array.set(tvReasons, idx, why)
            if attempted
                tvRawAttempts += 1
                if why == "УСЛОВИЯТА СА ИЗПЪЛНЕНИ"
                    tvAcceptedAttempts += 1
                else
                    tvRejectedAttempts += 1
        lastAnalysisClose := time_close
        closedEfficiency := efficiency
        localPressure := tvResearchDirection
        closedHtfBias := tvH1Bias
        lastContext := tvResearchDirection == 1 ? "НАТИСК НАГОРЕ" : tvResearchDirection == -1 ? "НАТИСК НАДОЛУ" : "СМЕСЕН КОНТЕКСТ"
    else
        for idx = 0 to 1
            int d = idx == 0 ? 1 : -1
            Plan pending = array.get(tvFastPending, idx)
            bool terminated = false
            string why = "Няма оригинален FAST trigger"
            if not na(pending)
                float boundary = array.get(tvFastBoundary, idx)
                int wait = tvStrategyMode == "F2" ? 1 : 4
                int age = bar_index - pending.signalBar
                float extreme = d == 1 ? low : high
                bool cancelled = tvTimeGap or (extreme - pending.initialStop) * d <= 0 or (close - boundary) * d <= 0
                bool expired = age > wait
                bool accepted = age >= 1 and age <= wait and (tvStrategyMode == "F2" ? (close - boundary) * d >= 0.10 * pending.atrValue : math.abs(extreme - boundary) <= 0.15 * pending.atrValue)
                if cancelled or expired or accepted or (tvStrategyMode == "F2" and age == 1)
                    terminated := true
                    array.set(tvFastPending, idx, na)
                    if cancelled or expired or not accepted
                        why := cancelled ? "Прекъсване / стоп / връщане през пробива" : "Изтекло отложено потвърждение"
                        f_planEvent(events, pending, cancelled ? "CANCELLED" : "EXPIRED", "CORE", time_close, close, why)
                        tvRejectedAttempts += 1
                    else
                        float obstacle = d == 1 ? longObstacle : shortObstacle
                        Plan p = f_tvStamp(f_makePlan(2, d, pending.initialStop, pending.createdTime, pending.maxRiskATR, obstacle, pending.requiredRoom), tvStrategyMode)
                        why := f_tvCommonReason(p, false)
                        if why == "УСЛОВИЯТА СА ИЗПЪЛНЕНИ"
                            array.push(candidates, p)
                            tvAcceptedAttempts += 1
                        else
                            f_planEvent(events, p, "REJECTED", "CORE", time_close, close, why)
                            tvRejectedAttempts += 1
                else
                    why := "Чака по-късно потвърждение; няма вход назад"
            if array.size(tvOriginalFast) > 0
                for rawPlan in tvOriginalFast
                    if rawPlan.side == d
                        tvRawAttempts += 1
                        Plan p = f_tvStamp(rawPlan.copy(), tvStrategyMode)
                        if tvStrategyMode == "F2" or tvStrategyMode == "F4"
                            if not terminated and na(array.get(tvFastPending, idx))
                                array.set(tvFastPending, idx, p)
                                array.set(tvFastBoundary, idx, d == 1 ? fastBreakHigh : fastBreakLow)
                                why := tvStrategyMode == "F2" ? "Чака следващо приемане" : "Чака отделен ретест до 4 свещи"
                                f_planEvent(events, p, "WATCH", "CORE", time_close, p.reference, why)
                            else
                                why := "Непрезаписан чакащ FAST / приключен на тази свещ"
                                f_planEvent(events, p, "REJECTED", "CORE", time_close, close, why)
                                tvRejectedAttempts += 1
                        else
                            why := f_tvFastGate(p)
                            if why == ""
                                array.push(candidates, p)
                                tvAcceptedAttempts += 1
                                why := "УСЛОВИЯТА СА ИЗПЪЛНЕНИ"
                            else
                                f_planEvent(events, p, "REJECTED", "CORE", time_close, close, why)
                                tvRejectedAttempts += 1
            array.set(tvReasons, idx, why)
    for i = 0 to 2
        array.set(buyReasons, i, array.get(tvReasons, 0))
        array.set(sellReasons, i, array.get(tvReasons, 1))
