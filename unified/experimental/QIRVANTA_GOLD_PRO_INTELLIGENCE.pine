//@version=6
indicator("QIRVANTA GOLD PRO Intelligence", shorttitle="Q GOLD Intel", overlay=true, max_bars_back=1000)
// Generated by unified.tools.build_gold_pro.

// Shared source for both GOLD PRO Pine scripts.
const int GP_HTF_WINDOW = 110
const int GP_FINGERPRINT_WINDOW = 200
const int GP_H1_MAX_AGE = 7200000
const int GP_H4_MAX_AGE = 28800000
const int GP_D1_MAX_AGE = 345600000
const int GP_PRIME_ONE = 1000000007
const int GP_PRIME_TWO = 1000000009
const string GP_TOKYO = "Asia/Tokyo"
const string GP_LONDON = "Europe/London"
const string GP_NEW_YORK = "America/New_York"

bool gpAuditContext = input.bool(false, "Log confirmed market context", group="GOLD PRO / EVIDENCE")
int gpAuditFrom = input.time(timestamp("10 Nov 2026 00:00 +0000"), "Context log start", group="GOLD PRO / EVIDENCE")
int gpAuditUntil = input.time(timestamp("11 Nov 2026 23:55 +0000"), "Context log cutoff", group="GOLD PRO / EVIDENCE")
bool gpSupported = syminfo.tickerid == "OANDA:XAUUSD" and chart.is_standard and (timeframe.period == "5" or timeframe.period == "15" or timeframe.period == "30") and syminfo.mintick > 0
bool gpClosedBar = gpSupported and barstate.isconfirmed

// Run in the requested context. Start from the oldest of exactly 110 completed closes.
f_gpConfirmedContext() =>
    float fast = close[GP_HTF_WINDOW]
    float slow = fast
    if not na(fast)
        for ago = GP_HTF_WINDOW - 1 to 1
            fast += (close[ago] - fast) * (2.0 / 22.0)
            slow += (close[ago] - slow) * (2.0 / 56.0)
    [time[1], time_close[1], open[1], high[1], low[1], close[1], fast, slow]

[gpH1OpenAt, gpH1Known, gpH1Open, gpH1High, gpH1Low, gpH1Close, gpH1Fast, gpH1Slow] = request.security(
     syminfo.tickerid, "60", f_gpConfirmedContext(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[gpH4OpenAt, gpH4Known, gpH4Open, gpH4High, gpH4Low, gpH4Close, gpH4Fast, gpH4Slow] = request.security(
     syminfo.tickerid, "240", f_gpConfirmedContext(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[gpD1OpenAt, gpD1Known, gpD1Open, gpD1High, gpD1Low, gpD1Close, gpD1Fast, gpD1Slow] = request.security(
     syminfo.tickerid, "1D", f_gpConfirmedContext(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

f_gpHtfSide(float lastClose, float fast, float slow, int known, int maxAge) =>
    int side = na
    if gpSupported and not na(known) and known <= time and time - known <= maxAge and not na(lastClose) and not na(fast) and not na(slow)
        int closeMicros = math.round(lastClose * 1000000.0)
        int fastMicros = math.round(fast * 1000000.0)
        int slowMicros = math.round(slow * 1000000.0)
        side := closeMicros > fastMicros and fastMicros > slowMicros ? 1 : closeMicros < fastMicros and fastMicros < slowMicros ? -1 : 0
    side

int gpH1Side = f_gpHtfSide(gpH1Close, gpH1Fast, gpH1Slow, gpH1Known, GP_H1_MAX_AGE)
int gpH4Side = f_gpHtfSide(gpH4Close, gpH4Fast, gpH4Slow, gpH4Known, GP_H4_MAX_AGE)
int gpD1Side = f_gpHtfSide(gpD1Close, gpD1Fast, gpD1Slow, gpD1Known, GP_D1_MAX_AGE)
bool gpContextReady = gpClosedBar and not na(gpH1Side) and not na(gpH4Side)

// Rolling fingerprints require the same latest 200 chart OHLC bars and timestamps.
int gpOpenTicks = math.round(open / syminfo.mintick)
int gpHighTicks = math.round(high / syminfo.mintick)
int gpLowTicks = math.round(low / syminfo.mintick)
int gpCloseTicks = math.round(close / syminfo.mintick)
int gpOpenSeconds = int(time / 1000)
int gpCloseSeconds = int(time_close / 1000)
int gpFingerprintTokenOne = (gpOpenSeconds + 3 * gpCloseSeconds + 5 * gpOpenTicks + 7 * gpHighTicks + 11 * gpLowTicks + 13 * gpCloseTicks) % GP_PRIME_ONE
int gpTimeFactor = 1 + gpOpenSeconds % 65521
int gpFingerprintTokenTwo = (gpCloseSeconds + gpTimeFactor * (17 * gpOpenTicks + 19 * gpHighTicks + 23 * gpLowTicks + 29 * gpCloseTicks)) % GP_PRIME_TWO
float gpFingerprintSumOne = math.sum(gpFingerprintTokenOne, GP_FINGERPRINT_WINDOW)
float gpFingerprintSumTwo = math.sum(gpFingerprintTokenTwo, GP_FINGERPRINT_WINDOW)
bool gpFingerprintReady = gpClosedBar and not na(gpFingerprintTokenOne[GP_FINGERPRINT_WINDOW - 1])
int gpFingerprint1 = gpFingerprintReady ? int(gpFingerprintSumOne) % GP_PRIME_ONE : na
int gpFingerprint2 = gpFingerprintReady ? int(gpFingerprintSumTwo) % GP_PRIME_TWO : na

f_gpDateKey(string tz) =>
    10000 * year(time, tz) + 100 * month(time, tz) + dayofmonth(time, tz)

f_gpSessionRange(bool inSession, int dateKey, bool atStart) =>
    var float observedHigh = na
    var float observedLow = na
    var int startedAt = na
    var bool observedComplete = false
    if gpClosedBar and inSession
        if not inSession[1] or dateKey != dateKey[1]
            observedHigh := high
            observedLow := low
            startedAt := time
            observedComplete := atStart
        else
            observedHigh := math.max(observedHigh, high)
            observedLow := math.min(observedLow, low)
            observedComplete := observedComplete and time == time_close[1]
    [observedHigh, observedLow, startedAt, observedComplete]

bool gpInAsia = not na(time(timeframe.period, "0900-1800:23456", GP_TOKYO))
bool gpInLondon = not na(time(timeframe.period, "0800-1700:23456", GP_LONDON))
bool gpInNewYork = not na(time(timeframe.period, "0800-1700:23456", GP_NEW_YORK))
bool gpInOverlap = gpInLondon and gpInNewYork
bool gpAtAsiaOpen = hour(time, GP_TOKYO) == 9 and minute(time, GP_TOKYO) == 0
bool gpAtLondonOpen = hour(time, GP_LONDON) == 8 and minute(time, GP_LONDON) == 0
bool gpAtNewYorkOpen = hour(time, GP_NEW_YORK) == 8 and minute(time, GP_NEW_YORK) == 0
[gpAsiaHigh, gpAsiaLow, gpAsiaSince, gpAsiaComplete] = f_gpSessionRange(gpInAsia, f_gpDateKey(GP_TOKYO), gpAtAsiaOpen)
[gpLondonHigh, gpLondonLow, gpLondonSince, gpLondonComplete] = f_gpSessionRange(gpInLondon, f_gpDateKey(GP_LONDON), gpAtLondonOpen)
[gpNewYorkHigh, gpNewYorkLow, gpNewYorkSince, gpNewYorkComplete] = f_gpSessionRange(gpInNewYork, f_gpDateKey(GP_NEW_YORK), gpAtNewYorkOpen)
[gpOverlapHigh, gpOverlapLow, gpOverlapSince, gpOverlapComplete] = f_gpSessionRange(gpInOverlap, f_gpDateKey(GP_NEW_YORK), gpAtNewYorkOpen)

string gpSession = not gpSupported ? "UNKNOWN" : gpInOverlap ? "LONDON–NEW YORK" : gpInNewYork ? "NEW YORK" : gpInLondon ? "LONDON" : gpInAsia ? "ASIA" : "OFF SESSION"
float gpSessionHigh = gpInOverlap ? gpOverlapHigh : gpInNewYork ? gpNewYorkHigh : gpInLondon ? gpLondonHigh : gpInAsia ? gpAsiaHigh : na
float gpSessionLow = gpInOverlap ? gpOverlapLow : gpInNewYork ? gpNewYorkLow : gpInLondon ? gpLondonLow : gpInAsia ? gpAsiaLow : na
int gpSessionSince = gpInOverlap ? gpOverlapSince : gpInNewYork ? gpNewYorkSince : gpInLondon ? gpLondonSince : gpInAsia ? gpAsiaSince : na
bool gpSessionComplete = gpInOverlap ? gpOverlapComplete : gpInNewYork ? gpNewYorkComplete : gpInLondon ? gpLondonComplete : gpInAsia ? gpAsiaComplete : false

// The symbol's native daily timestamp defines the observed current session.
int gpTradingDay = time("1D")
var float gpDayOpen = na
var float gpDayHigh = na
var float gpDayLow = na
var bool gpDayComplete = false
if gpClosedBar
    if na(gpTradingDay[1]) or gpTradingDay != gpTradingDay[1]
        gpDayOpen := open
        gpDayHigh := high
        gpDayLow := low
        gpDayComplete := time == gpTradingDay
    else
        gpDayHigh := math.max(gpDayHigh, high)
        gpDayLow := math.min(gpDayLow, low)
        gpDayComplete := gpDayComplete and time == time_close[1]

f_gpCtxNum(float value) =>
    na(value) ? "-" : str.tostring(value, "#.#########")
f_gpCtxInt(int value) =>
    na(value) ? "-" : str.tostring(value)
f_gpCtxBool(bool value) =>
    value ? "1" : "0"
f_gpHtfLog(int firstAt, int known, float lastClose, float fast, float slow, int side) =>
    "|" + f_gpCtxInt(firstAt) + "|" + f_gpCtxInt(known) + "|" + f_gpCtxNum(lastClose) + "|" +
      f_gpCtxNum(fast) + "|" + f_gpCtxNum(slow) + "|" + f_gpCtxInt(side)

if gpAuditContext and gpClosedBar and time_close >= gpAuditFrom and time_close <= gpAuditUntil
    log.info("GOLD_CTX|1|" + syminfo.tickerid + "|" + timeframe.period + "|" + f_gpCtxNum(syminfo.mintick) +
      "|" + f_gpCtxInt(time) + "|" + f_gpCtxInt(time_close) + "|" + f_gpCtxNum(open) + "|" + f_gpCtxNum(high) +
      "|" + f_gpCtxNum(low) + "|" + f_gpCtxNum(close) + "|" + f_gpCtxInt(gpFingerprint1) +
      "|" + f_gpCtxInt(gpFingerprint2) + "|" + f_gpCtxBool(gpContextReady) + "|" + gpSession +
      "|" + f_gpCtxNum(gpSessionHigh) + "|" + f_gpCtxNum(gpSessionLow) + "|" + f_gpCtxInt(gpSessionSince) +
      "|" + f_gpCtxBool(gpSessionComplete) + "|" + f_gpCtxInt(gpTradingDay) + "|" + f_gpCtxNum(gpDayOpen) +
      "|" + f_gpCtxNum(gpDayHigh) + "|" + f_gpCtxNum(gpDayLow) + "|" + f_gpCtxBool(gpDayComplete) +
      f_gpHtfLog(gpH1OpenAt, gpH1Known, gpH1Close, gpH1Fast, gpH1Slow, gpH1Side) +
      f_gpHtfLog(gpH4OpenAt, gpH4Known, gpH4Close, gpH4Fast, gpH4Slow, gpH4Side) +
      f_gpHtfLog(gpD1OpenAt, gpD1Known, gpD1Close, gpD1Fast, gpD1Slow, gpD1Side))

// Shared closed-bar market and model logic for the V2.2 indicator and strategy.
const int V22_WARMUP = 250
const int V22_COOLDOWN = 6
const float V22_MAX_EXTENSION = 2.50

bool v22EnableA = input.bool(true, "A · Structural breakout", group="Gold Pro models", display=display.none)
bool v22EnableB = input.bool(true, "B · Smart pullback", group="Gold Pro models", display=display.none)
bool v22EnableC = input.bool(true, "C · Consolidation continuation", group="Gold Pro models", display=display.none)
bool v22RequireADisplacement = input.bool(false, "A · Require displacement", group="Gold Pro models", display=display.none)

type V22Candidate
    string model
    int side
    string setupId
    int watchedAt
    int knownAt
    float level
    float reference
    float stopBase
    float barrier
    float atr
    float extension
    bool spike
    bool htfConflict

type V22Observation
    string model
    int side
    string setupId
    int knownAt
    string state
    string reason
    float level

type V22Setup
    int side = 0
    int watchedAt = na
    int started = na
    int pivotId = na
    int lastConfirmation = na
    float level = na
    float trigger = na
    float stopBase = na
    float atr = na
    string id = ""

bool v22Supported = gpSupported
float v22TR = ta.tr(true)
float v22RawATR = ta.atr(14)
float v22ATR = v22RawATR[1]
float v22MeanATR = ta.sma(v22RawATR, 20)[1]
float v22EMA21 = ta.ema(close, 21)
float v22EMA55 = ta.ema(close, 55)
[v22DIPlus, v22DIMinus, v22ADX] = ta.dmi(14, 14)

// GOLD PRO supplies confirmed finite-window higher-timeframe context.
f_v22Bias(float price, float fast, float slow) =>
    price > fast and fast > slow ? 1 : price < fast and fast < slow ? -1 : 0
int v22H1 = gpH1Side
int v22H4 = gpH4Side

bool v22HighPivot = high[2] > high[4] and high[2] > high[3] and high[2] > high[1] and high[2] > high
bool v22LowPivot = low[2] < low[4] and low[2] < low[3] and low[2] < low[1] and low[2] < low
var float v22LastHigh = na
var float v22LastLow = na
var float v22PreviousHigh = na
var float v22PreviousLow = na
var int v22LastHighKnown = na
var int v22LastLowKnown = na
var int v22BreakBias = 0

// These scalar values snapshot the pivots before any disclosure on this close.
float v22PriorHigh = v22LastHigh
float v22PriorLow = v22LastLow
float v22EarlierHigh = v22PreviousHigh
float v22EarlierLow = v22PreviousLow
int v22PriorHighKnown = v22LastHighKnown
int v22PriorLowKnown = v22LastLowKnown
bool v22HHHL = v22PriorHigh > v22EarlierHigh and v22PriorLow > v22EarlierLow
bool v22LHLL = v22PriorHigh < v22EarlierHigh and v22PriorLow < v22EarlierLow
int v22LocalBias = f_v22Bias(close, v22EMA21, v22EMA55)
bool v22BullEMA = v22LocalBias == 1 and v22EMA21 > v22EMA21[3] and v22EMA55 > v22EMA55[3]
bool v22BearEMA = v22LocalBias == -1 and v22EMA21 < v22EMA21[3] and v22EMA55 < v22EMA55[3]
int v22Trend = v22BullEMA and (v22HHHL or (v22ADX >= 18 and v22DIPlus > v22DIMinus)) ? 1 :
  v22BearEMA and (v22LHLL or (v22ADX >= 18 and v22DIMinus > v22DIPlus)) ? -1 : 0
bool v22Ready = v22Supported and bar_index >= V22_WARMUP and not na(v22ATR) and v22ATR > 0
float v22Extension = v22Ready ? math.abs(close - v22EMA21) / v22ATR : na
float v22Momentum = v22Ready ? (close - close[3]) / v22ATR : na
bool v22Spike = v22Ready and v22TR > 2.50 * v22ATR
float v22Candle = high - low
float v22Body = close - open
bool v22SubstantialBody = v22Candle > 0 and math.abs(v22Body) >= 0.55 * v22Candle
bool v22BullDisplacement = v22SubstantialBody and v22Body >= 0.80 * v22ATR and high - close <= 0.25 * v22Candle
bool v22BearDisplacement = v22SubstantialBody and -v22Body >= 0.80 * v22ATR and close - low <= 0.25 * v22Candle

f_v22Break(int side, float level) =>
    side * (close[1] - level) <= 0 and side * (close - level) > 0
bool v22BullBreak = v22Ready and f_v22Break(1, v22PriorHigh)
bool v22BearBreak = v22Ready and f_v22Break(-1, v22PriorLow)
int v22BOS = v22BullBreak ? 1 : v22BearBreak ? -1 : 0
bool v22MSS = v22BOS != 0 and v22BreakBias == -v22BOS
string v22Structure = v22MSS ? (v22BOS == 1 ? "MSS UP" : "MSS DOWN") :
  v22BOS == 1 ? "BOS UP" : v22BOS == -1 ? "BOS DOWN" : v22HHHL ? "HH / HL" : v22LHLL ? "LH / LL" : "MIXED"

float v22BoxHigh = ta.highest(high, 4)
float v22BoxLow = ta.lowest(low, 4)
float v22TR4 = ta.sma(v22TR, 4)
bool v22NarrowBox = v22Ready and v22BoxHigh - v22BoxLow <= 1.50 * v22ATR and v22TR4 <= 0.80 * v22ATR
bool v22Compression = v22Ready and (v22NarrowBox or v22ATR <= 0.80 * v22MeanATR)
bool v22Expansion = v22Ready and v22TR >= 1.50 * v22ATR
bool v22UpperExhaustion = v22Ready and v22Momentum[1] >= 0.80 and high - v22EMA21 >= 2.50 * v22ATR and
  v22Candle > 0 and high - math.max(open, close) >= 0.50 * v22Candle and v22Momentum < v22Momentum[1]
bool v22LowerExhaustion = v22Ready and v22Momentum[1] <= -0.80 and v22EMA21 - low >= 2.50 * v22ATR and
  v22Candle > 0 and math.min(open, close) - low >= 0.50 * v22Candle and v22Momentum > v22Momentum[1]
bool v22Exhausted = v22Ready and (v22Extension > V22_MAX_EXTENSION or v22UpperExhaustion or v22LowerExhaustion)
string v22RegimeNow = not v22Supported ? "UNSUPPORTED" : not v22Ready ? "WARMUP" :
  v22Exhausted ? "EXHAUSTION / OVEREXTENSION" : v22MSS ? "POTENTIAL REVERSAL" :
  v22Expansion ? "VOLATILITY EXPANSION" : v22Compression ? "COMPRESSION" :
  v22Trend == 1 ? "BULLISH TREND" : v22Trend == -1 ? "BEARISH TREND" : "SIDEWAYS / RANGE"
string v22RegimeReason = not v22Supported ? "SYMBOL_OR_TIMEFRAME" : not v22Ready ? "INSUFFICIENT_BARS" :
  v22Exhausted ? (v22Extension > V22_MAX_EXTENSION ? "EMA_DISTANCE" : "WICK_AND_DECELERATION") :
  v22MSS ? "OPPOSITE_STRUCTURE_BREAK" : v22Expansion ? "TRUE_RANGE_EXPANSION" :
  v22Compression ? (v22NarrowBox ? "NARROW_BOX" : "ATR_CONTRACTION") : v22Trend != 0 ? "EMA_DIRECTION_WITH_STRUCTURE_OR_DMI" :
  "NO_QUALIFIED_TREND"
var string v22Regime = ""
var array<V22Candidate> v22Candidates = array.new<V22Candidate>()
var array<V22Observation> v22Observations = array.new<V22Observation>()
var V22Setup v22SetupA = V22Setup.new()
var V22Setup v22SetupB = V22Setup.new()
var V22Setup v22SetupC = V22Setup.new()
var int v22AUsedHigh = na
var int v22AUsedLow = na

f_v22Direction(int side) =>
    side > 0 ? "BUY" : side < 0 ? "SELL" : "NEUTRAL"

f_v22Emit(string model, V22Setup setup, string state, string reason) =>
    array.push(v22Observations, V22Observation.new(model, setup.side, setup.id, time_close, state, reason, setup.level))

f_v22Watch(string model, V22Setup setup, int side, float level, float trigger, float stopBase, int pivotId, string reason) =>
    setup.side := side
    setup.watchedAt := time_close
    setup.started := bar_index
    setup.pivotId := pivotId
    setup.level := level
    setup.trigger := trigger
    setup.stopBase := stopBase
    setup.atr := v22ATR
    setup.id := model + "-" + f_v22Direction(side) + "-" + str.tostring(time_close)
    f_v22Emit(model, setup, "WATCH", reason)

f_v22Barrier(int side) =>
    float first = side == 1 ? v22PriorHigh : v22PriorLow
    float second = side == 1 ? v22EarlierHigh : v22EarlierLow
    bool firstAhead = side * (first - close) > 0
    bool secondAhead = side * (second - close) > 0
    firstAhead and secondAhead ? (side == 1 ? math.min(first, second) : math.max(first, second)) :
      firstAhead ? first : secondAhead ? second : na

f_v22Confirm(string model, V22Setup setup, string reason) =>
    int side = setup.side
    f_v22Emit(model, setup, "CONFIRMED", reason)
    array.push(v22Candidates, V22Candidate.new(model, side, setup.id, setup.watchedAt, time_close, setup.level,
      close, setup.stopBase, f_v22Barrier(side), v22ATR, v22Extension, v22Spike, v22H1 == -side or v22H4 == -side))
    setup.lastConfirmation := bar_index
    setup.side := 0

f_v22Cancel(string model, V22Setup setup, string state, string reason) =>
    f_v22Emit(model, setup, state, reason)
    setup.side := 0

f_v22Cooled(V22Setup setup) =>
    na(setup.lastConfirmation) or bar_index - setup.lastConfirmation > V22_COOLDOWN

f_v22Displaced(int side) =>
    side == 1 ? v22BullDisplacement : v22BearDisplacement

array.clear(v22Candidates)
array.clear(v22Observations)

if barstate.isconfirmed
    if v22RegimeNow != v22Regime
        string transition = (v22Regime == "" ? "INITIAL" : v22Regime) + ">" + v22RegimeNow + ":" + v22RegimeReason
        array.push(v22Observations, V22Observation.new("REGIME", v22Trend, "REGIME-" + str.tostring(time_close),
          time_close, "REGIME_TRANSITION", transition, close))
        v22Regime := v22RegimeNow
    if v22Ready
        if v22EnableA
            if v22SetupA.side != 0
                int age = bar_index - v22SetupA.started
                int activePivot = v22SetupA.side == 1 ? v22PriorHighKnown : v22PriorLowKnown
                if age > 8
                    f_v22Cancel("A", v22SetupA, "EXPIRED", "EXPIRED")
                else if v22Trend == -v22SetupA.side or activePivot != v22SetupA.pivotId
                    f_v22Cancel("A", v22SetupA, "INVALIDATED", "STRUCTURE_INVALID")
                else if age == 1
                    f_v22Emit("A", v22SetupA, "CONFIRMING", "WAITING_FOR_STRUCTURE_BREAK")
            if v22SetupA.side == 0 and f_v22Cooled(v22SetupA) and v22Trend != 0
                int side = v22Trend
                float level = side == 1 ? v22PriorHigh : v22PriorLow
                float stopBase = side == 1 ? v22PriorLow : v22PriorHigh
                int pivotId = side == 1 ? v22PriorHighKnown : v22PriorLowKnown
                int used = side == 1 ? v22AUsedHigh : v22AUsedLow
                float approach = side * (level - close)
                if not na(level) and not na(stopBase) and (na(used) or pivotId != used) and
                  ((approach >= 0 and approach <= 0.60 * v22ATR) or f_v22Break(side, level))
                    f_v22Watch("A", v22SetupA, side, level, level, stopBase, pivotId, "KNOWN_SWING_APPROACH")
            if v22SetupA.side != 0 and f_v22Break(v22SetupA.side, v22SetupA.level)
                int side = v22SetupA.side
                if side == 1
                    v22AUsedHigh := v22SetupA.pivotId
                else
                    v22AUsedLow := v22SetupA.pivotId
                if v22SetupA.started == bar_index
                    f_v22Emit("A", v22SetupA, "CONFIRMING", "STRUCTURE_BREAK")
                if v22Trend == side and (not v22RequireADisplacement or f_v22Displaced(side))
                    v22SetupA.stopBase := side == 1 ? v22PriorLow : v22PriorHigh
                    f_v22Confirm("A", v22SetupA, "STRUCTURE_BREAK")
                else
                    f_v22Cancel("A", v22SetupA, "INVALIDATED", "NO_CONFIRMATION")

        if v22EnableB
            if v22SetupB.side != 0
                int age = bar_index - v22SetupB.started
                int side = v22SetupB.side
                if age > 6
                    f_v22Cancel("B", v22SetupB, "EXPIRED", "EXPIRED")
                else if v22Trend == -side or side * (close - v22SetupB.level) < -0.75 * v22SetupB.atr
                    f_v22Cancel("B", v22SetupB, "INVALIDATED", "STRUCTURE_INVALID")
                else
                    if age == 1
                        f_v22Emit("B", v22SetupB, "CONFIRMING", "WAITING_FOR_PULLBACK_REJECTION")
                    v22SetupB.stopBase := side == 1 ? math.min(v22SetupB.stopBase, low) : math.max(v22SetupB.stopBase, high)
                    if v22Trend == side and side * v22Body > 0 and side * (close - v22SetupB.trigger) > 0
                        f_v22Confirm("B", v22SetupB, "PULLBACK_REJECTION")
            if v22SetupB.side == 0 and f_v22Cooled(v22SetupB) and v22Trend[1] != 0
                int side = v22Trend[1]
                float level = v22EMA21[1]
                bool touched = side == 1 ? low <= level + 0.20 * v22ATR : high >= level - 0.20 * v22ATR
                if v22Trend != -side and side * (close[1] - level) > 0.20 * v22ATR and touched and
                  side * (close - level) >= -0.75 * v22ATR
                    f_v22Watch("B", v22SetupB, side, level, side == 1 ? high : low, side == 1 ? low : high, na,
                      "PRIOR_EMA21_PULLBACK")

        if v22EnableC
            if v22SetupC.side != 0
                int age = bar_index - v22SetupC.started
                int side = v22SetupC.side
                if age > 4
                    f_v22Cancel("C", v22SetupC, "EXPIRED", "EXPIRED")
                else if v22Trend == -side or side * (close - v22SetupC.stopBase) < 0
                    f_v22Cancel("C", v22SetupC, "INVALIDATED", "STRUCTURE_INVALID")
                else
                    if age == 1
                        f_v22Emit("C", v22SetupC, "CONFIRMING", "WAITING_FOR_BOX_BREAK")
                    if side * (close - v22SetupC.trigger) > 0
                        if v22Trend == side and f_v22Displaced(side)
                            f_v22Confirm("C", v22SetupC, "BOX_BREAK_WITH_DISPLACEMENT")
                        else
                            f_v22Cancel("C", v22SetupC, "INVALIDATED", "NO_CONFIRMATION")
            if v22SetupC.side == 0 and f_v22Cooled(v22SetupC) and v22NarrowBox and v22Trend != 0
                int side = v22Trend
                if (side == 1 and low > low[3]) or (side == -1 and high < high[3])
                    float level = side == 1 ? v22BoxHigh : v22BoxLow
                    f_v22Watch("C", v22SetupC, side, level, level, side == 1 ? v22BoxLow : v22BoxHigh, na,
                      "DIRECTIONAL_COMPRESSION")

    if v22BOS != 0
        v22BreakBias := v22BOS
    // Disclose strict 2/2 pivots on this close. Model decisions see them from
    // the next chart bar. Trailing rules can schedule them on this close.
    if v22HighPivot
        v22PreviousHigh := v22LastHigh
        v22LastHigh := high[2]
        v22LastHighKnown := time_close
    if v22LowPivot
        v22PreviousLow := v22LastLow
        v22LastLow := low[2]
        v22LastLowKnown := time_close

// Three additional research models. Each has its own setup ID and cooldown.
bool gpTrendModel = input.bool(true, "D · Trend continuation", group="Gold Pro models", display=display.none)
bool gpSweepModel = input.bool(true, "E · Liquidity sweep reversal", group="Gold Pro models", display=display.none)
bool gpMomentumModel = input.bool(true, "F · Momentum breakout", group="Gold Pro models", display=display.none)

float gpEMA200 = ta.ema(close, 200)
float gpEfficiencyPath = math.sum(math.abs(ta.change(close)), 20)
float gpEfficiency = gpEfficiencyPath > 0 ? math.abs(close - close[20]) / gpEfficiencyPath : 0
float gpMomentumChange = v22Momentum - v22Momentum[1]
float gpPriorRangeHigh = ta.highest(high, 10)[1]
float gpPriorRangeLow = ta.lowest(low, 10)[1]
float gpContinuationHigh = ta.highest(high, 3)[1]
float gpContinuationLow = ta.lowest(low, 3)[1]
bool gpEqualHighs = not na(v22EarlierHigh) and math.abs(v22PriorHigh - v22EarlierHigh) <= 0.15 * v22ATR
bool gpEqualLows = not na(v22EarlierLow) and math.abs(v22PriorLow - v22EarlierLow) <= 0.15 * v22ATR
bool gpBullSweep = v22Ready and low < v22PriorLow - syminfo.mintick and close > v22PriorLow
bool gpBearSweep = v22Ready and high > v22PriorHigh + syminfo.mintick and close < v22PriorHigh
bool gpBullFVG = low > high[2] and v22BullDisplacement[1]
bool gpBearFVG = high < low[2] and v22BearDisplacement[1]

var V22Setup gpTrendSetup = V22Setup.new()
var V22Setup gpSweepSetup = V22Setup.new()
var V22Setup gpMomentumSetup = V22Setup.new()

// A new setup is disclosed on its trigger bar. Its confirmation can first
// occur on the following close, through the frozen trigger.
f_gpAdditionalModel(string code, V22Setup setup, bool enabled, int side, float level, float trigger, float stopBase, string reason) =>
    if enabled
        if setup.side != 0
            int age = bar_index - setup.started
            if age > 5
                f_v22Cancel(code, setup, "EXPIRED", "EXPIRED")
            else if (close - setup.stopBase) * setup.side <= 0 or (code != "E" and v22Trend == -setup.side)
                f_v22Cancel(code, setup, "INVALIDATED", "STRUCTURE_INVALID")
            else if age > 0
                bool aligned = code == "E" ? v22Trend != -setup.side : v22Trend == setup.side
                if aligned and (close - setup.trigger) * setup.side > 0 and v22Body * setup.side > 0
                    f_v22Confirm(code, setup, "CLOSE_THROUGH_FROZEN_TRIGGER")
                else if age == 1
                    f_v22Emit(code, setup, "SETUP_FORMING", "WAIT_FOR_FROZEN_TRIGGER")
        if setup.side == 0 and side != 0 and f_v22Cooled(setup) and not na(stopBase)
            f_v22Watch(code, setup, side, level, trigger, stopBase, na, reason)

if gpClosedBar and v22Ready
    bool priorTrend = v22Trend != 0 and v22Trend == v22Trend[1] and (close - gpEMA200) * v22Trend > 0
    int continuationSide = priorTrend and v22Extension <= 1.50 and gpEfficiency >= 0.25 and
      v22Momentum * v22Trend >= 0.40 and gpMomentumChange * v22Trend > 0 ? v22Trend : 0
    f_gpAdditionalModel("D", gpTrendSetup, gpTrendModel, continuationSide, v22EMA21,
      continuationSide > 0 ? gpContinuationHigh : gpContinuationLow,
      continuationSide > 0 ? gpContinuationLow : gpContinuationHigh, "TREND_REACCELERATION")

    int sweepSide = gpBullSweep == gpBearSweep ? 0 : gpBullSweep ? 1 : -1
    bool equalPool = sweepSide > 0 ? gpEqualLows : gpEqualHighs
    f_gpAdditionalModel("E", gpSweepSetup, gpSweepModel, sweepSide,
      sweepSide > 0 ? v22PriorLow : v22PriorHigh, sweepSide > 0 ? high : low,
      sweepSide > 0 ? low : high, equalPool ? "EQUAL_LEVEL_SWEEP_RECLAIM" : "SWING_SWEEP_RECLAIM")

    int momentumSide = v22Trend == 1 and v22BullDisplacement and close > gpPriorRangeHigh and gpMomentumChange > 0 ? 1 :
      v22Trend == -1 and v22BearDisplacement and close < gpPriorRangeLow and gpMomentumChange < 0 ? -1 : 0
    f_gpAdditionalModel("F", gpMomentumSetup, gpMomentumModel, momentumSide,
      momentumSide > 0 ? gpPriorRangeHigh : gpPriorRangeLow, momentumSide > 0 ? high : low,
      momentumSide > 0 ? low : high, "DISPLACEMENT_RANGE_BREAK")

string gpRegime = not gpContextReady or not v22Ready ? "UNCERTAIN" : v22Spike ? "VOLATILITY SHOCK" :
  v22MSS ? "REVERSAL WATCH" : v22Exhausted ? "EXHAUSTION" : v22BOS != 0 ? "BREAKOUT" :
  v22Compression ? "COMPRESSION" : v22Trend == 1 ? "TRENDING UP" : v22Trend == -1 ? "TRENDING DOWN" : "RANGING"

f_gpModel(string code) =>
    switch code
        "A" => "Structural breakout"
        "B" => "Smart pullback"
        "C" => "Compression expansion"
        "D" => "Trend continuation"
        "E" => "Liquidity sweep reversal"
        "F" => "Momentum breakout"
        "R" => "Second chance"
        "Q" => "Fast opportunity"
        => "Market regime"

f_gpDirection(int side) =>
    na(side) ? "UNKNOWN" : f_v22Direction(side)

bool gpSecondChance = input.bool(true, "Track second-chance observations", group="Gold Pro opportunities")
bool gpAlertEarly = input.bool(false, "Early directional alerts", group="Gold Pro alerts")
bool gpAlertEntry = input.bool(true, "Valid entry alerts", group="Gold Pro alerts")
bool gpAlertSecond = input.bool(true, "Second-chance alerts", group="Gold Pro alerts")
const int GP_OPPORTUNITY_BARS = 24

type GoldOpportunity
    int side = 0
    int startedBar = na
    int waitBar = na
    int retestBar = na
    int watchedAt = na
    float level = na
    float retestTrigger = na
    float retestStop = na
    string id = ""
    string state = ""
    string reason = ""

var GoldOpportunity gpBuyOpportunity = GoldOpportunity.new()
var GoldOpportunity gpSellOpportunity = GoldOpportunity.new()
var int gpOpportunityAt = na
var string gpOpportunityText = "WAIT"

f_gpStartOpportunity(GoldOpportunity tracker, int side, float level, string cause) =>
    tracker.side := side
    tracker.startedBar := bar_index
    tracker.watchedAt := time_close
    tracker.waitBar := na
    tracker.retestBar := na
    tracker.level := level
    tracker.retestTrigger := na
    tracker.retestStop := na
    tracker.id := "O-" + f_gpDirection(side) + "-" + str.tostring(time_close)
    tracker.state := f_gpDirection(side) + " WATCH"
    tracker.reason := cause

f_gpWaitOpportunity(GoldOpportunity tracker, int side, float level, string cause) =>
    if gpSecondChance and not na(level) and (tracker.state != "WAIT FOR PULLBACK" or na(tracker.waitBar))
        if tracker.state == "" or tracker.state == "OPPORTUNITY EXPIRED" or tracker.state == "SECOND CHANCE"
            f_gpStartOpportunity(tracker, side, level, cause)
        tracker.state := "WAIT FOR PULLBACK"
        tracker.reason := cause
        tracker.level := level
        tracker.waitBar := bar_index
        tracker.retestBar := na

f_gpFollowOpportunity(GoldOpportunity tracker, int side, bool early, bool confirmed, float structure) =>
    bool changed = false
    bool expired = not na(tracker.startedBar) and bar_index - tracker.startedBar > GP_OPPORTUNITY_BARS
    bool active = tracker.state != "" and tracker.state != "OPPORTUNITY EXPIRED" and tracker.state != "SECOND CHANCE"
    if active and (expired or v22BOS == -side)
        tracker.state := "OPPORTUNITY EXPIRED"
        tracker.reason := expired ? "MAXIMUM_AGE" : "OPPOSITE_STRUCTURE_BREAK"
        changed := true
    else if early and not active and not na(structure)
        f_gpStartOpportunity(tracker, side, structure, "DIRECTIONAL_STRUCTURE_AND_MOMENTUM")
        changed := true
    if confirmed and tracker.state == f_gpDirection(side) + " WATCH"
        tracker.state := "TREND CONFIRMED"
        tracker.reason := "CAUSAL_STRUCTURE_BREAK"
        changed := true
    if tracker.state == "WAIT FOR PULLBACK" and bar_index > tracker.waitBar
        bool touched = side == 1 ? low <= tracker.level + 0.20 * v22ATR : high >= tracker.level - 0.20 * v22ATR
        if na(tracker.retestBar) and touched and (close - tracker.level) * side >= -0.50 * v22ATR
            tracker.retestBar := bar_index
            tracker.retestTrigger := side == 1 ? high : low
            tracker.retestStop := side == 1 ? low : high
        if not na(tracker.retestBar) and bar_index > tracker.retestBar
            tracker.retestStop := side == 1 ? math.min(tracker.retestStop, low) : math.max(tracker.retestStop, high)
        bool retest = not na(tracker.retestBar) and bar_index > tracker.retestBar and (close - tracker.retestTrigger) * side > 0
        float freshRange = v22BoxHigh[1] - v22BoxLow[1]
        bool compression = v22NarrowBox[1] and freshRange <= 1.50 * v22ATR and
          (close - (side == 1 ? v22BoxHigh[1] : v22BoxLow[1])) * side > 0
        bool continuation = v22Trend == side and v22Trend[1] == side and v22Extension <= 1.25 and
          gpMomentumChange * side > 0 and (close - (side == 1 ? gpContinuationHigh : gpContinuationLow)) * side > 0
        bool qualified = (retest or compression or continuation) and v22Body * side > 0 and v22Trend != -side
        if qualified
            float stopBase = retest ? tracker.retestStop : compression ? (side == 1 ? v22BoxLow[1] : v22BoxHigh[1]) :
              side == 1 ? gpContinuationLow : gpContinuationHigh
            string method = retest ? "FRESH_RETEST" : compression ? "FRESH_COMPRESSION" : "FRESH_CONTINUATION"
            string newId = "R-" + method + "-" + f_gpDirection(side) + "-" + str.tostring(time_close)
            array.push(v22Candidates, V22Candidate.new("R", side, newId, time_close, time_close, tracker.level, close,
              stopBase, f_v22Barrier(side), v22ATR, v22Extension, v22Spike, gpH1Side == -side or gpH4Side == -side))
            array.push(v22Observations, V22Observation.new("R", side, newId, time_close, "CONFIRMED", method, close))
            tracker.state := "SECOND CHANCE"
            tracker.reason := method
            changed := true
    changed

bool gpOpportunityBuyChanged = false
bool gpOpportunitySellChanged = false
if gpClosedBar and v22Ready
    bool buyEarly = v22Trend == 1 and v22Momentum >= 0.60 and v22Extension <= 2.50
    bool sellEarly = v22Trend == -1 and v22Momentum <= -0.60 and v22Extension <= 2.50
    gpOpportunityBuyChanged := f_gpFollowOpportunity(gpBuyOpportunity, 1, buyEarly, v22BOS == 1, v22PriorHigh)
    gpOpportunitySellChanged := f_gpFollowOpportunity(gpSellOpportunity, -1, sellEarly, v22BOS == -1, v22PriorLow)
    for tracker in array.from(gpBuyOpportunity, gpSellOpportunity)
        if tracker.startedBar == bar_index and tracker.state != "OPPORTUNITY EXPIRED"
            int side = tracker.side
            float stopBase = side == 1 ? gpContinuationLow : gpContinuationHigh
            string fastId = "Q-" + f_gpDirection(side) + "-" + str.tostring(time_close)
            array.push(v22Candidates, V22Candidate.new("Q", side, fastId, time_close, time_close, tracker.level, close,
              stopBase, f_v22Barrier(side), v22ATR, v22Extension, v22Spike, gpH1Side == -side or gpH4Side == -side))
    if gpOpportunityBuyChanged or gpOpportunitySellChanged
        gpOpportunityAt := time_close
        gpOpportunityText := gpOpportunityBuyChanged and gpOpportunitySellChanged ? "CONFLICT" :
          gpOpportunityBuyChanged ? gpBuyOpportunity.state : gpSellOpportunity.state

string gpEntryMethod = input.string("Next-open market", "Entry policy",
  options=["Next-open market", "Pullback limit", "Breakout stop"], group="Gold Pro research risk")
string gpSizeMethod = input.string("Reference size", "Simulation size", options=["Reference size", "Fixed risk"],
  group="Gold Pro research risk", tooltip="Reference size uses three TradingView units for comparison. The risk and exposure caps still apply.")
float gpEquityInput = input.float(100000.0, "Research equity (USD)", minval=1, group="Gold Pro research risk")
float gpRiskPct = input.float(0.25, "Initial risk cap (%)", minval=0.01, maxval=1, step=0.05, group="Gold Pro research risk")
float gpExposurePct = input.float(100, "Maximum position notional (%)", minval=1, maxval=100, group="Gold Pro research risk")
float gpSpreadInput = input.float(0.35, "Estimated round-trip spread (price)", minval=0, step=0.05, group="Gold Pro research risk")
float gpMinNetRR = input.float(0.70, "Minimum estimated net reward/risk", minval=0.1, maxval=0.95, step=0.05, group="Gold Pro research risk")
float gpCostCap = input.float(0.30, "Maximum cost/stop distance", minval=0.01, maxval=0.50, step=0.05, group="Gold Pro research risk")
bool gpRequireNews = input.bool(false, "Require verified news source to clear risk", group="Gold Pro research risk")
string gpStudyModel = input.string("A", "Independent simulation model", options=["A", "B", "C", "D", "E", "F", "R"],
  group="Gold Pro research risk")
string gpTiming = input.string("CONFIRMED", "Research entry timing", options=["FAST", "CONFIRMED"],
  group="Gold Pro research risk", tooltip="FAST tests the first directional opportunity. CONFIRMED uses the selected independent model.")
bool gpAlertEnabled = input.bool(false, "Enable informational alerts", group="Gold Pro alerts")
bool gpAlertWatches = input.bool(false, "Include watch alerts", group="Gold Pro alerts")
bool gpAuditSignals = input.bool(false, "Log analytical lifecycle", group="Gold Pro evidence")
int gpSignalLogFrom = input.time(timestamp("10 Nov 2026 00:00 +0000"), "Lifecycle log from (UTC)", group="Gold Pro evidence")
int gpSignalLogUntil = input.time(timestamp("12 Nov 2026 00:00 +0000"), "Lifecycle log through (UTC)", group="Gold Pro evidence")

const float GP_NATIVE_FEE = 0.175
const int GP_NATIVE_SLIPPAGE = 2
const int GP_PENDING_BARS = 3
const string GP_NEWS_STATE = "NEWS DATA UNAVAILABLE"
float gpTick = syminfo.mintick
float gpPoint = syminfo.pointvalue
float gpUnitStep = syminfo.mincontract
bool gpContract = gpSupported and syminfo.currency == "USD" and gpPoint > 0 and gpTick > 0 and gpUnitStep > 0
float gpCostPrice = gpContract ? gpSpreadInput + 2.0 * GP_NATIVE_FEE / gpPoint + 2.0 * GP_NATIVE_SLIPPAGE * gpTick : na
bool gpEmitLogs = gpAuditSignals and gpClosedBar and time_close >= gpSignalLogFrom and time_close <= gpSignalLogUntil

type GoldPlan
    string id = ""
    string model = ""
    string reason = ""
    int side = 0
    int knownAt = na
    int watchedAt = na
    int expiryBar = na
    float entry = na
    float invalidation = na
    float structure = na
    float stop = na
    float tp1 = na
    float tp2 = na
    float tp3 = na
    float grossRR = na
    float netRR = na
    float qty = na
    float leg = na
    float riskCash = na
    float costCash = na
    float atr = na
    float extension = na

f_gpStopPrice(float price, int side) =>
    side > 0 ? math.floor(price / gpTick + 1e-8) * gpTick : math.ceil(price / gpTick - 1e-8) * gpTick

f_gpTargetPrice(float price, int side) =>
    f_gpStopPrice(price, -side)

f_gpPlan(V22Candidate candidate) =>
    GoldPlan plan = GoldPlan.new()
    plan.id := candidate.setupId + "|" + str.tostring(candidate.knownAt)
    plan.model := candidate.model
    plan.side := candidate.side
    plan.knownAt := candidate.knownAt
    plan.watchedAt := candidate.watchedAt
    plan.expiryBar := bar_index + (gpEntryMethod == "Next-open market" ? 1 : GP_PENDING_BARS)
    plan.atr := candidate.atr
    plan.extension := candidate.extension
    plan.invalidation := candidate.stopBase
    plan.structure := candidate.level
    float offset = gpEntryMethod == "Pullback limit" ? -0.25 * candidate.atr : gpEntryMethod == "Breakout stop" ? gpTick : 0.0
    plan.entry := math.round_to_mintick(candidate.reference + candidate.side * offset)
    plan.stop := f_gpStopPrice(candidate.stopBase - candidate.side * 0.10 * candidate.atr, candidate.side)
    float distance = (plan.entry - plan.stop) * candidate.side
    if not na(distance) and distance >= gpTick * (1 - 1e-7) and gpContract
        plan.tp1 := f_gpTargetPrice(plan.entry + candidate.side * distance, candidate.side)
        plan.tp2 := f_gpTargetPrice(plan.entry + candidate.side * 2.0 * distance, candidate.side)
        plan.tp3 := f_gpTargetPrice(plan.entry + candidate.side * 3.0 * distance, candidate.side)
        float firstTargetRoom = (plan.tp1 - plan.entry) * candidate.side
        float room = na(candidate.barrier) ? firstTargetRoom : math.max(0, math.min(firstTargetRoom, (candidate.barrier - plan.entry) * candidate.side))
        plan.grossRR := room / distance
        plan.netRR := (room - gpCostPrice) / (distance + gpCostPrice)
        float unitRisk = (distance + gpCostPrice) * gpPoint
        float riskBudget = gpEquityInput * gpRiskPct * 0.01
        float exposureBudget = gpEquityInput * gpExposurePct * 0.01
        float qtyLimit = math.min(riskBudget / unitRisk, exposureBudget / (plan.entry * gpPoint))
        float quantity = gpSizeMethod == "Reference size" ? 3 : qtyLimit
        plan.leg := math.floor(quantity / (3 * gpUnitStep) + 1e-8) * gpUnitStep
        plan.qty := 3 * plan.leg
        plan.riskCash := plan.qty * unitRisk
        plan.costCash := plan.qty * gpCostPrice * gpPoint
        if plan.leg < gpUnitStep * (1 - 1e-7) or plan.riskCash > riskBudget + 1e-7 or plan.qty * plan.entry * gpPoint > exposureBudget + 1e-7
            plan.reason := "RISK_OR_EXPOSURE_CAP"
    if not gpContract
        plan.reason := "CONTRACT_UNSUPPORTED"
    else if not gpContextReady
        plan.reason := "HTF_UNKNOWN"
    else if gpRequireNews
        plan.reason := "NEWS_DATA_UNAVAILABLE"
    else if na(distance) or distance < gpTick * (1 - 1e-7)
        plan.reason := "STRUCTURE_INVALID"
    else if candidate.spike
        plan.reason := "VOLATILITY_SPIKE"
    else if gpH1Side == -plan.side or gpH4Side == -plan.side
        plan.reason := "HTF_CONFLICT"
    else if candidate.extension > 1.75
        plan.reason := "EXCESSIVE_EXTENSION"
    else if distance > 3.0 * candidate.atr
        plan.reason := "OVERSIZED_STOP"
    else if gpCostPrice > gpCostCap * distance
        plan.reason := "COST_TOO_HIGH"
    else if plan.netRR < gpMinNetRR
        plan.reason := "INSUFFICIENT_NET_ROOM"
    plan

f_gpNumber(float value) =>
    na(value) ? "null" : str.tostring(value, "#.########")

f_gpEvent(string model, string id, int side, string state, string reason, float reference, float stop, float tp1, float tp2, float tp3, bool alertable) =>
    string message = '{"schema":"qirvanta.goldpro.event.v1","symbol":"' + syminfo.tickerid +
      '","timeframe":"' + timeframe.period + '","known_at":' + str.tostring(time_close) +
      ',"model":"' + model + '","id":"' + id + '","direction":"' + f_gpDirection(side) +
      '","state":"' + state + '","reason":"' + reason + '","reference":' + f_gpNumber(reference) +
      ',"stop":' + f_gpNumber(stop) + ',"tp1":' + f_gpNumber(tp1) + ',"tp2":' + f_gpNumber(tp2) +
      ',"tp3":' + f_gpNumber(tp3) + ',"informational":true}'
    if gpEmitLogs
        log.info(message)
    if alertable and gpAlertEnabled and barstate.isrealtime
        alert(message, alert.freq_all)

var string gpLastWatch = "—"
var string gpLastConfirmation = "—"
var string gpLastState = "WAIT"
var string gpLastReason = ""
var string gpLastQuality = "NO TRADE"
var bool gpLastConflict = false
var GoldPlan gpLastPlan = na
var int gpPlanValidThrough = na
bool gpBuyWatch = false
bool gpSellWatch = false
bool gpBuyConfirmed = false
bool gpSellConfirmed = false
bool gpExpiryMark = false
GoldPlan gpSelected = na

if gpClosedBar
    if not na(gpPlanValidThrough) and bar_index >= gpPlanValidThrough
        if gpOpportunityText == "ENTRY AVAILABLE" or gpOpportunityText == "SECOND CHANCE"
            gpOpportunityText := "OPPORTUNITY EXPIRED"
            gpOpportunityAt := time_close
        if gpLastState == "ENTRY_VALID"
            gpLastState := "EXPIRED"
            gpLastReason := "PLAN_VALIDITY_ENDED"
        gpPlanValidThrough := na
    if gpOpportunityBuyChanged and (gpEmitLogs or gpAlertEnabled and gpAlertEarly)
        f_gpEvent("O", gpBuyOpportunity.id, 1, gpBuyOpportunity.state, gpBuyOpportunity.reason, gpBuyOpportunity.level, na, na, na, na, gpAlertEarly and gpBuyOpportunity.state != "SECOND CHANCE")
    if gpOpportunitySellChanged and (gpEmitLogs or gpAlertEnabled and gpAlertEarly)
        f_gpEvent("O", gpSellOpportunity.id, -1, gpSellOpportunity.state, gpSellOpportunity.reason, gpSellOpportunity.level, na, na, na, na, gpAlertEarly and gpSellOpportunity.state != "SECOND CHANCE")
    for obs in v22Observations
        bool watch = obs.state == "WATCH"
        bool confirmed = obs.state == "CONFIRMED"
        bool invalidated = obs.state == "INVALIDATED"
        if watch
            gpLastWatch := obs.model + " " + f_gpDirection(obs.side)
            gpBuyWatch := gpBuyWatch or obs.side > 0
            gpSellWatch := gpSellWatch or obs.side < 0
        if confirmed
            gpLastConfirmation := obs.model + " " + f_gpDirection(obs.side)
            gpBuyConfirmed := gpBuyConfirmed or obs.side > 0
            gpSellConfirmed := gpSellConfirmed or obs.side < 0
        if obs.state != "REGIME_TRANSITION"
            gpLastState := obs.state == "CONFIRMING" ? "SETUP_FORMING" : obs.state
            gpLastReason := obs.reason
            gpExpiryMark := gpExpiryMark or obs.state == "EXPIRED"
            if not confirmed
                gpLastQuality := watch or obs.state == "CONFIRMING" or obs.state == "SETUP_FORMING" ? "LOW CONFLUENCE" : "NO TRADE"
            if gpEmitLogs or gpAlertEnabled and (confirmed or invalidated or watch and gpAlertWatches)
                f_gpEvent(obs.model, obs.setupId, obs.side, gpLastState, obs.reason, obs.level, na, na, na, na,
                  confirmed or invalidated or watch and gpAlertWatches)

    bool candidateBuy = false
    bool candidateSell = false
    for candidate in v22Candidates
        if (gpTiming == "FAST") == (candidate.model == "Q")
            candidateBuy := candidateBuy or candidate.side > 0
            candidateSell := candidateSell or candidate.side < 0
    bool opposed = gpBuyConfirmed and gpSellConfirmed or candidateBuy and candidateSell
    if array.size(v22Candidates) > 0
        gpLastConflict := opposed
    GoldPlan featured = na
    bool featuredInLane = false
    for candidate in v22Candidates
        GoldPlan plan = f_gpPlan(candidate)
        if opposed
            plan.reason := "OPPOSING_CONFIRMED_SIGNALS"
        bool timingSelected = (gpTiming == "FAST") == (candidate.model == "Q")
        if gpEmitLogs
            log.info("GOLD_PLAN|" + plan.id + "|" + gpTiming + "|" + str.tostring(timingSelected) + "|" +
              str.tostring(plan.knownAt - plan.watchedAt) + "|" + f_gpNumber(plan.extension) + "|" +
              f_gpNumber(plan.grossRR) + "|" + f_gpNumber(plan.netRR) + "|" + plan.reason)
        if not timingSelected
            continue
        bool valid = plan.reason == ""
        string planState = valid ? "ENTRY_VALID" : "ENTRY_REJECTED"
        bool inLane = candidate.model == gpStudyModel or gpTiming == "FAST"
        if na(featured) or inLane and not featuredInLane or inLane == featuredInLane and valid and featured.reason != ""
            featured := plan
            featuredInLane := inLane
        if valid and inLane and na(gpSelected)
            gpSelected := plan
        bool waitForNew = candidate.model != "R" and (plan.reason == "EXCESSIVE_EXTENSION" or plan.reason == "OVERSIZED_STOP" or plan.reason == "HTF_CONFLICT")
        if waitForNew
            GoldOpportunity tracker = plan.side > 0 ? gpBuyOpportunity : gpSellOpportunity
            f_gpWaitOpportunity(tracker, plan.side, plan.structure, plan.reason)
        bool entryAlert = valid and (candidate.model == "R" ? gpAlertSecond : gpAlertEntry)
        if gpEmitLogs or gpAlertEnabled and (entryAlert or opposed or plan.reason == "HTF_CONFLICT")
            f_gpEvent(plan.model, plan.id, plan.side, planState, plan.reason, plan.entry, plan.stop, plan.tp1, plan.tp2, plan.tp3,
              entryAlert or opposed or plan.reason == "HTF_CONFLICT")
    if not na(featured)
        bool valid = featured.reason == ""
        bool aligned = gpH1Side == featured.side and gpH4Side == featured.side
        gpLastPlan := featured
        gpLastState := valid ? "ENTRY_VALID" : "ENTRY_REJECTED"
        gpLastReason := featured.reason
        gpLastQuality := opposed or featured.reason == "HTF_CONFLICT" ? "CONFLICT" : not valid ? "NO TRADE" :
          aligned and v22Trend == featured.side and v22ADX >= 22 ? "HIGH CONFLUENCE" : "MODERATE CONFLUENCE"
        gpOpportunityAt := time_close
        gpPlanValidThrough := valid ? featured.expiryBar : na
        GoldOpportunity tracker = featured.side > 0 ? gpBuyOpportunity : gpSellOpportunity
        bool recoverable = featured.reason == "EXCESSIVE_EXTENSION" or featured.reason == "OVERSIZED_STOP" or featured.reason == "HTF_CONFLICT"
        gpOpportunityText := valid ? (featured.model == "R" ? "SECOND CHANCE" : "ENTRY AVAILABLE") :
          recoverable and tracker.state == "WAIT FOR PULLBACK" ? "WAIT FOR PULLBACK" : "RISK REJECTED"

string gpPresentationMode = "MARKET OBSERVATION"
GoldPlan gpVisiblePlan = gpLastPlan
string gpExecutionState = "RESEARCH"
string gpExecutionRisk = "OBSERVATION ONLY"
float gpVisibleFill = na
float gpVisibleStop = not na(gpVisiblePlan) ? gpVisiblePlan.stop : na
string gpLastClosedText = "—"
bool gpShowNativePlan = false
bool gpClosedMark = false

string gpView = input.string("COMPACT", "Dashboard preset", options=["MINIMAL", "COMPACT", "PROFESSIONAL", "MOBILE"], group="Gold Pro display")
bool gpShowDashboard = input.bool(true, "Show dashboard", group="Gold Pro display")
bool gpOverlayWatch = input.bool(false, "Watch markers", group="Gold Pro display")
bool gpOverlayConfirm = input.bool(true, "Confirmation markers", group="Gold Pro display")
bool gpOverlayStructure = input.bool(false, "Structure levels and BOS / MSS", group="Gold Pro display")
bool gpOverlaySession = input.bool(false, "Session and prior day levels", group="Gold Pro display")
bool gpOverlayLiquidity = input.bool(false, "Estimated liquidity and FVG", group="Gold Pro display")
bool gpOverlayEntry = input.bool(true, "Native simulation and risk levels", group="Gold Pro display")
bool gpOverlayOutcome = input.bool(true, "Simulation close markers", group="Gold Pro display")
bool gpOverlayExpiry = input.bool(false, "Opportunity expiry markers", group="Gold Pro display")

color gpInk = color.rgb(229, 237, 241)
color gpMuted = color.rgb(165, 181, 193)
color gpGraphite = color.rgb(17, 24, 32)
color gpHead = color.rgb(27, 40, 52)
color gpEmerald = color.rgb(81, 218, 169)
color gpRed = color.rgb(255, 122, 130)
color gpCyan = color.rgb(115, 219, 250)
color gpAmber = color.rgb(255, 205, 111)
bool gpMobile = gpView == "MOBILE"
bool gpMinimal = gpView == "MINIMAL"
bool gpFull = gpView == "PROFESSIONAL"
string gpFont = gpMobile ? size.tiny : size.small
var table gpPanel = table.new(gpMobile ? position.bottom_right : position.top_right, 2, 23, bgcolor=gpGraphite,
  frame_color=color.new(gpCyan, 60), frame_width=1)

f_gpPrice(float price) =>
    na(price) ? "—" : str.tostring(price, format.mintick)

f_gpPair(float left, float right) =>
    f_gpPrice(left) + " / " + f_gpPrice(right)

f_gpCell(int row, string label, string value, color ink) =>
    color background = row == 0 ? gpHead : row % 2 == 0 ? gpGraphite : color.rgb(20, 29, 38)
    table.cell(gpPanel, 0, row, label, bgcolor=background, text_color=row == 0 ? gpCyan : gpMuted, text_size=gpFont, text_halign=text.align_left)
    table.cell(gpPanel, 1, row, value, bgcolor=background, text_color=ink, text_size=gpFont, text_halign=text.align_right)

f_gpReason(string reason) =>
    reason == "" ? "—" : str.replace_all(reason, "_", " ")

bool gpPanelReady = not na(gpH1Side) and not na(gpH4Side)
bool gpDrawBoard = gpShowDashboard and (barstate.islastconfirmedhistory or barstate.islast and barstate.isconfirmed)
if gpDrawBoard
    bool hasPlan = not na(gpVisiblePlan)
    color directionalInk = not hasPlan ? gpMuted : gpVisiblePlan.side == 1 ? gpEmerald : gpRed
    string planName = not hasPlan ? "—" : gpMobile ? gpVisiblePlan.model + " " + f_gpDirection(gpVisiblePlan.side) :
      f_gpModel(gpVisiblePlan.model) + " · " + f_gpDirection(gpVisiblePlan.side)
    string status = not gpSupported ? "OANDA:XAUUSD M5/M15/M30 REQUIRED" : gpExecutionState
    f_gpCell(0, "QIRVANTA GOLD PRO", syminfo.ticker + " · " + timeframe.period + "m", gpCyan)
    f_gpCell(1, "Mode", gpPresentationMode, gpCyan)
    f_gpCell(2, "Regime", gpRegime, gpPanelReady ? gpInk : gpAmber)
    f_gpCell(3, "H1 / H4", f_gpDirection(gpH1Side) + " / " + f_gpDirection(gpH4Side), gpPanelReady ? gpInk : gpAmber)
    f_gpCell(4, "Opportunity", gpOpportunityText, gpOpportunityText == "RISK REJECTED" ? gpAmber : gpCyan)
    f_gpCell(5, "Risk", gpExecutionRisk, gpAmber)
    if not gpMinimal
        f_gpCell(6, "Structure", v22Structure, gpInk)
        f_gpCell(7, "Watch / confirmed", gpLastWatch + " / " + gpLastConfirmation, gpInk)
        f_gpCell(8, "Decision", gpLastState + (gpLastReason == "" or gpMobile ? "" : " · " + f_gpReason(gpLastReason)), gpLastConflict ? gpAmber : gpInk)
        f_gpCell(9, "Quality", gpLastQuality, gpLastConflict ? gpAmber : gpMuted)
        f_gpCell(10, "Position", status, directionalInk)
        f_gpCell(11, "Plan / fill", hasPlan ? f_gpPair(gpVisiblePlan.entry, gpVisibleFill) : "—", gpCyan)
        f_gpCell(12, "Initial / current SL", hasPlan ? f_gpPair(gpVisiblePlan.stop, gpVisibleStop) : "—", gpRed)
        string targets = hasPlan ? f_gpPrice(gpVisiblePlan.tp1) + " / " + f_gpPrice(gpVisiblePlan.tp2) + " / " + f_gpPrice(gpVisiblePlan.tp3) : "—"
        f_gpCell(13, "TP1 / TP2 / TP3", targets, gpCyan)
        f_gpCell(14, "Last closed", gpLastClosedText, gpMuted)
        if gpMobile
            f_gpCell(15, "Reason", f_gpReason(gpLastReason), gpAmber)
    if gpFull
        f_gpCell(15, "Model / side", planName, directionalInk)
        f_gpCell(16, "D1 / session", f_gpDirection(gpD1Side) + " / " + gpSession, gpMuted)
        f_gpCell(17, "Momentum / prior ATR", str.tostring(v22Momentum, "#.00") + " / " + f_gpPrice(v22ATR), gpMuted)
        f_gpCell(18, "Gross / net R:R", hasPlan ? str.tostring(gpVisiblePlan.grossRR, "#.00") + " / " + str.tostring(gpVisiblePlan.netRR, "#.00") : "—", gpCyan)
        f_gpCell(19, "Units / SL budget", hasPlan ? str.tostring(gpVisiblePlan.qty, "#.##") + " / $" + str.tostring(gpVisiblePlan.riskCash, "#.##") : "—", gpMuted)
        f_gpCell(20, "Entry / costs", gpEntryMethod + (hasPlan ? " · $" + str.tostring(gpVisiblePlan.costCash, "#.##") : ""), gpMuted)
        f_gpCell(21, "Known UTC / validity", hasPlan ? str.format_time(gpVisiblePlan.knownAt, "dd MMM HH:mm", "UTC") + " / " +
          str.tostring(gpEntryMethod == "Next-open market" ? 1 : GP_PENDING_BARS) + " bars" : "—", gpMuted)
        f_gpCell(22, "News", GP_NEWS_STATE, gpAmber)

bool gpDrawNative = gpOverlayEntry and gpShowNativePlan and not na(gpVisiblePlan)
gpEntryPlot = plot(gpDrawNative ? (na(gpVisibleFill) ? gpVisiblePlan.entry : gpVisibleFill) : na, "Simulated entry / fill", gpCyan, 2, plot.style_linebr)
gpStopPlot = plot(gpDrawNative ? gpVisibleStop : na, "Current stop", gpRed, 2, plot.style_linebr)
plot(gpDrawNative and gpVisibleStop != gpVisiblePlan.stop ? gpVisiblePlan.stop : na, "Initial stop", color.new(gpRed, 45), 1, plot.style_linebr)
plot(gpDrawNative ? gpVisiblePlan.tp1 : na, "TP1", color.new(gpCyan, 35), 1, plot.style_linebr)
plot(gpDrawNative ? gpVisiblePlan.tp2 : na, "TP2", color.new(gpCyan, 20), 1, plot.style_linebr)
gpTargetPlot = plot(gpDrawNative ? gpVisiblePlan.tp3 : na, "TP3", gpCyan, 1, plot.style_linebr)
fill(gpEntryPlot, gpStopPlot, color.new(gpRed, 90), "Risk area", fillgaps=false)
fill(gpEntryPlot, gpTargetPlot, color.new(gpCyan, 92), "Reward area", fillgaps=false)

plot(gpOverlayStructure and gpClosedBar ? v22PriorHigh : na, "Confirmed resistance", color.new(gpRed, 35), 1, plot.style_linebr)
plot(gpOverlayStructure and gpClosedBar ? v22PriorLow : na, "Confirmed support", color.new(gpEmerald, 35), 1, plot.style_linebr)
plot(gpOverlaySession and gpSessionComplete ? gpSessionHigh : na, "Session high", color.new(gpCyan, 45), 1, plot.style_linebr)
plot(gpOverlaySession and gpSessionComplete ? gpSessionLow : na, "Session low", color.new(gpCyan, 45), 1, plot.style_linebr)
plot(gpOverlaySession and gpD1Known <= time ? gpD1High : na, "Prior day high", color.new(gpMuted, 55), 1, plot.style_linebr)
plot(gpOverlaySession and gpD1Known <= time ? gpD1Low : na, "Prior day low", color.new(gpMuted, 55), 1, plot.style_linebr)
plot(gpOverlayLiquidity and gpEqualHighs and gpClosedBar ? v22PriorHigh : na, "Estimated equal-high zone", color.new(gpRed, 50), 2, plot.style_linebr)
plot(gpOverlayLiquidity and gpEqualLows and gpClosedBar ? v22PriorLow : na, "Estimated equal-low zone", color.new(gpEmerald, 50), 2, plot.style_linebr)
plotshape(gpOverlayLiquidity and gpClosedBar and gpBullFVG, "Bullish FVG observation", shape.diamond, location.belowbar, color.new(gpEmerald, 40), size=size.tiny)
plotshape(gpOverlayLiquidity and gpClosedBar and gpBearFVG, "Bearish FVG observation", shape.diamond, location.abovebar, color.new(gpRed, 40), size=size.tiny)
plotshape(gpOverlayStructure and gpClosedBar and v22BOS == 1, "Bullish BOS/MSS", shape.square, location.belowbar, gpEmerald, size=size.tiny)
plotshape(gpOverlayStructure and gpClosedBar and v22BOS == -1, "Bearish BOS/MSS", shape.square, location.abovebar, gpRed, size=size.tiny)
plotshape(gpOverlayWatch and gpBuyWatch and not gpBuyConfirmed, "BUY watch", shape.circle, location.belowbar, color.new(gpEmerald, 55), size=size.tiny)
plotshape(gpOverlayWatch and gpSellWatch and not gpSellConfirmed, "SELL watch", shape.circle, location.abovebar, color.new(gpRed, 55), size=size.tiny)
plotshape(gpOverlayConfirm and gpBuyConfirmed, "BUY confirmed", shape.triangleup, location.belowbar, gpEmerald, size=size.tiny)
plotshape(gpOverlayConfirm and gpSellConfirmed, "SELL confirmed", shape.triangledown, location.abovebar, gpRed, size=size.tiny)
plotshape(gpOverlayOutcome and gpClosedMark, "Simulated campaign closed", shape.xcross, location.abovebar, gpCyan, size=size.tiny)
plotshape(gpOverlayExpiry and gpClosedBar and (gpExpiryMark or gpOpportunityAt == time_close and gpOpportunityText == "OPPORTUNITY EXPIRED"), "Observation expired", shape.xcross, location.belowbar, gpAmber, size=size.tiny)
