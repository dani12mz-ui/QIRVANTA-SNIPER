//@version=6
strategy("QIRVANTA GOLD PRO Final Strategy", shorttitle="Q FINAL Risk", overlay=true, behind_chart=false,
     initial_capital=100000, currency=currency.USD, pyramiding=0, default_qty_type=strategy.fixed,
     default_qty_value=3, commission_type=strategy.commission.cash_per_contract, commission_value=0.175,
     slippage=2, backtest_fill_limits_assumption=1, calc_on_every_tick=false, calc_on_order_fills=false,
     process_orders_on_close=false, use_bar_magnifier=false, margin_long=100, margin_short=100, max_bars_back=1000, max_lines_count=12, max_labels_count=60, max_boxes_count=4)
// Generated by unified.tools.build_gold_final_ux.

// Shared source for both GOLD PRO Pine scripts.
const int GP_HTF_WINDOW = 110
const int GP_FINGERPRINT_WINDOW = 200
const int GP_H1_MAX_AGE = 7200000
const int GP_H4_MAX_AGE = 28800000
const int GP_D1_MAX_AGE = 345600000
const int GP_PRIME_ONE = 1000000007
const int GP_PRIME_TWO = 1000000009
const string GP_TOKYO = "Asia/Tokyo"
const string GP_LONDON = "Europe/London"
const string GP_NEW_YORK = "America/New_York"

bool gpAuditContext = input.bool(false, "Log confirmed market context", group="GOLD PRO / EVIDENCE")
int gpAuditFrom = input.time(timestamp("10 Nov 2026 00:00 +0000"), "Context log start", group="GOLD PRO / EVIDENCE")
int gpAuditUntil = input.time(timestamp("11 Nov 2026 23:55 +0000"), "Context log cutoff", group="GOLD PRO / EVIDENCE")
bool gpSupported = syminfo.tickerid == "OANDA:XAUUSD" and chart.is_standard and (timeframe.period == "5" or timeframe.period == "15" or timeframe.period == "30") and syminfo.mintick > 0
bool gpClosedBar = gpSupported and barstate.isconfirmed

// Run in the requested context. Start from the oldest of exactly 110 completed closes.
f_gpConfirmedContext() =>
    float fast = close[GP_HTF_WINDOW]
    float slow = fast
    if not na(fast)
        for ago = GP_HTF_WINDOW - 1 to 1
            fast += (close[ago] - fast) * (2.0 / 22.0)
            slow += (close[ago] - slow) * (2.0 / 56.0)
    [time[1], time_close[1], open[1], high[1], low[1], close[1], fast, slow]

[gpH1OpenAt, gpH1Known, gpH1Open, gpH1High, gpH1Low, gpH1Close, gpH1Fast, gpH1Slow] = request.security(
     syminfo.tickerid, "60", f_gpConfirmedContext(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[gpH4OpenAt, gpH4Known, gpH4Open, gpH4High, gpH4Low, gpH4Close, gpH4Fast, gpH4Slow] = request.security(
     syminfo.tickerid, "240", f_gpConfirmedContext(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[gpD1OpenAt, gpD1Known, gpD1Open, gpD1High, gpD1Low, gpD1Close, gpD1Fast, gpD1Slow] = request.security(
     syminfo.tickerid, "1D", f_gpConfirmedContext(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

f_gpHtfSide(float lastClose, float fast, float slow, int known, int maxAge) =>
    int side = na
    if gpSupported and not na(known) and known <= time and time - known <= maxAge and not na(lastClose) and not na(fast) and not na(slow)
        int closeMicros = math.round(lastClose * 1000000.0)
        int fastMicros = math.round(fast * 1000000.0)
        int slowMicros = math.round(slow * 1000000.0)
        side := closeMicros > fastMicros and fastMicros > slowMicros ? 1 : closeMicros < fastMicros and fastMicros < slowMicros ? -1 : 0
    side

int gpH1Side = f_gpHtfSide(gpH1Close, gpH1Fast, gpH1Slow, gpH1Known, GP_H1_MAX_AGE)
int gpH4Side = f_gpHtfSide(gpH4Close, gpH4Fast, gpH4Slow, gpH4Known, GP_H4_MAX_AGE)
int gpD1Side = f_gpHtfSide(gpD1Close, gpD1Fast, gpD1Slow, gpD1Known, GP_D1_MAX_AGE)
bool gpContextReady = gpClosedBar and not na(gpH1Side) and not na(gpH4Side)

// Rolling fingerprints require the same latest 200 chart OHLC bars and timestamps.
int gpOpenTicks = math.round(open / syminfo.mintick)
int gpHighTicks = math.round(high / syminfo.mintick)
int gpLowTicks = math.round(low / syminfo.mintick)
int gpCloseTicks = math.round(close / syminfo.mintick)
int gpOpenSeconds = int(time / 1000)
int gpCloseSeconds = int(time_close / 1000)
int gpFingerprintTokenOne = (gpOpenSeconds + 3 * gpCloseSeconds + 5 * gpOpenTicks + 7 * gpHighTicks + 11 * gpLowTicks + 13 * gpCloseTicks) % GP_PRIME_ONE
int gpTimeFactor = 1 + gpOpenSeconds % 65521
int gpFingerprintTokenTwo = (gpCloseSeconds + gpTimeFactor * (17 * gpOpenTicks + 19 * gpHighTicks + 23 * gpLowTicks + 29 * gpCloseTicks)) % GP_PRIME_TWO
float gpFingerprintSumOne = math.sum(gpFingerprintTokenOne, GP_FINGERPRINT_WINDOW)
float gpFingerprintSumTwo = math.sum(gpFingerprintTokenTwo, GP_FINGERPRINT_WINDOW)
bool gpFingerprintReady = gpClosedBar and not na(gpFingerprintTokenOne[GP_FINGERPRINT_WINDOW - 1])
int gpFingerprint1 = gpFingerprintReady ? int(gpFingerprintSumOne) % GP_PRIME_ONE : na
int gpFingerprint2 = gpFingerprintReady ? int(gpFingerprintSumTwo) % GP_PRIME_TWO : na

f_gpDateKey(string tz) =>
    10000 * year(time, tz) + 100 * month(time, tz) + dayofmonth(time, tz)

f_gpSessionRange(bool inSession, int dateKey, bool atStart) =>
    var float observedHigh = na
    var float observedLow = na
    var int startedAt = na
    var bool observedComplete = false
    if gpClosedBar and inSession
        if not inSession[1] or dateKey != dateKey[1]
            observedHigh := high
            observedLow := low
            startedAt := time
            observedComplete := atStart
        else
            observedHigh := math.max(observedHigh, high)
            observedLow := math.min(observedLow, low)
            observedComplete := observedComplete and time == time_close[1]
    [observedHigh, observedLow, startedAt, observedComplete]

bool gpInAsia = not na(time(timeframe.period, "0900-1800:23456", GP_TOKYO))
bool gpInLondon = not na(time(timeframe.period, "0800-1700:23456", GP_LONDON))
bool gpInNewYork = not na(time(timeframe.period, "0800-1700:23456", GP_NEW_YORK))
bool gpInOverlap = gpInLondon and gpInNewYork
bool gpAtAsiaOpen = hour(time, GP_TOKYO) == 9 and minute(time, GP_TOKYO) == 0
bool gpAtLondonOpen = hour(time, GP_LONDON) == 8 and minute(time, GP_LONDON) == 0
bool gpAtNewYorkOpen = hour(time, GP_NEW_YORK) == 8 and minute(time, GP_NEW_YORK) == 0
[gpAsiaHigh, gpAsiaLow, gpAsiaSince, gpAsiaComplete] = f_gpSessionRange(gpInAsia, f_gpDateKey(GP_TOKYO), gpAtAsiaOpen)
[gpLondonHigh, gpLondonLow, gpLondonSince, gpLondonComplete] = f_gpSessionRange(gpInLondon, f_gpDateKey(GP_LONDON), gpAtLondonOpen)
[gpNewYorkHigh, gpNewYorkLow, gpNewYorkSince, gpNewYorkComplete] = f_gpSessionRange(gpInNewYork, f_gpDateKey(GP_NEW_YORK), gpAtNewYorkOpen)
[gpOverlapHigh, gpOverlapLow, gpOverlapSince, gpOverlapComplete] = f_gpSessionRange(gpInOverlap, f_gpDateKey(GP_NEW_YORK), gpAtNewYorkOpen)

string gpSession = not gpSupported ? "UNKNOWN" : gpInOverlap ? "LONDON–NEW YORK" : gpInNewYork ? "NEW YORK" : gpInLondon ? "LONDON" : gpInAsia ? "ASIA" : "OFF SESSION"
float gpSessionHigh = gpInOverlap ? gpOverlapHigh : gpInNewYork ? gpNewYorkHigh : gpInLondon ? gpLondonHigh : gpInAsia ? gpAsiaHigh : na
float gpSessionLow = gpInOverlap ? gpOverlapLow : gpInNewYork ? gpNewYorkLow : gpInLondon ? gpLondonLow : gpInAsia ? gpAsiaLow : na
int gpSessionSince = gpInOverlap ? gpOverlapSince : gpInNewYork ? gpNewYorkSince : gpInLondon ? gpLondonSince : gpInAsia ? gpAsiaSince : na
bool gpSessionComplete = gpInOverlap ? gpOverlapComplete : gpInNewYork ? gpNewYorkComplete : gpInLondon ? gpLondonComplete : gpInAsia ? gpAsiaComplete : false

// The symbol's native daily timestamp defines the observed current session.
int gpTradingDay = time("1D")
var float gpDayOpen = na
var float gpDayHigh = na
var float gpDayLow = na
var bool gpDayComplete = false
if gpClosedBar
    if na(gpTradingDay[1]) or gpTradingDay != gpTradingDay[1]
        gpDayOpen := open
        gpDayHigh := high
        gpDayLow := low
        gpDayComplete := time == gpTradingDay
    else
        gpDayHigh := math.max(gpDayHigh, high)
        gpDayLow := math.min(gpDayLow, low)
        gpDayComplete := gpDayComplete and time == time_close[1]

f_gpCtxNum(float value) =>
    na(value) ? "-" : str.tostring(value, "#.#########")
f_gpCtxInt(int value) =>
    na(value) ? "-" : str.tostring(value)
f_gpCtxBool(bool value) =>
    value ? "1" : "0"
f_gpHtfLog(int firstAt, int known, float lastClose, float fast, float slow, int side) =>
    "|" + f_gpCtxInt(firstAt) + "|" + f_gpCtxInt(known) + "|" + f_gpCtxNum(lastClose) + "|" +
      f_gpCtxNum(fast) + "|" + f_gpCtxNum(slow) + "|" + f_gpCtxInt(side)

if gpAuditContext and gpClosedBar and time_close >= gpAuditFrom and time_close <= gpAuditUntil
    log.info("GOLD_CTX|1|" + syminfo.tickerid + "|" + timeframe.period + "|" + f_gpCtxNum(syminfo.mintick) +
      "|" + f_gpCtxInt(time) + "|" + f_gpCtxInt(time_close) + "|" + f_gpCtxNum(open) + "|" + f_gpCtxNum(high) +
      "|" + f_gpCtxNum(low) + "|" + f_gpCtxNum(close) + "|" + f_gpCtxInt(gpFingerprint1) +
      "|" + f_gpCtxInt(gpFingerprint2) + "|" + f_gpCtxBool(gpContextReady) + "|" + gpSession +
      "|" + f_gpCtxNum(gpSessionHigh) + "|" + f_gpCtxNum(gpSessionLow) + "|" + f_gpCtxInt(gpSessionSince) +
      "|" + f_gpCtxBool(gpSessionComplete) + "|" + f_gpCtxInt(gpTradingDay) + "|" + f_gpCtxNum(gpDayOpen) +
      "|" + f_gpCtxNum(gpDayHigh) + "|" + f_gpCtxNum(gpDayLow) + "|" + f_gpCtxBool(gpDayComplete) +
      f_gpHtfLog(gpH1OpenAt, gpH1Known, gpH1Close, gpH1Fast, gpH1Slow, gpH1Side) +
      f_gpHtfLog(gpH4OpenAt, gpH4Known, gpH4Close, gpH4Fast, gpH4Slow, gpH4Side) +
      f_gpHtfLog(gpD1OpenAt, gpD1Known, gpD1Close, gpD1Fast, gpD1Slow, gpD1Side))

// Shared closed-bar market and model logic for the V2.2 indicator and strategy.
const int V22_WARMUP = 250
const int V22_COOLDOWN = 6
const float V22_MAX_EXTENSION = 2.50

bool v22EnableA = input.bool(true, "A · Structural breakout", group="Gold Pro models", display=display.none)
bool v22EnableB = input.bool(true, "B · Smart pullback", group="Gold Pro models", display=display.none)
bool v22EnableC = input.bool(true, "C · Consolidation continuation", group="Gold Pro models", display=display.none)
bool v22RequireADisplacement = input.bool(false, "A · Require displacement", group="Gold Pro models", display=display.none)

type V22Candidate
    string model
    int side
    string setupId
    int watchedAt
    int knownAt
    float level
    float reference
    float stopBase
    float barrier
    float atr
    float extension
    bool spike
    bool htfConflict

type V22Observation
    string model
    int side
    string setupId
    int knownAt
    string state
    string reason
    float level

type V22Setup
    int side = 0
    int watchedAt = na
    int started = na
    int pivotId = na
    int lastConfirmation = na
    float level = na
    float trigger = na
    float stopBase = na
    float atr = na
    string id = ""

bool v22Supported = gpSupported
float v22TR = ta.tr(true)
float v22RawATR = ta.atr(14)
float v22ATR = v22RawATR[1]
float v22MeanATR = ta.sma(v22RawATR, 20)[1]
float v22EMA21 = ta.ema(close, 21)
float v22EMA55 = ta.ema(close, 55)
[v22DIPlus, v22DIMinus, v22ADX] = ta.dmi(14, 14)

// GOLD PRO supplies confirmed finite-window higher-timeframe context.
f_v22Bias(float price, float fast, float slow) =>
    price > fast and fast > slow ? 1 : price < fast and fast < slow ? -1 : 0
int v22H1 = gpH1Side
int v22H4 = gpH4Side

bool v22HighPivot = high[2] > high[4] and high[2] > high[3] and high[2] > high[1] and high[2] > high
bool v22LowPivot = low[2] < low[4] and low[2] < low[3] and low[2] < low[1] and low[2] < low
var float v22LastHigh = na
var float v22LastLow = na
var float v22PreviousHigh = na
var float v22PreviousLow = na
var int v22LastHighKnown = na
var int v22LastLowKnown = na
var int v22BreakBias = 0

// These scalar values snapshot the pivots before any disclosure on this close.
float v22PriorHigh = v22LastHigh
float v22PriorLow = v22LastLow
float v22EarlierHigh = v22PreviousHigh
float v22EarlierLow = v22PreviousLow
int v22PriorHighKnown = v22LastHighKnown
int v22PriorLowKnown = v22LastLowKnown
bool v22HHHL = v22PriorHigh > v22EarlierHigh and v22PriorLow > v22EarlierLow
bool v22LHLL = v22PriorHigh < v22EarlierHigh and v22PriorLow < v22EarlierLow
int v22LocalBias = f_v22Bias(close, v22EMA21, v22EMA55)
bool v22BullEMA = v22LocalBias == 1 and v22EMA21 > v22EMA21[3] and v22EMA55 > v22EMA55[3]
bool v22BearEMA = v22LocalBias == -1 and v22EMA21 < v22EMA21[3] and v22EMA55 < v22EMA55[3]
int v22Trend = v22BullEMA and (v22HHHL or (v22ADX >= 18 and v22DIPlus > v22DIMinus)) ? 1 :
  v22BearEMA and (v22LHLL or (v22ADX >= 18 and v22DIMinus > v22DIPlus)) ? -1 : 0
bool v22Ready = v22Supported and bar_index >= V22_WARMUP and not na(v22ATR) and v22ATR > 0
float v22Extension = v22Ready ? math.abs(close - v22EMA21) / v22ATR : na
float v22Momentum = v22Ready ? (close - close[3]) / v22ATR : na
bool v22Spike = v22Ready and v22TR > 2.50 * v22ATR
float v22Candle = high - low
float v22Body = close - open
bool v22SubstantialBody = v22Candle > 0 and math.abs(v22Body) >= 0.55 * v22Candle
bool v22BullDisplacement = v22SubstantialBody and v22Body >= 0.80 * v22ATR and high - close <= 0.25 * v22Candle
bool v22BearDisplacement = v22SubstantialBody and -v22Body >= 0.80 * v22ATR and close - low <= 0.25 * v22Candle

f_v22Break(int side, float level) =>
    side * (close[1] - level) <= 0 and side * (close - level) > 0
bool v22BullBreak = v22Ready and f_v22Break(1, v22PriorHigh)
bool v22BearBreak = v22Ready and f_v22Break(-1, v22PriorLow)
int v22BOS = v22BullBreak ? 1 : v22BearBreak ? -1 : 0
bool v22MSS = v22BOS != 0 and v22BreakBias == -v22BOS
string v22Structure = v22MSS ? (v22BOS == 1 ? "MSS UP" : "MSS DOWN") :
  v22BOS == 1 ? "BOS UP" : v22BOS == -1 ? "BOS DOWN" : v22HHHL ? "HH / HL" : v22LHLL ? "LH / LL" : "MIXED"

float v22BoxHigh = ta.highest(high, 4)
float v22BoxLow = ta.lowest(low, 4)
float v22TR4 = ta.sma(v22TR, 4)
bool v22NarrowBox = v22Ready and v22BoxHigh - v22BoxLow <= 1.50 * v22ATR and v22TR4 <= 0.80 * v22ATR
bool v22Compression = v22Ready and (v22NarrowBox or v22ATR <= 0.80 * v22MeanATR)
bool v22Expansion = v22Ready and v22TR >= 1.50 * v22ATR
bool v22UpperExhaustion = v22Ready and v22Momentum[1] >= 0.80 and high - v22EMA21 >= 2.50 * v22ATR and
  v22Candle > 0 and high - math.max(open, close) >= 0.50 * v22Candle and v22Momentum < v22Momentum[1]
bool v22LowerExhaustion = v22Ready and v22Momentum[1] <= -0.80 and v22EMA21 - low >= 2.50 * v22ATR and
  v22Candle > 0 and math.min(open, close) - low >= 0.50 * v22Candle and v22Momentum > v22Momentum[1]
bool v22Exhausted = v22Ready and (v22Extension > V22_MAX_EXTENSION or v22UpperExhaustion or v22LowerExhaustion)
string v22RegimeNow = not v22Supported ? "UNSUPPORTED" : not v22Ready ? "WARMUP" :
  v22Exhausted ? "EXHAUSTION / OVEREXTENSION" : v22MSS ? "POTENTIAL REVERSAL" :
  v22Expansion ? "VOLATILITY EXPANSION" : v22Compression ? "COMPRESSION" :
  v22Trend == 1 ? "BULLISH TREND" : v22Trend == -1 ? "BEARISH TREND" : "SIDEWAYS / RANGE"
string v22RegimeReason = not v22Supported ? "SYMBOL_OR_TIMEFRAME" : not v22Ready ? "INSUFFICIENT_BARS" :
  v22Exhausted ? (v22Extension > V22_MAX_EXTENSION ? "EMA_DISTANCE" : "WICK_AND_DECELERATION") :
  v22MSS ? "OPPOSITE_STRUCTURE_BREAK" : v22Expansion ? "TRUE_RANGE_EXPANSION" :
  v22Compression ? (v22NarrowBox ? "NARROW_BOX" : "ATR_CONTRACTION") : v22Trend != 0 ? "EMA_DIRECTION_WITH_STRUCTURE_OR_DMI" :
  "NO_QUALIFIED_TREND"
var string v22Regime = ""
var array<V22Candidate> v22Candidates = array.new<V22Candidate>()
var array<V22Observation> v22Observations = array.new<V22Observation>()
var V22Setup v22SetupA = V22Setup.new()
var V22Setup v22SetupB = V22Setup.new()
var V22Setup v22SetupC = V22Setup.new()
var int v22AUsedHigh = na
var int v22AUsedLow = na

f_v22Direction(int side) =>
    side > 0 ? "BUY" : side < 0 ? "SELL" : "NEUTRAL"

f_v22Emit(string model, V22Setup setup, string state, string reason) =>
    array.push(v22Observations, V22Observation.new(model, setup.side, setup.id, time_close, state, reason, setup.level))

f_v22Watch(string model, V22Setup setup, int side, float level, float trigger, float stopBase, int pivotId, string reason) =>
    setup.side := side
    setup.watchedAt := time_close
    setup.started := bar_index
    setup.pivotId := pivotId
    setup.level := level
    setup.trigger := trigger
    setup.stopBase := stopBase
    setup.atr := v22ATR
    setup.id := model + "-" + f_v22Direction(side) + "-" + str.tostring(time_close)
    f_v22Emit(model, setup, "WATCH", reason)

f_v22Barrier(int side) =>
    float first = side == 1 ? v22PriorHigh : v22PriorLow
    float second = side == 1 ? v22EarlierHigh : v22EarlierLow
    bool firstAhead = side * (first - close) > 0
    bool secondAhead = side * (second - close) > 0
    firstAhead and secondAhead ? (side == 1 ? math.min(first, second) : math.max(first, second)) :
      firstAhead ? first : secondAhead ? second : na

f_v22Confirm(string model, V22Setup setup, string reason) =>
    int side = setup.side
    f_v22Emit(model, setup, "CONFIRMED", reason)
    array.push(v22Candidates, V22Candidate.new(model, side, setup.id, setup.watchedAt, time_close, setup.level,
      close, setup.stopBase, f_v22Barrier(side), v22ATR, v22Extension, v22Spike, v22H1 == -side or v22H4 == -side))
    setup.lastConfirmation := bar_index
    setup.side := 0

f_v22Cancel(string model, V22Setup setup, string state, string reason) =>
    f_v22Emit(model, setup, state, reason)
    setup.side := 0

f_v22Cooled(V22Setup setup) =>
    na(setup.lastConfirmation) or bar_index - setup.lastConfirmation > V22_COOLDOWN

f_v22Displaced(int side) =>
    side == 1 ? v22BullDisplacement : v22BearDisplacement

array.clear(v22Candidates)
array.clear(v22Observations)

if barstate.isconfirmed
    if v22RegimeNow != v22Regime
        string transition = (v22Regime == "" ? "INITIAL" : v22Regime) + ">" + v22RegimeNow + ":" + v22RegimeReason
        array.push(v22Observations, V22Observation.new("REGIME", v22Trend, "REGIME-" + str.tostring(time_close),
          time_close, "REGIME_TRANSITION", transition, close))
        v22Regime := v22RegimeNow
    if v22Ready
        if v22EnableA
            if v22SetupA.side != 0
                int age = bar_index - v22SetupA.started
                int activePivot = v22SetupA.side == 1 ? v22PriorHighKnown : v22PriorLowKnown
                if age > 8
                    f_v22Cancel("A", v22SetupA, "EXPIRED", "EXPIRED")
                else if v22Trend == -v22SetupA.side or activePivot != v22SetupA.pivotId
                    f_v22Cancel("A", v22SetupA, "INVALIDATED", "STRUCTURE_INVALID")
                else if age == 1
                    f_v22Emit("A", v22SetupA, "CONFIRMING", "WAITING_FOR_STRUCTURE_BREAK")
            if v22SetupA.side == 0 and f_v22Cooled(v22SetupA) and v22Trend != 0
                int side = v22Trend
                float level = side == 1 ? v22PriorHigh : v22PriorLow
                float stopBase = side == 1 ? v22PriorLow : v22PriorHigh
                int pivotId = side == 1 ? v22PriorHighKnown : v22PriorLowKnown
                int used = side == 1 ? v22AUsedHigh : v22AUsedLow
                float approach = side * (level - close)
                if not na(level) and not na(stopBase) and (na(used) or pivotId != used) and
                  ((approach >= 0 and approach <= 0.60 * v22ATR) or f_v22Break(side, level))
                    f_v22Watch("A", v22SetupA, side, level, level, stopBase, pivotId, "KNOWN_SWING_APPROACH")
            if v22SetupA.side != 0 and f_v22Break(v22SetupA.side, v22SetupA.level)
                int side = v22SetupA.side
                if side == 1
                    v22AUsedHigh := v22SetupA.pivotId
                else
                    v22AUsedLow := v22SetupA.pivotId
                if v22SetupA.started == bar_index
                    f_v22Emit("A", v22SetupA, "CONFIRMING", "STRUCTURE_BREAK")
                if v22Trend == side and (not v22RequireADisplacement or f_v22Displaced(side))
                    v22SetupA.stopBase := side == 1 ? v22PriorLow : v22PriorHigh
                    f_v22Confirm("A", v22SetupA, "STRUCTURE_BREAK")
                else
                    f_v22Cancel("A", v22SetupA, "INVALIDATED", "NO_CONFIRMATION")

        if v22EnableB
            if v22SetupB.side != 0
                int age = bar_index - v22SetupB.started
                int side = v22SetupB.side
                if age > 6
                    f_v22Cancel("B", v22SetupB, "EXPIRED", "EXPIRED")
                else if v22Trend == -side or side * (close - v22SetupB.level) < -0.75 * v22SetupB.atr
                    f_v22Cancel("B", v22SetupB, "INVALIDATED", "STRUCTURE_INVALID")
                else
                    if age == 1
                        f_v22Emit("B", v22SetupB, "CONFIRMING", "WAITING_FOR_PULLBACK_REJECTION")
                    v22SetupB.stopBase := side == 1 ? math.min(v22SetupB.stopBase, low) : math.max(v22SetupB.stopBase, high)
                    if v22Trend == side and side * v22Body > 0 and side * (close - v22SetupB.trigger) > 0
                        f_v22Confirm("B", v22SetupB, "PULLBACK_REJECTION")
            if v22SetupB.side == 0 and f_v22Cooled(v22SetupB) and v22Trend[1] != 0
                int side = v22Trend[1]
                float level = v22EMA21[1]
                bool touched = side == 1 ? low <= level + 0.20 * v22ATR : high >= level - 0.20 * v22ATR
                if v22Trend != -side and side * (close[1] - level) > 0.20 * v22ATR and touched and
                  side * (close - level) >= -0.75 * v22ATR
                    f_v22Watch("B", v22SetupB, side, level, side == 1 ? high : low, side == 1 ? low : high, na,
                      "PRIOR_EMA21_PULLBACK")

        if v22EnableC
            if v22SetupC.side != 0
                int age = bar_index - v22SetupC.started
                int side = v22SetupC.side
                if age > 4
                    f_v22Cancel("C", v22SetupC, "EXPIRED", "EXPIRED")
                else if v22Trend == -side or side * (close - v22SetupC.stopBase) < 0
                    f_v22Cancel("C", v22SetupC, "INVALIDATED", "STRUCTURE_INVALID")
                else
                    if age == 1
                        f_v22Emit("C", v22SetupC, "CONFIRMING", "WAITING_FOR_BOX_BREAK")
                    if side * (close - v22SetupC.trigger) > 0
                        if v22Trend == side and f_v22Displaced(side)
                            f_v22Confirm("C", v22SetupC, "BOX_BREAK_WITH_DISPLACEMENT")
                        else
                            f_v22Cancel("C", v22SetupC, "INVALIDATED", "NO_CONFIRMATION")
            if v22SetupC.side == 0 and f_v22Cooled(v22SetupC) and v22NarrowBox and v22Trend != 0
                int side = v22Trend
                if (side == 1 and low > low[3]) or (side == -1 and high < high[3])
                    float level = side == 1 ? v22BoxHigh : v22BoxLow
                    f_v22Watch("C", v22SetupC, side, level, level, side == 1 ? v22BoxLow : v22BoxHigh, na,
                      "DIRECTIONAL_COMPRESSION")

    if v22BOS != 0
        v22BreakBias := v22BOS
    // Disclose strict 2/2 pivots on this close. Model decisions see them from
    // the next chart bar. Trailing rules can schedule them on this close.
    if v22HighPivot
        v22PreviousHigh := v22LastHigh
        v22LastHigh := high[2]
        v22LastHighKnown := time_close
    if v22LowPivot
        v22PreviousLow := v22LastLow
        v22LastLow := low[2]
        v22LastLowKnown := time_close

// Three additional research models. Each has its own setup ID and cooldown.
bool gpTrendModel = input.bool(true, "D · Trend continuation", group="Gold Pro models", display=display.none)
bool gpSweepModel = input.bool(true, "E · Liquidity sweep reversal", group="Gold Pro models", display=display.none)
bool gpMomentumModel = input.bool(true, "F · Momentum breakout", group="Gold Pro models", display=display.none)

float gpEMA200 = ta.ema(close, 200)
float gpEfficiencyPath = math.sum(math.abs(ta.change(close)), 20)
float gpEfficiency = gpEfficiencyPath > 0 ? math.abs(close - close[20]) / gpEfficiencyPath : 0
float gpMomentumChange = v22Momentum - v22Momentum[1]
float gpPriorRangeHigh = ta.highest(high, 10)[1]
float gpPriorRangeLow = ta.lowest(low, 10)[1]
float gpContinuationHigh = ta.highest(high, 3)[1]
float gpContinuationLow = ta.lowest(low, 3)[1]
bool gpEqualHighs = not na(v22EarlierHigh) and math.abs(v22PriorHigh - v22EarlierHigh) <= 0.15 * v22ATR
bool gpEqualLows = not na(v22EarlierLow) and math.abs(v22PriorLow - v22EarlierLow) <= 0.15 * v22ATR
bool gpBullSweep = v22Ready and low < v22PriorLow - syminfo.mintick and close > v22PriorLow
bool gpBearSweep = v22Ready and high > v22PriorHigh + syminfo.mintick and close < v22PriorHigh
bool gpBullFVG = low > high[2] and v22BullDisplacement[1]
bool gpBearFVG = high < low[2] and v22BearDisplacement[1]

var V22Setup gpTrendSetup = V22Setup.new()
var V22Setup gpSweepSetup = V22Setup.new()
var V22Setup gpMomentumSetup = V22Setup.new()

// A new setup is disclosed on its trigger bar. Its confirmation can first
// occur on the following close, through the frozen trigger.
f_gpAdditionalModel(string code, V22Setup setup, bool enabled, int side, float level, float trigger, float stopBase, string reason) =>
    if enabled
        if setup.side != 0
            int age = bar_index - setup.started
            if age > 5
                f_v22Cancel(code, setup, "EXPIRED", "EXPIRED")
            else if (close - setup.stopBase) * setup.side <= 0 or (code != "E" and v22Trend == -setup.side)
                f_v22Cancel(code, setup, "INVALIDATED", "STRUCTURE_INVALID")
            else if age > 0
                bool aligned = code == "E" ? v22Trend != -setup.side : v22Trend == setup.side
                if aligned and (close - setup.trigger) * setup.side > 0 and v22Body * setup.side > 0
                    f_v22Confirm(code, setup, "CLOSE_THROUGH_FROZEN_TRIGGER")
                else if age == 1
                    f_v22Emit(code, setup, "SETUP_FORMING", "WAIT_FOR_FROZEN_TRIGGER")
        if setup.side == 0 and side != 0 and f_v22Cooled(setup) and not na(stopBase)
            f_v22Watch(code, setup, side, level, trigger, stopBase, na, reason)

if gpClosedBar and v22Ready
    bool priorTrend = v22Trend != 0 and v22Trend == v22Trend[1] and (close - gpEMA200) * v22Trend > 0
    int continuationSide = priorTrend and v22Extension <= 1.50 and gpEfficiency >= 0.25 and
      v22Momentum * v22Trend >= 0.40 and gpMomentumChange * v22Trend > 0 ? v22Trend : 0
    f_gpAdditionalModel("D", gpTrendSetup, gpTrendModel, continuationSide, v22EMA21,
      continuationSide > 0 ? gpContinuationHigh : gpContinuationLow,
      continuationSide > 0 ? gpContinuationLow : gpContinuationHigh, "TREND_REACCELERATION")

    int sweepSide = gpBullSweep == gpBearSweep ? 0 : gpBullSweep ? 1 : -1
    bool equalPool = sweepSide > 0 ? gpEqualLows : gpEqualHighs
    f_gpAdditionalModel("E", gpSweepSetup, gpSweepModel, sweepSide,
      sweepSide > 0 ? v22PriorLow : v22PriorHigh, sweepSide > 0 ? high : low,
      sweepSide > 0 ? low : high, equalPool ? "EQUAL_LEVEL_SWEEP_RECLAIM" : "SWING_SWEEP_RECLAIM")

    int momentumSide = v22Trend == 1 and v22BullDisplacement and close > gpPriorRangeHigh and gpMomentumChange > 0 ? 1 :
      v22Trend == -1 and v22BearDisplacement and close < gpPriorRangeLow and gpMomentumChange < 0 ? -1 : 0
    f_gpAdditionalModel("F", gpMomentumSetup, gpMomentumModel, momentumSide,
      momentumSide > 0 ? gpPriorRangeHigh : gpPriorRangeLow, momentumSide > 0 ? high : low,
      momentumSide > 0 ? low : high, "DISPLACEMENT_RANGE_BREAK")

string gpRegime = not gpContextReady or not v22Ready ? "UNCERTAIN" : v22Spike ? "VOLATILITY SHOCK" :
  v22MSS ? "REVERSAL WATCH" : v22Exhausted ? "EXHAUSTION" : v22BOS != 0 ? "BREAKOUT" :
  v22Compression ? "COMPRESSION" : v22Trend == 1 ? "TRENDING UP" : v22Trend == -1 ? "TRENDING DOWN" : "RANGING"

f_gpModel(string code) =>
    switch code
        "A" => "Structural breakout"
        "B" => "Smart pullback"
        "C" => "Compression expansion"
        "D" => "Trend continuation"
        "E" => "Liquidity sweep reversal"
        "F" => "Momentum breakout"
        "R" => "Second chance"
        "Q" => "Fast opportunity"
        => "Market regime"

f_gpDirection(int side) =>
    na(side) ? "UNKNOWN" : f_v22Direction(side)

bool gpSecondChance = input.bool(true, "Track second-chance observations", group="Gold Pro opportunities")
bool gpAlertEarly = input.bool(false, "Early directional alerts", group="Gold Pro alerts")
bool gpAlertEntry = input.bool(true, "Valid entry alerts", group="Gold Pro alerts")
bool gpAlertSecond = input.bool(true, "Second-chance alerts", group="Gold Pro alerts")
const int GP_OPPORTUNITY_BARS = 24

type GoldOpportunity
    int side = 0
    int startedBar = na
    int waitBar = na
    int retestBar = na
    int watchedAt = na
    float level = na
    float retestTrigger = na
    float retestStop = na
    string id = ""
    string state = ""
    string reason = ""

var GoldOpportunity gpBuyOpportunity = GoldOpportunity.new()
var GoldOpportunity gpSellOpportunity = GoldOpportunity.new()
var int gpOpportunityAt = na
var string gpOpportunityText = "WAIT"

f_gpStartOpportunity(GoldOpportunity tracker, int side, float level, string cause) =>
    tracker.side := side
    tracker.startedBar := bar_index
    tracker.watchedAt := time_close
    tracker.waitBar := na
    tracker.retestBar := na
    tracker.level := level
    tracker.retestTrigger := na
    tracker.retestStop := na
    tracker.id := "O-" + f_gpDirection(side) + "-" + str.tostring(time_close)
    tracker.state := f_gpDirection(side) + " WATCH"
    tracker.reason := cause

f_gpWaitOpportunity(GoldOpportunity tracker, int side, float level, string cause) =>
    if gpSecondChance and not na(level) and (tracker.state != "WAIT FOR PULLBACK" or na(tracker.waitBar))
        if tracker.state == "" or tracker.state == "OPPORTUNITY EXPIRED" or tracker.state == "SECOND CHANCE"
            f_gpStartOpportunity(tracker, side, level, cause)
        tracker.state := "WAIT FOR PULLBACK"
        tracker.reason := cause
        tracker.level := level
        tracker.waitBar := bar_index
        tracker.retestBar := na

f_gpFollowOpportunity(GoldOpportunity tracker, int side, bool early, bool confirmed, float structure) =>
    bool changed = false
    bool expired = not na(tracker.startedBar) and bar_index - tracker.startedBar > GP_OPPORTUNITY_BARS
    bool active = tracker.state != "" and tracker.state != "OPPORTUNITY EXPIRED" and tracker.state != "SECOND CHANCE"
    if active and (expired or v22BOS == -side)
        tracker.state := "OPPORTUNITY EXPIRED"
        tracker.reason := expired ? "MAXIMUM_AGE" : "OPPOSITE_STRUCTURE_BREAK"
        changed := true
    else if early and not active and not na(structure)
        f_gpStartOpportunity(tracker, side, structure, "DIRECTIONAL_STRUCTURE_AND_MOMENTUM")
        changed := true
    if confirmed and tracker.state == f_gpDirection(side) + " WATCH"
        tracker.state := "TREND CONFIRMED"
        tracker.reason := "CAUSAL_STRUCTURE_BREAK"
        changed := true
    if tracker.state == "WAIT FOR PULLBACK" and bar_index > tracker.waitBar
        bool touched = side == 1 ? low <= tracker.level + 0.20 * v22ATR : high >= tracker.level - 0.20 * v22ATR
        if na(tracker.retestBar) and touched and (close - tracker.level) * side >= -0.50 * v22ATR
            tracker.retestBar := bar_index
            tracker.retestTrigger := side == 1 ? high : low
            tracker.retestStop := side == 1 ? low : high
        if not na(tracker.retestBar) and bar_index > tracker.retestBar
            tracker.retestStop := side == 1 ? math.min(tracker.retestStop, low) : math.max(tracker.retestStop, high)
        bool retest = not na(tracker.retestBar) and bar_index > tracker.retestBar and (close - tracker.retestTrigger) * side > 0
        float freshRange = v22BoxHigh[1] - v22BoxLow[1]
        bool compression = v22NarrowBox[1] and freshRange <= 1.50 * v22ATR and
          (close - (side == 1 ? v22BoxHigh[1] : v22BoxLow[1])) * side > 0
        bool continuation = v22Trend == side and v22Trend[1] == side and v22Extension <= 1.25 and
          gpMomentumChange * side > 0 and (close - (side == 1 ? gpContinuationHigh : gpContinuationLow)) * side > 0
        bool qualified = (retest or compression or continuation) and v22Body * side > 0 and v22Trend != -side
        if qualified
            float stopBase = retest ? tracker.retestStop : compression ? (side == 1 ? v22BoxLow[1] : v22BoxHigh[1]) :
              side == 1 ? gpContinuationLow : gpContinuationHigh
            string method = retest ? "FRESH_RETEST" : compression ? "FRESH_COMPRESSION" : "FRESH_CONTINUATION"
            string newId = "R-" + method + "-" + f_gpDirection(side) + "-" + str.tostring(time_close)
            array.push(v22Candidates, V22Candidate.new("R", side, newId, time_close, time_close, tracker.level, close,
              stopBase, f_v22Barrier(side), v22ATR, v22Extension, v22Spike, gpH1Side == -side or gpH4Side == -side))
            array.push(v22Observations, V22Observation.new("R", side, newId, time_close, "CONFIRMED", method, close))
            tracker.state := "SECOND CHANCE"
            tracker.reason := method
            changed := true
    changed

bool gpOpportunityBuyChanged = false
bool gpOpportunitySellChanged = false
if gpClosedBar and v22Ready
    bool buyEarly = v22Trend == 1 and v22Momentum >= 0.60 and v22Extension <= 2.50
    bool sellEarly = v22Trend == -1 and v22Momentum <= -0.60 and v22Extension <= 2.50
    gpOpportunityBuyChanged := f_gpFollowOpportunity(gpBuyOpportunity, 1, buyEarly, v22BOS == 1, v22PriorHigh)
    gpOpportunitySellChanged := f_gpFollowOpportunity(gpSellOpportunity, -1, sellEarly, v22BOS == -1, v22PriorLow)
    for tracker in array.from(gpBuyOpportunity, gpSellOpportunity)
        if tracker.startedBar == bar_index and tracker.state != "OPPORTUNITY EXPIRED"
            int side = tracker.side
            float stopBase = side == 1 ? gpContinuationLow : gpContinuationHigh
            string fastId = "Q-" + f_gpDirection(side) + "-" + str.tostring(time_close)
            array.push(v22Candidates, V22Candidate.new("Q", side, fastId, time_close, time_close, tracker.level, close,
              stopBase, f_v22Barrier(side), v22ATR, v22Extension, v22Spike, gpH1Side == -side or gpH4Side == -side))
    if gpOpportunityBuyChanged or gpOpportunitySellChanged
        gpOpportunityAt := time_close
        gpOpportunityText := gpOpportunityBuyChanged and gpOpportunitySellChanged ? "CONFLICT" :
          gpOpportunityBuyChanged ? gpBuyOpportunity.state : gpSellOpportunity.state

string gpEntryMethod = input.string("Next-open market", "Entry policy",
  options=["Next-open market", "Pullback limit", "Breakout stop"], group="Gold Pro research risk")
string gpSizeMethod = input.string("Reference size", "Simulation size", options=["Reference size", "Fixed risk"],
  group="Gold Pro research risk", tooltip="Reference size uses three TradingView units for comparison. The risk and exposure caps still apply.")
float gpEquityInput = input.float(100000.0, "Research equity (USD)", minval=1, group="Gold Pro research risk")
float gpRiskPct = input.float(0.25, "Initial risk cap (%)", minval=0.01, maxval=1, step=0.05, group="Gold Pro research risk")
float gpExposurePct = input.float(100, "Maximum position notional (%)", minval=1, maxval=100, group="Gold Pro research risk")
float gpSpreadInput = input.float(0.35, "Estimated round-trip spread (price)", minval=0, step=0.05, group="Gold Pro research risk")
float gpMinNetRR = input.float(0.70, "Minimum estimated net reward/risk", minval=0.1, maxval=0.95, step=0.05, group="Gold Pro research risk")
float gpCostCap = input.float(0.30, "Maximum cost/stop distance", minval=0.01, maxval=0.50, step=0.05, group="Gold Pro research risk")
bool gpRequireNews = input.bool(false, "Require verified news source to clear risk", group="Gold Pro research risk")
string gpStudyModel = input.string("A", "Independent simulation model", options=["A", "B", "C", "D", "E", "F", "R"],
  group="Gold Pro research risk")
string gpTiming = input.string("CONFIRMED", "Research entry timing", options=["FAST", "CONFIRMED"],
  group="Gold Pro research risk", tooltip="FAST tests the first directional opportunity. CONFIRMED uses the selected independent model.")
bool gpAlertEnabled = input.bool(false, "Enable informational alerts", group="Gold Pro alerts")
bool gpAlertWatches = input.bool(false, "Include watch alerts", group="Gold Pro alerts")
bool gpAuditSignals = input.bool(false, "Log analytical lifecycle", group="Gold Pro evidence")
int gpSignalLogFrom = input.time(timestamp("10 Nov 2026 00:00 +0000"), "Lifecycle log from (UTC)", group="Gold Pro evidence")
int gpSignalLogUntil = input.time(timestamp("12 Nov 2026 00:00 +0000"), "Lifecycle log through (UTC)", group="Gold Pro evidence")

const float GP_NATIVE_FEE = 0.175
const int GP_NATIVE_SLIPPAGE = 2
const int GP_PENDING_BARS = 3
const string GP_NEWS_STATE = "NEWS DATA UNAVAILABLE"
float gpTick = syminfo.mintick
float gpPoint = syminfo.pointvalue
float gpUnitStep = syminfo.mincontract
bool gpContract = gpSupported and syminfo.currency == "USD" and gpPoint > 0 and gpTick > 0 and gpUnitStep > 0
float gpCostPrice = gpContract ? gpSpreadInput + 2.0 * GP_NATIVE_FEE / gpPoint + 2.0 * GP_NATIVE_SLIPPAGE * gpTick : na
bool gpEmitLogs = gpAuditSignals and gpClosedBar and time_close >= gpSignalLogFrom and time_close <= gpSignalLogUntil

type GoldPlan
    string id = ""
    string model = ""
    string reason = ""
    int side = 0
    int knownAt = na
    int watchedAt = na
    int expiryBar = na
    float entry = na
    float invalidation = na
    float structure = na
    float stop = na
    float tp1 = na
    float tp2 = na
    float tp3 = na
    float grossRR = na
    float netRR = na
    float qty = na
    float leg = na
    float riskCash = na
    float costCash = na
    float atr = na
    float extension = na

f_gpStopPrice(float price, int side) =>
    side > 0 ? math.floor(price / gpTick + 1e-8) * gpTick : math.ceil(price / gpTick - 1e-8) * gpTick

f_gpTargetPrice(float price, int side) =>
    f_gpStopPrice(price, -side)

f_gpPlan(V22Candidate candidate) =>
    GoldPlan plan = GoldPlan.new()
    plan.id := candidate.setupId + "|" + str.tostring(candidate.knownAt)
    plan.model := candidate.model
    plan.side := candidate.side
    plan.knownAt := candidate.knownAt
    plan.watchedAt := candidate.watchedAt
    plan.expiryBar := bar_index + (gpEntryMethod == "Next-open market" ? 1 : GP_PENDING_BARS)
    plan.atr := candidate.atr
    plan.extension := candidate.extension
    plan.invalidation := candidate.stopBase
    plan.structure := candidate.level
    float offset = gpEntryMethod == "Pullback limit" ? -0.25 * candidate.atr : gpEntryMethod == "Breakout stop" ? gpTick : 0.0
    plan.entry := math.round_to_mintick(candidate.reference + candidate.side * offset)
    plan.stop := f_gpStopPrice(candidate.stopBase - candidate.side * 0.10 * candidate.atr, candidate.side)
    float distance = (plan.entry - plan.stop) * candidate.side
    if not na(distance) and distance >= gpTick * (1 - 1e-7) and gpContract
        plan.tp1 := f_gpTargetPrice(plan.entry + candidate.side * distance, candidate.side)
        plan.tp2 := f_gpTargetPrice(plan.entry + candidate.side * 2.0 * distance, candidate.side)
        plan.tp3 := f_gpTargetPrice(plan.entry + candidate.side * 3.0 * distance, candidate.side)
        float firstTargetRoom = (plan.tp1 - plan.entry) * candidate.side
        float room = na(candidate.barrier) ? firstTargetRoom : math.max(0, math.min(firstTargetRoom, (candidate.barrier - plan.entry) * candidate.side))
        plan.grossRR := room / distance
        plan.netRR := (room - gpCostPrice) / (distance + gpCostPrice)
        float unitRisk = (distance + gpCostPrice) * gpPoint
        float riskBudget = gpEquityInput * gpRiskPct * 0.01
        float exposureBudget = gpEquityInput * gpExposurePct * 0.01
        float qtyLimit = math.min(riskBudget / unitRisk, exposureBudget / (plan.entry * gpPoint))
        float quantity = gpSizeMethod == "Reference size" ? 3 : qtyLimit
        plan.leg := math.floor(quantity / (3 * gpUnitStep) + 1e-8) * gpUnitStep
        plan.qty := 3 * plan.leg
        plan.riskCash := plan.qty * unitRisk
        plan.costCash := plan.qty * gpCostPrice * gpPoint
        if plan.leg < gpUnitStep * (1 - 1e-7) or plan.riskCash > riskBudget + 1e-7 or plan.qty * plan.entry * gpPoint > exposureBudget + 1e-7
            plan.reason := "RISK_OR_EXPOSURE_CAP"
    if not gpContract
        plan.reason := "CONTRACT_UNSUPPORTED"
    else if not gpContextReady
        plan.reason := "HTF_UNKNOWN"
    else if gpRequireNews
        plan.reason := "NEWS_DATA_UNAVAILABLE"
    else if na(distance) or distance < gpTick * (1 - 1e-7)
        plan.reason := "STRUCTURE_INVALID"
    else if candidate.spike
        plan.reason := "VOLATILITY_SPIKE"
    else if gpH1Side == -plan.side or gpH4Side == -plan.side
        plan.reason := "HTF_CONFLICT"
    else if candidate.extension > 1.75
        plan.reason := "EXCESSIVE_EXTENSION"
    else if distance > 3.0 * candidate.atr
        plan.reason := "OVERSIZED_STOP"
    else if gpCostPrice > gpCostCap * distance
        plan.reason := "COST_TOO_HIGH"
    else if plan.netRR < gpMinNetRR
        plan.reason := "INSUFFICIENT_NET_ROOM"
    plan

f_gpNumber(float value) =>
    na(value) ? "null" : str.tostring(value, "#.########")

f_gpEvent(string model, string id, int side, string state, string reason, float reference, float stop, float tp1, float tp2, float tp3, bool alertable) =>
    string message = '{"schema":"qirvanta.goldpro.event.v1","symbol":"' + syminfo.tickerid +
      '","timeframe":"' + timeframe.period + '","known_at":' + str.tostring(time_close) +
      ',"model":"' + model + '","id":"' + id + '","direction":"' + f_gpDirection(side) +
      '","state":"' + state + '","reason":"' + reason + '","reference":' + f_gpNumber(reference) +
      ',"stop":' + f_gpNumber(stop) + ',"tp1":' + f_gpNumber(tp1) + ',"tp2":' + f_gpNumber(tp2) +
      ',"tp3":' + f_gpNumber(tp3) + ',"informational":true}'
    if gpEmitLogs
        log.info(message)
    if alertable and gpAlertEnabled and barstate.isrealtime
        alert(message, alert.freq_all)

var string gpLastWatch = "—"
var string gpLastConfirmation = "—"
var string gpLastState = "WAIT"
var string gpLastReason = ""
var string gpLastQuality = "NO TRADE"
var bool gpLastConflict = false
var GoldPlan gpLastPlan = na
var int gpPlanValidThrough = na
bool gpBuyWatch = false
bool gpSellWatch = false
bool gpBuyConfirmed = false
bool gpSellConfirmed = false
bool gpExpiryMark = false
GoldPlan gpSelected = na

if gpClosedBar
    if not na(gpPlanValidThrough) and bar_index >= gpPlanValidThrough
        if gpOpportunityText == "ENTRY AVAILABLE" or gpOpportunityText == "SECOND CHANCE"
            gpOpportunityText := "OPPORTUNITY EXPIRED"
            gpOpportunityAt := time_close
        if gpLastState == "ENTRY_VALID"
            gpLastState := "EXPIRED"
            gpLastReason := "PLAN_VALIDITY_ENDED"
        gpPlanValidThrough := na
    if gpOpportunityBuyChanged and (gpEmitLogs or gpAlertEnabled and gpAlertEarly)
        f_gpEvent("O", gpBuyOpportunity.id, 1, gpBuyOpportunity.state, gpBuyOpportunity.reason, gpBuyOpportunity.level, na, na, na, na, gpAlertEarly and gpBuyOpportunity.state != "SECOND CHANCE")
    if gpOpportunitySellChanged and (gpEmitLogs or gpAlertEnabled and gpAlertEarly)
        f_gpEvent("O", gpSellOpportunity.id, -1, gpSellOpportunity.state, gpSellOpportunity.reason, gpSellOpportunity.level, na, na, na, na, gpAlertEarly and gpSellOpportunity.state != "SECOND CHANCE")
    for obs in v22Observations
        bool watch = obs.state == "WATCH"
        bool confirmed = obs.state == "CONFIRMED"
        bool invalidated = obs.state == "INVALIDATED"
        if watch
            gpLastWatch := obs.model + " " + f_gpDirection(obs.side)
            gpBuyWatch := gpBuyWatch or obs.side > 0
            gpSellWatch := gpSellWatch or obs.side < 0
        if confirmed
            gpLastConfirmation := obs.model + " " + f_gpDirection(obs.side)
            gpBuyConfirmed := gpBuyConfirmed or obs.side > 0
            gpSellConfirmed := gpSellConfirmed or obs.side < 0
        if obs.state != "REGIME_TRANSITION"
            gpLastState := obs.state == "CONFIRMING" ? "SETUP_FORMING" : obs.state
            gpLastReason := obs.reason
            gpExpiryMark := gpExpiryMark or obs.state == "EXPIRED"
            if not confirmed
                gpLastQuality := watch or obs.state == "CONFIRMING" or obs.state == "SETUP_FORMING" ? "LOW CONFLUENCE" : "NO TRADE"
            if gpEmitLogs or gpAlertEnabled and (confirmed or invalidated or watch and gpAlertWatches)
                f_gpEvent(obs.model, obs.setupId, obs.side, gpLastState, obs.reason, obs.level, na, na, na, na,
                  confirmed or invalidated or watch and gpAlertWatches)

    bool candidateBuy = false
    bool candidateSell = false
    for candidate in v22Candidates
        if (gpTiming == "FAST") == (candidate.model == "Q")
            candidateBuy := candidateBuy or candidate.side > 0
            candidateSell := candidateSell or candidate.side < 0
    bool opposed = gpBuyConfirmed and gpSellConfirmed or candidateBuy and candidateSell
    if array.size(v22Candidates) > 0
        gpLastConflict := opposed
    GoldPlan featured = na
    bool featuredInLane = false
    for candidate in v22Candidates
        GoldPlan plan = f_gpPlan(candidate)
        if opposed
            plan.reason := "OPPOSING_CONFIRMED_SIGNALS"
        bool timingSelected = (gpTiming == "FAST") == (candidate.model == "Q")
        if gpEmitLogs
            log.info("GOLD_PLAN|" + plan.id + "|" + gpTiming + "|" + str.tostring(timingSelected) + "|" +
              str.tostring(plan.knownAt - plan.watchedAt) + "|" + f_gpNumber(plan.extension) + "|" +
              f_gpNumber(plan.grossRR) + "|" + f_gpNumber(plan.netRR) + "|" + plan.reason)
        if not timingSelected
            continue
        bool valid = plan.reason == ""
        string planState = valid ? "ENTRY_VALID" : "ENTRY_REJECTED"
        bool inLane = candidate.model == gpStudyModel or gpTiming == "FAST"
        if na(featured) or inLane and not featuredInLane or inLane == featuredInLane and valid and featured.reason != ""
            featured := plan
            featuredInLane := inLane
        if valid and inLane and na(gpSelected)
            gpSelected := plan
        bool waitForNew = candidate.model != "R" and (plan.reason == "EXCESSIVE_EXTENSION" or plan.reason == "OVERSIZED_STOP" or plan.reason == "HTF_CONFLICT")
        if waitForNew
            GoldOpportunity tracker = plan.side > 0 ? gpBuyOpportunity : gpSellOpportunity
            f_gpWaitOpportunity(tracker, plan.side, plan.structure, plan.reason)
        bool entryAlert = valid and (candidate.model == "R" ? gpAlertSecond : gpAlertEntry)
        if gpEmitLogs or gpAlertEnabled and (entryAlert or opposed or plan.reason == "HTF_CONFLICT")
            f_gpEvent(plan.model, plan.id, plan.side, planState, plan.reason, plan.entry, plan.stop, plan.tp1, plan.tp2, plan.tp3,
              entryAlert or opposed or plan.reason == "HTF_CONFLICT")
    if not na(featured)
        bool valid = featured.reason == ""
        bool aligned = gpH1Side == featured.side and gpH4Side == featured.side
        gpLastPlan := featured
        gpLastState := valid ? "ENTRY_VALID" : "ENTRY_REJECTED"
        gpLastReason := featured.reason
        gpLastQuality := opposed or featured.reason == "HTF_CONFLICT" ? "CONFLICT" : not valid ? "NO TRADE" :
          aligned and v22Trend == featured.side and v22ADX >= 22 ? "HIGH CONFLUENCE" : "MODERATE CONFLUENCE"
        gpOpportunityAt := time_close
        gpPlanValidThrough := valid ? featured.expiryBar : na
        GoldOpportunity tracker = featured.side > 0 ? gpBuyOpportunity : gpSellOpportunity
        bool recoverable = featured.reason == "EXCESSIVE_EXTENSION" or featured.reason == "OVERSIZED_STOP" or featured.reason == "HTF_CONFLICT"
        gpOpportunityText := valid ? (featured.model == "R" ? "SECOND CHANCE" : "ENTRY AVAILABLE") :
          recoverable and tracker.state == "WAIT FOR PULLBACK" ? "WAIT FOR PULLBACK" : "RISK REJECTED"

bool gpSimEnabled = input.bool(false, "Enable experimental TradingView simulation", group="Gold Pro simulation")
int gpSimulationFrom = input.time(timestamp("01 Jan 2026 00:00 +0000"), "Simulate from (UTC)", group="Gold Pro simulation")
int gpSimulationUntil = input.time(timestamp("01 Jan 2035 00:00 +0000"), "Simulate until (UTC, exclusive)", group="Gold Pro simulation")
string gpManagement = input.string("Fixed", "Exit policy", options=["Fixed", "Cost-adjusted BE", "Profit lock",
  "ATR trail", "Structure trail", "Momentum exit", "Stalled exit", "Time exit"], group="Gold Pro simulation")
float gpDayLossPct = input.float(0.75, "Daily loss cap (%)", minval=0.10, maxval=3, step=0.05, group="Gold Pro simulation")
float gpDrawdownPct = input.float(4, "Drawdown halt (%)", minval=0.25, maxval=15, step=0.25, group="Gold Pro simulation")
int gpCooldownLosses = input.int(3, "Losses before cooldown", minval=1, maxval=10, group="Gold Pro simulation")
int gpCooldownBars = input.int(24, "Cooldown length (bars)", minval=1, maxval=300, group="Gold Pro simulation")
float gpRsi = ta.rsi(close, 14)

type GoldCampaign
    GoldPlan plan = na
    int submittedBar = na
    int fillBar = na
    int fillTime = na
    float filled = na
    float workingStop = na
    float effectiveStop = na
    int stopScheduled = na
    float realized = 0
    float closedQty = 0
    bool legOneClosed = false
    bool legTwoClosed = false
    bool legThreeClosed = false
    bool firstTarget = false
    bool exitRequested = false
    string status = "SUBMITTED"
    string exitReason = ""
    int previousExitBar = na
    string previousExitReason = ""

var GoldCampaign gpActiveCampaign = na
var GoldCampaign gpLastCampaign = na
var int gpClosedSeen = 0
var float gpDayStartEquity = na
var float gpPreviousEquity = na
var float gpPeakEquity = na
var int gpLosses = 0
var int gpCooldownUntil = na
var bool gpDrawdownHalt = false
bool gpClosedMark = false

f_gpSimEvent(GoldCampaign campaign, string state, string reason, float price, bool notify) =>
    GoldPlan plan = campaign.plan
    if gpEmitLogs or gpAlertEnabled and notify
        f_gpEvent(plan.model, plan.id, plan.side, state, reason, price, campaign.effectiveStop, plan.tp1, plan.tp2, plan.tp3, notify)

f_gpSimBrackets(GoldCampaign campaign) =>
    GoldPlan plan = campaign.plan
    if not campaign.legOneClosed
        strategy.exit(plan.id + "|1", from_entry=plan.id, qty=plan.leg, stop=campaign.workingStop, limit=plan.tp1,
          oca_name=plan.id + "|T1", comment_profit="TP1", comment_loss="SL", disable_alert=true)
    if not campaign.legTwoClosed
        strategy.exit(plan.id + "|2", from_entry=plan.id, qty=plan.leg, stop=campaign.workingStop, limit=plan.tp2,
          oca_name=plan.id + "|T2", comment_profit="TP2", comment_loss="SL", disable_alert=true)
    if not campaign.legThreeClosed
        strategy.exit(plan.id + "|3", from_entry=plan.id, qty=plan.leg, stop=campaign.workingStop, limit=plan.tp3,
          oca_name=plan.id + "|T3", comment_profit="TP3", comment_loss="SL", disable_alert=true)

f_gpSimCancel(GoldPlan plan) =>
    strategy.cancel(plan.id)
    strategy.cancel(plan.id + "|1")
    strategy.cancel(plan.id + "|2")
    strategy.cancel(plan.id + "|3")

f_gpSimFill(GoldCampaign campaign, float price, int fillBar, int fillTime) =>
    campaign.filled := price
    campaign.fillBar := fillBar
    campaign.fillTime := fillTime
    campaign.status := "SIMULATED_FILLED"
    f_gpSimEvent(campaign, campaign.status, "NATIVE_EMULATOR", price, false)

f_gpSimStop(GoldCampaign campaign) =>
    GoldPlan plan = campaign.plan
    float risk = (campaign.filled - plan.stop) * plan.side
    float candidate = na
    if risk > 0
        if gpManagement == "Cost-adjusted BE" and campaign.firstTarget
            candidate := f_gpTargetPrice(campaign.filled + plan.side * gpCostPrice, plan.side)
        else if gpManagement == "Profit lock" and campaign.firstTarget
            candidate := f_gpStopPrice(campaign.filled + plan.side * 0.05 * risk, plan.side)
        else if gpManagement == "ATR trail"
            candidate := f_gpStopPrice(close - plan.side * 2 * v22ATR, plan.side)
        else if gpManagement == "Structure trail"
            int known = plan.side == 1 ? v22LastLowKnown : v22LastHighKnown
            float swing = plan.side == 1 ? v22LastLow : v22LastHigh
            if not na(known) and known > campaign.fillTime
                candidate := f_gpStopPrice(swing - plan.side * 0.10 * v22ATR, plan.side)
    candidate

f_gpSimExitReason(GoldCampaign campaign, bool emergency) =>
    GoldPlan plan = campaign.plan
    int held = bar_index - campaign.fillBar
    float stopDistance = (campaign.filled - plan.stop) * plan.side
    float cashRisk = (stopDistance + gpCostPrice) * plan.qty * gpPoint
    bool gapRisk = stopDistance <= 0 or stopDistance > 3.0 * plan.atr or
      (campaign.filled - plan.entry) * plan.side > 0.60 * plan.atr or (plan.tp1 - campaign.filled) * plan.side <= 0 or
      cashRisk > math.min(gpEquityInput, strategy.equity) * gpRiskPct * 0.01 + 1e-7 or
      campaign.filled * plan.qty * gpPoint > math.min(gpEquityInput, strategy.equity) * gpExposurePct * 0.01 + 1e-7
    bool momentum = gpManagement == "Momentum exit" and held > 0 and time == time_close[1] and
      (close - campaign.filled) * plan.side < 0 and (close[1] - campaign.filled) * plan.side < 0 and (gpRsi - 50) * plan.side < 0
    bool stalled = gpManagement == "Stalled exit" and held >= 24 and not campaign.firstTarget
    bool timeExit = held >= (gpManagement == "Time exit" ? 32 : 60)
    emergency ? "EMERGENCY_DRAWDOWN" : gapRisk ? "FILL_RISK_EXCEEDED" : momentum ? "MOMENTUM_EXIT" :
      stalled ? "STALLED_EXIT" : timeExit ? "TIME_EXIT" : ""

string gpSimulationGate = "SIMULATION OFF"
if gpClosedBar and gpSimEnabled
    if na(gpDayStartEquity) or gpTradingDay != gpTradingDay[1]
        gpDayStartEquity := nz(gpPreviousEquity, strategy.initial_capital)
    gpPeakEquity := math.max(nz(gpPeakEquity, strategy.initial_capital), strategy.equity)
    gpDrawdownHalt := gpDrawdownHalt or strategy.equity <= gpPeakEquity * (1 - gpDrawdownPct * 0.01)
    float dailyRoom = math.max(0, strategy.equity - gpDayStartEquity * (1 - gpDayLossPct * 0.01))
    float drawdownRoom = math.max(0, strategy.equity - gpPeakEquity * (1 - gpDrawdownPct * 0.01))

    if not na(gpActiveCampaign) and not na(gpActiveCampaign.stopScheduled) and bar_index > gpActiveCampaign.stopScheduled
        gpActiveCampaign.effectiveStop := gpActiveCampaign.workingStop
        gpActiveCampaign.stopScheduled := na
    if not na(gpActiveCampaign) and na(gpActiveCampaign.filled) and strategy.opentrades > 0
        f_gpSimFill(gpActiveCampaign, strategy.opentrades.entry_price(0), strategy.opentrades.entry_bar_index(0), strategy.opentrades.entry_time(0))

    if strategy.closedtrades > gpClosedSeen
        int first = nz(strategy.closedtrades.first_index, 0)
        for tradeIndex = math.max(gpClosedSeen, first) to strategy.closedtrades - 1
            if not na(gpActiveCampaign) and strategy.closedtrades.entry_id(tradeIndex) == gpActiveCampaign.plan.id
                string exitId = strategy.closedtrades.exit_id(tradeIndex)
                string exitComment = strategy.closedtrades.exit_comment(tradeIndex)
                string note = na(exitComment) ? "SIMULATED_EXIT" : exitComment
                float fill = strategy.closedtrades.entry_price(tradeIndex)
                float price = strategy.closedtrades.exit_price(tradeIndex)
                float signedQuantity = strategy.closedtrades.size(tradeIndex)
                int exitBar = strategy.closedtrades.exit_bar_index(tradeIndex)
                if na(gpActiveCampaign.filled)
                    f_gpSimFill(gpActiveCampaign, fill, strategy.closedtrades.entry_bar_index(tradeIndex), strategy.closedtrades.entry_time(tradeIndex))
                gpActiveCampaign.realized += (price - fill) * signedQuantity * gpPoint - strategy.closedtrades.commission(tradeIndex)
                gpActiveCampaign.closedQty += math.abs(signedQuantity)
                gpActiveCampaign.legOneClosed := gpActiveCampaign.legOneClosed or exitId == gpActiveCampaign.plan.id + "|1"
                gpActiveCampaign.legTwoClosed := gpActiveCampaign.legTwoClosed or exitId == gpActiveCampaign.plan.id + "|2"
                gpActiveCampaign.legThreeClosed := gpActiveCampaign.legThreeClosed or exitId == gpActiveCampaign.plan.id + "|3"
                gpActiveCampaign.firstTarget := gpActiveCampaign.firstTarget or note == "TP1"
                bool mixed = gpActiveCampaign.previousExitBar == exitBar and
                  (note == "SL" and str.startswith(gpActiveCampaign.previousExitReason, "TP") or gpActiveCampaign.previousExitReason == "SL" and str.startswith(note, "TP"))
                if mixed
                    f_gpSimEvent(gpActiveCampaign, "INTRABAR_AMBIGUITY", "EMULATOR_PATH", price, false)
                gpActiveCampaign.previousExitBar := exitBar
                gpActiveCampaign.previousExitReason := note
                gpActiveCampaign.exitReason := note
                f_gpSimEvent(gpActiveCampaign, note == "SL" ? "STOP_FILLED" : note + "_FILLED", note, price, false)
        gpClosedSeen := strategy.closedtrades

    if not na(gpActiveCampaign) and strategy.position_size == 0 and bar_index > gpActiveCampaign.submittedBar
        GoldPlan plan = gpActiveCampaign.plan
        if not na(gpActiveCampaign.filled)
            bool complete = math.abs(gpActiveCampaign.closedQty - plan.qty) <= 1e-7
            gpActiveCampaign.status := "SIMULATED_CLOSED"
            gpActiveCampaign.exitReason := complete ? gpActiveCampaign.exitReason : "INCOMPLETE_LEDGER"
            gpClosedMark := true
            if complete
                gpLosses := gpActiveCampaign.realized < 0 ? gpLosses + 1 : 0
                if gpLosses >= gpCooldownLosses
                    gpCooldownUntil := bar_index + gpCooldownBars
                    gpLosses := 0
            if gpActiveCampaign.exitReason == "SL" and plan.model != "R"
                GoldOpportunity tracker = plan.side == 1 ? gpBuyOpportunity : gpSellOpportunity
                f_gpWaitOpportunity(tracker, plan.side, plan.structure, "STOP_FILLED")
                if tracker.state == "WAIT FOR PULLBACK"
                    gpOpportunityText := tracker.state
                    gpOpportunityAt := time_close
            f_gpSimEvent(gpActiveCampaign, "POSITION_CLOSED", gpActiveCampaign.exitReason, gpActiveCampaign.filled, true)
        else if bar_index >= plan.expiryBar or (close - plan.invalidation) * plan.side < 0 or gpDrawdownHalt or dailyRoom <= 0 or time_close >= gpSimulationUntil
            gpActiveCampaign.status := bar_index >= plan.expiryBar ? "EXPIRED" : "INVALIDATED"
            gpActiveCampaign.exitReason := bar_index >= plan.expiryBar ? "ORDER_EXPIRED_UNFILLED" : "PENDING_RISK_OR_STRUCTURE"
            f_gpSimEvent(gpActiveCampaign, gpActiveCampaign.status, gpActiveCampaign.exitReason, na, gpActiveCampaign.status == "INVALIDATED")
        if gpActiveCampaign.status == "SIMULATED_CLOSED" or gpActiveCampaign.status == "EXPIRED" or gpActiveCampaign.status == "INVALIDATED"
            f_gpSimCancel(plan)
            if gpActiveCampaign.status == "SIMULATED_CLOSED"
                gpLastCampaign := gpActiveCampaign
            gpActiveCampaign := na

    if not na(gpActiveCampaign) and strategy.position_size != 0 and not gpActiveCampaign.exitRequested
        string exitReason = f_gpSimExitReason(gpActiveCampaign, gpDrawdownHalt)
        if exitReason != ""
            strategy.close(gpActiveCampaign.plan.id, comment=exitReason, disable_alert=true)
            gpActiveCampaign.exitRequested := true
            f_gpSimEvent(gpActiveCampaign, "EXIT_SCHEDULED", exitReason, na, false)
        else
            float stop = f_gpSimStop(gpActiveCampaign)
            int side = gpActiveCampaign.plan.side
            if not na(stop) and (stop - gpActiveCampaign.workingStop) * side >= gpTick * 0.5 and (close - stop) * side >= gpTick * 0.5
                gpActiveCampaign.workingStop := stop
                gpActiveCampaign.stopScheduled := bar_index
                f_gpSimBrackets(gpActiveCampaign)
                f_gpSimEvent(gpActiveCampaign, "STOP_SCHEDULED", "NEXT_AVAILABLE_TICK", stop, false)

    bool cooling = not na(gpCooldownUntil) and bar_index < gpCooldownUntil
    bool permittedTime = time_close >= gpSimulationFrom and time_close < gpSimulationUntil
    gpSimulationGate := not gpContextReady ? "HTF UNKNOWN" : gpRequireNews ? "NEWS SOURCE REQUIRED" :
      gpDrawdownHalt ? "DRAWDOWN HALT" : dailyRoom <= 0 ? "DAILY LOSS CAP" : cooling ? "LOSS COOLDOWN" :
      not permittedTime ? "OUTSIDE WINDOW" : not na(gpActiveCampaign) ? "POSITION OCCUPIED" : "RISK MONITORING"
    if not na(gpSelected)
        float notional = gpSelected.qty * gpSelected.entry * gpPoint
        float equityCap = math.min(gpEquityInput, strategy.equity)
        string reject = gpSimulationGate != "RISK MONITORING" ? gpSimulationGate : gpSelected.riskCash > math.min(dailyRoom, drawdownRoom) or
          gpSelected.riskCash > equityCap * gpRiskPct * 0.01 or notional > equityCap * gpExposurePct * 0.01 ? "PORTFOLIO RISK CAP" : ""
        if reject == "" and strategy.position_size == 0
            GoldCampaign campaign = GoldCampaign.new()
            campaign.plan := gpSelected
            campaign.submittedBar := bar_index
            campaign.workingStop := gpSelected.stop
            campaign.effectiveStop := gpSelected.stop
            gpActiveCampaign := campaign
            float limitPrice = gpEntryMethod == "Pullback limit" ? gpSelected.entry : na
            float stopPrice = gpEntryMethod == "Breakout stop" ? gpSelected.entry : na
            strategy.entry(gpSelected.id, gpSelected.side > 0 ? strategy.long : strategy.short, qty=gpSelected.qty,
              limit=limitPrice, stop=stopPrice, comment=gpSelected.model, disable_alert=true)
            f_gpSimBrackets(campaign)
            f_gpSimEvent(campaign, "SUBMITTED", gpEntryMethod, gpSelected.entry, false)
        else if gpEmitLogs or gpAlertEnabled
            f_gpEvent(gpSelected.model, gpSelected.id, gpSelected.side, "RISK_BLOCKED", reject,
              gpSelected.entry, gpSelected.stop, gpSelected.tp1, gpSelected.tp2, gpSelected.tp3, true)
    gpPreviousEquity := strategy.equity

string gpPresentationMode = gpSimEnabled ? "SIMULATION" : "RESEARCH"
GoldCampaign gpViewCampaign = na(gpActiveCampaign) ? gpLastCampaign : gpActiveCampaign
GoldPlan gpVisiblePlan = na(gpViewCampaign) ? gpLastPlan : gpViewCampaign.plan
string gpExecutionState = na(gpActiveCampaign) ? (na(gpLastCampaign) ? "FLAT" : "LAST SIMULATED CLOSED") : gpActiveCampaign.status
string gpExecutionRisk = gpSimulationGate
float gpVisibleFill = na(gpViewCampaign) ? na : gpViewCampaign.filled
float gpVisibleStop = na(gpViewCampaign) ? (na(gpVisiblePlan) ? na : gpVisiblePlan.stop) : gpViewCampaign.effectiveStop
string gpLastClosedText = "—"
if not na(gpLastCampaign)
    GoldPlan previous = gpLastCampaign.plan
    float initialRisk = ((gpLastCampaign.filled - previous.stop) * previous.side + gpCostPrice) * previous.qty * gpPoint
    gpLastClosedText := gpLastCampaign.exitReason == "INCOMPLETE_LEDGER" ? "INCOMPLETE LEDGER" :
      previous.model + " · $" + str.tostring(gpLastCampaign.realized, "#.##") +
      (initialRisk > 0 ? " / " + str.tostring(gpLastCampaign.realized / initialRisk, "#.##") + "R" : "")
bool gpShowNativePlan = not na(gpActiveCampaign)

// Precision view derives display state from the native simulation ledger.
bool prNativeActive = not na(gpActiveCampaign)
bool prPlanAvailable = gpLastState == "ENTRY_VALID" and not na(gpPlanValidThrough) and bar_index < gpPlanValidThrough
bool prNativeClosed = not prNativeActive and not prPlanAvailable and not na(gpLastCampaign)
GoldCampaign prViewCampaign = prNativeActive ? gpActiveCampaign : prNativeClosed ? gpLastCampaign : na
GoldPlan prViewPlan = na(prViewCampaign) ? gpLastPlan : prViewCampaign.plan
float prViewFill = na(prViewCampaign) ? na : prViewCampaign.filled
float prViewStop = na(prViewCampaign) ? (na(prViewPlan) ? na : prViewPlan.stop) : prViewCampaign.effectiveStop
int prViewFillAt = na(prViewCampaign) ? na : prViewCampaign.fillBar

var string prTargetsCampaign = ""
var int prTargetsSeen = 0
var bool prTargetOne = false
var bool prTargetTwo = false
var bool prTargetThree = false
var int prNativeExitBar = na
var string prTrackedStopCampaign = ""
var float prTrackedStop = na
var int prTrackedStopAt = na
var int prClosedStopAt = na
if gpClosedBar and gpSimEnabled
    if strategy.closedtrades > prTargetsSeen
        int firstTrade = math.max(prTargetsSeen, nz(strategy.closedtrades.first_index, 0))
        if firstTrade < strategy.closedtrades
            for tradeNumber = firstTrade to strategy.closedtrades - 1
                string entryId = strategy.closedtrades.entry_id(tradeNumber)
                if entryId != prTargetsCampaign
                    prTargetsCampaign := entryId
                    prTargetOne := false
                    prTargetTwo := false
                    prTargetThree := false
                string exitId = strategy.closedtrades.exit_id(tradeNumber)
                string exitReason = strategy.closedtrades.exit_comment(tradeNumber)
                prTargetOne := prTargetOne or (exitId == entryId + "|1" and exitReason == "TP1")
                prTargetTwo := prTargetTwo or (exitId == entryId + "|2" and exitReason == "TP2")
                prTargetThree := prTargetThree or (exitId == entryId + "|3" and exitReason == "TP3")
                prNativeExitBar := strategy.closedtrades.exit_bar_index(tradeNumber)
        prTargetsSeen := strategy.closedtrades
    if gpClosedMark and not na(gpLastCampaign)
        prClosedStopAt := prTrackedStopCampaign == gpLastCampaign.plan.id and
          prTrackedStop == gpLastCampaign.effectiveStop ? prTrackedStopAt : bar_index
    if prNativeActive
        if prTrackedStopCampaign != gpActiveCampaign.plan.id or prTrackedStop != gpActiveCampaign.effectiveStop
            prTrackedStopCampaign := gpActiveCampaign.plan.id
            prTrackedStop := gpActiveCampaign.effectiveStop
            prTrackedStopAt := bar_index

bool prLedgerForPlan = not na(prViewCampaign) and prViewCampaign.plan.id == prTargetsCampaign
int prViewClosedAt = prNativeClosed and prLedgerForPlan ? prNativeExitBar : na
int prViewStopAt = prNativeActive ? prTrackedStopAt : prClosedStopAt
bool prHitOne = prLedgerForPlan and prTargetOne
bool prHitTwo = prLedgerForPlan and prTargetTwo
bool prHitThree = prLedgerForPlan and prTargetThree
GoldCampaign prFillCampaign = gpClosedMark and not na(gpLastCampaign) and gpLastCampaign.fillBar == bar_index ?
  gpLastCampaign : gpActiveCampaign
bool prNativeFillMark = gpClosedBar and not na(prFillCampaign) and prFillCampaign.fillBar == bar_index
int prNativeFillSide = prNativeFillMark ? prFillCampaign.plan.side : 0
bool prMovedStop = not na(prViewCampaign) and prViewStop != prViewCampaign.plan.stop
string prProtection = not prMovedStop ? "INITIAL" : gpManagement == "Cost-adjusted BE" ? "BREAK EVEN" :
  gpManagement == "Profit lock" ? "PROFIT LOCK" : "TRAILING"
string prPosition = prNativeActive ? (na(prViewFill) ? "SIM ORDER PENDING" : "SIM ACTIVE") :
  prPlanAvailable ? "PLAN READY" : prNativeClosed ? "SIM CLOSED" : "FLAT"

string prPreset = input.string("PROFESSIONAL", "Dashboard preset",
  options=["PROFESSIONAL", "FULL AUDIT", "MINIMAL", "MOBILE"], group="Final display", display=display.none)
string prCorner = input.string("Auto", "Panel corner",
  options=["Auto", "Bottom right", "Bottom left", "Top right", "Top left"], group="Final display", display=display.none)
bool prShowDashboard = input.bool(true, "Show dashboard", group="Final display", display=display.none)
bool prShowLevels = input.bool(true, "Plan price levels", group="Final display", display=display.none)
bool prShowZones = input.bool(true, "Risk and reward zones", group="Final display", display=display.none)
bool prShowTags = input.bool(true, "Price tags", group="Final display", display=display.none)
bool prShowClosed = input.bool(false, "Latest closed campaign levels", group="Final display", display=display.none)
int prClosedAge = input.int(60, "Closed campaign maximum age (bars)", minval=5, maxval=3000,
  group="Final display", display=display.none)
string prDensity = input.string("Preset", "Historical marker density", options=["Preset", "Off", "Low", "Medium", "High"],
  group="Final display", display=display.none)
bool prShowWatches = input.bool(true, "Watch markers", group="Final display", display=display.none)
bool prShowDecisions = input.bool(true, "Rejected and expired markers in FULL AUDIT",
  group="Final display", display=display.none)
bool prShowFills = input.bool(false, "Extra Pine fill badges in FULL AUDIT", group="Final display", display=display.none,
  tooltip="Native TradingView strategy fills stay visible. This setting adds a custom badge with a SIM prefix.")
bool prShowStructure = input.bool(false, "Structure and BOS / MSS", group="Final audit overlays", display=display.none)
bool prShowSessions = input.bool(false, "Session and prior day levels", group="Final audit overlays", display=display.none)
bool prShowLiquidity = input.bool(false, "Estimated liquidity and FVG", group="Final audit overlays", display=display.none)

color prInk = #EDF2F7
color prSlate = #A8B5C5
color prGraphite = #101722
color prSurface = #151F2B
color prHeader = #1A2635
color prDivider = #293544
color prEmerald = #42D8B6
color prCoral = #FF8090
color prCyan = #62CAE2
color prAmber = #EFC174
bool prLightChart = 0.2126 * color.r(chart.bg_color) + 0.7152 * color.g(chart.bg_color) +
  0.0722 * color.b(chart.bg_color) > 145
color prChartBuy = prLightChart ? #087766 : prEmerald
color prChartSell = prLightChart ? #A5243D : prCoral
color prChartTarget = prLightChart ? #08697C : prCyan
color prChartWarning = prLightChart ? #855207 : prAmber
color prChartNeutral = prLightChart ? #394D62 : #B0BFD0
bool prMobile = prPreset == "MOBILE"
bool prMinimal = prPreset == "MINIMAL"
bool prFull = prPreset == "FULL AUDIT"
int prBodySize = prMobile ? 9 : 11
int prHeroSize = prMobile ? 11 : 13
string prPositionSetting = switch prCorner
    "Bottom left" => position.bottom_left
    "Top right" => position.top_right
    "Top left" => position.top_left
    "Auto" => prNativeActive and not prMobile ? position.bottom_left : position.bottom_right
    => position.bottom_right
var table prPanel = table.new(position.bottom_right, 2, 36, bgcolor=prGraphite, frame_color=prDivider, frame_width=1)

f_prPrice(float value) =>
    na(value) ? "—" : str.tostring(value, format.mintick)

f_prNumber(float value) =>
    na(value) ? "—" : str.tostring(value, "#.00")

f_prPair(float left, float right) =>
    f_prPrice(left) + " / " + f_prPrice(right)

f_prShort(string value, int length) =>
    str.length(value) > length ? str.substring(value, 0, length - 1) + "…" : value

f_prSide(int side) =>
    na(side) ? "?" : side > 0 ? "BUY" : side < 0 ? "SELL" : "NEUTRAL"

f_prDirectionColor(int side) =>
    na(side) ? prAmber : side > 0 ? prEmerald : side < 0 ? prCoral : prSlate

f_prReadable(string value) =>
    value == "" ? "—" : str.replace_all(value, "_", " ")

f_prRow(int row, string caption, string value, color ink, string help = "") =>
    color bg = row % 2 == 0 ? prGraphite : prSurface
    table.cell(prPanel, 0, row, " " + caption, bgcolor=bg, text_color=prSlate, text_size=prBodySize,
      text_halign=text.align_left, tooltip=help)
    table.cell(prPanel, 1, row, value + " ", bgcolor=bg, text_color=ink, text_size=prBodySize,
      text_halign=text.align_right, tooltip=help)
    row + 1

f_prSection(int row, string caption, string value, color ink, string help = "") =>
    table.cell(prPanel, 0, row, " " + caption, bgcolor=prHeader, text_color=prInk, text_size=prBodySize,
      text_halign=text.align_left, text_formatting=text.format_bold, tooltip=help)
    table.cell(prPanel, 1, row, value + " ", bgcolor=prHeader, text_color=ink, text_size=prBodySize,
      text_halign=text.align_right, text_formatting=text.format_bold, tooltip=help)
    row + 1

f_prTarget(float price, bool filled) =>
    f_prPrice(price) + (filled ? " ✓" : "")

bool prHasPlan = not na(prViewPlan)
bool prCurrentPlan = prHasPlan and (prNativeActive or prPlanAvailable)
bool prClosedInScope = prNativeClosed and prHasPlan and not na(prViewClosedAt) and bar_index - prViewClosedAt <= prClosedAge
bool prShowPlan = prCurrentPlan or prClosedInScope and (prShowClosed or prFull)
int prPlanSide = prShowPlan ? prViewPlan.side : 0
color prSideInk = f_prDirectionColor(prPlanSide)
bool prSimMode = gpPresentationMode == "SIMULATION"
bool prNewDecision = not na(gpLastPlan) and gpLastPlan.knownAt == time_close
bool prConflictNow = prNewDecision and gpLastConflict or gpOpportunityAt == time_close and gpOpportunityText == "CONFLICT"
bool prRiskRejected = prNewDecision and gpLastState == "ENTRY_REJECTED" or prConflictNow
bool prEligiblePlan = prHasPlan and prPlanAvailable and gpSupported and gpContextReady and gpContract and not gpLastConflict
bool prActionable = prEligiblePlan and not prNativeActive and not prSimMode
bool prInSimulationLane = prHasPlan and (gpTiming == "FAST" ? prViewPlan.model == "Q" : prViewPlan.model == gpStudyModel)
bool prDraw = barstate.islastconfirmedhistory or (barstate.islast and barstate.isconfirmed)

if prDraw and prShowDashboard
    table.set_position(prPanel, prPositionSetting)
    string opportunity = gpOpportunityText == "OPPORTUNITY EXPIRED" ? "EXPIRED" :
      gpOpportunityText == "CONFLICT" and not prConflictNow ? "WAIT" :
      gpOpportunityText == "ENTRY AVAILABLE" and not prPlanAvailable ? "WAIT" : gpOpportunityText
    string why = not gpSupported or not gpContract ? "UNSUPPORTED CHART" : not gpContextReady ? "CONTEXT UNAVAILABLE" :
      prNativeActive ? (na(prViewFill) ? "ORDER PENDING" : "POSITION OPEN") :
      prEligiblePlan and prSimMode ? (not prInSimulationLane ? "MODEL OUT OF LANE" :
      gpExecutionRisk == "RISK MONITORING" ? "SIM NOT SUBMITTED" : gpExecutionRisk) :
      prRiskRejected ? (prConflictNow ? "CONFLICT" : "RISK REJECTED") : opportunity == "EXPIRED" ? "EXPIRED" : "WAIT"
    string mobileWhy = switch why
        "UNSUPPORTED CHART" => "CHECK CHART"
        "CONTEXT UNAVAILABLE" => "NEED CONTEXT"
        "SIM NOT SUBMITTED" => "SIM BLOCKED"
        "MODEL OUT OF LANE" => "MODEL FILTER"
        "NEWS SOURCE REQUIRED" => "NEED NEWS"
        => why
    string action = prActionable ? "YES · " + f_prSide(prViewPlan.side) + " PLAN" : "NO · " + (prMobile ? mobileWhy : why)
    color actionInk = prActionable ? prSideInk : prRiskRejected or not gpContextReady ? prAmber : prInk
    color actionBg = prActionable ? (prViewPlan.side > 0 ? #16342E : #3A2533) : prHeader
    string actionHelp = prActionable ? "A current research plan cleared the original filters. Check the plan levels below." :
      "No new actionable setup. " + why + (gpLastReason == "" ? "" : " · " + f_prReadable(gpLastReason))
    table.cell(prPanel, 0, 0, " QIRVANTA GOLD PRO", bgcolor=prGraphite, text_color=prSlate, text_size=prBodySize,
      text_halign=text.align_left)
    table.cell(prPanel, 1, 0, syminfo.ticker + " · M" + timeframe.period + " ", bgcolor=prGraphite, text_color=prSlate,
      text_size=prBodySize, text_halign=text.align_right)
    table.cell(prPanel, 0, 1, " ACTIONABLE SETUP", bgcolor=actionBg, text_color=prInk, text_size=prHeroSize,
      text_halign=text.align_left, text_formatting=text.format_bold, tooltip=actionHelp)
    table.cell(prPanel, 1, 1, f_prShort(action, prMobile ? 19 : 31) + " ", bgcolor=actionBg, text_color=actionInk,
      text_size=prHeroSize, text_halign=text.align_right, text_formatting=text.format_bold, tooltip=actionHelp)
    int row = f_prSection(2, "MARKET BIAS", f_prSide(v22Trend), f_prDirectionColor(v22Trend), "Directional market context")
    string regime = gpSupported ? gpRegime : "UNSUPPORTED CHART"
    string context = f_prSide(gpH1Side) + " / " + f_prSide(gpH4Side)
    if not prMinimal
        row := f_prRow(row, "H1 / H4", context, gpContextReady ? prInk : prAmber, regime + " · Confirmed higher timeframe")
    string detail = f_prReadable(gpLastState) + (gpLastReason == "" ? "" : " · " + f_prReadable(gpLastReason))
    row := f_prSection(row, "OPPORTUNITY STATE", f_prShort(opportunity, prMobile ? 17 : 25),
      prRiskRejected ? prAmber : prCyan, detail)
    string tradeStatus = prNativeActive ? (na(prViewFill) ? "SIM ORDER PENDING" : "SIM POSITION OPEN") :
      prSimMode ? "FLAT · SIMULATION" : "OBSERVATION"
    row := f_prSection(row, "TRADE STATUS", tradeStatus, prNativeActive ? prSideInk : prSlate, gpExecutionRisk)
    if prShowPlan
        row := f_prRow(row, prClosedInScope and not prCurrentPlan ? "Closed entry" : "Entry / Sim fill",
          na(prViewFill) ? f_prPrice(prViewPlan.entry) : f_prPair(prViewPlan.entry, prViewFill), prCyan,
          "Planned entry / recorded TradingView emulator fill")
        bool stopMoved = not na(prViewStop) and math.abs(prViewStop - prViewPlan.stop) >= gpTick * 0.5
        row := f_prRow(row, stopMoved ? "Initial / Current SL" : "Stop loss",
          stopMoved ? f_prPair(prViewPlan.stop, prViewStop) : f_prPrice(prViewStop), prCoral, prProtection)
        row := f_prRow(row, "TP1 / TP2", f_prTarget(prViewPlan.tp1, prHitOne) + " / " + f_prTarget(prViewPlan.tp2, prHitTwo),
          prCyan, "A checkmark denotes a recorded matching target fill")
        row := f_prRow(row, "TP3 / Net est. R:R", f_prTarget(prViewPlan.tp3, prHitThree) + " / " + f_prNumber(prViewPlan.netRR),
          prCyan, "Estimated reward/risk includes the model's assumed costs")
    string last = gpLastClosedText
    row := f_prSection(row, "LAST CLOSED RESULT", f_prShort(last, prMobile ? 24 : 36), prSlate, last)
    if prFull
        row := f_prRow(row, "Regime / Session", f_prShort(regime + " · " + gpSession, 39), prSlate)
        row := f_prRow(row, "Structure", f_prShort(v22Structure, 30), prInk)
        row := f_prRow(row, "Momentum / ATR", f_prNumber(v22Momentum) + " / " + f_prNumber(v22ATR),
          v22Spike ? prAmber : prInk, "Three-bar momentum in ATR units / previous confirmed ATR")
        string liquidity = gpEqualHighs and gpEqualLows ? "BOTH SIDES" : gpEqualHighs ? "EQUAL HIGHS" :
          gpEqualLows ? "EQUAL LOWS" : gpBullFVG or gpBearFVG ? "FVG OBSERVED" : "—"
        row := f_prRow(row, "Liquidity", liquidity, prSlate)
        row := f_prRow(row, "D1 / Volatility", f_prSide(gpD1Side) + " / " + (v22Spike ? "SHOCK" :
          v22Expansion ? "EXPANSION" : v22Compression ? "COMPRESSION" : "NORMAL"), v22Spike ? prAmber : prInk)
        row := f_prRow(row, "Watch / Confirmed", gpLastWatch + " / " + gpLastConfirmation, prInk)
        row := f_prRow(row, "Quality / Conflict", gpLastQuality + (prConflictNow ? " · YES" : " · NO"),
          prConflictNow ? prAmber : prSlate, "Last recorded quality and conflict on the latest confirmed bar")
        row := f_prRow(row, "Decision / Reason", f_prShort(detail, 38), prRiskRejected ? prAmber : prInk, detail)
        row := f_prRow(row, "Simulation gate", gpExecutionRisk, prSlate)
        if prShowPlan
            row := f_prRow(row, "Model / Direction", f_gpModel(prViewPlan.model) + " · " + f_prSide(prPlanSide), prSideInk)
            row := f_prRow(row, "Extension / Cost", f_prNumber(prViewPlan.extension) + " ATR / $" +
              f_prNumber(prViewPlan.costCash), prSlate)
            row := f_prRow(row, "Risk / Units", "$" + f_prNumber(prViewPlan.riskCash) + " / " +
              f_prNumber(prViewPlan.qty), prSlate)
            row := f_prRow(row, "Confirmed UTC", str.format_time(prViewPlan.knownAt, "dd MMM HH:mm", "UTC"), prSlate)
        row := f_prRow(row, "Fill markers", "TRADINGVIEW" + (prShowFills ? " + SIM BADGES" : ""), prSlate)
        row := f_prRow(row, "News", GP_NEWS_STATE, prAmber)
    if row <= 35
        table.clear(prPanel, 0, row, 1, 35)

// Reuse one set of objects for the current plan. Each guide and tag keeps its ledger price.
var array<line> prLines = array.new<line>()
var array<label> prTags = array.new<label>()
var box prRiskBox = na
var box prRewardBox = na

f_prFar(float price, float other, float spacing) =>
    na(other) or math.abs(price - other) >= spacing

f_prLevel(int index, int startAt, int endAt, float price, string caption, color ink, string stroke, bool tag) =>
    line guide = prLines.get(index)
    label priceTag = prTags.get(index)
    bool visible = not na(price) and not na(startAt) and not na(endAt) and startAt <= endAt
    line.set_xy1(guide, visible ? startAt : bar_index, visible ? price : na)
    line.set_xy2(guide, visible ? endAt : bar_index, visible ? price : na)
    line.set_color(guide, ink)
    line.set_style(guide, stroke)
    // The right-facing tag extends left from the level endpoint and fits inside the pane.
    label.set_xy(priceTag, visible and tag ? endAt : bar_index, visible and tag ? price : na)
    label.set_text(priceTag, visible and tag ? (prFull ? caption + " " + f_prPrice(price) : caption) : "")
    label.set_textcolor(priceTag, ink)
    label.set_color(priceTag, prLightChart ? #F1F6F9 : prGraphite)
    label.set_tooltip(priceTag, caption + " · " + f_prPrice(price))

f_prZone(box zone, int left, int right, float first, float second, color ink) =>
    box.set_lefttop(zone, left, math.max(first, second))
    box.set_rightbottom(zone, right, math.min(first, second))
    box.set_bgcolor(zone, ink)

if prDraw
    if prLines.size() == 0
        for index = 0 to 6
            prLines.push(line.new(bar_index, na, bar_index, na))
            prTags.push(label.new(bar_index, na, style=label.style_label_right, size=9,
              text_font_family=font.family_monospace))
        prRiskBox := box.new(left=bar_index, top=na, right=bar_index, bottom=na, border_width=0)
        prRewardBox := box.new(left=bar_index, top=na, right=bar_index, bottom=na, border_width=0)
    int horizon = gpEntryMethod == "Next-open market" ? 1 : GP_PENDING_BARS
    bool showClosed = prClosedInScope and (prShowClosed or prFull)
    int planStart = prHasPlan ? prViewPlan.expiryBar - horizon : na
    bool visiblePlan = prShowLevels and (prCurrentPlan or showClosed) and
      not na(planStart) and planStart <= bar_index and bar_index - planStart < 9500
    int left = visiblePlan ? planStart : bar_index
    int right = not visiblePlan ? bar_index : showClosed ? prViewClosedAt : bar_index + 1
    float planned = visiblePlan ? prViewPlan.entry : na
    float executed = visiblePlan ? prViewFill : na
    float initial = visiblePlan ? prViewPlan.stop : na
    float stop = visiblePlan ? prViewStop : na
    float targetOne = visiblePlan ? prViewPlan.tp1 : na
    float targetTwo = visiblePlan ? prViewPlan.tp2 : na
    float targetThree = visiblePlan ? prViewPlan.tp3 : na
    bool moved = not na(stop) and math.abs(stop - initial) >= gpTick * 0.5
    int fillAt = visiblePlan and not na(executed) ? math.max(left, nz(prViewFillAt, left)) : left
    int stopAt = moved ? math.max(left, nz(prViewStopAt, right)) : left
    float minSpacing = math.max(nz(v22ATR, gpTick) * 0.28, gpTick * 3)
    color entryInk = color.new(prChartNeutral, showClosed ? 43 : 0)
    color lossInk = color.new(prChartSell, showClosed ? 44 : 0)
    color goalInk = color.new(prChartTarget, showClosed ? 42 : 0)
    color protectedInk = color.new(prChartBuy, showClosed ? 40 : 0)
    bool protect = moved and not na(executed) and (stop - executed) * prPlanSide >= 0
    bool tags = prShowTags and not prMinimal and not prMobile and not showClosed
    // Favor the current stop and emulator entry where neighboring values would overlap.
    bool fillTag = tags and not na(executed) and f_prFar(executed, stop, minSpacing)
    bool planTag = tags and f_prFar(planned, stop, minSpacing) and f_prFar(planned, executed, minSpacing)
    float entryTag = fillTag ? executed : planTag ? planned : na
    bool targetOneTag = tags and f_prFar(targetOne, stop, minSpacing) and f_prFar(targetOne, entryTag, minSpacing)
    bool targetTwoTag = tags and f_prFar(targetTwo, stop, minSpacing) and f_prFar(targetTwo, entryTag, minSpacing) and
      f_prFar(targetTwo, targetOneTag ? targetOne : na, minSpacing)
    bool targetThreeTag = tags and f_prFar(targetThree, stop, minSpacing) and f_prFar(targetThree, entryTag, minSpacing) and
      f_prFar(targetThree, targetOneTag ? targetOne : na, minSpacing) and f_prFar(targetThree, targetTwoTag ? targetTwo : na, minSpacing)
    bool initialTag = tags and moved and prFull and f_prFar(initial, stop, minSpacing) and f_prFar(initial, entryTag, minSpacing) and
      f_prFar(initial, targetOneTag ? targetOne : na, minSpacing) and f_prFar(initial, targetTwoTag ? targetTwo : na, minSpacing) and
      f_prFar(initial, targetThreeTag ? targetThree : na, minSpacing)
    f_prLevel(0, left, right, planned, "PLAN", entryInk, line.style_dashed, planTag)
    f_prLevel(1, fillAt, right, executed, "SIM", entryInk, line.style_solid, fillTag)
    f_prLevel(2, left, right, moved ? initial : na, "INIT SL", color.new(lossInk, 35), line.style_dotted, initialTag)
    f_prLevel(3, stopAt, right, stop, protect ? "PROTECTED SL" : "SL", protect ? protectedInk : lossInk, line.style_solid, tags)
    f_prLevel(4, left, right, targetOne, "TP1" + (prHitOne ? " ✓" : ""), prHitOne ? protectedInk : goalInk,
      prHitOne ? line.style_solid : line.style_dotted, targetOneTag)
    f_prLevel(5, left, right, targetTwo, "TP2" + (prHitTwo ? " ✓" : ""), prHitTwo ? protectedInk : goalInk,
      prHitTwo ? line.style_solid : line.style_dotted, targetTwoTag)
    f_prLevel(6, left, right, targetThree, "TP3" + (prHitThree ? " ✓" : ""), prHitThree ? protectedInk : goalInk,
      line.style_solid, targetThreeTag)
    bool zones = prShowZones and visiblePlan and not showClosed and not prMinimal and not prMobile
    float basis = na(executed) ? planned : executed
    bool showRisk = zones and not protect
    f_prZone(prRiskBox, math.max(fillAt, stopAt), right, showRisk ? basis : na, showRisk ? stop : na,
      color.new(prChartSell, 93))
    f_prZone(prRewardBox, fillAt, right, zones ? basis : na, zones ? targetThree : na, color.new(prChartTarget, 94))

bool prStructure = prFull and prShowStructure and gpClosedBar
bool prSessionLevels = prFull and prShowSessions
bool prLiquidity = prFull and prShowLiquidity and gpClosedBar
plot(prStructure ? v22PriorHigh : na, "Confirmed resistance", color.new(prChartSell, 43), 1, plot.style_linebr, display=display.pane)
plot(prStructure ? v22PriorLow : na, "Confirmed support", color.new(prChartBuy, 43), 1, plot.style_linebr, display=display.pane)
plot(prSessionLevels and gpSessionComplete ? gpSessionHigh : na, "Session high", color.new(prChartTarget, 48), 1, plot.style_linebr, display=display.pane)
plot(prSessionLevels and gpSessionComplete ? gpSessionLow : na, "Session low", color.new(prChartTarget, 48), 1, plot.style_linebr, display=display.pane)
plot(prSessionLevels and gpD1Known <= time ? gpD1High : na, "Prior day high", color.new(prChartNeutral, 53), 1, plot.style_linebr, display=display.pane)
plot(prSessionLevels and gpD1Known <= time ? gpD1Low : na, "Prior day low", color.new(prChartNeutral, 53), 1, plot.style_linebr, display=display.pane)
plot(prLiquidity and gpEqualHighs ? v22PriorHigh : na, "Estimated equal highs", color.new(prChartSell, 42), 2, plot.style_linebr, display=display.pane)
plot(prLiquidity and gpEqualLows ? v22PriorLow : na, "Estimated equal lows", color.new(prChartBuy, 42), 2, plot.style_linebr, display=display.pane)
plotshape(prLiquidity and gpBullFVG, "Bullish FVG observation", shape.diamond, location.belowbar, color.new(prChartBuy, 45), size=size.tiny, display=display.pane)
plotshape(prLiquidity and gpBearFVG, "Bearish FVG observation", shape.diamond, location.abovebar, color.new(prChartSell, 45), size=size.tiny, display=display.pane)
plotshape(prStructure and v22BOS == 1, "Bullish BOS/MSS", shape.square, location.belowbar, prChartBuy, size=size.tiny, display=display.pane)
plotshape(prStructure and v22BOS == -1, "Bearish BOS/MSS", shape.square, location.abovebar, prChartSell, size=size.tiny, display=display.pane)

// Keep one marker per confirmed bar. TradingView supplies the strategy's fill arrows.
int prRequestedMarkers = switch prDensity
    "Off" => 0
    "Low" => 8
    "Medium" => 20
    "High" => 48
    => prFull ? 30 : prMobile ? 4 : prMinimal ? 3 : 8
int prMarkerLimit = math.min(prRequestedMarkers, prMobile ? 6 : prMinimal ? 3 : 48)
var array<label> prHistory = array.new<label>()
var int prHistoryHead = 0
bool prNewOpportunity = gpOpportunityAt == time_close
bool prNewPlan = not na(gpLastPlan) and gpLastPlan.knownAt == time_close
bool prSignalConflict = gpBuyConfirmed and gpSellConfirmed
bool prBuyWatching = gpBuyWatch or prNewOpportunity and gpOpportunityText == "BUY WATCH"
bool prSellWatching = gpSellWatch or prNewOpportunity and gpOpportunityText == "SELL WATCH"
bool prWait = prNewOpportunity and gpOpportunityText == "WAIT FOR PULLBACK"
bool prExpired = gpExpiryMark or prNewOpportunity and gpOpportunityText == "OPPORTUNITY EXPIRED"
int prMarkerSide = prNewPlan ? gpLastPlan.side : gpBuyConfirmed ? 1 : gpSellConfirmed ? -1 :
  prBuyWatching and not prSellWatching ? 1 : prSellWatching and not prBuyWatching ? -1 : 0

if gpClosedBar and prMarkerLimit > 0
    string glyph = ""
    string detail = ""
    bool badge = false
    int side = prMarkerSide
    color accent = side > 0 ? prChartBuy : side < 0 ? prChartSell : prChartNeutral
    if prNativeFillMark
        if prFull and prShowFills
            side := prNativeFillSide
            glyph := side > 0 ? "SIM B" : "SIM S"
            detail := "Pine badge for a recorded TradingView emulator fill"
            accent := prChartTarget
    else if prSignalConflict and prFull
        glyph := "!"
        detail := "Conflicting confirmed BUY and SELL signals"
        side := 0
        accent := prChartWarning
    else if prNewPlan and gpLastState == "ENTRY_VALID" and not prSignalConflict
        glyph := gpLastPlan.model == "R" ? (side > 0 ? "B²" : "S²") : side > 0 ? "B" : "S"
        detail := (gpLastPlan.model == "R" ? "SECOND CHANCE" : "ENTRY VALID") + " · " + f_prSide(side)
        badge := true
    else if (gpBuyConfirmed or gpSellConfirmed) and not prSignalConflict
        side := gpBuyConfirmed ? 1 : -1
        accent := side > 0 ? prChartBuy : prChartSell
        glyph := side > 0 ? "B" : "S"
        detail := f_prSide(side) + " CONFIRMED"
        badge := true
    else if prFull and prShowDecisions and prNewPlan and gpLastState == "ENTRY_REJECTED"
        glyph := "!"
        detail := "ENTRY REJECTED · " + f_prReadable(gpLastReason)
        accent := prChartWarning
    else if prFull and prShowDecisions and prExpired
        glyph := "×"
        detail := "EXPIRED · " + f_prReadable(gpLastReason)
        accent := prChartNeutral
    else if prFull and prShowWatches and prWait
        glyph := "…"
        detail := "WAIT FOR PULLBACK · " + f_prReadable(gpLastReason)
        accent := prChartWarning
    else if prShowWatches and (prBuyWatching or prSellWatching) and not prMinimal
        side := prBuyWatching and not prSellWatching ? 1 : prSellWatching and not prBuyWatching ? -1 : 0
        accent := side > 0 ? prChartBuy : side < 0 ? prChartSell : prChartNeutral
        glyph := "·"
        detail := prBuyWatching and prSellWatching ? "BUY and SELL WATCH" : f_prSide(side) + " WATCH"
    if glyph != ""
        bool buy = side > 0
        float padding = math.max(nz(v22ATR, gpTick) * 0.12, gpTick * 3)
        float markerPrice = buy ? low - padding : high + padding
        string badgeStyle = not badge ? label.style_none : buy ? label.style_label_up : label.style_label_down
        color background = badge ? color.new(accent, 8) : color.new(accent, 100)
        color textInk = badge ? (prLightChart ? #FFFFFF : prGraphite) : accent
        label marker = na
        if prHistory.size() < prMarkerLimit
            marker := label.new(bar_index, markerPrice, yloc=yloc.price, size=9)
            prHistory.push(marker)
        else
            marker := prHistory.get(prHistoryHead)
            prHistoryHead := (prHistoryHead + 1) % prMarkerLimit
        label.set_xy(marker, bar_index, markerPrice)
        label.set_style(marker, badgeStyle)
        label.set_text(marker, glyph)
        label.set_color(marker, background)
        label.set_textcolor(marker, textInk)
        label.set_tooltip(marker, detail + "\n" + str.format_time(time_close, "dd MMM HH:mm", "UTC") + " UTC")
