// Native fill messages contain known plan/order levels, never an invented future fill.
// Actual fill price/quantity are supplied by the strategy_alert_message UI template.
f_alertSide(int d) => d == 1 ? "ПОКУПКА" : d == -1 ? "ПРОДАЖБА" : "БЕЗ ПОСОКА"
f_clockUtc(int stamp) => na(stamp) ? "—" : str.format_time(stamp, "dd.MM.yyyy HH:mm:ss", "UTC") + " UTC"
f_biasSymbol(int bias) => bias == 1 ? "↑" : bias == -1 ? "↓" : "↔"
// Only commentary is bounded. IDs, timestamps and executable prices never use this helper.
f_humanReason(string value, int limit) =>
    bool codeFragment = str.contains(value, "f_price(") or str.contains(value, "plannedCampaignQty") or str.contains(value, "maxDeviationATRFrozen") or str.contains(value, "=>")
    string clean = codeFragment ? "Технически подробности в диагностиката" : value
    clean := str.replace_all(clean, "NATIVE_", "")
    clean := str.replace_all(clean, "native", "емулатор")
    clean := str.replace_all(clean, "NATIVE", "ЕМУЛАТОР")
    clean := str.replace_all(clean, "FILTERED", "филтрирана симулация")
    clean := str.replace_all(clean, "RAW", "основна симулация")
    clean := str.replace_all(clean, "PAPER", "отделна симулация")
    clean := str.replace_all(clean, "HTF", "по-висока рамка")
    clean := str.replace_all(clean, "next-open", "следващо отваряне")
    clean := str.replace_all(clean, "fill", "изпълнение")
    f_short(clean, limit)
f_eventTitle(string kind) =>
    (kind == "ENTRY" or kind == "NATIVE_ENTRY") ? "СИМУЛИРАН ВХОД" : (kind == "TP1" or kind == "NATIVE_TP1") ? "СИМУЛИРАН ИЗХОД TP1" : (kind == "TP2" or kind == "NATIVE_TP2") ? "СИМУЛИРАН ИЗХОД TP2" : (kind == "TP3" or kind == "NATIVE_TP3") ? "СИМУЛИРАН ИЗХОД TP3" : (kind == "SL" or str.startswith(kind, "NATIVE_SL")) ? "СИМУЛИРАН СТОП" : kind == "NATIVE_EXIT_TIME" ? "ИЗХОД — ИЗТЕКЪЛ СРОК" : kind == "NATIVE_EXIT_GAP" ? "НЕВАЛИДЕН ИЗПЪЛНЕН ВХОД" : kind == "NATIVE_SUBMITTED" ? "ПЛАН ЗАЯВЕН · БЕЗ ИЗПЪЛНЕНИЕ" : kind == "WATCH" ? "ПОДГОТОВКА · ЧАКА ПОТВЪРЖДЕНИЕ" : kind == "CONFIRMED" ? "ТЕХНИЧЕСКИ КАНДИДАТ" : kind == "NATIVE_BLOCKED" ? "КАНДИДАТ БЕЗ ПОРЪЧКА" : kind == "NATIVE_NOT_FILLED" ? "ЗАЯВКАТА НЕ Е ИЗПЪЛНЕНА" : kind == "NATIVE_STOP_SCHEDULED" ? "НОВ СТОП ОТ СЛЕДВАЩИЯ ТИК" : kind == "CANCELLED" ? "ПЛАНЪТ Е ОТМЕНЕН" : kind == "EXPIRED" ? "ПЛАНЪТ Е ИЗТЕКЪЛ" : kind == "REJECTED" ? "КАНДИДАТЪТ Е ОТХВЪРЛЕН" : "ПРЕДУПРЕЖДЕНИЕ"
f_nativeMessage(Plan p, float plannedCampaignQty, string eventKind, string reason, float level) =>
    string actionReason = eventKind == "NATIVE_EXIT_GAP" ? "Точната причина не е записана; възможни са риск, преграда, новини или отклонение." : reason
    string expiry = f_int(p.expiresAfterBar - p.signalBar) + " св. след потв.: " + f_humanReason(p.cancellationReason, 64)
    string age = str.tostring(math.max(0, bar_index - p.signalBar)) + " св. при заявката"
    "QIRVANTA · " + syminfo.tickerid + " · " + timeframe.period + "\n" + f_eventTitle(eventKind) + " · " + f_alertSide(p.side) + "\n" + f_model(p.family) + " · План " + p.id + "\nПотв. " + f_clockUtc(p.signalTime) + " · " + age + "\nОриентир " + f_price(p.reference) + " · Структ. SL " + f_price(p.initialStop) + "\nR проекции: TP1 " + f_price(p.tp1) + " · TP2 " + f_price(p.tp2) + " · TP3 " + f_price(p.tp3) + "\nПреграда " + f_price(p.obstacle) + " · Заявено ниво " + f_price(level) + "\nРазмер на плана " + f_num(plannedCampaignQty) + " · Гап ≤ " + f_num(p.maxDeviationATRFrozen) + " ATR\nСрок " + f_int(p.maxHoldBarsFrozen) + " св. след вход\nБез изпълнение: " + expiry + "\n" + f_humanReason(actionReason, 96) + "\nСамо симулация; изпълнението е в данните на известието."
f_isRiskEvent(Event e) =>
    e.kind == "CANCELLED" or e.kind == "EXPIRED" or e.kind == "REJECTED" or e.kind == "EVIDENCE" or e.kind == "CONFLICT" or e.kind == "AMBIGUOUS" or e.kind == "NATIVE_BLOCKED" or e.kind == "NATIVE_DIVERGENCE" or e.kind == "NATIVE_NOT_FILLED" or e.kind == "NATIVE_LEDGER_INCOMPLETE" or e.kind == "NATIVE_STOP_SCHEDULED"
f_allowedUnifiedEvent(Event e) =>
    bool shadow = e.book != "CORE" and e.book != "NATIVE"
    bool nativeFillObservation = e.kind == "NATIVE_ENTRY" or str.startswith(e.kind, "NATIVE_EXIT_") or e.kind == "NATIVE_CLOSED"
    bool selectedPlan = e.book == "NATIVE" and e.kind == "NATIVE_SUBMITTED" and alertPlan
    bool watch = e.book == "CORE" and e.kind == "WATCH" and alertWatch
    bool risk = not shadow and f_isRiskEvent(e) and alertRisk and (e.book == "NATIVE" or e.kind == "EVIDENCE")
    bool diagnostic = alertDiagnostics and e.book == "CORE" and (e.kind == "CONFIRMED" or f_isRiskEvent(e))
    alertsEnabled and not nativeFillObservation and (selectedPlan or watch or risk or diagnostic or (shadow and alertShadow))
f_readableEvent(Event e) =>
    string origin = e.book == "CORE" ? "АНАЛИЗ" : e.book == "NATIVE" ? "ЕМУЛАТОР" : "ОТДЕЛНА СИМУЛАЦИЯ"
    string direction = e.kind == "WATCH" ? (e.side == 1 ? "НАГОРЕ" : "НАДОЛУ") : f_alertSide(e.side)
    string age = str.tostring(math.max(0, e.knownTime - e.effectiveTime) / 1000) + " сек. до обработка"
    "QIRVANTA · " + syminfo.tickerid + " · " + timeframe.period + "\n" + f_eventTitle(e.kind) + " · " + direction + "\n" + origin + " · " + f_model(e.family) + " · План " + e.planId + "\nСъбитие " + f_clockUtc(e.effectiveTime) + "\nОбработено " + f_clockUtc(e.knownTime) + " · " + age + "\nОриентир " + f_price(e.reference) + " · Структ. SL " + f_price(e.stop) + "\nR проекции: TP1 " + f_price(e.tp1) + " · TP2 " + f_price(e.tp2) + " · TP3 " + f_price(e.tp3) + "\nПреграда " + f_price(e.obstacle) + " · Цена на събитието " + f_price(e.price) + "\n" + f_humanReason(e.reason, 96) + "\nСамо симулация; старо известие не е нов вход."

